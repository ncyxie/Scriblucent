<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF would swap the SDK's implicit-using set (drops System.IO); the WPF framework
         reference flows transitively from the Scriblucent project instead. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scriblucent\Scriblucent.csproj" />
    <ProjectReference Include="..\Scriblucent.AI.Protocol\Scriblucent.AI.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Hunspell dictionary fixture for SpellCheckServiceTests - downloaded once from the
         same LibreOffice/dictionaries source SpellCheckDictionaryService fetches from at runtime,
         committed here so tests are deterministic and don't need network access. -->
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Scriblucent\Views\NoteEditorTabsWindow.xaml"
          Link="TestData\Production\NoteEditorTabsWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app's worker project is a deployment-only reference, so its managed entry assembly
       does not flow transitively into the test output. RealModel tests launch that worker. -->
  <Target Name="BuildAiWorkerForRealModelTests" BeforeTargets="CopyAiWorkerForRealModelTests">
    <MSBuild Projects="..\Scriblucent.AI.Worker\Scriblucent.AI.Worker.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64" />
  </Target>

  <Target Name="CopyAiWorkerForRealModelTests" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)AIWorker" Condition="Exists('$(OutDir)AIWorker')" />
    <ItemGroup>
      <AiWorkerTestFiles Include="..\Scriblucent.AI.Worker\bin\$(Configuration)\$(TargetFramework)\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AiWorkerTestFiles)"
          DestinationFolder="$(OutDir)AIWorker\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
