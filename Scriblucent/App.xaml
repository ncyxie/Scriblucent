<Application x:Class="Scriblucent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:conv="clr-namespace:Scriblucent.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Generic.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Shared.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Chrome.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Calendar.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Dashboard.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Quiz.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">6</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">6</sys:Double>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <sys:Double x:Key="GlobalVerticalScrollBarWidth">6</sys:Double>
            <sys:Double x:Key="GlobalHorizontalScrollBarHeight">6</sys:Double>

            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="behaviors:CheckBoxCheckMotionBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder"
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Path x:Name="CheckGlyph"
                                          Data="M 2,5.5 L 5.5,9 L 12,2.5"
                                          Stroke="{DynamicResource TextColor}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0"
                                          StrokeDashArray="{StaticResource CheckGlyphDashArray}"
                                          StrokeDashOffset="{StaticResource CheckGlyphPathLength}"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernScrollBarThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}"/>
                <Setter Property="MinWidth" Value="3"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBody"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"
                                    Margin="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollBarThumbPressedBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Opacity" Value="0.85"/>
                <Setter Property="Width" Value="{DynamicResource GlobalVerticalScrollBarWidth}"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreaseButton"
                                                      Command="ScrollBar.LineUpCommand"
                                                      Style="{StaticResource ModernScrollBarButtonStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="PART_Thumb" Style="{StaticResource ModernScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreaseButton"
                                                      Command="ScrollBar.LineDownCommand"
                                                      Style="{StaticResource ModernScrollBarButtonStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="{DynamicResource GlobalVerticalScrollBarWidth}"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.LineLeftCommand"/>
                                    <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.LineRightCommand"/>
                                    <Setter TargetName="PART_Thumb" Property="MinWidth" Value="26"/>
                                    <Setter TargetName="PART_Thumb" Property="MinHeight" Value="3"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Height" Value="{DynamicResource GlobalHorizontalScrollBarHeight}"/>
                                </Trigger>
                                <Trigger Property="Visibility" Value="Collapsed">
                                    <Setter Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Level 1 grabber: theme fill + accent ring so the thumb reads on card/window chrome. -->
            <ControlTemplate x:Key="ModernSliderThumbTemplate" TargetType="{x:Type Thumb}">
                <Ellipse Width="14"
                         Height="14"
                         Fill="{DynamicResource SliderThumbBackground}"
                         Stroke="{DynamicResource SliderThumbBorder}"
                         StrokeThickness="2"
                         Effect="{StaticResource Elevation.Thumb}"/>
            </ControlTemplate>

            <Style TargetType="{x:Type Slider}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid Margin="2,0">
                                <Border Height="4"
                                        CornerRadius="2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SliderTrackBackground}"/>
                                <Track x:Name="PART_Track" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Opacity="0"
                                                      Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Opacity="0"
                                                      Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource ModernSliderThumbTemplate}"
                                               VerticalAlignment="Center"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="True"/>
                <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="{x:Type Separator}">
                <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border Background="{TemplateBinding Background}"
                                    Height="1"
                                    SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            </Style>

            <!-- Level 2 floating chrome: Elevation.Popup + theme PopupBorder (clip only on inner shell). -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <!-- Seal weight so Bold/SemiBold on owner buttons (⋯, Layout) does not inherit into items. -->
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="Transparent"
                                    Padding="18,14,18,20"
                                    ClipToBounds="False">
                                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="4"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Leaf + submenu MenuItem chrome. SubmenuHeader needs PART_Popup / ItemsHost
                 or nested ContextMenu items (table Insert ▸ etc.) never open or fire. -->
            <ControlTemplate x:Key="MenuItemLeafTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="ItemBorder"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,8"
                        Margin="2,1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon/check gutter: checkable items and items with an icon reserve a
                             fixed slot (checkmark and icons line up, Word-style); plain items
                             get no slot at all - no stray indent. -->
                        <Grid x:Name="IconGutter"
                              Grid.Column="0"
                              Width="Auto"
                              VerticalAlignment="Center">
                            <Grid.MinWidth>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.MinWidth>
                            <Grid.Margin>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.Margin>
                            <ContentPresenter x:Name="IconPresenter"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark"
                                  Width="10"
                                  Height="8"
                                  Data="M 1.5,5 L 4,7.5 L 8.5,1.5"
                                  Stroke="{DynamicResource AccentPrimary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownItemHoverBackground}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="MenuItemSubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="ItemBorder"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,8"
                        Margin="2,1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Same icon/check slot as leaf items, so submenu headers with an icon
                             (e.g. the "Text wrap" header) line up with the other menu items. -->
                        <Grid x:Name="IconGutter"
                              Grid.Column="0"
                              Width="Auto"
                              VerticalAlignment="Center">
                            <Grid.MinWidth>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.MinWidth>
                            <Grid.Margin>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.Margin>
                            <ContentPresenter x:Name="IconPresenter"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                        <Path Grid.Column="2"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Data="M0,0 L4,3.5 0,7 Z"
                              Fill="{TemplateBinding Foreground}"
                              StrokeThickness="0"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="6"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               PopupAnimation="Fade"
                               VerticalOffset="-6">
                            <Border Background="Transparent"
                                    Padding="18,14,18,20"
                                    ClipToBounds="False">
                                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="4"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownItemHoverBackground}"/>
                    </Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownItemHoverBackground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource MenuItemLeafTemplate}"/>
                <Style.Triggers>
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
