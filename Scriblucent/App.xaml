<Application x:Class="Scriblucent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:conv="clr-namespace:Scriblucent.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Generic.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Shared.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Chrome.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Calendar.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Dashboard.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Quiz.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <sys:Double x:Key="GlobalVerticalScrollBarWidth">8</sys:Double>
            <sys:Double x:Key="GlobalHorizontalScrollBarHeight">8</sys:Double>

            <!-- One shared ContextMenu for every dashboard card. Cards are virtualized and can
                 number in the hundreds; an 11-item menu + 2 separators + 13 bindings per card
                 adds up fast (virtualized or not, WPF constructs the menu tree with the
                 control). The open path (NoteCardControl.OpenContextMenu) assigns the card's
                 DataContext on each open, and the binding below is the fallback for any other
                 opener. -->
            <ContextMenu x:Key="NoteCardContextMenu" behaviors:ItemReorderBehavior.MenuActions="True"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}" Click="OnNoteCardMenuOpen"/>
                <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}" Click="OnNoteCardMenuSelectMultiple"/>
                <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="OnNoteCardMenuInfo"/>
                <Separator/>
                <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                          Command="{Binding TogglePinCommand}"
                          Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                          Command="{Binding TogglePinCommand}"
                          Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="OnNoteCardMenuAssignSchedule"/>
                <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                          Command="{Binding RemoveFromGroupCommand}"
                          Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                          Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="{Binding [ReplaceFromFile], Source={StaticResource Loc}}" Click="OnNoteCardMenuReplaceFromFile"/>
                <Separator/>
                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}" Command="{Binding DeleteCommand}"/>
            </ContextMenu>



            <Style x:Key="ModernScrollBarThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!-- No MinWidth/MinHeight: the WPF Track clips the thumb to its computed slot,
                     so a min-height-stretched thumb gets a square cut at the clip edge (the
                     "rounded top, flat bottom" artifact). Without a min the thumb matches the
                     slot and both ends render rounded at any size. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBody"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Margin="1"
                                    SnapsToDevicePixels="True"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollBarThumbPressedBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Opacity" Value="0.85"/>
                <Setter Property="Width" Value="{DynamicResource GlobalVerticalScrollBarWidth}"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBackground}"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreaseButton"
                                                      Command="ScrollBar.LineUpCommand"
                                                      Style="{StaticResource ModernScrollBarButtonStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="PART_Thumb" Style="{StaticResource ModernScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreaseButton"
                                                      Command="ScrollBar.LineDownCommand"
                                                      Style="{StaticResource ModernScrollBarButtonStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="{DynamicResource GlobalVerticalScrollBarWidth}"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.LineLeftCommand"/>
                                    <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.LineRightCommand"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Height" Value="{DynamicResource GlobalHorizontalScrollBarHeight}"/>
                                </Trigger>
                                <Trigger Property="Visibility" Value="Collapsed">
                                    <Setter Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource ModernSliderStyle}"/>

            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="True"/>
                <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style TargetType="{x:Type Separator}">
                <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border Background="{TemplateBinding Background}"
                                    Height="1"
                                    SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            </Style>

            <!-- Level 2 floating chrome: Elevation.Popup + theme PopupBorder (clip only on inner shell). -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <!-- Padding grew to 32 so the blur can finish; pull the menu back by the
                     extra inset so the card stays where it was relative to the pointer. -->
                <Setter Property="HorizontalOffset" Value="-14"/>
                <Setter Property="VerticalOffset" Value="-18"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <!-- Seal weight so Bold/SemiBold on owner buttons (⋯, Layout) does not inherit into items. -->
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="4"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Leaf + submenu MenuItem chrome. SubmenuHeader needs PART_Popup / ItemsHost
                 or nested ContextMenu items (table Insert ▸ etc.) never open or fire. -->
            <ControlTemplate x:Key="MenuItemLeafTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="ItemBorder" behaviors:StateSurfaceMotionBehavior.IsEnabled="True"
                        behaviors:StateSurfaceMotionBehavior.ActiveState="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,8"
                        Margin="2,1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon/check gutter: checkable items and items with an icon reserve a
                             fixed slot (checkmark and icons line up, Word-style); plain items
                             get no slot at all - no stray indent. -->
                        <Grid x:Name="IconGutter"
                              Grid.Column="0"
                              Width="Auto"
                              VerticalAlignment="Center">
                            <Grid.MinWidth>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.MinWidth>
                            <Grid.Margin>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.Margin>
                            <ContentPresenter x:Name="IconPresenter"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <Path x:Name="CheckMark"
                                  Width="10"
                                  Height="8"
                                  Data="M 1.5,5 L 4,7.5 L 8.5,1.5"
                                  Stroke="{DynamicResource AccentPrimary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="MenuItemSubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
                <Border x:Name="ItemBorder" behaviors:StateSurfaceMotionBehavior.IsEnabled="True"
                        behaviors:StateSurfaceMotionBehavior.ActiveState="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,8"
                        Margin="2,1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Same icon/check slot as leaf items, so submenu headers with an icon
                             (e.g. the "Text wrap" header) line up with the other menu items. -->
                        <Grid x:Name="IconGutter"
                              Grid.Column="0"
                              Width="Auto"
                              VerticalAlignment="Center">
                            <Grid.MinWidth>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.MinWidth>
                            <Grid.Margin>
                                <MultiBinding Converter="{x:Static conv:MenuGutterGeometryConverter.Instance}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsCheckable"/>
                                </MultiBinding>
                            </Grid.Margin>
                            <ContentPresenter x:Name="IconPresenter"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                        <Path Grid.Column="2"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Data="M0,0 L4,3.5 0,7 Z"
                              Fill="{TemplateBinding Foreground}"
                              StrokeThickness="0"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-8"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               PopupAnimation="None"
                               VerticalOffset="-24">
                            <Border
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="4"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSubmenuOpen" Value="True">
                        <Setter TargetName="ItemBorder" Property="behaviors:StateSurfaceMotionBehavior.ActiveState" Value="True"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="MinHeight" Value="{StaticResource Control.Height.Menu}"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Control.Menu}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource MenuItemLeafTemplate}"/>
                <Style.Triggers>
                    <Trigger Property="Role" Value="TopLevelHeader">
                        <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
                    </Trigger>
                    <Trigger Property="Role" Value="SubmenuHeader">
                        <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GroupColourMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="IsCheckable" Value="True"/>
                <Setter Property="IsChecked">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource GroupAccentConverter}" ConverterParameter="Selected" Mode="OneWay">
                            <Binding Path="PlacementTarget.DataContext.BackgroundBrush" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource GroupAccentConverter}" ConverterParameter="Swatch">
                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=MenuItem}"/>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=MenuItem}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
