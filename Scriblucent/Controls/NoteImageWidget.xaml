<UserControl xmlns:controls="clr-namespace:Scriblucent.Controls" x:Class="Scriblucent.Controls.NoteImageWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:localization="clr-namespace:Scriblucent.Localization"
             x:Name="Root"
             MinWidth="80"
             MinHeight="80"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Focusable="True"
             Background="Transparent"
             ClipToBounds="False"
             ContextMenuOpening="ContextMenu_Opening">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding [TextWrap], Source={x:Static localization:LocalizationProvider.Instance}}">
                <MenuItem x:Name="WrapInlineItem"
                          Header="{Binding [WrapInline], Source={x:Static localization:LocalizationProvider.Instance}}"
                          IsCheckable="True"
                          Tag="Inline"
                          Click="ContextMenuWrapMode_Click"/>
                <MenuItem x:Name="WrapSquareItem"
                          Header="{Binding [WrapSquare], Source={x:Static localization:LocalizationProvider.Instance}}"
                          IsCheckable="True"
                          Tag="Square"
                          Click="ContextMenuWrapMode_Click"/>
                <MenuItem x:Name="WrapTopBottomItem"
                          Header="{Binding [WrapTopAndBottom], Source={x:Static localization:LocalizationProvider.Instance}}"
                          IsCheckable="True"
                          Tag="TopAndBottom"
                          Click="ContextMenuWrapMode_Click"/>
                <MenuItem x:Name="WrapNoneItem"
                          Header="{Binding [WrapNone], Source={x:Static localization:LocalizationProvider.Instance}}"
                          IsCheckable="True"
                          Tag="None"
                          Click="ContextMenuWrapMode_Click"/>
            </MenuItem>
            <MenuItem x:Name="ArrangeForwardItem"
                      Header="{Binding [BringForward], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Tag="Forward"
                      Click="ContextMenuArrange_Click"/>
            <MenuItem x:Name="ArrangeBackwardItem"
                      Header="{Binding [SendBackward], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Tag="Backward"
                      Click="ContextMenuArrange_Click"/>
            <Separator/>
            <MenuItem x:Name="LockAspectItem"
                      Header="{Binding [LockAspectRatio], Source={x:Static localization:LocalizationProvider.Instance}}"
                      IsCheckable="True"
                      Click="ContextMenuLockAspect_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [CopyImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Click="ContextMenuCopy_Click"/>
            <MenuItem Header="{Binding [CutImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Click="ContextMenuCut_Click"/>
            <MenuItem Header="{Binding [ChangePicture], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Click="ContextMenuChangePicture_Click"/>
            <MenuItem Header="{Binding [InsertCaption], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Click="ContextMenuCaption_Click"/>
            <MenuItem Header="{Binding [DeleteImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                      Click="ContextMenuDelete_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Scriblucent;component/Themes/Controls/ImageChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" ClipToBounds="False">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionWash"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HandleLayer"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionWash"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HandleLayer"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Elevation host stays unclipped so Popup shadow can fall off; no CardBackground
             plate (that filled transparent PNG alpha white while dragging). -->
        <Border x:Name="ElevationHost"
                Background="Transparent"
                ClipToBounds="False"
                Effect="{x:Null}">
            <Border x:Name="ImageClipHost"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Background="Transparent"
                    MouseLeftButtonDown="Body_MouseLeftButtonDown">
                <Grid>
                    <Image x:Name="DisplayImage"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"/>
                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Marker" controls:SurfaceMaterial.Foreground="{DynamicResource AccentPrimaryForeground}" x:Name="SelectionWash"
                            Background="{DynamicResource EditSelectionWash}"
                            Opacity="1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Border>

        <!-- Flush with image; each 22x22 thumb center sits on a corner or edge midpoint. -->
        <Grid x:Name="HandleLayer"
              Margin="0"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              ClipToBounds="False">

            <!-- Corners: elbow of L at thumb center (11,11) -->
            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNWSE"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="-11,-11,0,0" Tag="TL"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNESW"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-11,-11,0" Tag="TR"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNWSE"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,-11,-11" Tag="BR"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNESW"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="-11,0,0,-11" Tag="BL"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <!-- Mid-edge capsule bars -->
            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNS"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,-11,0,0" Tag="T"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeWE"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,-11,0" Tag="R"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeNS"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,-11" Tag="B"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <Thumb Style="{StaticResource ImageResizeThumbStyle}"
                   Cursor="SizeWE"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="-11,0,0,0" Tag="L"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"/>

            <!-- Aspect lock + delete chips — above the top edge, clear of resize brackets;
                 flipped below the bottom edge when the image is pressed against the top. -->
            <Button x:Name="LockAspectButton"
                    Width="26"
                    Height="26"
                    Margin="0,-34,44,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="0"
                    Cursor="Hand"
                    IsTabStop="False"
                    Focusable="False"
                    Style="{DynamicResource EditorToolButtonBaseStyle}"
                    Click="LockAspectButton_Click"
                    Content="{icons:Icon Kind=Lock, Size=12}"/>
            <Button x:Name="DeleteButton"
                    Width="26"
                    Height="26"
                    Margin="0,-34,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="0"
                    Cursor="Hand"
                    IsTabStop="False"
                    Focusable="False"
                    Style="{DynamicResource EditorDangerToolButtonStyle}"
                    ToolTip="{Binding [DeleteImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                    Click="DeleteButton_Click"
                    Content="{icons:Icon Kind=Delete, Size=12}"/>
        </Grid>
    </Grid>
</UserControl>
