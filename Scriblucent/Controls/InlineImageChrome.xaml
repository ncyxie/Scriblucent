<UserControl x:Class="Scriblucent.Controls.InlineImageChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:localization="clr-namespace:Scriblucent.Localization"
             Focusable="False"
             Background="{x:Null}"
             IsHitTestVisible="True"
             Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Scriblucent;component/Themes/Controls/ImageChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <!-- Flush with the image; each 22x22 thumb center sits on a corner (same geometry as
             the floating widget's corner handles). The chrome lives on the overlay canvas, so
             the handles always meet the photo's corners - never clipped by the text content. -->
        <Thumb x:Name="TopLeftThumb"
               Style="{StaticResource ImageResizeThumbStyle}"
               Cursor="SizeNWSE"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-11,-11,0,0" Tag="TL"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted"/>

        <Thumb x:Name="TopRightThumb"
               Style="{StaticResource ImageResizeThumbStyle}"
               Cursor="SizeNESW"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-11,-11,0" Tag="TR"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted"/>

        <Thumb x:Name="BottomRightThumb"
               Style="{StaticResource ImageResizeThumbStyle}"
               Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-11,-11" Tag="BR"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted"/>

        <Thumb x:Name="BottomLeftThumb"
               Style="{StaticResource ImageResizeThumbStyle}"
               Cursor="SizeNESW"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-11,0,0,-11" Tag="BL"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted"/>

        <!-- Aspect lock + delete chips, same chrome as the floating widget; flipped below the
             photo when it is pressed against the editor's top edge. -->
        <Button x:Name="LockAspectButton"
                Width="26"
                Height="26"
                Margin="0,-34,44,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="0"
                Cursor="Hand"
                IsTabStop="False"
                Focusable="False"
                Style="{DynamicResource EditorToolButtonBaseStyle}"
                Click="LockAspectButton_Click"
                Content="{icons:Icon Kind=Lock, Size=12}"/>
        <Button x:Name="DeleteButton"
                Width="26"
                Height="26"
                Margin="0,-34,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="0"
                Cursor="Hand"
                IsTabStop="False"
                Focusable="False"
                Style="{DynamicResource EditorDangerToolButtonStyle}"
                ToolTip="{Binding [DeleteImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                Click="DeleteButton_Click"
                Content="{icons:Icon Kind=Delete, Size=12}"/>
    </Grid>
</UserControl>
