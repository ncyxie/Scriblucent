<UserControl x:Class="Scriblucent.Controls.InlineImageChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:localization="clr-namespace:Scriblucent.Localization"
             Focusable="False"
             Background="{x:Null}"
             IsHitTestVisible="True"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="InlineChromeHandleHitStyle" TargetType="Thumb">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>

        <!-- Shared L-bracket stroke (elbow at local 11,11 = thumb center), same as the
             floating widget's selection chrome. -->
        <Style x:Key="InlineChromeBracketPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="StrokeThickness" Value="2.25"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <!-- Flush with the image; each 22x22 thumb center sits on a corner (same geometry as
             the floating widget's corner handles). The chrome lives on the overlay canvas, so
             the handles always meet the photo's corners - never clipped by the text content. -->
        <Thumb x:Name="TopLeftThumb"
               Style="{StaticResource InlineChromeHandleHitStyle}"
               Cursor="SizeNWSE"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-11,-11,0,0" Tag="TL"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Width="22" Height="22">
                        <Path Style="{StaticResource InlineChromeBracketPathStyle}"
                              Data="M 3,11 L 11,11 L 11,3"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Thumb x:Name="TopRightThumb"
               Style="{StaticResource InlineChromeHandleHitStyle}"
               Cursor="SizeNESW"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-11,-11,0" Tag="TR"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Width="22" Height="22">
                        <Path Style="{StaticResource InlineChromeBracketPathStyle}"
                              Data="M 19,11 L 11,11 L 11,3"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Thumb x:Name="BottomRightThumb"
               Style="{StaticResource InlineChromeHandleHitStyle}"
               Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-11,-11" Tag="BR"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Width="22" Height="22">
                        <Path Style="{StaticResource InlineChromeBracketPathStyle}"
                              Data="M 19,11 L 11,11 L 11,19"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Thumb x:Name="BottomLeftThumb"
               Style="{StaticResource InlineChromeHandleHitStyle}"
               Cursor="SizeNESW"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-11,0,0,-11" Tag="BL"
               DragStarted="ResizeThumb_DragStarted"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Width="22" Height="22">
                        <Path Style="{StaticResource InlineChromeBracketPathStyle}"
                              Data="M 3,11 L 11,11 L 11,19"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Aspect lock + delete chips, same chrome as the floating widget; flipped below the
             photo when it is pressed against the editor's top edge. -->
        <Button x:Name="LockAspectButton"
                Width="26"
                Height="26"
                Margin="0,-34,44,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="0"
                Cursor="Hand"
                IsTabStop="False"
                Focusable="False"
                Style="{DynamicResource EditorToolButtonBaseStyle}"
                Click="LockAspectButton_Click"
                Content="{icons:Icon Kind=Lock, Size=12}"/>
        <Button x:Name="DeleteButton"
                Width="26"
                Height="26"
                Margin="0,-34,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="0"
                Cursor="Hand"
                IsTabStop="False"
                Focusable="False"
                Style="{DynamicResource EditorDangerToolButtonStyle}"
                ToolTip="{Binding [DeleteImage], Source={x:Static localization:LocalizationProvider.Instance}}"
                Click="DeleteButton_Click"
                Content="{icons:Icon Kind=Delete, Size=12}"/>
    </Grid>
</UserControl>
