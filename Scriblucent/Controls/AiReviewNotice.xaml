<UserControl xmlns:controls="clr-namespace:Scriblucent.Controls" x:Class="Scriblucent.Controls.AiReviewNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             HorizontalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- Role I status banner: amber fill + optional status stroke, matching CramModeBanner
         and the quiz hint chip, with a warning glyph so the line is readable at a glance. -->
    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Background="{DynamicResource AccentWarningSubtle}"
            BorderBrush="{DynamicResource AccentWarningSubtleBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}"
            Padding="12,8">
        <DockPanel LastChildFill="True">
            <Button x:Name="DismissButton"
                    DockPanel.Dock="Right"
                    Width="22"
                    Height="22"
                    Margin="8,0,0,0"
                    Padding="0"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    Focusable="True"
                    MinHeight="0" MinWidth="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    ToolTip="{Binding [AiGenerationDismiss], Source={StaticResource Loc}}"
                    Visibility="Collapsed"
                    Click="DismissButton_Click">
                <icons:AppIcon Kind="Close"
                               Width="12"
                               Height="12"
                               Foreground="{DynamicResource AccentWarningSubtleForeground}"/>
            </Button>
            <icons:AppIcon Kind="Warning"
                           Width="14"
                           Height="14"
                           Margin="0,1,8,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentWarningSubtleForeground}"/>
            <TextBlock Text="{Binding [AiReviewDisclaimer], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentWarningSubtleForeground}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </controls:SurfaceMaterialBorder>
</UserControl>
