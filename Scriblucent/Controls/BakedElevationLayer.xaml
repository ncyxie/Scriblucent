<UserControl x:Class="Scriblucent.Controls.BakedElevationLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False">
    <!-- The face owns layout. Constrain the slice grid to the layer's arranged size;
         its unconstrained image measurements must not push the lower corners down. -->
    <Grid x:Name="Slices"
          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightColumn" Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomRow" Height="30"/>
        </Grid.RowDefinitions>
        <Image x:Name="TopLeft" Grid.Row="0" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="TopEdge" Grid.Row="0" Grid.Column="1" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="TopRight" Grid.Row="0" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="LeftEdge" Grid.Row="1" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="RightEdge" Grid.Row="1" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="BottomLeft" Grid.Row="2" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="BottomEdge" Grid.Row="2" Grid.Column="1" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
        <Image x:Name="BottomRight" Grid.Row="2" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant"/>
    </Grid>
</UserControl>
