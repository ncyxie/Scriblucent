<UserControl x:Class="Scriblucent.Controls.Dashboard.DashboardSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="MoveUpButton"
                Grid.Column="0"
                Style="{StaticResource DashboardSectionMoveButtonStyle}"
                Content="{icons:Icon Kind=ArrowUp, Size=12}"
                Margin="0,0,2,0"
                Click="MoveUpButton_Click"/>
        <Button x:Name="MoveDownButton"
                Grid.Column="1"
                Style="{StaticResource DashboardSectionMoveButtonStyle}"
                Content="{icons:Icon Kind=ArrowDown, Size=12}"
                Margin="0,0,4,0"
                Click="MoveDownButton_Click"/>
        <Button x:Name="ToggleButton"
                Grid.Column="2"
                Style="{StaticResource DashboardSectionToggleButtonStyle}"
                Click="ToggleButton_Click"/>
        <TextBlock x:Name="TitleText"
                   Grid.Column="3"
                   FontSize="{StaticResource Type.SectionTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
        <ContentPresenter x:Name="TrailingContentPresenter"
                          Grid.Column="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
    </Grid>
</UserControl>
