<UserControl x:Class="Scriblucent.Controls.Dashboard.DashboardSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:controls="clr-namespace:Scriblucent.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <controls:PositionButtons x:Name="PositionButton" Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                        CanMoveUp="True" CanMoveDown="True" MoveUp="MoveUpMenu_Click" MoveDown="MoveDownMenu_Click"/>
                <Border>
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ActionStripDividerStyle}"><Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PositionButton}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                </Border>
                <Button x:Name="ToggleButton"
                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                        Click="ToggleButton_Click"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="TitleText"
                   Grid.Column="3"
                   FontSize="{StaticResource Type.SectionTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"/>
        <ContentPresenter x:Name="TrailingContentPresenter"
                          Grid.Column="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
    </Grid>
</UserControl>
