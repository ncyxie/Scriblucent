<UserControl x:Class="Scriblucent.Controls.Dashboard.EmptyDashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             HorizontalAlignment="Center"
             Margin="0,32,0,0">
    <StackPanel x:Name="MotionRoot" HorizontalAlignment="Center">
        <Grid x:Name="GlyphChip" Width="144" Height="120" HorizontalAlignment="Center"
              IsHitTestVisible="False" Margin="0,0,0,20"/>
        <TextBlock x:Name="PromptText"
                   FontFamily="{StaticResource FontFamily.UI}"
                   FontSize="{StaticResource Type.EmptyState}"
                   Foreground="{DynamicResource TextColor}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   Margin="0,0,0,16"/>
        <Button x:Name="PrimaryButton"
                Style="{StaticResource EmptyDashboardPrimaryButtonStyle}"
                MinWidth="180"
                Padding="18,10"
                HorizontalAlignment="Center"
                Click="PrimaryButton_Click"/>
    </StackPanel>
</UserControl>
