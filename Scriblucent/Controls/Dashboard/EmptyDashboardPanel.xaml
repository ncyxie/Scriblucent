<UserControl x:Class="Scriblucent.Controls.Dashboard.EmptyDashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center"
             Margin="0,32,0,0">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock x:Name="PromptText"
                   FontSize="{StaticResource Type.EmptyState}"
                   FontStyle="Italic"
                   Foreground="{DynamicResource TextColorSecondary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   Margin="0,0,0,8"/>
        <Button x:Name="PrimaryButton"
                Style="{StaticResource EmptyDashboardPrimaryButtonStyle}"
                MinWidth="180"
                Padding="18,10"
                HorizontalAlignment="Center"
                Click="PrimaryButton_Click"/>
    </StackPanel>
</UserControl>
