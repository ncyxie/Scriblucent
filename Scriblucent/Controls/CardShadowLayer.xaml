<UserControl x:Class="Scriblucent.Controls.CardShadowLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             IsHitTestVisible="False"
             Focusable="False"
             Margin="-17">
    <!-- Tiles do not overlap, so each applies the same opacity independently.
         Group opacity plus a per-card BitmapCache creates a full-card intermediate
         surface (including its empty center) during scrolling. Keep the shared
         baked slices and avoid that extra surface. The face still owns layout/motion. -->
    <Grid x:Name="ShadowRoot"
          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopLeft}"/>
        <Image Grid.Row="0" Grid.Column="1" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopEdge}"/>
        <Image Grid.Row="0" Grid.Column="2" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopRight}"/>
        <Image Grid.Row="1" Grid.Column="0" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.LeftEdge}"/>
        <Image Grid.Row="1" Grid.Column="2" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.RightEdge}"/>
        <Image Grid.Row="2" Grid.Column="0" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomLeft}"/>
        <Image Grid.Row="2" Grid.Column="1" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomEdge}"/>
        <Image Grid.Row="2" Grid.Column="2" Stretch="Fill" Opacity="0.58" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomRight}"/>
    </Grid>
</UserControl>
