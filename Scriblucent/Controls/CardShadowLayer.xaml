<UserControl x:Class="Scriblucent.Controls.CardShadowLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             IsHitTestVisible="False"
             Focusable="False"
             Margin="-14,-12,-14,-16">
    <!--
        Nine-slice shadow: a shadow texture baked ONCE (see CardShadowAsset) and reused as eight
        stretched image slices per card, instead of a live DropShadowEffect - which forces an
        offscreen blur pass on every dirty repaint, and a crowded dashboard repaints many cards a
        frame. Slicing a pre-baked bitmap needs no blur pass, so this is cheap unconditionally.
        BitmapCache bakes the eight draws into one cached texture per card since this never changes.

        Margin defaults are bottom-biased (more room under the card) and negative to bleed past a
        full-scale card; overridden per-instance for templates that render at a sub-1.0 scale via a
        RenderTransform (see ungrouped Flashcard/Quiz/MindMap templates), since Margin composes with
        the card's own transform predictably instead of needing to match it.
    -->
    <Grid x:Name="ShadowRoot" Opacity="0.58">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopLeft}"/>
        <Image Grid.Row="0" Grid.Column="1" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopEdge}"/>
        <Image Grid.Row="0" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.TopRight}"/>
        <Image Grid.Row="1" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.LeftEdge}"/>
        <Image Grid.Row="1" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.RightEdge}"/>
        <Image Grid.Row="2" Grid.Column="0" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomLeft}"/>
        <Image Grid.Row="2" Grid.Column="1" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomEdge}"/>
        <Image Grid.Row="2" Grid.Column="2" Stretch="Fill" RenderOptions.BitmapScalingMode="Fant" Source="{x:Static anim:CardShadowAsset.BottomRight}"/>
    </Grid>
</UserControl>
