<UserControl x:Class="Scriblucent.Controls.ResizableImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             MinHeight="50" MinWidth="50"
             Cursor="SizeAll"
             Opacity="1"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ImageResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource Elevation.Thumb}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageLayoutButtonStyle" TargetType="Button">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="LayoutButtonBorder"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LayoutButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LayoutButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LayoutButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageAspectRatioToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="AspectButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AspectButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AspectButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AspectButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" ClipToBounds="False">
        <!-- Level 6: baked plate; selection ring (A) appears while resize handles are shown. -->
        <controls:CardShadowLayer/>
        <Border CornerRadius="10"
                BorderThickness="0"
                Background="{DynamicResource CardBackground}"
                Padding="2"
                SnapsToDevicePixels="True">
            <Border CornerRadius="8" ClipToBounds="True">
                <Image x:Name="InnerImage"
                       Stretch="Fill"
                       Opacity="1" />
            </Border>
        </Border>

        <!-- Resize Handles -->
        <Grid x:Name="ResizeHandlesGrid" Visibility="Collapsed">
            <Border BorderBrush="{DynamicResource NoteCardSelectionBorder}"
                    BorderThickness="2"
                    CornerRadius="11"
                    Background="Transparent"/>
            <Thumb x:Name="TopLeftThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Cursor="SizeNWSE" />
            <Thumb x:Name="TopThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" Cursor="SizeNS" />
            <Thumb x:Name="TopRightThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Cursor="SizeNESW" />
            <Thumb x:Name="RightThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0" Cursor="SizeWE" />
            <Thumb x:Name="BottomRightThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Cursor="SizeNWSE" />
            <Thumb x:Name="BottomThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6" Cursor="SizeNS" />
            <Thumb x:Name="BottomLeftThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6" Cursor="SizeNESW" />
            <Thumb x:Name="LeftThumb" Style="{StaticResource ImageResizeThumbStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0" Cursor="SizeWE" />

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Margin="0,-34,0,0">
                <ToggleButton x:Name="AspectRatioToggleButton"
                              Style="{StaticResource ImageAspectRatioToggleStyle}"
                              Content="{icons:Icon Kind=ZoomReset, Size=12}"
                              Checked="AspectRatioToggleButton_Checked"
                              Unchecked="AspectRatioToggleButton_Unchecked"/>

                <Button x:Name="LayoutButton"
                        Style="{StaticResource ImageLayoutButtonStyle}"
                        Content="Layout"
                        Margin="6,0,0,0"
                        Click="LayoutButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="InlineLayoutMenuItem"
                                      Header="In line with text"
                                      Click="InlineLayoutMenuItem_Click"/>
                            <MenuItem x:Name="FloatingLayoutMenuItem"
                                      Header="Floating"
                                      Click="FloatingLayoutMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
