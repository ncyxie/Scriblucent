<UserControl x:Class="Scriblucent.Controls.CombineWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
        <Style x:Key="SourceListStyle" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              behaviors:MiddleClickScrollBehavior.IsEnabled="True" behaviors:RoundedClipBehavior.IsEnabled="True"
                              behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScopeButtonStyle" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <controls:InteractionSurface Background="{TemplateBinding Background}" Role="Compact" BorderThickness="0"
                    CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"
                    HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}"
                    HighlightWash="{DynamicResource ControlHoverSurfaceWash}" HighlightEdge="{DynamicResource ControlHoverSurfaceEdge}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                </controls:InteractionSurface>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimarySubtleForeground}"/>
            </Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource WorkspaceHeadingStyle}"><StackPanel>
                <TextBlock Text="{Binding Workspace.Heading}" FontSize="{StaticResource Type.DialogTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="{Binding Workspace.Help}" Margin="0,6,0,0" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" TextWrapping="Wrap"/>
            </StackPanel></Border>
        </controls:FeatureWindowShell.Header>
        <controls:FeatureWindowShell.Body>
            <Grid x:Name="LayoutRoot" Margin="24,4,24,0" behaviors:CombineLayoutBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <Border Background="{DynamicResource ContentInsetSurface}" CornerRadius="12" Padding="3" DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllSourcesScope" GroupName="SourceScope" Content="{Binding [CombineAllView], Source={StaticResource Loc}}" IsChecked="{Binding Workspace.IsAllView, Mode=TwoWay}" Style="{StaticResource ScopeButtonStyle}"/>
                                <RadioButton x:Name="SelectedSourcesScope" GroupName="SourceScope" Content="{Binding Workspace.SelectedViewLabel}" IsChecked="{Binding Workspace.ShowSelectedOnly, Mode=TwoWay}" Style="{StaticResource ScopeButtonStyle}" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button DockPanel.Dock="Right" Content="{Binding [PremiumClearSelection], Source={StaticResource Loc}}" Command="{Binding Workspace.ClearSelectionCommand}" Style="{StaticResource FeatureToolbarSecondaryButtonStyle}" IsEnabled="{Binding Workspace.HasSelection}" Margin="8,3,0,3"/>
                        <Button Command="{Binding Workspace.SelectAllCommand}" ToolTip="{Binding [EditorSelectAllMatching], Source={StaticResource Loc}}" Style="{StaticResource EditorToolButtonBaseStyle}" Padding="4,0,8,0" DockPanel.Dock="Right" Margin="8,3,0,3">
                            <StackPanel Orientation="Horizontal"><CheckBox Style="{StaticResource CollectionSelectionCheckBoxStyle}" IsChecked="{Binding PickerAllChecked, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,0,8,0"/><TextBlock Text="{Binding Workspace.VisibleCountText}" FontSize="{StaticResource Type.Control.Toolbar}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding Workspace.IsAllView, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SourceSearchTextBox" Text="{Binding Workspace.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Workspace.SearchHint}" Background="{DynamicResource InputSurface}" MinHeight="36"/>
                            <TextBlock Text="{Binding Workspace.SearchHint}" Foreground="{DynamicResource TextColorSecondary}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="{Binding FontSize, ElementName=SourceSearchTextBox}" FontFamily="{Binding FontFamily, ElementName=SourceSearchTextBox}">
                                <TextBlock.Margin><MultiBinding Converter="{StaticResource FieldContentInset}"><Binding ElementName="SourceSearchTextBox" Path="Padding"/><Binding ElementName="SourceSearchTextBox" Path="BorderThickness"/></MultiBinding></TextBlock.Margin>
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ToggleButton x:Name="TagFilterButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource DisclosureHeaderToggleButtonStyle}" Background="{DynamicResource InputSurface}" ToolTip="{Binding Workspace.TagFilterText}">
                            <StackPanel Orientation="Horizontal"><icons:AppIcon Kind="Tag" Margin="0,0,6,0"/><TextBlock Text="{Binding [PremiumFilterTag], Source={StaticResource Loc}}" FontSize="{StaticResource Type.Control.Toolbar}"/><Ellipse Width="5" Height="5" Margin="6,0,0,0" Fill="{DynamicResource AccentPrimary}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.HasActiveTags}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><icons:AppIcon Kind="ChevronDown" Width="12" Margin="6,0,0,0"/></StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="2" Content="{icons:Icon Kind=Clear}" Command="{Binding Workspace.ClearFiltersCommand}" Height="36" Margin="6,0,0,0" ToolTip="{Binding [PremiumClearFilter], Source={StaticResource Loc}}" AutomationProperties.Name="{Binding [PremiumClearFilter], Source={StaticResource Loc}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.CanClearFilters}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Popup PlacementTarget="{Binding ElementName=TagFilterButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=TagFilterButton, Mode=TwoWay}">
                            <Grid><Grid Margin="12,12,12,13" Width="280">
                                <controls:BakedElevationLayer Kind="Button"/>
                                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource FloatingSurfaceEdge}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [PremiumFilterTag], Source={StaticResource Loc}}" FontSize="{StaticResource Type.Control.Form}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding [CombineNoTags], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.HasTags}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Workspace.Tags}" Style="{StaticResource SourceListStyle}" MaxHeight="200" Visibility="{Binding Workspace.HasTags, Converter={StaticResource VisibleWhen}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Tag}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource FeatureCombineOptionCheckBoxStyle}"
                                                              Margin="0,4" ToolTip="{Binding Tag}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding [PremiumClearFilter], Source={StaticResource Loc}}" Command="{Binding Workspace.ClearFiltersCommand}" Style="{StaticResource FeatureToolbarSecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Workspace.HasTags, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding Workspace.HasFilters}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                            </Grid></Grid>
                        </Popup>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding [CombineSelectedViewHelp], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" Margin="0,0,0,12" Visibility="{Binding Workspace.ShowSelectedOnly, Converter={StaticResource VisibleWhen}}"/>
                    <Grid Grid.Row="2">
                        <ItemsControl x:Name="SourceItems" AutomationProperties.Name="{Binding Workspace.SourcesHeading}" ItemsSource="{Binding Workspace.Sources}" Style="{StaticResource SourceListStyle}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <controls:DashboardTileHost RendererKey="{Binding DataContext.Workspace.RendererKey, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid Margin="0,0,0,8" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                        <controls:SurfaceMaterialBorder Style="{StaticResource FeatureCombineItemBorderStyle}" MouseLeftButtonUp="SourceRow_Click">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource CollectionSelectionCheckBoxStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0" Click="SelectionCheckBox_Click"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource Type.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ItemCountText}" Margin="0,4,0,0" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}"/>
                                                    <TextBlock Text="{Binding TagsDisplay}" Margin="0,4,0,0" Height="18" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TagsDisplay}">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding HasTags}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </controls:SurfaceMaterialBorder>
                                    </Grid>
                                </controls:DashboardTileHost>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding Workspace.IsSourceListEmpty, Converter={StaticResource VisibleWhen}}">
                            <controls:ContextualStatePanel IllustrationKind="Search" Title="{Binding Workspace.EmptyTitle}" Description="{Binding Workspace.EmptyDescription}"/>
                            <Button Content="{Binding [CombineBackToAll], Source={StaticResource Loc}}" Command="{Binding Workspace.ShowAllCommand}" HorizontalAlignment="Center" Style="{StaticResource FeatureToolbarSecondaryButtonStyle}" Visibility="{Binding Workspace.ShowSelectedOnly, Converter={StaticResource VisibleWhen}}"/>
                            <Button Content="{Binding [PremiumClearFilter], Source={StaticResource Loc}}" Command="{Binding Workspace.ClearFiltersCommand}" HorizontalAlignment="Center" Style="{StaticResource FeatureToolbarSecondaryButtonStyle}" Visibility="{Binding Workspace.CanClearFilters, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextColorSecondary}" Visibility="{Binding Workspace.IsLoading, Converter={StaticResource VisibleWhen}}"/>
                    </Grid>
                </Grid>
                <Border Grid.Column="2">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkspaceSectionStyle}"><Style.Triggers><DataTrigger Binding="{Binding (behaviors:CombineLayoutBehavior.IsCompact), ElementName=LayoutRoot}" Value="True"><Setter Property="Padding" Value="8"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Workspace.TitleLabel}" FontSize="{StaticResource Type.Control.Form}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="{StaticResource Field.LabelMargin}"/><Style.Triggers><DataTrigger Binding="{Binding (behaviors:CombineLayoutBehavior.IsCompact), ElementName=LayoutRoot}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="MaxWidth" Value="180"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="VerticalAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Workspace.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource FeatureCombineTextBoxStyle}"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,0,0,16"/><Style.Triggers><DataTrigger Binding="{Binding (behaviors:CombineLayoutBehavior.IsCompact), ElementName=LayoutRoot}" Value="True"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="12,0,0,4"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                            </TextBox>
                        </Grid>
                        <Grid MinHeight="156" Margin="0,0,0,12">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding (behaviors:CombineLayoutBehavior.IsCompact), ElementName=LayoutRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Workspace.HasSources}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <controls:ContextualStatePanel IllustrationKind="{Binding Workspace.SelectionIllustration}" Title="{Binding Workspace.SelectionTitle}" Description="{Binding Workspace.SelectionDescription}">
                                <controls:ContextualStatePanel.Style><Style TargetType="controls:ContextualStatePanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:ContextualStatePanel.Style>
                            </controls:ContextualStatePanel>
                            <Border x:Name="ResultSummary" Style="{StaticResource ContentInsetBorderStyle}" VerticalAlignment="Top" Visibility="{Binding Workspace.HasSelection, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <icons:AppIcon Kind="{Binding Workspace.ContentIcon}" Width="28" Height="28" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                    <TextBlock Text="{Binding Workspace.ResultCountText}" FontSize="{StaticResource Type.SectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Workspace.ResultSourcesText}" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Workspace.DuplicatesText}" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Workspace.HasRemovedDuplicates, Converter={StaticResource VisibleWhen}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Expander x:Name="ConfigurationOptions" IsExpanded="True" Background="Transparent" Padding="0">
                            <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding [CombineOptions], Source={StaticResource Loc}}"/><TextBlock Text="{Binding Workspace.ResultCountText}" Foreground="{DynamicResource TextColorSecondary}" FontWeight="Normal" Margin="12,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding (behaviors:CombineLayoutBehavior.IsCompact), ElementName=LayoutRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Expander.Header>
                            <StackPanel>
                                <CheckBox Content="{Binding Workspace.ShuffleLabel}" IsChecked="{Binding Workspace.Shuffle, Mode=TwoWay}" Style="{StaticResource FeatureCombineOptionCheckBoxStyle}"/>
                                <CheckBox Content="{Binding Workspace.SkipDuplicatesLabel}" IsChecked="{Binding Workspace.SkipDuplicates, Mode=TwoWay}" Style="{StaticResource FeatureCombineOptionCheckBoxStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </controls:FeatureWindowShell.Body>
        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource WorkspaceFooterStyle}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextColorSecondary}" TextWrapping="Wrap" Margin="0,0,16,0" FontSize="{StaticResource Type.Control.Helper}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}" Command="{Binding Workspace.CloseCommand}" Style="{StaticResource DialogSecondaryButtonStyle}" MinWidth="96" Margin="0,0,12,0"/>
                    <Button Content="{Binding Workspace.CreateLabel}" Command="{Binding Workspace.CreateCommand}" Style="{StaticResource DialogPrimaryButtonStyle}" MinWidth="150" IsEnabled="{Binding Workspace.HasSelection}"/>
                </StackPanel>
            </Grid></Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
</UserControl>
