<UserControl x:Class="Scriblucent.Controls.FlashcardFlipHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             ClipToBounds="True">
    <Grid x:Name="FlipHost"
          ClipToBounds="True"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="FlipScale"
                            ScaleX="1"
                            ScaleY="1"/>
        </Grid.RenderTransform>

        <ContentPresenter x:Name="FrontHost"
                          Content="{Binding FrontContent, ElementName=Root}"/>

        <Grid x:Name="BackFace"
              Visibility="Hidden"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleY="-1"/>
            </Grid.RenderTransform>
            <ContentPresenter x:Name="BackHost"
                              Content="{Binding BackContent, ElementName=Root}"/>
        </Grid>
    </Grid>
</UserControl>