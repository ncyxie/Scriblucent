<UserControl x:Class="Scriblucent.Controls.DashboardCreateMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,36"
             MaxWidth="280" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <Style x:Key="ActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,10,16,10"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Action}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
            <Style.Triggers>
                <!-- Rows own exit opacity; nested disabled opacity produces a content-sized patch. -->
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="ActionViewport" Grid.Row="0" Margin="-16,-16,-16,-4"
                      Style="{StaticResource RoundedContentScrollViewerStyle}" Padding="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" CanContentScroll="False" Visibility="{Binding Visibility, ElementName=ActionPanel}">
            <!-- Inset inside the scroll content: ScrollViewer.Padding clips the shadow at its inner edge. -->
            <StackPanel x:Name="ActionPanel" Margin="16" Visibility="Collapsed"
                        IsHitTestVisible="False" IsEnabled="False" behaviors:CommandLightBehavior.IsScope="True">
                <Grid x:Name="ImportRow" Margin="0,0,0,8" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform Y="8"/></Grid.RenderTransform>
                    <controls:BakedElevationLayer Kind="Button" Opacity="0.14" IsHitTestVisible="False"/>
                    <Button x:Name="ImportAction" Style="{StaticResource ActionStyle}" Click="ImportAction_Click" KeyboardNavigation.TabIndex="3"
                            AutomationProperties.Name="{Binding ImportLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <icons:AppIcon Kind="Import" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{Binding ImportLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}"/>
                        </Grid>
                    </Button>
                </Grid>
                <Grid x:Name="QuickAddRow" Margin="0,0,0,8" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform Y="8"/></Grid.RenderTransform>
                    <controls:BakedElevationLayer Kind="Button" Opacity="0.14" IsHitTestVisible="False"/>
                    <Button x:Name="QuickAddAction" Style="{StaticResource ActionStyle}" KeyboardNavigation.TabIndex="2"
                            Command="{Binding QuickAddCommand, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}"
                            ToolTip="{Binding [QuickAddExplanation], Source={StaticResource Loc}}"
                            AutomationProperties.Name="{Binding QuickAddLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <icons:AppIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{Binding QuickAddLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}"/>
                        </Grid>
                    </Button>
                </Grid>
                <Grid x:Name="CreateRow" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform Y="8"/></Grid.RenderTransform>
                    <controls:BakedElevationLayer Kind="Button" Opacity="0.14" IsHitTestVisible="False"/>
                    <Button x:Name="CreateAction" Style="{StaticResource ActionStyle}" Click="CreateAction_Click" KeyboardNavigation.TabIndex="1"
                            AutomationProperties.Name="{Binding CreateLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <icons:AppIcon Kind="{Binding CreateIcon, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{Binding CreateLabel, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="ToggleAction" Grid.Row="1" Margin="0" HorizontalAlignment="Right" Click="ToggleAction_Click" KeyboardNavigation.TabIndex="0"
                FocusVisualStyle="{StaticResource CardButtonKeyboardFocusStyle}"
                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FabStyle}">
                    <Setter Property="ToolTip" Value="{Binding [CreationActions], Source={StaticResource Loc}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=controls:DashboardCreateMenu}}" Value="True">
                            <Setter Property="ToolTip" Value="{Binding [CloseCreationActions], Source={StaticResource Loc}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <icons:AppIcon x:Name="PlusIcon" Kind="Plus" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                <icons:AppIcon.RenderTransform><RotateTransform x:Name="IconRotation"/></icons:AppIcon.RenderTransform>
            </icons:AppIcon>
        </Button>
    </Grid>
</UserControl>
