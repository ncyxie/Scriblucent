
<UserControl x:Class="Scriblucent.Controls.NoteCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
             behaviors:CardSurfaceMotionBehavior.Profile="NoteCard"
             behaviors:CardSurfaceMotionBehavior.ShadowElementName="CardBorder"
             Width="220" MinHeight="140" Margin="12"
             RenderTransformOrigin="0.5,0.5"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             Opacity="1"
             AllowDrop="True"
             ContextMenu="{StaticResource NoteCardContextMenu}"
             DataContextChanged="OnDataContextChanged"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp"
             MouseMove="OnMouseMove"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Drop="OnDrop"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <UserControl.Resources>
        <Style x:Key="NoteDashboardListingMenuButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="MenuButtonBorder"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NoteCardTitle}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.BlockTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="MenuButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </controls:InteractionSurface>
                        <ControlTemplate.Triggers>


                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMenuVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <Border Background="Transparent">
    <controls:CollectionSelectionFrame ItemId="{Binding Document.Id}" SelectionLabel="{Binding Title}" FaceName="CardBorder" SelectionInset="0,13,13,0">
    <Grid x:Name="HoverMotionSurface">
        <Image x:Name="BitmapLayer"
               Stretch="Fill"
               Visibility="Collapsed"
               IsHitTestVisible="False"
               SnapsToDevicePixels="True"/>
        <controls:CardShadowLayer x:Name="CardShadow"/>
        <controls:SurfaceMaterialBorder x:Name="CardBorder"
            behaviors:RoundedClipBehavior.IsEnabled="True"
            CornerRadius="{StaticResource Radius.Card}"
            Padding="14">
        <!-- The shared selection frame paints its contour outside live and cached card content. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
                <Setter Property="Background" Value="{DynamicResource NoteCardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </Border.Style>
        <Grid x:Name="CardContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="DragDimOverlay"
                    Background="#000000"
                    Opacity="0.82"
                    CornerRadius="{StaticResource Radius.Card}"
                    Grid.RowSpan="3"
                    Margin="-14"
                    Panel.ZIndex="45"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
            <controls:DropTargetSurface x:Name="DropGlow" Surface="{Binding ElementName=CardBorder}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource AccentRimBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Radius.Card}"
                    Opacity="0"
                    Grid.RowSpan="3"
                    Panel.ZIndex="50"
                    IsHitTestVisible="False"/>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <icons:AppIcon Grid.Column="0" Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="14" Height="14" Foreground="{DynamicResource NoteCardTitle}" Margin="0,0,6,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                    <icons:AppIcon Grid.Column="1" Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="14" Height="14" Foreground="{DynamicResource NoteCardTitle}" Margin="0,0,6,0" ToolTip="{Binding Document.ScheduledAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Title}"
                               FontSize="{StaticResource Type.CardTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NoteCardTitle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="MenuButton"
                        Grid.Column="1"
                        Content="{icons:Icon Kind=MoreVertical, Size=14}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource NoteDashboardListingMenuButtonStyle}"
                        ContextMenu="{StaticResource NoteCardContextMenu}"
                        Click="OnMenuButtonClick">
                </Button>


            </Grid>
            <TextBlock x:Name="ContentPreview"
                       Grid.Row="1"
                       FontSize="{StaticResource Type.Body}" TextWrapping="Wrap"
                       MaxHeight="100"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextColor}"/>
            <controls:SurfaceMaterialBorder Grid.Row="2"
                    Style="{StaticResource DashboardTagChipStyle}">
                <TextBlock Text="{Binding TagsDisplay}"
                           Style="{StaticResource DashboardTagTextStyle}"/>
            </controls:SurfaceMaterialBorder>
        </Grid>
        </controls:SurfaceMaterialBorder>
    </Grid>
    </controls:CollectionSelectionFrame>
    </Border>
</UserControl>
