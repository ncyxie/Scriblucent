<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0-beta.2</Version>
    <Authors>ncyxie</Authors>
    <Company>ncyxie</Company>
    <Product>Scriblucent</Product>
    <Copyright>Copyright (c) 2026 ncyxie</Copyright>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="Assets\brand-logo-light.svg" />
    <Resource Include="Assets\brand-logo-dark.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Panels\VirtualizingWrapPanel\LICENSE" Link="LICENSE-VirtualizingWrapPanel" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\EditHistoryWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.151.1" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <!-- Build the AI worker and copy its output to the main app's output directory. -->
  <ItemGroup>
    <ProjectReference Include="..\Scriblucent.AI.Worker\Scriblucent.AI.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Scriblucent.AI.Protocol\Scriblucent.AI.Protocol.csproj" />
  </ItemGroup>

  <!--
    ReferenceOutputAssembly="false" above keeps the worker's managed assembly (and transitively
    LLamaSharp/native llama.cpp) out of this project's own compile-time references, but it also
    suppresses MSBuild's normal copy-referenced-project's-output-to-my-output-directory behavior.
    Without an explicit copy, only a handful of apphost-related files for the worker end up next
    to Scriblucent.exe - not its managed DLL or any of its dependencies - so the worker process
    fails to launch at all. Copy its full output directory ourselves instead.
  -->
  <PropertyGroup>
    <AiWorkerBaseOutputPath>..\Scriblucent.AI.Worker\bin\$(Configuration)\$(TargetFramework)\</AiWorkerBaseOutputPath>
    <AiWorkerOutputPath Condition="'$(RuntimeIdentifier)' == ''">$(AiWorkerBaseOutputPath)</AiWorkerOutputPath>
    <AiWorkerOutputPath Condition="'$(RuntimeIdentifier)' != ''">$(AiWorkerBaseOutputPath)$(RuntimeIdentifier)\</AiWorkerOutputPath>
    <AiWorkerOutputExcludes>$(AiWorkerOutputPath)publish\**\*</AiWorkerOutputExcludes>
    <AiWorkerOutputExcludes Condition="'$(RuntimeIdentifier)' == 'win-arm64'">$(AiWorkerOutputExcludes);$(AiWorkerOutputPath)runtimes\win-x64\**\*</AiWorkerOutputExcludes>
  </PropertyGroup>

  <Target Name="CopyAiWorkerBuildOutput" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <!-- Use **\* not **\*.* to include extensionless native assets -->
      <AiWorkerBuildOutputFiles Include="$(AiWorkerOutputPath)**\*"
                                Exclude="$(AiWorkerOutputExcludes)" />
    </ItemGroup>
    <Copy SourceFiles="@(AiWorkerBuildOutputFiles)"
          DestinationFolder="$(TargetDir)AIWorker\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="false" />
  </Target>

  <Target Name="CopyAiWorkerPublishOutput" AfterTargets="Publish" DependsOnTargets="CopyAiWorkerBuildOutput">
    <ItemGroup>
      <AiWorkerPublishOutputFiles Include="$(AiWorkerOutputPath)**\*"
                                  Exclude="$(AiWorkerOutputExcludes)" />
    </ItemGroup>
    <Copy SourceFiles="@(AiWorkerPublishOutputFiles)"
          DestinationFolder="$(PublishDir)AIWorker\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateAiWorkerPublish" AfterTargets="CopyAiWorkerPublishOutput">
    <Error Condition="!Exists('$(PublishDir)AIWorker\Scriblucent.AI.Worker.exe')"
           Text="Published AI worker executable is missing." />
    <Error Condition="!Exists('$(PublishDir)AIWorker\Scriblucent.AI.Worker.dll')"
           Text="Published AI worker managed assembly is missing." />
    <Error Condition="!Exists('$(PublishDir)AIWorker\Scriblucent.AI.Worker.deps.json')"
           Text="Published AI worker dependency manifest is missing." />
    <Error Condition="!Exists('$(PublishDir)AIWorker\Scriblucent.AI.Worker.runtimeconfig.json')"
           Text="Published AI worker runtime configuration is missing." />
    <Error Condition="'$(RuntimeIdentifier)' == 'win-x64' and !Exists('$(PublishDir)AIWorker\runtimes\win-x64\native\vulkan\llama.dll')"
           Text="Published x64 AI worker Vulkan backend is missing." />
    <Error Condition="'$(RuntimeIdentifier)' == 'win-arm64' and !Exists('$(PublishDir)AIWorker\runtimes\win-arm64\native\llama.dll')"
           Text="Published ARM64 AI worker CPU backend is missing." />
    <Error Condition="'$(RuntimeIdentifier)' == 'win-arm64' and Exists('$(PublishDir)AIWorker\runtimes\win-x64')"
           Text="Published ARM64 AI worker incorrectly contains x64 native files." />
    <Error Condition="'$(RuntimeIdentifier)' == 'win-arm64' and Exists('$(PublishDir)AIWorker\runtimes\win-arm64\native\vulkan')"
           Text="Published ARM64 AI worker incorrectly contains a Vulkan backend." />
  </Target>

  <Target Name="PruneReleasePublishAssets"
          AfterTargets="CopyAiWorkerPublishOutput"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleaseSymbols Include="$(PublishDir)**\*.pdb" />
      <RootWorkerDuplicates Include="$(PublishDir)Scriblucent.AI.Worker.*" />
      <RootLlamaDuplicates Include="$(PublishDir)LLamaSharp*;$(PublishDir)runtimes\**\*" />
    </ItemGroup>
    <Delete Files="@(ReleaseSymbols);@(RootWorkerDuplicates);@(RootLlamaDuplicates)" />
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)runtimes')" />
  </Target>

  <!-- Clean stale worker files that were removed from worker output but remain in OutDir/PublishDir due to SkipUnchangedFiles -->
  <Target Name="CleanAiWorkerOutput" BeforeTargets="Clean">
    <ItemGroup>
      <AiWorkerStaleFiles Include="$(OutDir)Scriblucent.AI.Worker.*" />
      <AiWorkerStalePublishFiles Include="$(PublishDir)Scriblucent.AI.Worker.*" Condition="Exists('$(PublishDir)')" />
    </ItemGroup>
    <Delete Files="@(AiWorkerStaleFiles)" Condition="Exists('%(Identity)')" />
    <Delete Files="@(AiWorkerStalePublishFiles)" Condition="Exists('%(Identity)')" />
    <RemoveDir Directories="$(OutDir)AIWorker" Condition="Exists('$(OutDir)AIWorker')" />
    <RemoveDir Directories="$(PublishDir)AIWorker" Condition="Exists('$(PublishDir)AIWorker')" />
  </Target>

</Project>
