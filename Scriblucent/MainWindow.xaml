                                                                                              HorizontalAlignment="Right"
                                                                                              VerticalAlignment="Top"
                                                                                              Margin="0,0,2,0"
                                                                                              Panel.ZIndex="6"
                                                                                              Style="{StaticResource DashboardMassSelectCheckBoxStyle}"

                                                                                              />
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Border Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="12"
                                                                                                Background="{DynamicResource IconButtonBackground}"
                                                                                                BorderBrush="{DynamicResource IconButtonBorder}"
                                                                                                BorderThickness="1"
                                                                                                ToolTip="{Binding AiGeneratedTooltip}"
                                                                                                Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                                            <TextBlock Text="🤖"
                                                                                                       FontSize="13"
                                                                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <TextBlock Style="{StaticResource DashboardPinIconStyle}"
                                                                                                       Text="📌"
                                                                                                       FontSize="13"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       Margin="0,0,5,0"
                                                                                                       ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                                            <TextBlock Style="{StaticResource DashboardScheduleIconStyle}"
                                                                                                       Text="🕒"
                                                                                                       FontSize="12"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       Margin="0,0,5,0"
                                                                                                       ToolTip="{Binding NextScheduleDisplay}"/>
                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                       FontSize="14"
                                                                                                       FontWeight="SemiBold"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Button x:Name="ListingContextMenuButton"
                                                                                                Grid.Column="2"
                                                                                                Tag="{Binding}"
                                                                                                Content="&#x22EE;"
                                                                                                Style="{StaticResource DashboardListingMenuButtonStyle}"
                                                                                                ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                                                Click="ListingContextMenuButton_Click"/>
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="{Binding CardCountText}"
                                                                                               FontSize="12"
                                                                                               Foreground="{DynamicResource TextColorSecondary}"
                                                                                               Margin="0,6,0,0"/>
                                                                                    <Border Grid.Row="2"
                                                                                            Style="{StaticResource DashboardTagChipStyle}">
                                                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                                                   Style="{StaticResource DashboardTagTextStyle}"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                            </controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                            </controls:DashboardVirtualizedCardGrid>
                                                            </controls:DashboardVirtualizationHost>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                <Border x:Name="FlashcardDashboardUngroupedSectionContainer"
                                                Margin="0,0,0,10"
