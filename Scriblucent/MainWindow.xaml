<Window x:Class="Scriblucent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:vm="clr-namespace:Scriblucent.ViewModels"
        xmlns:Views="clr-namespace:Scriblucent.Views"
        xmlns:dashboards="clr-namespace:Scriblucent.Views.Dashboards"
        xmlns:converters="clr-namespace:Scriblucent.Converters"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:services="clr-namespace:Scriblucent.Services"
        xmlns:anim="clr-namespace:Scriblucent.Animations"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
		Title="Scriblucent" Height="755" Width="1145"
        Icon="/logo.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SidebarBackground}"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Ideal"
		TextOptions.TextRenderingMode="ClearType"
        Closing="MainWindow_Closing">

    <Window.Resources>
		<!-- Calendar schedule tiles use CalendarScheduledItemCardStyle (Level 4 D: E.Card + NoteCardBorder). -->

		<Style x:Key="MassActionIconButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="MassActionBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Margin" Value="0,0,3,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MassActionBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

        <Style x:Key="MassActionDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MassActionIconButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

		<Style x:Key="TopBarIconButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="TopBarIconBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="{StaticResource Type.BlockTitle}"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="TopBarIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SearchClearButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="IsTabStop" Value="False"/>
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="ToolTip" Value="{Binding [ClearSearch], Source={StaticResource Loc}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ClearBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ClearBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FloatingSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="False"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="FloatingSecondary"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="FloatingSecondaryBorder"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.ShadowElementName" Value="FloatingSecondaryShadow"/>
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="FontSize" Value="{StaticResource Type.SectionTitle}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid x:Name="FloatingSecondaryBorder">
							<controls:BakedElevationLayer x:Name="FloatingSecondaryShadow" Kind="Button" Opacity="0.20"/>
							<Border x:Name="FloatingSecondaryFace"
									Background="{TemplateBinding Background}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Control}">
								<ContentPresenter HorizontalAlignment="Center"
												  VerticalAlignment="Center"/>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatingSecondaryFace" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FloatingSecondaryFace" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarActionButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="SidebarButtonBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
			<Setter Property="Padding" Value="0,8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="ActiveIndicator"
									Background="{DynamicResource SelectionBackground}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Card}"
									Opacity="0"/>
							<Border x:Name="SidebarButtonBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Card}"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="Center"/>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
					<Setter Property="Visibility" Value="Collapsed"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarNotesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsNotesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarFlashcardsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarQuizzesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsQuizzesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarMindMapsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMindMapsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		
		
        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter" />
		<Style x:Key="PopupMenuButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="PopupItemBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="PopupItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="{StaticResource Radius.Control}"
								Padding="{TemplateBinding Padding}"
								Margin="2">
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
		</Style>

		<Style x:Key="GroupCardStyle" TargetType="Border">
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="18"/>
				</Setter.Value>
			</Setter>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.Profile" Value="GroupSlide"/>
		</Style>

		<!-- Level 4 content card (D): CardShadowLayer at use site + NoteCardBorder R(theme); mass-select A. -->
		<Style x:Key="DashboardGroupedListingCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<!-- No Effect: nine-slice CardShadowLayer sibling (not live DropShadowEffect). -->
			<Setter Property="behaviors:MassSelectHighlightBehavior.IsEnabled" Value="True"/>
		</Style>

		<!-- Same D rest tokens as grouped listing (ungrouped / larger tiles). -->
        <Style x:Key="DashboardListingCardSelectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="behaviors:MassSelectHighlightBehavior.IsEnabled" Value="True"/>
        </Style>

		<Style x:Key="GroupHeaderMoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DashboardSectionMoveButtonStyle}">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
		</Style>

		<Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="GroupIconBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="GroupIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardListingMenuButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="MenuButtonBorder"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="{StaticResource Type.BlockTitle}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Visibility" Value="Hidden"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MenuButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" Value="True">
					<Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardCalendarControlStyle" TargetType="Calendar" BasedOn="{StaticResource EmbeddedCalendarControlStyle}">
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Height" Value="208"/>
		</Style>
	</Window.Resources>
	<Grid Background="{DynamicResource SidebarBackground}">

		<Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="64"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Level 3 sidebar: soft fill selection; separators are L (SidebarSeparator). -->
     <Border x:Name="SidebarChrome"
				Grid.Column="0"
				Background="Transparent"
				BorderThickness="0"
             ClipToBounds="True"
             IsEnabled="{Binding IsNotMassSelectMode}"
				Padding="8,14,8,14">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Button Command="{Binding ToggleSidebarCommand}"
						Style="{StaticResource SidebarActionButtonStyle}"
						Margin="0,0,0,10"
						ToolTip="{Binding [Menu], Source={StaticResource Loc}}">
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="48"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<icons:AppIcon Grid.Column="0" Kind="Menu" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
						<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
								   Text="{Binding [Menu], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"/>
					</Grid>
				</Button>

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<Separator Margin="8,12,8,12"
								   Background="{DynamicResource SidebarSeparator}"
								   Opacity="1"/>
						<Button Style="{StaticResource SidebarNotesDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsNotesView}"
								Command="{Binding ShowNotesCommand}"
								Margin="0,5"
								ToolTip="{Binding [NotesDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Notes" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [NotesDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarFlashcardsDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsFlashcardsView}"
								Command="{Binding ShowFlashcardsCommand}"
								Margin="0,5"
								ToolTip="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Flashcards" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarMindMapsDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsMindMapsView}"
								Command="{Binding ShowMindMapsCommand}"
								Margin="0,5"
								ToolTip="{Binding [MindMapsDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="MindMaps" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [MindMapsDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarQuizzesDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsQuizzesView}"
								Command="{Binding ShowQuizzesCommand}"
								Margin="0,5"
								ToolTip="{Binding [QuizzesDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Quizzes" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [QuizzesDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
                        <Separator Margin="8,12,8,12"
								   Background="{DynamicResource SidebarSeparator}"
								   Opacity="1"/>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarTrashButton_Click"
								ToolTip="{Binding [Trash], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0" Width="48" HorizontalAlignment="Center">
									<icons:AppIcon Kind="Trash" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
									<Border HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,2,6,0"
											MinWidth="16"
											Height="16"
											Padding="4,0"
											CornerRadius="8"
											Background="{DynamicResource AccentPrimary}"
											Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVis}}">
										<TextBlock Text="{Binding TrashItemCount}"
												   FontSize="10"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource AccentPrimaryForeground}"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>
								</Grid>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [Trash], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarSettingsButton_Click"
								ToolTip="{Binding [Settings], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Settings" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [Settings], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="AboutButton_Click"
								ToolTip="{Binding [About], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="About" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [About], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>


		<!-- Fluent-style inset content stage: rounded where it meets the sidebar -->
		<Grid Grid.Column="1" Margin="0,10,10,10">
			<controls:StageShadowLayer/>
			<Border x:Name="ContentStage"
					CornerRadius="{StaticResource Radius.Overlay}"
					Background="{DynamicResource WindowBackground}"
					behaviors:RoundedClipBehavior.IsEnabled="True"
					ClipToBounds="True"
					SnapsToDevicePixels="True">
		<Grid x:Name="MainContentRoot"
			  Background="Transparent">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar: brand lockup + actions -->
			<Border Grid.Row="0"
					Background="Transparent"
					BorderThickness="0"
					Padding="{StaticResource Shell.TopBarPadding}">
				<Grid MinHeight="40" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Brand: official outlined logo (mark + wordmark) -->
					<svgc:SvgViewbox Grid.Column="0"
									 Source="{DynamicResource BrandLogoSvg}"
									 Height="36"
									 Stretch="Uniform"
									 VerticalAlignment="Center"
									 SnapsToDevicePixels="True"
									 UseLayoutRounding="True"/>

					<Grid Grid.Column="2"
						  VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- Level 3 form field: E.Field; focus ring via adorner (matches Chrome fields). -->
						<Grid x:Name="TopSearchPanel"
								Grid.Column="0"
								Width="0"
								Height="32"
								Margin="0,0,8,0"
								Visibility="Collapsed"
								VerticalAlignment="Center"
								Opacity="0"
								SnapsToDevicePixels="True"
								UseLayoutRounding="True"
								RenderTransformOrigin="1,0.5">
							<controls:BakedElevationLayer Kind="Field"/>
							<Border Padding="6,0"
									CornerRadius="{StaticResource Radius.Control}"
									SnapsToDevicePixels="True"
									Background="{DynamicResource InputSurface}"
									BorderBrush="{DynamicResource InputRestBorder}"
									BorderThickness="{DynamicResource Field.RestBorderThickness}"
									behaviors:RoundedClipBehavior.IsEnabled="True"
									behaviors:FieldFocusRingBehavior.IsEnabled="True">
							<DockPanel LastChildFill="True">
                              <icons:AppIcon Kind="Search" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" Margin="2,0,8,0" VerticalAlignment="Center"/>
								<Button x:Name="ClearSearchButton"
										DockPanel.Dock="Right"
										Style="{StaticResource SearchClearButtonStyle}"
										Width="0"
										Margin="0"
										Opacity="0"
										Visibility="Collapsed"
										IsHitTestVisible="False"
										Content="{icons:Icon Kind=Close, Size=12}"
										Click="ClearSearchButton_Click"/>
								<TextBox x:Name="TopSearchTextBox"
										 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
										 VerticalContentAlignment="Center"
 										 Text="{Binding ActiveSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 										 ToolTip="{Binding [SearchNotesHint], Source={StaticResource Loc}}"
										 KeyDown="TopSearchTextBox_KeyDown"/>
							</DockPanel>
						</Border>
						</Grid>

						<Button x:Name="TopSearchButton"
								Grid.Column="1"
                                Style="{StaticResource TopBarIconButtonStyle}"
                              Content="{icons:Icon Search}"
								Margin="0,0,8,0"
								ToolTip="{Binding [Search], Source={StaticResource Loc}}"
								Click="TopSearchButton_Click"/>

						<Button x:Name="SortNotesButton"
								Grid.Column="2"
                             Style="{StaticResource TopBarIconButtonStyle}"
								Content="{icons:Icon Sort}"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveSortButtonText}"
								Click="SortNotesButton_Click"/>

						<Button x:Name="TagsFilterButton"
							 Grid.Column="3"
                              Style="{StaticResource TopBarIconButtonStyle}"
							  Content="{icons:Icon Tag}"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveTagFilterButtonText}"
								Click="TagsFilterButton_Click"/>

						<Button x:Name="DashboardSectionsButton"
								Grid.Column="4"
								Style="{StaticResource TopBarIconButtonStyle}"
								Content="{icons:Icon Sections}"
								Margin="0,0,8,0"
                                ToolTip="{Binding [DashboardSections], Source={StaticResource Loc}}"
								Click="DashboardSectionsButton_Click"/>

					</Grid>
				</Grid>
			</Border>

			<Popup x:Name="SortNotesPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=SortNotesButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="Transparent"
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="260"
						  MaxWidth="320"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<TextBlock Text="{Binding ActiveSortButtonText}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   Margin="0,0,0,8"/>
							<ItemsControl ItemsSource="{Binding ActiveSortOptions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<RadioButton Style="{StaticResource SortOptionRadioButtonStyle}"
													 GroupName="NoteSortOptionGroup"
													 Content="{Binding DisplayName}"
													 IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Margin="2,4"
													 Foreground="{DynamicResource TextColor}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
						</Border>
					</Border>
					</Grid>
				</Border>
			</Popup>

			<Popup x:Name="DashboardSectionsPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=DashboardSectionsButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="Transparent"
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="220"
						  MaxWidth="300"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<TextBlock Text="{Binding [DashboardSections], Source={StaticResource Loc}}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   Margin="0,0,0,8"/>
							<Grid>
							<StackPanel Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
								<CheckBox Content="{Binding [RecentNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                             <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [NotesDashboard], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsNotesDashboardSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentFlashcards], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [FlashcardGroupsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsQuizzesView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentQuizzes], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [QuizzesDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMindMapsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentMindMaps], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
							</Grid>
						</StackPanel>
						</Border>
					</Border>
					</Grid>
				</Border>
			</Popup>

			<Popup x:Name="TagsFilterPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=TagsFilterButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="Transparent"
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="260"
						  MaxWidth="320"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="{Binding [FilterTags], Source={StaticResource Loc}}"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextColor}"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Style="{StaticResource PopupMenuButtonStyle}"
										Padding="8,4"
										Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
										Command="{Binding ClearTagFiltersCommand}"/>
							</Grid>
							<ScrollViewer MaxHeight="230"
										  VerticalScrollBarVisibility="Auto"
										  Visibility="{Binding ActiveHasTagFilters, Converter={StaticResource BoolToVis}}">
								<ItemsControl ItemsSource="{Binding ActiveTagFilters}"
										  VirtualizingPanel.IsVirtualizing="True"
										  VirtualizingPanel.VirtualizationMode="Recycling"
										  VirtualizingPanel.ScrollUnit="Pixel"
										  ScrollViewer.CanContentScroll="True">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel IsItemsHost="True"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
											<CheckBox Content="{Binding Tag}"
													  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="0,2"
													  Foreground="{DynamicResource TextColor}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
							<TextBlock Text="{Binding [NoTagsFound], Source={StaticResource Loc}}"
									   Margin="0,4,0,0"
									   FontStyle="Italic"
									   Foreground="{DynamicResource TextColorSecondary}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding ActiveHasTagFilters}" Value="False">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>
						</Border>
					</Border>
					</Grid>
				</Border>
			</Popup>

			<!-- Dashboard + FAB overlay -->
            <Grid Grid.Row="1">
                <dashboards:NotesDashboardPage x:Name="NotesDashboardView" Visibility="Collapsed"/>
                <dashboards:FlashcardsDashboardPage x:Name="FlashcardsDashboardView" Visibility="Collapsed"/>
                <dashboards:QuizzesDashboardPage x:Name="QuizzesDashboardView" Visibility="Collapsed"/>
                <dashboards:MindMapsDashboardPage x:Name="MindMapsDashboardView" Visibility="Collapsed"/>
                <Grid x:Name="DashboardLoadingLayer" Visibility="Visible" ClipToBounds="True">
                    <Border Background="{DynamicResource WindowBackground}"/>
                    <controls:DashboardLoadingOverlay x:Name="DashboardLoadingShell"
                                                      Background="Transparent"
                                                      SurfaceBrush="{DynamicResource CardBackground}"
                                                      DetailBrush="{DynamicResource BorderColor}"
                                                      ClipToBounds="True"
                                                      Opacity="0"/>
                    <Border x:Name="DashboardLoadFailurePanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440"
                            Margin="24"
                            Padding="24"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [DashboardLoadFailedTitle], Source={StaticResource Loc}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding [DashboardLoadFailedMessage], Source={StaticResource Loc}}"
                                       Margin="0,12,0,20"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Button Content="{Binding [DashboardLoadRetry], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    MinWidth="120"
                                    Click="RetryDashboardLoad_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="MassSelectOverlayToolbar"
                    Grid.Row="1"
                    Panel.ZIndex="80"
                    Visibility="Collapsed"
                    Opacity="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,14,0"
                    MaxWidth="620"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Grid.RenderTransform>
                    <TranslateTransform Y="-12"/>
                </Grid.RenderTransform>
                <!-- Shadow plate is a sibling so toolbar text is not rasterized by DropShadowEffect.
                     The outer margin is the blur's room; it does not change where the bar sits. -->
                <Border Margin="-32"
                        Padding="32"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        ClipToBounds="False">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{StaticResource Elevation.Popup}"/>
                </Border>
                <Border x:Name="MassSelectCard"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        Padding="6"
                        VerticalAlignment="Top"
                        CornerRadius="{StaticResource Radius.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackground}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Card}"
                            Padding="8,5"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="{DynamicResource NoteCardSelectionBorder}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding [MassSelectModeTitle], Source={StaticResource Loc}}"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource Type.Meta}"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Text="{Binding MassSelectSelectionText}"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           FontSize="{StaticResource Type.Chip}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="4,4,1,4"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon SelectAll}"
                                        ToolTip="{Binding [MassSelectSelectAll], Source={StaticResource Loc}}"
                                        Command="{Binding SelectAllVisibleNotesCommand}"/>
                                <Button Style="{StaticResource MassActionDangerIconButtonStyle}"
                                        Content="{icons:Icon Delete}"
                                        FontSize="{StaticResource Type.Meta}"
                                        ToolTip="{Binding [MassSelectDeleteSelected], Source={StaticResource Loc}}"
                                        Click="DeleteSelectedMassButton_Click"/>
                                <Button x:Name="MassSelectMoreActionsToggleButton"
                                        Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon More}"
                                        ToolTip="{Binding [MassSelectMoreActions], Source={StaticResource Loc}}"
                                        Click="ToggleMassSelectMoreActionsButton_Click"/>
                            </StackPanel>
                        </Border>
                        <!-- Shown only while more-actions is expanded (toggled in code-behind). -->
                        <Border x:Name="MassSelectMoreActionsSeparator"
                                Width="1"
                                Height="30"
                                Margin="0,3,7,3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SidebarSeparator}"
                                Visibility="Collapsed"/>

                        <Border x:Name="MassSelectMoreActionsPanel"
                                Margin="0"
                                Padding="5,4,2,4"
                                Background="{DynamicResource CardBackground}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Card}"
                                Visibility="Collapsed"
                                Opacity="0"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                            </Border.RenderTransform>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon Group}"
                                        ToolTip="{Binding [MassSelectGroupSelected], Source={StaticResource Loc}}"
                                        Command="{Binding GroupSelectedNotesCommand}"/>
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon Ungroup}"
                                        ToolTip="{Binding [MassSelectUngroupSelected], Source={StaticResource Loc}}"
                                        Command="{Binding RemoveSelectedFromGroupsCommand}"/>
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon Pin}"
                                        ToolTip="{Binding [MassSelectPinSelected], Source={StaticResource Loc}}"
                                        Command="{Binding PinSelectedNotesCommand}"/>
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon Unpin}"
                                        ToolTip="{Binding [MassSelectUnpinSelected], Source={StaticResource Loc}}"
                                        Command="{Binding UnpinSelectedNotesCommand}"/>
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Content="{icons:Icon Duplicate}"
                                        ToolTip="{Binding [MassSelectDuplicateSelected], Source={StaticResource Loc}}"
                                        Command="{Binding DuplicateSelectedNotesCommand}"/>
                                <Button Style="{StaticResource MassActionIconButtonStyle}"
                                        Margin="0"
                                        Content="{icons:Icon Tag}"
                                        ToolTip="{Binding [MassSelectAddTags], Source={StaticResource Loc}}"
                                        Click="AddTagsToSelectedButton_Click"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="8,0,0,0"
                            BorderBrush="{DynamicResource SidebarSeparator}"
                            BorderThickness="1,0,0,0"
                            VerticalAlignment="Center">
                        <Button Style="{StaticResource MassActionIconButtonStyle}"
                                Margin="0"
                                Content="{icons:Icon Close}"
                                ToolTip="{Binding [Close], Source={StaticResource Loc}}"
                                Click="ExitMassSelectButton_Click"/>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>
			</Border>
		</Grid>

		<Views:SettingsPanel x:Name="SettingsPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="200"/>

		<Views:AboutPanel x:Name="AboutPanelControl"
					  x:FieldModifier="public"
					  Grid.ColumnSpan="2"
					  Visibility="Collapsed"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  Panel.ZIndex="201"/>

		<Views:NoteSchedulePanel x:Name="NoteSchedulePanelControl"
							 x:FieldModifier="public"
							 Grid.ColumnSpan="2"
							 Visibility="Collapsed"
							 HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Panel.ZIndex="202"/>

		<Views:TrashPanel x:Name="TrashPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="203"/>
    </Grid>
</Window>
