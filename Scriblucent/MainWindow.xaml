                                                                                        Margin="0,0,10,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip="{Binding [CalendarEditSchedule], Source={StaticResource Loc}}"
                                                                                        Click="CalendarScheduleGearButton_Click"/>
                                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextColor}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="0,0,0,6"/>
