								Margin="0,5"
								ToolTip="{Binding [QuizzesDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="16"
                                            Height="16"
                                            Background="Transparent"
                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            BorderThickness="0.8"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="✓"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    TextAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [QuizzesDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
                        <Separator Margin="6,10,6,10"/>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarSettingsButton_Click"
								ToolTip="{Binding [Settings], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="⚙" FontSize="14" Width="20" TextAlignment="Center"
										   VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [Settings], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="AboutButton_Click"
								ToolTip="{Binding [About], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="ℹ" FontSize="14" Width="20" TextAlignment="Center"
										   VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [About], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>


		<Grid x:Name="MainContentRoot"
			  Grid.Column="1"
			  Background="{DynamicResource WindowBackground}">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar -->
			<Border Grid.Row="0"
					Background="{DynamicResource SidebarBackground}"
					BorderBrush="{DynamicResource BorderColor}"
					BorderThickness="0,0,0,1"
					Padding="16,10">
				<Grid>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                     <Image Source="/Scriblucent;component/logo.ico"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

						<TextBlock Text="Scriblucent"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"/>

					</StackPanel>
					<Grid HorizontalAlignment="Right"
						  VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<Border x:Name="TopSearchPanel"
								Grid.Column="0"
								Width="0"
								Height="32"
								Margin="0,0,8,0"
								Padding="10,0"
								Visibility="Collapsed"
								ClipToBounds="True"
								VerticalAlignment="Center"
                                Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource BorderColor}"
								BorderThickness="1"
								CornerRadius="8"
								Opacity="0"
								RenderTransformOrigin="1,0.5">
							<DockPanel LastChildFill="True">
                              <TextBlock Text="🔎"
                                    Foreground="{DynamicResource TextColorSecondary}"
										   Margin="0,0,8,0"
                                        VerticalAlignment="Center"
										   FontSize="13"/>
								<TextBox x:Name="TopSearchTextBox"
										 BorderThickness="0"
										 Background="Transparent"
										 Foreground="{DynamicResource TextColor}"
										 CaretBrush="{DynamicResource TextColor}"
 										 VerticalContentAlignment="Center"
 										 Text="{Binding ActiveSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 										 ToolTip="{Binding [SearchNotesHint], Source={StaticResource Loc}}"
										 KeyDown="TopSearchTextBox_KeyDown"/>
							</DockPanel>
						</Border>

						<Button x:Name="TopSearchButton"
								Grid.Column="1"
                                Style="{StaticResource TopBarIconButtonStyle}"
                              Content="🔎"
                               FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding [Search], Source={StaticResource Loc}}"
								Click="TopSearchButton_Click"/>

						<Button x:Name="SortNotesButton"
								Grid.Column="2"
                             Style="{StaticResource TopBarIconButtonStyle}"
								Content="⇅"
								FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveSortButtonText}"
								Click="SortNotesButton_Click"/>

						<Button x:Name="TagsFilterButton"
							 Grid.Column="3"
                              Style="{StaticResource TopBarIconButtonStyle}"
							  Content="🏷"
							   FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveTagFilterButtonText}"
								Click="TagsFilterButton_Click"/>

						<Button x:Name="DashboardSectionsButton"
								Grid.Column="4"
								Style="{StaticResource TopBarIconButtonStyle}"
								Content="☷"
								FontSize="14"
								Margin="0,0,8,0"
                                ToolTip="{Binding [DashboardSections], Source={StaticResource Loc}}"
								Click="DashboardSectionsButton_Click"/>

					</Grid>
				</Grid>
			</Border>

			<Popup x:Name="SortNotesPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=SortNotesButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding ActiveSortButtonText}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="8,8">
							<ItemsControl ItemsSource="{Binding ActiveSortOptions}">
								<ItemsControl.ItemTemplate>
                                   <DataTemplate>
										<RadioButton Style="{StaticResource SortOptionRadioButtonStyle}"
												 GroupName="NoteSortOptionGroup"
												 Content="{Binding DisplayName}"
												 IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 Margin="2,4"
												 Foreground="{DynamicResource TextColor}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="DashboardSectionsPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=DashboardSectionsButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="220"
						MaxWidth="300"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding [DashboardSections], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,10">
                            <Grid>
							<StackPanel Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
								<CheckBox Content="{Binding [RecentNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                             <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [NotesDashboard], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsNotesDashboardSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentFlashcards], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [FlashcardGroupsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsQuizzesView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentQuizzes], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [QuizzesDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMindMapsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentMindMaps], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            </Grid>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="TagsFilterPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=TagsFilterButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<Grid Margin="4,2,4,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding [FilterTags], Source={StaticResource Loc}}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Style="{StaticResource PopupMenuButtonStyle}"
									Padding="8,4"
									Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
									Command="{Binding ClearTagFiltersCommand}"/>
						</Grid>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,14"
								Visibility="{Binding ActiveHasTagFilters, Converter={StaticResource BoolToVis}}">
							<ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding ActiveTagFilters}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
											<CheckBox Content="{Binding Tag}"
													  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="0,2"
													  Foreground="{DynamicResource TextColor}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
                      <TextBlock Text="{Binding [NoTagsFound], Source={StaticResource Loc}}"
								   Margin="4,8,4,6"
								   FontStyle="Italic"
								   Foreground="{DynamicResource TextColorSecondary}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ActiveHasTagFilters}" Value="False">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>
			</Popup>

			<!-- Dashboard + FAB overlay -->
            <Grid Grid.Row="1">
                
                <!-- NOTES VIEW -->
                <Grid x:Name="NotesDashboardView"
                      Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Recent Notes strip -->
                    <Border Grid.Row="0"
                        Visibility="{Binding IsRecentSectionVisible, Converter={StaticResource BoolToVis}}"
						Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="0,0,0,1"
						Padding="16,8"
                        ClipToBounds="False">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
									ToolTip="{Binding [ToggleRecentNotesSection], Source={StaticResource Loc}}"
									Click="ToggleRecentSectionButton_Click"

						Style="{StaticResource DashboardSectionToggleButtonStyle}"

						behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsRecentSectionExpanded}" />
                                <TextBlock Grid.Column="1"
									   Text="{Binding [RecentNotes], Source={StaticResource Loc}}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									Margin="8,0,0,0"
									   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
									   VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="RecentSectionBody"
								Margin="0,6,0,0"
								ClipToBounds="False"
								RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <ScrollViewer x:Name="RecentNotesScrollViewer"
                                              Style="{StaticResource RecentItemsStripScrollViewerStyle}">
                                    <ItemsControl Style="{StaticResource RecentStripItemsStyle}"
                                                  ItemsSource="{Binding RecentNotes}">
                                        <ItemsControl.ItemsPanel>
                                            <StaticResource ResourceKey="RecentItemsStripPanelTemplate"/>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                <Button Style="{StaticResource RecentNoteCardStyle}"
													Tag="{Binding}"
													Click="RecentNoteButton_Click">
                                                    <StackPanel MinWidth="118" MaxWidth="176">
                                                        <TextBlock Text="{Binding Document.Title}"
															   FontWeight="SemiBold"
															   FontSize="13"
															   TextTrimming="CharacterEllipsis"
															   Foreground="{DynamicResource TextColor}"/>
                                                        <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
															   FontSize="11"
															   Foreground="{DynamicResource TextColor}"
															   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- All Notes + FAB -->
                        <ScrollViewer x:Name="NotesScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListingScrollViewerStyle}"
								 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="{DynamicResource WindowBackground}"
								 Padding="8"
								 AllowDrop="True"
								 PreviewDragOver="NotesScrollViewer_PreviewDragOver"
								 PreviewDragLeave="NotesScrollViewer_PreviewDragLeave"
								 PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                            <Grid Margin="0,0,0,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CalendarSectionContainer"
									Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SidebarBackground}"
									BorderBrush="{DynamicResource BorderColor}"
									BorderThickness="0"
                                    CornerRadius="14"
									Padding="12"
									Margin="8,0,8,10"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↑"
												Margin="0,0,2,0"
												ToolTip="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}"
												Click="MoveCalendarUpButton_Click"/>
                                            <Button Grid.Column="1"
												Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↓"
												Margin="0,0,4,0"
												ToolTip="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
												Click="MoveCalendarDownButton_Click"/>
                                            <Button Grid.Column="2"
												ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
												Click="ToggleCalendarSectionButton_Click"
                                            Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsCalendarSectionExpanded}" />
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
												   FontSize="14"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												   Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid x:Name="CalendarSectionBody" Margin="2,0,2,2" Height="220">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
												Background="{DynamicResource CardBackground}"
												BorderBrush="{DynamicResource BorderColor}"
                                             BorderThickness="0"
                                               CornerRadius="12"
                                               Padding="8">
                                                <Calendar x:Name="DashboardCalendar"
                                              Style="{StaticResource DashboardCalendarControlStyle}"
													 SelectedDate="{Binding CalendarSelectedDate, Mode=TwoWay}"
													 SelectionMode="SingleDate"
													 SelectedDatesChanged="DashboardCalendar_SelectedDatesChanged"/>
                                            </Border>
                                            <Border Grid.Column="2"
												Background="{DynamicResource CardBackground}"
												BorderBrush="{DynamicResource BorderColor}"
												BorderThickness="0"
                                               CornerRadius="12"
                                                Padding="8"
                                               ClipToBounds="True"
                                               Height="220">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding CalendarSelectedDateDisplay}"
														   FontWeight="SemiBold"
														   Foreground="{DynamicResource TextColor}"
                                                      Margin="2,2,2,8"/>
                                                    <Grid Grid.Row="1">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="146">
                                                            <ItemsControl ItemsSource="{Binding CalendarScheduledNotes}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CalendarScheduledItemViewModel}">
                                                                        <Border Style="{StaticResource CalendarScheduledItemCardStyle}"
												Tag="{Binding}"
												MouseLeftButtonUp="CalendarScheduledItemCard_MouseLeftButtonUp">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
