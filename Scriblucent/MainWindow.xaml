<Window xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:vm="clr-namespace:Scriblucent.ViewModels"
        xmlns:Views="clr-namespace:Scriblucent.Views"
        xmlns:dashboards="clr-namespace:Scriblucent.Views.Dashboards"
        xmlns:converters="clr-namespace:Scriblucent.Converters"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:services="clr-namespace:Scriblucent.Services"
        xmlns:anim="clr-namespace:Scriblucent.Animations"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
		Title="Scriblucent" Height="755" Width="1145"
        Icon="/logo.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SidebarBackground}"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Ideal"
		TextOptions.TextRenderingMode="ClearType"
        Closing="MainWindow_Closing">

    <Window.Resources>
		<!-- Calendar reminders use the shared raised item face without separate elevation. -->

		<Style x:Key="TopBarIconButtonStyle" TargetType="Button">
			<Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
      <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="TopBarIconBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="{StaticResource Type.BlockTitle}"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="TopBarIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</controls:InteractionSurface>
						<ControlTemplate.Triggers>


						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SearchClearButtonStyle" TargetType="Button">
      <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="IsTabStop" Value="False"/>
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="ToolTip" Value="{Binding [ClearSearch], Source={StaticResource Loc}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="ClearBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</controls:InteractionSurface>
						<ControlTemplate.Triggers>


						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SidebarActionButtonStyle" TargetType="Button">
			<Setter Property="FocusVisualStyle" Value="{StaticResource CardButtonKeyboardFocusStyle}"/>
            <Setter Property="behaviors:CommandLightBehavior.Role" Value="Navigation"/>
      <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="SidebarButtonBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
			<Setter Property="Padding" Value="0,8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="ActiveIndicator"
									Background="{DynamicResource SelectionBackground}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Card}"
									Opacity="0"/>
							<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" x:Name="SidebarButtonBorder" Role="Compact"
                                    HoverBackground="{DynamicResource IconButtonHoverBackground}"
                                    PressedBackground="{DynamicResource IconButtonPressedBackground}"
                                    HighlightWash="{DynamicResource ControlHoverSurfaceWash}"
                                    HighlightEdge="{DynamicResource ControlHoverSurfaceEdge}"
									Background="{TemplateBinding Background}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Card}"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="Center"/>
							</controls:InteractionSurface>
						</Grid>
						<ControlTemplate.Triggers>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
			<Setter Property="motion:SidebarResizeMotion.IsLabel" Value="True"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		</Style>

		<Style x:Key="SidebarNotesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsNotesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarFlashcardsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarQuizzesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsQuizzesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarMindMapsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMindMapsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>


        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter" />
		<Style x:Key="PopupMenuButtonStyle" TargetType="Button">
			<Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
      <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="PopupItemBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="PopupItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="{StaticResource Radius.Control}"
								Padding="{TemplateBinding Padding}"
								Margin="2">
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</controls:InteractionSurface>
						<ControlTemplate.Triggers>


							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
		</Style>

		<Style x:Key="GroupCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource ContentInsetSurface}"/>
			<Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
			<Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="6"/>
				</Setter.Value>
			</Setter>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.Profile" Value="GroupSlide"/>
		</Style>

		<!-- Level 4 content card (D): CardShadowLayer at use site + NoteCardBorder R(theme); mass-select A. -->
		<Style x:Key="DashboardGroupedListingCardStyle" TargetType="Border">
      <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<!-- No Effect: nine-slice CardShadowLayer sibling (not live DropShadowEffect). -->
		</Style>

		<!-- Same D rest tokens as grouped listing (ungrouped / larger tiles). -->
        <Style x:Key="DashboardListingCardSelectionStyle" TargetType="Border">
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

		<Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ReorderTrayButtonStyle}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Width" Value="{StaticResource Control.Size.Reorder}"/>
            <Setter Property="Height" Value="{StaticResource Control.Size.Reorder}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardListingMenuButtonStyle" TargetType="Button">
			<Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
      <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="MenuButtonBorder"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="{StaticResource Type.BlockTitle}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Visibility" Value="Hidden"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="MenuButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="0"
								CornerRadius="{StaticResource Radius.Control}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</controls:InteractionSurface>
						<ControlTemplate.Triggers>


						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" Value="True">
					<Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
			</Style.Triggers>
		</Style>

	</Window.Resources>
	<Grid Background="{DynamicResource SidebarBackground}" ClipToBounds="True">

		<Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="64"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

        <!-- Level 3 sidebar: soft fill selection; separators are L (SidebarSeparator). -->
     <controls:SidebarChrome x:Name="SidebarChrome" motion:SidebarResizeMotion.IsEnabled="True" Panel.ZIndex="2"
				Grid.Column="0"
				Background="{DynamicResource SidebarBackground}"
				BorderThickness="0"
             ClipToBounds="True"
             IsEnabled="{Binding IsNotMassSelectMode}"
				Padding="8,14,8,14">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Button Command="{Binding ToggleSidebarCommand}"
						Style="{StaticResource SidebarActionButtonStyle}"
						Margin="0,0,0,10"
						ToolTip="{Binding [Menu], Source={StaticResource Loc}}">
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="48"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<icons:AppIcon Grid.Column="0" Kind="Menu" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
						<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
								   Text="{Binding [Menu], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"/>
					</Grid>
				</Button>

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<Separator Margin="8,12,8,12" HorizontalAlignment="Left"
								   Background="{DynamicResource SidebarSeparator}"
								   Opacity="1"/>
						<Grid behaviors:SidebarNavMotionBehavior.IsGroupHost="True" behaviors:CommandLightBehavior.IsScope="True">
                            <Canvas IsHitTestVisible="False">
                                <controls:SidebarSelectionSurface x:Name="SidebarSelectionPlate" Visibility="Collapsed"
                                    Fill="{DynamicResource ControlHoverSurfaceWash}" Edge="{DynamicResource ControlHoverSurfaceEdge}"/>
                            </Canvas>
                            <StackPanel>
<Button Style="{StaticResource SidebarNotesDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsNotesView}"
								Command="{Binding ShowNotesCommand}"
								Margin="0,5"
								ToolTip="{Binding [NotesDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Notes" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [NotesDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarFlashcardsDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsFlashcardsView}"
								Command="{Binding ShowFlashcardsCommand}"
								Margin="0,5"
								ToolTip="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Flashcards" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarMindMapsDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsMindMapsView}"
								Command="{Binding ShowMindMapsCommand}"
								Margin="0,5"
								ToolTip="{Binding [MindMapsDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="MindMaps" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [MindMapsDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarQuizzesDashboardButtonStyle}"
								behaviors:SidebarNavMotionBehavior.IsActive="{Binding IsQuizzesView}"
								Command="{Binding ShowQuizzesCommand}"
								Margin="0,5"
								ToolTip="{Binding [QuizzesDashboard], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Quizzes" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [QuizzesDashboard], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
                            </StackPanel>
                        </Grid>
                        <Separator Margin="8,12,8,12" HorizontalAlignment="Left"
								   Background="{DynamicResource SidebarSeparator}"
								   Opacity="1"/>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarTrashButton_Click"
								ToolTip="{Binding [Trash], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0" Width="48" HorizontalAlignment="Center">
									<icons:AppIcon Kind="Trash" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
									<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Marker" controls:SurfaceMaterial.Foreground="{DynamicResource AccentPrimaryForeground}" HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="0,2,6,0"
											MinWidth="16"
											Height="16"
											Padding="4,0"
											CornerRadius="8"
											Background="{DynamicResource AccentPrimary}"
											Visibility="{Binding HasTrashItems, Converter={StaticResource BoolToVis}}">
										<TextBlock Text="{Binding TrashItemCount}"
												   FontSize="10"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource AccentPrimaryForeground}"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</controls:SurfaceMaterialBorder>
								</Grid>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [Trash], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarSettingsButton_Click"
								ToolTip="{Binding [Settings], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="Settings" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [Settings], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="AboutButton_Click"
								ToolTip="{Binding [About], Source={StaticResource Loc}}">
							<Grid VerticalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<icons:AppIcon Grid.Column="0" Kind="About" Style="{StaticResource SidebarNavIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<TextBlock Grid.Column="1" Style="{StaticResource SidebarLabelTextStyle}"
										   Text="{Binding [About], Source={StaticResource Loc}}"/>
							</Grid>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</controls:SidebarChrome>


		<!-- Fluent-style inset content stage: rounded where it meets the sidebar -->
		<Grid x:Name="SidebarContentStage" controls:CollectionSelectionFrame.Selection="{Binding DashboardSelection}" Panel.ZIndex="3" Grid.Column="1" Margin="0,10,10,10">
			<controls:StageShadowLayer/>
			<controls:SurfaceMaterialBorder x:Name="ContentStage" Style="{StaticResource WorkspaceFrameStyle}"
					behaviors:RoundedClipBehavior.IsEnabled="True"
					ClipToBounds="True"
					SnapsToDevicePixels="True">
		<Grid x:Name="MainContentRoot"
			  Background="Transparent">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar: brand lockup + actions -->
			<Border Grid.Row="0"
					Background="Transparent"
					BorderThickness="0"
					Padding="{StaticResource Shell.TopBarPadding}">
				<controls:DashboardHeaderPanel x:Name="DashboardHeader" MinHeight="40" VerticalAlignment="Center">

					<!-- Keep the lockup's footprint stable while SvgViewbox replaces its source on theme changes. -->
					<svgc:SvgViewbox
									 Source="{DynamicResource BrandLogoSvg}"
									 Width="125"
									 Height="36"
									 Stretch="Uniform"
									 VerticalAlignment="Center"
									 SnapsToDevicePixels="True"
									 UseLayoutRounding="True"/>

                    <controls:DashboardActionStrip x:Name="DashboardCollectionActions" Dashboard="{Binding ActiveDashboard}" Height="32" Orientation="Horizontal" VerticalAlignment="Center" behaviors:CommandLightBehavior.IsEnabled="True">
                        <Grid x:Name="DashboardCombineMotion">
                            <Button x:Name="DashboardCombineButton" Content="{icons:Icon Group}" Margin="0,0,8,0" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Click="DashboardCombineButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
                                        <Setter Property="ToolTip" Value="{Binding [CombineFlashcards], Source={StaticResource Loc}}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ActiveDashboard}" Value="Quizzes"><Setter Property="ToolTip" Value="{Binding [CombineQuizzes], Source={StaticResource Loc}}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Grid x:Name="DashboardHistoryMotion">
                            <Button x:Name="DashboardHistoryButton" Content="{icons:Icon History}" Margin="0,0,8,0" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Click="DashboardHistoryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
                                        <Setter Property="ToolTip" Value="{Binding [FlashcardHistory], Source={StaticResource Loc}}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ActiveDashboard}" Value="Quizzes"><Setter Property="ToolTip" Value="{Binding [QuizHistory], Source={StaticResource Loc}}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Grid x:Name="DashboardStatisticsMotion">
                            <Button x:Name="DashboardStatisticsButton" Content="{icons:Icon Chart}" Margin="0,0,8,0" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" ToolTip="{Binding [FlashcardStatistics], Source={StaticResource Loc}}" Click="DashboardStatisticsButton_Click" Style="{StaticResource TopBarIconButtonStyle}"/>
                        </Grid>
                        <Border x:Name="DashboardActionsDivider" Width="1" Height="18" Margin="4,0,0,0" CornerRadius="0.5" Background="{DynamicResource ActionDividerBrush}" Opacity="0.7" IsHitTestVisible="False"/>
                    </controls:DashboardActionStrip>
                    <Border Background="Transparent" CornerRadius="{StaticResource Radius.Card}" Padding="4,2"
                            behaviors:CommandLightBehavior.IsEnabled="True">
					<Grid
						  VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

						<!-- Flat form field; focus rim follows the face (matches Chrome fields). -->
						<motion:LayoutRevealHost Grid.Column="0" VerticalAlignment="Center" RevealFromEnd="True">
						<Grid x:Name="TopSearchPanel"
								Width="0" MaxWidth="{Binding SearchWidth, ElementName=DashboardHeader}"
								Height="32"
								Margin="0,0,8,0"
								Visibility="Collapsed"
								VerticalAlignment="Center"
								SnapsToDevicePixels="True"
								UseLayoutRounding="True"
								RenderTransformOrigin="1,0.5">
							<Border Padding="{StaticResource Field.ContentPadding}"
									CornerRadius="{StaticResource Radius.Control}"
									SnapsToDevicePixels="True"
									Background="{DynamicResource InputSurface}"
									BorderBrush="{DynamicResource InputRestBorder}"
									BorderThickness="{DynamicResource Field.RestBorderThickness}"
									behaviors:RoundedClipBehavior.IsEnabled="True"
									behaviors:FieldFocusRingBehavior.IsEnabled="True">
							<DockPanel LastChildFill="True">
                              <icons:AppIcon Kind="Search" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" Margin="{StaticResource Field.InlineLabelMargin}" VerticalAlignment="Center"/>
								<Button x:Name="ClearSearchButton"
										DockPanel.Dock="Right"
										Style="{StaticResource SearchClearButtonStyle}"
										Width="0"
										Margin="0"
										Opacity="0"
										Visibility="Collapsed"
										IsHitTestVisible="False"
										Content="{icons:Icon Kind=Close, Size=12}"
										Click="ClearSearchButton_Click"/>
								<TextBox x:Name="TopSearchTextBox"
										 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
										 VerticalContentAlignment="Center"
 										 Text="{Binding ActiveSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 										 ToolTip="{Binding [SearchNotesHint], Source={StaticResource Loc}}"
										 KeyDown="TopSearchTextBox_KeyDown"/>
							</DockPanel>
							</Border>
							</Grid>

						</motion:LayoutRevealHost>
						<Button x:Name="TopSearchButton"
								Grid.Column="1"
                                Style="{StaticResource TopBarIconButtonStyle}"
                              Content="{icons:Icon Search}"
								Margin="0,0,8,0"
								ToolTip="{Binding [Search], Source={StaticResource Loc}}"
								Click="TopSearchButton_Click"/>

						<Button x:Name="SortNotesButton"
								Grid.Column="2"
                             Style="{StaticResource TopBarIconButtonStyle}"
								Content="{icons:Icon Sort}"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveSortButtonText}"
								Click="SortNotesButton_Click"/>

						<Button x:Name="TagsFilterButton"
							 Grid.Column="3"
                              Style="{StaticResource TopBarIconButtonStyle}"
							  Content="{icons:Icon Tag}"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveTagFilterButtonText}"
								Click="TagsFilterButton_Click"/>

						<Button x:Name="DashboardSectionsButton"
								Grid.Column="4"
								Style="{StaticResource TopBarIconButtonStyle}"
								Content="{icons:Icon Sections}"
								Margin="0,0,8,0"
                                ToolTip="{Binding [DashboardSections], Source={StaticResource Loc}}"
								Click="DashboardSectionsButton_Click"/>

					</Grid>
					</Border>
				</controls:DashboardHeaderPanel>
			</Border>

			<Popup x:Name="SortNotesPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=SortNotesButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="260"
						  MaxWidth="320"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<TextBlock Text="{Binding ActiveSortButtonText}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   Margin="0,0,0,8"/>
							<ItemsControl ItemsSource="{Binding ActiveSortOptions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<RadioButton Style="{StaticResource SortOptionRadioButtonStyle}"
													 GroupName="NoteSortOptionGroup"
													 Content="{Binding DisplayName}"
													 IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													 Margin="2,4"
													 Foreground="{DynamicResource TextColor}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
						</Border>
					</controls:SurfaceMaterialBorder>
					</Grid>
				</Border>
			</Popup>

			<Popup x:Name="DashboardSectionsPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=DashboardSectionsButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="220"
						  MaxWidth="300"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<TextBlock Text="{Binding [DashboardSections], Source={StaticResource Loc}}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   Margin="0,0,0,8"/>
							<Grid>
							<StackPanel Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
								<CheckBox Content="{Binding [RecentNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                             <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [NotesDashboard], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsNotesDashboardSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsNotesDashboardSectionVisible}"
										  Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentFlashcards], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [FlashcardGroupsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsFlashcardGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsQuizzesView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentQuizzes], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [QuizzesDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsQuizDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsQuizGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMindMapsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [RecentMindMaps], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapDashboardUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsMindMapGroupsSectionVisible}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
							</Grid>
						</StackPanel>
						</Border>
					</controls:SurfaceMaterialBorder>
					</Grid>
				</Border>
			</Popup>

			<Popup x:Name="TagsFilterPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=TagsFilterButton}"
				   Placement="Bottom"
				   HorizontalOffset="-32"
				   VerticalOffset="-28"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="None">
				<Border
						Padding="32"
						ClipToBounds="False">
					<Grid MinWidth="260"
						  MaxWidth="320"
						  HorizontalAlignment="Left"
						  UseLayoutRounding="True"
						  SnapsToDevicePixels="True">
						<Border Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								IsHitTestVisible="False"
								Effect="{StaticResource Elevation.Popup}"/>
						<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource PopupBorder}"
								BorderThickness="1"
								CornerRadius="{StaticResource Radius.Card}"
								SnapsToDevicePixels="True">
						<Border Background="Transparent"
								CornerRadius="{StaticResource Radius.Card}"
								Padding="12"
								behaviors:RoundedClipBehavior.IsEnabled="True"
								SnapsToDevicePixels="True">
						<StackPanel>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="{Binding [FilterTags], Source={StaticResource Loc}}"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextColor}"
										   VerticalAlignment="Center"/>
								<Button Grid.Column="1"
										Style="{StaticResource PopupMenuButtonStyle}"
										Padding="8,4"
										Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
										Command="{Binding ClearTagFiltersCommand}"/>
							</Grid>
							<ItemsControl ItemsSource="{Binding ActiveTagFilters}"
										  MaxHeight="230"
										  Visibility="{Binding ActiveHasTagFilters, Converter={StaticResource BoolToVis}}"
										  VirtualizingPanel.IsVirtualizing="True"
										  VirtualizingPanel.VirtualizationMode="Recycling"
										  VirtualizingPanel.ScrollUnit="Pixel"
										  ScrollViewer.CanContentScroll="True">
								<ItemsControl.Template>
									<ControlTemplate TargetType="{x:Type ItemsControl}">
										<ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
													  VerticalScrollBarVisibility="Auto"
													  HorizontalScrollBarVisibility="Disabled"
													  behaviors:RoundedClipBehavior.IsEnabled="True"
													  behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}">
											<ItemsPresenter/>
										</ScrollViewer>
									</ControlTemplate>
								</ItemsControl.Template>
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel IsItemsHost="True"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
											<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="0,2"
													  Foreground="{DynamicResource TextColor}">
												<TextBlock Text="{Binding Tag}"
													   Height="20"
													   TextTrimming="CharacterEllipsis"
													   ToolTip="{Binding Tag}"/>
											</CheckBox>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="{Binding [NoTagsFound], Source={StaticResource Loc}}"
									   Margin="0,4,0,0"
									   FontStyle="Italic"
									   Foreground="{DynamicResource TextColorSecondary}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding ActiveHasTagFilters}" Value="False">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>
						</Border>
					</controls:SurfaceMaterialBorder>
					</Grid>
				</Border>
			</Popup>

			<!-- Dashboard + FAB overlay -->
            <Grid Grid.Row="1">
                <motion:LayoutRevealHost Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,120,28"><controls:CollectionSelectionDock x:Name="DashboardSelectionDock" Visibility="Collapsed"/></motion:LayoutRevealHost>
                <Grid>
                <dashboards:NotesDashboardPage x:Name="NotesDashboardView" Visibility="Collapsed"/>
                <dashboards:FlashcardsDashboardPage x:Name="FlashcardsDashboardView" Visibility="Collapsed"/>
                <dashboards:QuizzesDashboardPage x:Name="QuizzesDashboardView" Visibility="Collapsed"/>
                <dashboards:MindMapsDashboardPage x:Name="MindMapsDashboardView" Visibility="Collapsed"/>
                <Grid x:Name="DashboardLoadingLayer" Visibility="Visible" ClipToBounds="True">
                    <!-- Continue the full stage's lighting beneath the opaque loading cover.
                         Canvas keeps this full-height paint from affecting the content row's measure. -->
                    <Canvas IsHitTestVisible="False">
                        <controls:SurfaceMaterialBorder Canvas.Bottom="0"
                                                       Width="{Binding ActualWidth, ElementName=MainContentRoot}"
                                                       Height="{Binding ActualHeight, ElementName=MainContentRoot}"
                                                       Background="{DynamicResource WindowBackground}"
                                                       controls:SurfaceMaterial.Kind="Workspace"/>
                    </Canvas>
                    <controls:DashboardLoadingOverlay x:Name="DashboardLoadingShell"
                                                      Background="Transparent"
                                                      SurfaceBrush="{DynamicResource CardBackground}"
                                                      InsetBrush="{DynamicResource ContentInsetSurface}"
                                                      DetailBrush="{DynamicResource TextColorSecondary}"
                                                      AccentBrush="{DynamicResource AccentPrimary}"
                                                      ControlBrush="{DynamicResource IconButtonBackground}"
                                                      ClipToBounds="True"
                                                      Opacity="1"/>
                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" x:Name="DashboardLoadFailurePanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440"
                            Margin="24"
                            Padding="24"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [DashboardLoadFailedTitle], Source={StaticResource Loc}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding [DashboardLoadFailedMessage], Source={StaticResource Loc}}"
                                       Margin="0,12,0,20"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <Button Content="{Binding [DashboardLoadRetry], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    MinWidth="120"
                                    Click="RetryDashboardLoad_Click"/>
                        </StackPanel>
                    </controls:SurfaceMaterialBorder>
                </Grid>
            </Grid>
                </Grid>


        </Grid>
			</controls:SurfaceMaterialBorder>
		</Grid>

		<Views:SettingsPanel x:Name="SettingsPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="200"/>

		<Views:AboutPanel x:Name="AboutPanelControl"
					  x:FieldModifier="public"
					  Grid.ColumnSpan="2"
					  Visibility="Collapsed"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  Panel.ZIndex="201"/>

		<Views:NoteSchedulePanel x:Name="NoteSchedulePanelControl"
							 x:FieldModifier="public"
							 Grid.ColumnSpan="2"
							 Visibility="Collapsed"
							 HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Panel.ZIndex="202"/>

		<Views:TrashPanel x:Name="TrashPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="203"/>
    </Grid>
</Window>
