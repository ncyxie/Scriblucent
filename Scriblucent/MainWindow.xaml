                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Content="&#x22EE;"
