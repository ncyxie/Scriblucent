                                                                                Width="236"
                                                                                MinHeight="112"
                                                                                Margin="0,0,4,6"
                                                                                Padding="8"
                                                                                Background="Transparent"
                                                                                Cursor="Hand"
                                                                                AllowDrop="True"
                                                                                behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
