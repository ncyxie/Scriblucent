                                                                                               TextWrapping="Wrap"
                                                                                               MaxHeight="34"
                                                                                               Foreground="{DynamicResource TextColorSecondary}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="Text" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </Trigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
                                                                                            BorderBrush="{DynamicResource BorderColor}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="8"
                                                                                            Padding="6,2"
                                                                                            Margin="0,0,4,0"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
                                                                                            BorderBrush="{DynamicResource BorderColor}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="8"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Center">
