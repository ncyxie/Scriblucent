<Window x:Class="Scriblucent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:vm="clr-namespace:Scriblucent.ViewModels"
        xmlns:Views="clr-namespace:Scriblucent.Views"
        xmlns:converters="clr-namespace:Scriblucent.Converters"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:services="clr-namespace:Scriblucent.Services"
        xmlns:anim="clr-namespace:Scriblucent.Animations"
        Title="Scriblucent" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <SolidColorBrush x:Key="DashboardGroupNameForeground" Color="#1C1C1C"/>
        <ItemsPanelTemplate x:Key="RecentItemsStripPanelTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4"/>
        </ItemsPanelTemplate>
        <Style x:Key="RecentStripItemsStyle" TargetType="ItemsControl">
            <Setter Property="behaviors:RecentStripEnterMotionBehavior.IsEnabled" Value="True"/>
        </Style>
        <Style x:Key="RecentItemsStripScrollViewerStyle"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="PanningMode" Value="HorizontalOnly"/>
            <Setter Property="Padding" Value="8,2,8,3"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="behaviors:MiddleClickScrollBehavior.IsEnabled" Value="True"/>
        </Style>
        <Style x:Key="DashboardListingScrollViewerStyle"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="behaviors:MiddleClickScrollBehavior.IsEnabled" Value="True"/>
        </Style>
        <Style x:Key="RecentNoteCardStyle" TargetType="Button">
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="RecentCard"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="CardBorder"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.ShadowElementName" Value="CardShadow"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="Margin" Value="0,5,7,5"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid ClipToBounds="False">
							<controls:CardShadowLayer x:Name="CardShadow"/>
							<Border x:Name="CardBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="{DynamicResource BorderColor}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="1" Direction="270"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="ScheduledItemBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
         <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
           <Setter Property="Padding" Value="12,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ScheduledItemBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
								Padding="{TemplateBinding Padding}"
								Margin="1">
                            <Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                              <Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MassActionIconButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="MassActionBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Margin" Value="0,0,3,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MassActionBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

        <Style x:Key="MassActionDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MassActionIconButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>

		<Style x:Key="TopBarIconButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="TopBarIconBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="TopBarIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="FloatingSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="False"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="FloatingSecondary"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="FloatingSecondaryBorder"/>
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="FloatingSecondaryBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="16" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarActionButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="SidebarButtonBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
			<Setter Property="Padding" Value="0,8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="ActiveIndicator"
									Background="{DynamicResource SelectionBackground}"
									BorderBrush="{DynamicResource BorderColor}"
									BorderThickness="1"
									CornerRadius="10"
									Opacity="0"/>
							<Border x:Name="SidebarButtonBorder"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="10"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="Center"/>
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
					<Setter Property="Visibility" Value="Collapsed"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarNotesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsNotesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarFlashcardsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarQuizzesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsQuizzesView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarMindMapsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMindMapsView}" Value="True">
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		
		
        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter" />
		<Style x:Key="PopupMenuButtonStyle" TargetType="Button">
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="PopupItemBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="PopupItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="6"
								Padding="{TemplateBinding Padding}"
								Margin="2">
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
		</Style>

		<Style x:Key="FabStyle" TargetType="Button">
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="Fab"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="FabBorder"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="52"/>
			<Setter Property="Height" Value="52"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="FabBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="14">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20"
												  BlurRadius="16" ShadowDepth="3"
												  Direction="270"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									   Margin="0,-3,0,0"
									   FontSize="{TemplateBinding FontSize}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						   <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="FabBorder" Property="Opacity" Value="0.62"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Cursor" Value="Arrow"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="EmptyDashboardPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
					<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
					<Setter Property="Opacity" Value="0.62"/>
					<Setter Property="Cursor" Value="Arrow"/>
				</Trigger>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="GroupCardStyle" TargetType="Border">
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="18"/>
				</Setter.Value>
			</Setter>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:CardSurfaceMotionBehavior.Profile" Value="GroupSlide"/>
		</Style>

