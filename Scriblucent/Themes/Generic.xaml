<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
                    xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:services="clr-namespace:Scriblucent.Services"
                    xmlns:icons="clr-namespace:Scriblucent.Icons"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:motion="clr-namespace:Scriblucent.Animations">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Scriblucent;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="CollectionSelectionCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="behaviors:CheckBoxCheckMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <Border x:Name="HoverPlate" Background="Transparent" CornerRadius="10">
                    <Border x:Name="SelectionBox" Width="22" Height="22" CornerRadius="7" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource MassSelectBoxBackground}">
                        <Grid>
                            <Path x:Name="CheckGlyph" Data="M 2,5.5 L 5.5,9 L 12,2.5" Stroke="{DynamicResource MassSelectBoxGlyph}"
                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" StrokeDashArray="14" StrokeDashOffset="16"/>
                            <Border x:Name="MixedGlyph" Visibility="Collapsed" Width="10" Height="2" CornerRadius="1" Background="{DynamicResource MassSelectBoxGlyph}"/>
                        </Grid>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HoverPlate" Property="BorderBrush" Value="{DynamicResource AccentRimBrush}"/><Setter TargetName="HoverPlate" Property="BorderThickness" Value="1"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource MassSelectBoxCheckedBackground}"/><Setter TargetName="SelectionBox" Property="controls:SurfaceMaterial.Kind" Value="Marker"/></Trigger>
                    <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource MassSelectBoxCheckedBackground}"/><Setter TargetName="SelectionBox" Property="controls:SurfaceMaterial.Kind" Value="Marker"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="MixedGlyph" Property="Visibility" Value="Visible"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type controls:CollectionSelectionToggle}" BasedOn="{StaticResource CollectionSelectionCheckBoxStyle}"/>
    <Style TargetType="{x:Type controls:CollectionSelectionFrame}">
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="{x:Type controls:CollectionSelectionFrame}">
                <Grid Background="Transparent">
                    <ContentPresenter x:Name="Body" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    <Grid Margin="{TemplateBinding FaceMargin}" IsHitTestVisible="False">
                        <controls:CollectionSelectionFeedback x:Name="PART_Feedback"/>
                    </Grid>
                    <Grid Margin="{TemplateBinding FaceMargin}">
                        <controls:CollectionSelectionToggle x:Name="PART_Toggle" Visibility="Collapsed" Margin="{TemplateBinding SelectionInset}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{TemplateBinding SelectionLabel}"/>
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelecting" Value="True"><Setter TargetName="PART_Toggle" Property="Visibility" Value="Visible"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- Replace WPF's dotted focus fallback; specialized circular/tab/swatch contours override this. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="2" BorderBrush="{DynamicResource AccentRimBrush}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Scroll-tile host for dashboard listing cards: the Skia tile covers the live template
         during smooth-scroll sessions (see DashboardTileHost / SkiaCardTileCache). -->
    <Style TargetType="{x:Type controls:DashboardTileHost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DashboardTileHost}">
                    <Grid>
                        <ContentPresenter x:Name="LiveContent"/>
                        <!-- Canvas keeps scroll paint out of layout measurement. -->
                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <Image x:Name="BitmapLayer"
                                   Visibility="Collapsed"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same rounded workspace frame as the main dashboard; content retains its own role. -->
    <Style TargetType="{x:Type controls:FeatureWindowShell}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="Background" Value="{DynamicResource WorkspaceBackdrop}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FeatureWindowShell}">
                    <Grid x:Name="FeatureRoot" Background="{TemplateBinding Background}">
                        <Grid x:Name="MotionStage" Margin="{StaticResource Workspace.FrameInset}" RenderTransformOrigin="0.5,0.35">
                            <controls:StageShadowLayer x:Name="WorkspaceShadow"/>
                            <controls:SurfaceMaterialBorder x:Name="StageFace" Style="{StaticResource WorkspaceFrameStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter x:Name="MotionChrome" Grid.Row="0"
                                        motion:WindowMotion.Role="Chrome" motion:ArrivalGroups.Role="Heading" Content="{TemplateBinding Header}"/>
                                    <ContentPresenter x:Name="MotionBody" Grid.Row="1"
                                        Content="{TemplateBinding Body}"/>
                                    <ContentPresenter x:Name="MotionFooter" Grid.Row="2"
                                        motion:WindowMotion.Role="Footer" motion:ArrivalGroups.Role="Actions" Content="{TemplateBinding Footer}"/>
                                </Grid>
                            </controls:SurfaceMaterialBorder>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hosted documents belong to their parent's frame, never a frame inside a frame. -->
                        <Trigger Property="controls:EditorChromeContext.IsTabbed" Value="True">
                            <Setter TargetName="MotionStage" Property="Margin" Value="0"/>
                            <Setter TargetName="WorkspaceShadow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="StageFace" Property="Background" Value="Transparent"/>
                            <Setter TargetName="StageFace" Property="controls:SurfaceMaterial.Kind" Value="None"/>
                            <Setter TargetName="StageFace" Property="CornerRadius" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:EditorChromeContext.IsTabbed" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Level 2 floating dialog: Elevation.Dialog only (no rest hairline). -->
    <Style TargetType="{x:Type controls:OverlayDialogShell}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OverlayDialogShell}">
                    <Grid x:Name="OverlayRoot">
                        <Grid x:Name="ScrimHost"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              behaviors:RoundedClipBehavior.IsEnabled="True"
                              behaviors:RoundedClipBehavior.TopInset="1"
                              behaviors:RoundedClipBehavior.CornerRadius="{x:Static services:OverlayScrimRounding.WindowMatchRadius}">
                            <Image x:Name="BackdropSnapshot"
                                   Stretch="Fill"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                            <Rectangle x:Name="OverlayDim"
                                       Fill="{DynamicResource OverlayScrim}"/>
                        </Grid>
                        <Border x:Name="PanelMotionHost"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,1"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <controls:BakedElevationLayer Kind="Dialog"/>
                                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" x:Name="DialogCard"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource FloatingSurfaceEdge}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Overlay}"
                                        Padding="{TemplateBinding CardPadding}"
                                        Width="{TemplateBinding CardWidth}"
                                        MaxWidth="{TemplateBinding MaxCardWidth}"
                                        behaviors:RoundedClipBehavior.IsEnabled="True"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ContentPresenter Grid.Row="0" motion:ArrivalGroups.Role="Heading"
                                                          Content="{TemplateBinding Header}"/>
                                        <ContentPresenter Grid.Row="1" motion:ArrivalGroups.Role="Content"
                                                          Content="{TemplateBinding Body}"/>
                                        <ContentPresenter Grid.Row="2" motion:ArrivalGroups.Role="Actions"
                                                          behaviors:CommandLightBehavior.IsScope="True"
                                                          Content="{TemplateBinding Footer}"/>
                                    </Grid>
                                </controls:SurfaceMaterialBorder>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type icons:AppIcon}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Quieter nav glyphs so labels stay primary in the sidebar -->
    <Style x:Key="SidebarNavIconStyle" TargetType="{x:Type icons:AppIcon}" BasedOn="{StaticResource {x:Type icons:AppIcon}}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Opacity" Value="0.68"/>
    </Style>

    <!-- Native ToolTip placement and timing remain owned by WPF. -->
    <Style TargetType="ToolTip">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FloatingSurfaceEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <!-- Reserve the baked shadow's full bleed inside the popup so its edges
                 fade out instead of being cut into a gray rectangle. Match the face radius. -->
            <Grid Margin="12,12,12,13" UseLayoutRounding="True">
                <controls:BakedElevationLayer Kind="Button" Opacity="0.18" IsHitTestVisible="False"/>
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter RecognizesAccessKey="True"/>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
            <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <Setter Property="behaviors:ExpanderMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                <StackPanel>
                    <ToggleButton x:Name="HeaderSite" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Style="{DynamicResource DisclosureHeaderToggleButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <icons:AppIcon x:Name="DisclosureChevron" Grid.Column="1" Kind="ChevronRight" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                        </Grid>
                    </ToggleButton>
                    <motion:LayoutRevealHost><ContentPresenter x:Name="DisclosureContent" Margin="0,12,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></motion:LayoutRevealHost>
                </StackPanel>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
