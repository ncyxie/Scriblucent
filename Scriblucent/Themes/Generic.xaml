<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
                    xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:icons="clr-namespace:Scriblucent.Icons"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- Feature windows: outer FeatureFrameBackground ring + FeatureStageBackground plate (not main dashboard). -->
    <Style TargetType="{x:Type controls:FeatureWindowShell}">
        <Setter Property="Background" Value="{DynamicResource FeatureFrameBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FeatureWindowShell}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid Margin="{StaticResource Shell.FeatureInset}">
                            <Border CornerRadius="{StaticResource Radius.Overlay}"
                                    Background="{DynamicResource FeatureStageBackground}"
                                    IsHitTestVisible="False"
                                    Effect="{StaticResource Elevation.Stage}"/>
                            <Border Background="{DynamicResource FeatureStageBackground}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource Radius.Overlay}"
                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter Grid.Row="0"
                                                      Content="{TemplateBinding Header}"/>
                                    <ContentPresenter Grid.Row="1"
                                                      Content="{TemplateBinding Body}"/>
                                    <ContentPresenter Grid.Row="2"
                                                      Content="{TemplateBinding Footer}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Level 2 floating dialog: Elevation.Dialog only (no rest hairline). -->
    <Style TargetType="{x:Type controls:OverlayDialogShell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OverlayDialogShell}">
                    <Grid x:Name="OverlayRoot">
                        <Grid x:Name="ScrimHost"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                            <Image x:Name="BackdropSnapshot"
                                   Stretch="Fill"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                            <Rectangle x:Name="OverlayDim"
                                       Fill="{DynamicResource OverlayScrim}"/>
                        </Grid>
                        <Border x:Name="PanelMotionHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,1"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Background="{DynamicResource CardBackground}"
                                        CornerRadius="{StaticResource Radius.Overlay}"
                                        IsHitTestVisible="False"
                                        Effect="{StaticResource Elevation.Dialog}"/>
                                <Border x:Name="DialogCard"
                                        Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Overlay}"
                                        Padding="{TemplateBinding CardPadding}"
                                        Width="{TemplateBinding MaxCardWidth}"
                                        MaxWidth="{TemplateBinding MaxCardWidth}"
                                        behaviors:RoundedClipBehavior.IsEnabled="True"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ContentPresenter Grid.Row="0"
                                                          Content="{TemplateBinding Header}"/>
                                        <ContentPresenter Grid.Row="1"
                                                          Content="{TemplateBinding Body}"/>
                                        <ContentPresenter Grid.Row="2"
                                                          Content="{TemplateBinding Footer}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type icons:AppIcon}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icons:AppIcon}">
                    <iconPacks:PackIconLucide Kind="{TemplateBinding LucideKind}"
                                              Width="{TemplateBinding Width}"
                                              Height="{TemplateBinding Height}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quieter nav glyphs so labels stay primary in the sidebar -->
    <Style x:Key="SidebarNavIconStyle" TargetType="{x:Type icons:AppIcon}" BasedOn="{StaticResource {x:Type icons:AppIcon}}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Opacity" Value="0.68"/>
    </Style>
</ResourceDictionary>
