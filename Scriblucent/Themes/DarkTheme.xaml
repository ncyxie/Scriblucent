<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and Container Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#262626"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextColorSecondary" Color="#B0B0B0"/>

    <!-- Card/Note Colors -->
    <SolidColorBrush x:Key="NoteCardBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NoteCardBorder" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="NoteCardTitle" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoteCardSelection" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NoteCardSelectionBorder" Color="#7EA2FF"/>

    <!-- Flashcard Colors -->
    <SolidColorBrush x:Key="FlashcardCardBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBackground" Color="#333847"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBackground" Color="#293856"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedHoverBackground" Color="#304263"/>
    <SolidColorBrush x:Key="FlashcardCardBorder" Color="#424242"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBorder" Color="#5A6F9E"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBorder" Color="#7EA2FF"/>
    <SolidColorBrush x:Key="FlashcardSideChipBackground" Color="#373737"/>
    <SolidColorBrush x:Key="FlashcardSideChipBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="FlashcardSideChipForeground" Color="#D7DCE6"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBackground" Color="#263855"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBorder" Color="#3F5E91"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipForeground" Color="#BFD4FF"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBackground" Color="#173D2D"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBorder" Color="#2A7A52"/>
    <SolidColorBrush x:Key="FlashcardKnownChipForeground" Color="#79E0A5"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBackground" Color="#4A341A"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBorder" Color="#A66B18"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipForeground" Color="#F6C66D"/>
    <SolidColorBrush x:Key="FlashcardNewChipBackground" Color="#373737"/>
    <SolidColorBrush x:Key="FlashcardNewChipBorder" Color="#505050"/>
    <SolidColorBrush x:Key="FlashcardNewChipForeground" Color="#D1D5DB"/>

    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#5A5A5A"/>

    <!-- Icon Button Colors -->
    <SolidColorBrush x:Key="IconButtonBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="IconButtonForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="IconButtonHoverBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="IconButtonPressedBackground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="EditorToolActiveBackground" Color="#263855"/>
    <SolidColorBrush x:Key="EditorToolActiveBorder" Color="#5F85D6"/>
    <SolidColorBrush x:Key="EditorToolActiveForeground" Color="#C7DAFF"/>

    <!-- Mass Select Colors -->
    <SolidColorBrush x:Key="MassSelectBoxBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="MassSelectBoxBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBackground" Color="#4A6EE0"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBorder" Color="#3D5FC7"/>
    <SolidColorBrush x:Key="MassSelectBoxGlyph" Color="#FFFFFF"/>

    <!-- Selection/Hover Colors -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#353535"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#686868"/>

    <!-- Mind map search highlight colors -->
    <SolidColorBrush x:Key="MindMapSearchMatchBorderBrush" Color="#F5B84D"/>
    <SolidColorBrush x:Key="MindMapSearchActiveBorderBrush" Color="#FF8E3A"/>
    <SolidColorBrush x:Key="MindMapConnectionBrush" Color="#8394B8"/>
    <SolidColorBrush x:Key="MindMapSelectedBorderBrush" Color="#7EA2FF"/>

    <!-- RichTextBox Colors -->
    <SolidColorBrush x:Key="RichTextBoxBackground" Color="#262626"/>
    <SolidColorBrush x:Key="RichTextBoxForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#7EA2FF"/>
    <SolidColorBrush x:Key="EditorFindMatchBackground" Color="#5A3D12"/>
    <SolidColorBrush x:Key="EditorFindActiveMatchBackground" Color="#B7791F"/>

</ResourceDictionary>
