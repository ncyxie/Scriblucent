<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window and Container Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#232323"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#1A1A1A"/>
    <!-- Feature windows: frame a touch deeper than the content plate. -->
    <SolidColorBrush x:Key="FeatureFrameBackground" Color="#161616"/>
    <SolidColorBrush x:Key="FeatureStageBackground" Color="#232323"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="InputSurface" Color="#323232"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>
    <!-- Dark: soft rest edge (shadows read poorly on dark). Thickness stays put on focus;
         accent focus ring is drawn by FieldFocusRingBehavior (adorner), not by growing the border. -->
    <SolidColorBrush x:Key="InputRestBorder" Color="#3A3A3A"/>
    <Thickness x:Key="Field.RestBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="SidebarSeparator" Color="#555555"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextColorSecondary" Color="#B0B0B0"/>

    <!-- Brand wordmark URI is registered in ThemeManager (sys:Uri XAML parses as String on .NET). -->
    <SolidColorBrush x:Key="AboutStageBase" Color="#161926"/>
    <SolidColorBrush x:Key="AboutStageForeground" Color="#F4F6FF"/>
    <SolidColorBrush x:Key="AboutStageMuted" Color="#A8B0D0"/>
    <SolidColorBrush x:Key="AboutStageCloseFill" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="AboutStageCloseBorder" Color="#33FFFFFF"/>
    <LinearGradientBrush x:Key="AboutStageBottomFade" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00161926" Offset="0"/>
        <GradientStop Color="#CC161926" Offset="0.55"/>
        <GradientStop Color="#FF161926" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AboutStageMeshA" Center="0.12,0.18" GradientOrigin="0.12,0.18" RadiusX="0.78" RadiusY="0.92">
        <GradientStop Color="#77435CEC" Offset="0"/>
        <GradientStop Color="#00435CEC" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AboutStageMeshB" Center="0.88,0.22" GradientOrigin="0.88,0.22" RadiusX="0.72" RadiusY="0.86">
        <GradientStop Color="#556B7CF0" Offset="0"/>
        <GradientStop Color="#006B7CF0" Offset="1"/>
    </RadialGradientBrush>

    <!-- Semantic accents (brand blue #435CEC + derived hover / pressed / subtle) -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#435CEC"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="#5568F0"/>
    <SolidColorBrush x:Key="AccentPrimaryPressed" Color="#3A4FD4"/>
    <SolidColorBrush x:Key="AccentPrimaryForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentPrimarySubtle" Color="#242A52"/>

    <SolidColorBrush x:Key="AccentDanger" Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentDangerHover" Color="#DC2626"/>
    <SolidColorBrush x:Key="AccentDangerPressed" Color="#B91C1C"/>
    <SolidColorBrush x:Key="AccentDangerForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentDangerSubtle" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="AccentDangerSubtleHover" Color="#5A2828"/>
    <SolidColorBrush x:Key="AccentDangerSubtleBorder" Color="#7F3A3A"/>
    <SolidColorBrush x:Key="AccentDangerSubtleForeground" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="AccentWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentWarningHover" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentWarningPressed" Color="#B45309"/>
    <SolidColorBrush x:Key="AccentWarningForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="AccentWarningSubtle" Color="#4A341A"/>
    <SolidColorBrush x:Key="AccentWarningSubtleBorder" Color="#A66B18"/>
    <SolidColorBrush x:Key="AccentWarningSubtleForeground" Color="#F6C66D"/>

    <SolidColorBrush x:Key="AccentSuccess" Color="#79E0A5"/>
    <SolidColorBrush x:Key="AccentSuccessForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="AccentSuccessSubtle" Color="#173D2D"/>
    <SolidColorBrush x:Key="AccentSuccessSubtleBorder" Color="#2A7A52"/>
    <SolidColorBrush x:Key="AccentSuccessSubtleForeground" Color="#79E0A5"/>

    <SolidColorBrush x:Key="ProgressTrackBackground" Color="#3A3A3A"/>

    <!-- Tag chips (fill only — stroke role B, no border token) -->
    <SolidColorBrush x:Key="TagChipBackground" Color="#373737"/>
    <SolidColorBrush x:Key="TagChipForeground" Color="#B4BBF8"/>

    <!-- Card/Note Colors — dark keeps soft rest hairline (shadows read poorly on dark surfaces). -->
    <SolidColorBrush x:Key="NoteCardBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NoteCardBorder" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="NoteCardTitle" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoteCardSelection" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NoteCardSelectionBorder" Color="#435CEC"/>

    <!-- Flashcard Colors -->
    <SolidColorBrush x:Key="FlashcardCardBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBackground" Color="#2E3145"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBackground" Color="#242A52"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedHoverBackground" Color="#2A3160"/>
    <SolidColorBrush x:Key="FlashcardCardBorder" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBorder" Color="#435CEC"/>
    <SolidColorBrush x:Key="FlashcardSideChipBackground" Color="#373737"/>
    <SolidColorBrush x:Key="FlashcardSideChipBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="FlashcardSideChipForeground" Color="#D7DCE6"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBackground" Color="#1E2448"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBorder" Color="#3D4AB0"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipForeground" Color="#B4BBF8"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBackground" Color="#173D2D"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBorder" Color="#2A7A52"/>
    <SolidColorBrush x:Key="FlashcardKnownChipForeground" Color="#79E0A5"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBackground" Color="#4A341A"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBorder" Color="#A66B18"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipForeground" Color="#F6C66D"/>
    <SolidColorBrush x:Key="FlashcardNewChipBackground" Color="#373737"/>
    <SolidColorBrush x:Key="FlashcardNewChipBorder" Color="#505050"/>
    <SolidColorBrush x:Key="FlashcardNewChipForeground" Color="#D1D5DB"/>

    <!-- Button Colors (alias IconButton family — one button surface system) -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#454545"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#525252"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#5E5E5E"/>

    <!-- Icon Button Colors -->
    <SolidColorBrush x:Key="IconButtonBackground" Color="#454545"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="IconButtonForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="IconButtonHoverBackground" Color="#525252"/>
    <SolidColorBrush x:Key="IconButtonPressedBackground" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="EditorToolActiveBackground" Color="#1E2448"/>
    <SolidColorBrush x:Key="EditorToolActiveBorder" Color="#5A6AB8"/>
    <SolidColorBrush x:Key="EditorToolActiveForeground" Color="#B4BBF8"/>

    <!-- Mass Select Colors -->
    <SolidColorBrush x:Key="MassSelectBoxBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="MassSelectBoxBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBackground" Color="#435CEC"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBorder" Color="#5568F0"/>
    <SolidColorBrush x:Key="MassSelectBoxGlyph" Color="#FFFFFF"/>

    <!-- Selection/Hover Colors -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#353535"/>
    <SolidColorBrush x:Key="DropdownItemHoverBackground" Color="#2A3160"/>
    <SolidColorBrush x:Key="DropdownItemHoverBorder" Color="#5A6AB8"/>
    <!-- Calendar-only: brand-tinted hover so days/header read on dark cards without shouting. -->
    <SolidColorBrush x:Key="CalendarHoverBackground" Color="#2E3458"/>
    <SolidColorBrush x:Key="CalendarPressedBackground" Color="#383F6A"/>
    <!-- Floating menus: soft rest edge (elevation already reads on dark). -->
    <SolidColorBrush x:Key="PopupBorder" Color="#3F3F3F"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#686868"/>

    <!-- Slider (flip speed, zoom, etc.): bright thumb + accent ring on dark chrome -->
    <SolidColorBrush x:Key="SliderTrackBackground" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="SliderThumbBorder" Color="#5568F0"/>

    <!-- Mind map search highlight colors -->
    <SolidColorBrush x:Key="MindMapSearchMatchBorderBrush" Color="#F5B84D"/>
    <SolidColorBrush x:Key="MindMapSearchActiveBorderBrush" Color="#FF8E3A"/>
    <SolidColorBrush x:Key="MindMapConnectionBrush" Color="#7A85C0"/>
    <SolidColorBrush x:Key="MindMapCrossLinkBrush" Color="#9B8FD4"/>
    <SolidColorBrush x:Key="MindMapSelectedBorderBrush" Color="#5568F0"/>
    <!-- Root: restrained accent outline + cool wash (not solid candy blue). -->
    <SolidColorBrush x:Key="MindMapNodeRootBorderBrush" Color="#5568F0"/>
    <SolidColorBrush x:Key="MindMapNodeRootBackground" Color="#2A2D3A"/>
    <SolidColorBrush x:Key="MindMapNodeBorderBrush" Color="#525E82"/>
    <SolidColorBrush x:Key="MindMapBadgeBackground" Color="#373737"/>
    <SolidColorBrush x:Key="MindMapBadgeForeground" Color="#B4BBF8"/>

    <!-- RichTextBox Colors -->
    <SolidColorBrush x:Key="RichTextBoxBackground" Color="#262626"/>
    <SolidColorBrush x:Key="RichTextBoxForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#435CEC"/>
    <SolidColorBrush x:Key="EditorFindMatchBackground" Color="#5A3D12"/>
    <SolidColorBrush x:Key="EditorFindActiveMatchBackground" Color="#B7791F"/>

</ResourceDictionary>
