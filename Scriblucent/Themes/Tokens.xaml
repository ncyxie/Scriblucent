<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Structural design tokens (theme-invariant); theme colors live in LightTheme.xaml/DarkTheme.xaml.
      Contract:
        - Surfaces: SidebarBackground (frame) · WindowBackground / CardBackground (content) · InputSurface (fields)
        - Accent: AccentPrimary family for focus, selection, primary CTAs
        - Inputs: Chrome*BorderStyle + EmbeddedFieldTextBoxStyle (no local TextBox templates)
        - Buttons: Dialog* / ToolbarIcon / FAB only; implicit Button is theme-aware
        - Dialogs: OverlayDialogShell · Feature windows: FeatureWindowShell
        - Headers: DialogHeader or WindowChromeHeader (ChromePanelBorderStyle)
        - Color → DynamicResource · Geometry/Type/Space → StaticResource
      Stroke contract (soft-first — background/elevation before hairlines; hairline only for affordance or dark-mode edges):
        A Filled action     · no stroke — filled buttons, toolbar icons, FAB
        B Soft chip / tag   · no stroke — fill only
        C Form control      · InputRestBorder rest + AccentPrimary focus (a11y)
        D Content card      · shadow/elevation; NoteCardBorder transparent in light, soft in dark
        E Section / nested  · no stroke — surface contrast (+ optional Elevation.Field)
        F Floating surface  · Elevation.* primary; no rest hairline when elevation is present
        G Emphasis/select   · NoteCardSelectionBorder / AccentPrimary (1–2px)
        H Separator         · SidebarSeparator as a 1px line, not a box border
        I Status glyph chip · optional Accent*SubtleBorder
        Keep stroke: checkbox/radio, color swatches, drop-target glow. Domain exception: mind-map node
        borders (canvas model), not roles A–I.
    -->

    <!-- Typography -->
    <FontFamily x:Key="FontFamily.UI">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Editor">Calibri, Segoe UI, sans-serif</FontFamily>
    <SolidColorBrush x:Key="Brand.Lucent" Color="#435CEC"/>
    <sys:Double x:Key="Type.Display">28</sys:Double>
    <sys:Double x:Key="Type.PageTitle">22</sys:Double>
    <sys:Double x:Key="Type.DialogTitle">20</sys:Double>
    <sys:Double x:Key="Type.SectionTitle">15</sys:Double>
    <sys:Double x:Key="Type.Body">14</sys:Double>
    <sys:Double x:Key="Type.CardTitle">14.5</sys:Double>
    <sys:Double x:Key="Type.Meta">13</sys:Double>
    <sys:Double x:Key="Type.EmptyState">17</sys:Double>
    <sys:Double x:Key="Type.Chip">11</sys:Double>
    <sys:Double x:Key="Type.Caption">12</sys:Double>
    <sys:Double x:Key="Type.BlockTitle">16</sys:Double>

    <!-- Geometry -->
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.CalendarDay">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">18</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">7</CornerRadius>

    <!-- Field focus ring drawn by FieldFocusRingBehavior (adorner). Slightly thicker than 1px so the accent edge is less pixelated.
         Rest thickness is theme token Field.RestBorderThickness and never changes on focus. -->
    <Thickness x:Key="Field.FocusBorderThickness">2</Thickness>

    <!-- Spacing scale (px) -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>

    <Thickness x:Key="Shell.DashboardPadding">20,6,20,20</Thickness>
    <Thickness x:Key="Shell.RecentPadding">20,14,20,4</Thickness>
    <Thickness x:Key="Shell.TopBarPadding">20,12,20,12</Thickness>
    <!-- Slightly more top air so the title row clears the stage rounded edge. -->
    <Thickness x:Key="Shell.FeatureInset">10,14,10,10</Thickness>
    <Thickness x:Key="Shell.FeatureTitleRowPadding">20,16,20,4</Thickness>
    <Thickness x:Key="Shell.DialogPadding">24</Thickness>

    <!-- Dashboard card metrics -->
    <sys:Double x:Key="Dashboard.GroupedCardWidth">240</sys:Double>
    <sys:Double x:Key="Dashboard.GroupedCardHeight">128</sys:Double>
    <sys:Double x:Key="Dashboard.UngroupedCardWidth">330</sys:Double>
    <sys:Double x:Key="Dashboard.UngroupedCardHeight">204</sys:Double>
    <sys:Double x:Key="Dashboard.MindMapUngroupedCardWidth">360</sys:Double>
    <sys:Double x:Key="Dashboard.MindMapUngroupedCardHeight">224</sys:Double>
    <sys:Double x:Key="Dashboard.CalendarHeight">220</sys:Double>

    <!--
      Elevation contract (x:Shared=False so each consumer gets its own effect instance):
        Thumb  · small drag grabbers (slider thumb, resize handles)
        Field  · inputs, and small clickable list rows/panels at rest
        Popup  · sort/filter menus, ComboBox lists, ContextMenu (must read on light chrome)
        Button · primary/danger/warning CTAs, FAB - never default/secondary buttons (flat, no shadow)
        Dialog · modal surfaces
        Stage  · ambient halo behind inset feature/editor shells
      Pick the tier by role, not by eye - do not hand-roll a new DropShadowEffect inline.
      Never put RoundedClipBehavior on the same Border as Effect — clip eats the shadow.
    -->
    <DropShadowEffect x:Key="Elevation.Thumb"
                      Color="#000000"
                      Opacity="0.16"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Direction="270"/>
    <DropShadowEffect x:Key="Elevation.Field"
                      Color="#000000"
                      Opacity="0.18"
                      BlurRadius="14"
                      ShadowDepth="2"
                      Direction="270"/>
    <!-- Floating menus/dropdowns: soft lift (Quality bias). Keep opacity moderate — too high
         reads as a gray plate; too low vanishes on light chrome.
         Consumers: transparent padding ~16–20px around the shadow host + HorizontalOffset
         so the panel stays aligned with its control while blur has room to fall off. -->
    <DropShadowEffect x:Key="Elevation.Popup"
                      Color="#000000"
                      Opacity="0.18"
                      BlurRadius="26"
                      ShadowDepth="3"
                      Direction="270"
                      RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Elevation.Dialog"
                      Color="#000000"
                      Opacity="0.30"
                      BlurRadius="36"
                      ShadowDepth="8"
                      Direction="270"/>
    <DropShadowEffect x:Key="Elevation.Button"
                      Color="#000000"
                      Opacity="0.18"
                      BlurRadius="12"
                      ShadowDepth="1"
                      Direction="270"/>
    <!-- Soft ambient halo behind inset feature / editor stage shells -->
    <DropShadowEffect x:Key="Elevation.Stage"
                      Color="#000000"
                      Opacity="0.12"
                      BlurRadius="20"
                      ShadowDepth="0"/>


    <!-- Overlay scrim (fixed; works on both themes) -->
    <SolidColorBrush x:Key="OverlayScrim" Color="#66000000"/>
</ResourceDictionary>
