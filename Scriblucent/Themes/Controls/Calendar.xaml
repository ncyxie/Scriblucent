<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:icons="clr-namespace:Scriblucent.Icons"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors">

    <Style x:Key="CalendarScheduledListStyle" TargetType="{x:Type ItemsControl}">
        <Setter Property="MaxHeight" Value="218"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ItemsControl}">
                    <ScrollViewer behaviors:SmoothScrollBehavior.IsEnabled="True" behaviors:ScrollTileBehavior.IsEnabled="True"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:MiddleClickScrollBehavior.IsEnabled="True"
                                  behaviors:RoundedClipBehavior.IsEnabled="True"
                                  behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarDayKeyboardFocusStyle" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False">
                <Rectangle Width="32" Height="32" RadiusX="10" RadiusY="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource AccentRimBrush}" StrokeThickness="2"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CalendarDayKeyboardFocusStyle}"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="DayFace"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Calendar.Day}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="DayBorder"
                            Background="Transparent"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False">
                            <controls:InteractionSurface x:Name="DayFace" Role="Compact" CornerRadius="10" Background="Transparent"
                                HoverBackground="{DynamicResource CalendarHoverBackground}" PressedBackground="{DynamicResource CalendarPressedBackground}"
                                Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Grid Width="32" Height="32">
                                    <Rectangle RadiusX="10" RadiusY="10" x:Name="DayMarker" Width="32" Height="32" Fill="Transparent" Stroke="Transparent"
                                        StrokeThickness="2" SnapsToDevicePixels="False"/>
                                    <controls:CalendarDayLabel Content="{TemplateBinding Content}"
                                        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </controls:InteractionSurface>
                            <Border x:Name="ScheduleMark" Width="4" Height="2" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Background="{DynamicResource AccentPrimary}" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="DayMarker" Property="Stroke" Value="{DynamicResource AccentRimBrush}"/>
                            <Setter TargetName="DayMarker" Property="StrokeThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DayMarker" Property="Stroke" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarHeaderButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StandardKeyboardFocusStyle}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="HeaderButtonBorder"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="HeaderButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </controls:InteractionSurface>
                    <ControlTemplate.Triggers>


                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource StandardKeyboardFocusStyle}"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="CalendarButtonBorder"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <controls:InteractionSurface Role="Compact" HoverBackground="{DynamicResource CalendarHoverBackground}" PressedBackground="{DynamicResource CalendarPressedBackground}" x:Name="CalendarButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </controls:InteractionSurface>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource MaterialCalendarSelectedFill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryForeground}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarItemStyle" TargetType="CalendarItem">
        <!-- Make the native CalendarItem inset explicit for the shared loading geometry. -->
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                                <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                    <TextBlock Text="{Binding}" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="0"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root"
                              VerticalAlignment="Top">
                            <Grid.Resources>

                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton"
                                        ToolTip="{Binding [CalendarPreviousPeriod], Source={StaticResource Loc}}"
                                        AutomationProperties.Name="{Binding [CalendarPreviousPeriod], Source={StaticResource Loc}}"
                                        Style="{StaticResource CalendarHeaderButtonStyle}"
                                        Width="36"
                                        Height="36" Padding="0"
                                        Background="{DynamicResource IconButtonBackground}" controls:SurfaceMaterial.Kind="Neutral">
                                    <icons:AppIcon Kind="ChevronRight" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                        <icons:AppIcon.RenderTransform><RotateTransform Angle="180"/></icons:AppIcon.RenderTransform>
                                    </icons:AppIcon>
                                </Button>
                                <Button x:Name="PART_HeaderButton"
                                        ToolTip="{Binding [CalendarChoosePeriod], Source={StaticResource Loc}}"
                                        Grid.Column="1"
                                        Style="{StaticResource CalendarHeaderButtonStyle}"
                                        FontSize="{StaticResource Type.SectionTitle}"
                                        FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"/>
                                <Button x:Name="PART_NextButton"
                                        ToolTip="{Binding [CalendarNextPeriod], Source={StaticResource Loc}}"
                                        AutomationProperties.Name="{Binding [CalendarNextPeriod], Source={StaticResource Loc}}"
                                        Grid.Column="2"
                                        Style="{StaticResource CalendarHeaderButtonStyle}"
                                        Width="36"
                                        Height="36" Padding="0"
                                        Background="{DynamicResource IconButtonBackground}" controls:SurfaceMaterial.Kind="Neutral">
                                    <icons:AppIcon Kind="ChevronRight" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                            <Grid x:Name="MonthFrame" Grid.Row="1" Height="240" Margin="0,8,0,0" ClipToBounds="True">
                                <Canvas IsHitTestVisible="False">
                                    <controls:SurfaceMaterialBorder x:Name="CalendarSelectionPlate" Width="32" Height="32" CornerRadius="10"
                                        controls:SurfaceMaterial.Kind="Tinted" Background="{DynamicResource CalendarHoverBackground}"
                                        BorderBrush="{DynamicResource AccentRimBrush}" BorderThickness="2" Visibility="Hidden"/>
                                </Canvas>
                            <Grid x:Name="PART_MonthView"

                                  Height="240"
                                  Margin="0"
                                  ClipToBounds="True"
                                  VerticalAlignment="Top"
                                  TextElement.Foreground="{DynamicResource TextColorSecondary}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                            </Grid>
                            </Grid>
                            <Grid x:Name="PART_YearView"
                                  Grid.Row="1"
                                  Height="240" Margin="0,8,0,0"
                                  Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EmbeddedCalendarControlStyle" TargetType="Calendar">
        <Setter Property="behaviors:CommandLightBehavior.IsScope" Value="True"/>
        <Setter Property="behaviors:CalendarScheduleMarkBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:CalendarNavigationMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Meta}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonStyle}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarButtonStyle}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <!-- Grid (not StackPanel) so the month view fills the gray host evenly. -->
                    <CalendarItem x:Name="PART_CalendarItem"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  Style="{TemplateBinding CalendarItemStyle}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupCalendarControlStyle" TargetType="Calendar" BasedOn="{StaticResource EmbeddedCalendarControlStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border
                            Padding="32"
                            ClipToBounds="False">
                        <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    IsHitTestVisible="False"
                                    Effect="{StaticResource Elevation.Popup}"/>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    SnapsToDevicePixels="True">
                                <Border Background="Transparent"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Padding="8"
                                        behaviors:RoundedClipBehavior.IsEnabled="True"
                                        SnapsToDevicePixels="True">
                                    <CalendarItem x:Name="PART_CalendarItem"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Style="{TemplateBinding CalendarItemStyle}"/>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
