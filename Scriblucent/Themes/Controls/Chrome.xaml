<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
                    xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:icons="clr-namespace:Scriblucent.Icons"
                    xmlns:conv="clr-namespace:Scriblucent.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Scriblucent;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Level 1 form chrome (role C): flat InputSurface; elevation belongs to cards and floating surfaces.
         BorderThickness stays at theme Field.RestBorderThickness always (never changes on focus).
         Focus ring is an adorner (FieldFocusRingBehavior) so light title fields no longer optically
         shrink when a same-as-fill rest rim turns accent, and 0→N thickness never shifts layout.
         Light rest thickness 0 (no visible stroke); dark rest = soft InputRestBorder edge.
         Nested ChromePanelBorderStyle is role E (surface only; no field shadow/rest stroke/focus ring). -->

    <Style x:Key="ChromeFieldBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Field.ContentPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Form}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- No live DropShadow on this border — it wraps text inputs (would blur ClearType). Surface contrast is enough. -->
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="behaviors:RoundedClipBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:FieldFocusRingBehavior.IsEnabled" Value="True"/>
    </Style>

    <!-- Fields on a raised content face use an inset fill; fields on canvas/recessed groups use InputSurface. -->
    <Style x:Key="ChromeInsetFieldBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeFieldBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource InputSurfaceInset}"/>
    </Style>

    <Style x:Key="ChromeTitleFieldBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeInsetFieldBorderStyle}">
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="ChromeMultilineFieldBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeInsetFieldBorderStyle}">
        <Setter Property="Padding" Value="{StaticResource Field.MultilinePadding}"/>
    </Style>

    <!-- Status fits its current message and releases title space when dismissed. -->
    <Style x:Key="EditorTitleStatusStyle" TargetType="controls:EditorTitleStatus">
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Nested chrome panel: surface only (no field shadow, no rest stroke, no focus ring). -->
    <Style x:Key="ChromePanelBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeFieldBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="behaviors:FieldFocusRingBehavior.IsEnabled" Value="False"/>
    </Style>

    <!-- Role E: a neutral recess within a content face, with no additional elevation. -->
    <Style x:Key="ContentInsetBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromePanelBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentInsetSurface}"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- A shared pointer light belongs to command bands, never to content cards or forms. -->
    <Style x:Key="CommandSurfaceBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromePanelBorderStyle}">
        <Setter Property="behaviors:CommandLightBehavior.IsEnabled" Value="True"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource Field.ContentPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Form}"/>
        <!-- Center single-line caret/glyphs; AcceptsReturn fields pin Top via trigger. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!-- In-tree focus ring (not adorner) so secondary-window rise/sink motion keeps the ring glued.
                         A shared directional accent rim carries focus without changing field layout. -->
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                SnapsToDevicePixels="True">
                            <!-- TextBoxView already consumes TextBox.Padding. Applying it to this Border
                                 as well doubles the inset. VCA centers single lines and pins multiline Top. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=TextBoxBorder}" Thickness="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="{StaticResource Field.MultilinePadding}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmbeddedFieldTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- Fill chrome shells; Center mid-offsets one-line glyphs in tall title/search hosts. -->
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Padding="0"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <!-- The field shell already owns padding, including multiline fields. -->
                <Setter Property="Padding" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InsetFieldTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource InputSurfaceInset}"/>
    </Style>

    <!-- Boolean form labels wrap within their column; the native CheckBox still owns input and automation. -->
    <Style x:Key="FormCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupListScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="behaviors:PopupListSizeBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="False"/>
        <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ScrollWheelContainmentBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="CanContentScroll" Value="True"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <ControlTemplate x:Key="AppComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="ComboBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <icons:AppIcon x:Name="Chevron" behaviors:ControlDetailMotionBehavior.IsExpanded="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                               Kind="ChevronDown"
                               Width="12"
                               Height="12"
                               Grid.Column="1"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                    <icons:AppIcon.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </icons:AppIcon.RenderTransform>
                </icons:AppIcon>
            </Grid>
        </controls:SurfaceMaterialBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <!-- Non-editable dropdowns are neutral actions; editable variants retain field surfaces. -->
        <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource Field.ContentPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Form}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="behaviors:ComboBoxWholeAreaOpenBehavior.IsEnabled" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <!-- Dropdowns can be bound to the full note/set library (hundreds of items); without this
             the default ItemsPanel is a plain non-virtualizing StackPanel. -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Template="{StaticResource AppComboBoxToggleButtonTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"/>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=ToggleButton}" Thickness="2"/>
                        <ContentPresenter behaviors:ClosedDropdownLabelBehavior.IsEnabled="True" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch">
                            <ContentPresenter.Margin>
                                <MultiBinding Converter="{x:Static conv:ComboBoxContentInsetConverter.Instance}">
                                    <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsEditable" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </ContentPresenter.Margin>
                        </ContentPresenter>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <!-- Padding only for shadow falloff; MinWidth on the card (not shell) keeps left edge aligned.
                                 Shadow plate is a sibling so list text is not rasterized by DropShadowEffect. -->
                            <Border Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="behaviors:DropdownChoiceWidthBehavior.IsEnabled" Value="True">
                <Setter Property="Width" Value="{Binding Path=(behaviors:DropdownChoiceWidthBehavior.FittedWidth), RelativeSource={RelativeSource Self}}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Editable ComboBox: same chrome as implicit ComboBox, with PART_EditableTextBox. -->
    <Style x:Key="EditableComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="IsTextSearchEnabled" Value="True"/>
        <Setter Property="StaysOpenOnEdit" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True">
                        </controls:SurfaceMaterialBorder>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=ComboBorder}" Thickness="2"/>

                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"

                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontWeight="{TemplateBinding FontWeight}"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Margin>
                                <MultiBinding Converter="{x:Static conv:ComboBoxContentInsetConverter.Instance}">
                                    <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsEditable" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </TextBox.Margin>
                        </TextBox>

                        <ToggleButton x:Name="DropDownToggle"
                                      Width="32"
                                      HorizontalAlignment="Right"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <icons:AppIcon x:Name="Chevron" behaviors:ControlDetailMotionBehavior.IsExpanded="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Kind="ChevronDown"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <icons:AppIcon.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </icons:AppIcon.RenderTransform>
                                        </icons:AppIcon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsetEditableComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EditableComboBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource InputSurfaceInset}"/>
    </Style>

    <!-- Form selectors share the neutral action face; popup keeps Elevation.Popup. -->
    <Style x:Key="ChromeComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True"/>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=ComboBorder}" Thickness="2"/>
                        <ContentPresenter behaviors:ClosedDropdownLabelBehavior.IsEnabled="True" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch">
                            <ContentPresenter.Margin>
                                <MultiBinding Converter="{x:Static conv:ComboBoxContentInsetConverter.Instance}">
                                    <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsEditable" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </ContentPresenter.Margin>
                        </ContentPresenter>
                        <ToggleButton x:Name="DropDownToggle"
                                      HorizontalAlignment="Stretch"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <icons:AppIcon x:Name="Chevron" behaviors:ControlDetailMotionBehavior.IsExpanded="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Kind="ChevronDown"
                                                           Width="12"
                                                           Height="12"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Grid.Column="1"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                <icons:AppIcon.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </icons:AppIcon.RenderTransform>
                                            </icons:AppIcon>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preserve the named role while using the same selector face on inset and raised hosts. -->
    <Style x:Key="InsetComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ChromeComboBoxStyle}"/>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
        <Setter Property="MinHeight" Value="{Binding MinHeight, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder" behaviors:StateSurfaceMotionBehavior.IsEnabled="True"
                                behaviors:StateSurfaceMotionBehavior.ActiveState="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                                behaviors:StateSurfaceMotionBehavior.IsSelected="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter behaviors:DropdownLabelBehavior.IsEnabled="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar dropdowns use 14 DIP / 32 DIP; forms use 14 DIP / 36 DIP. -->
    <Style x:Key="FeatureToolbarComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
    </Style>

    <Style x:Key="FeatureToolbarComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Toolbar}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FeatureToolbarComboBoxItemStyle}"/>
    </Style>

    <!-- Closed display: SelectedItem.DisplayName (ItemTemplate may include action buttons). -->
    <Style x:Key="SetSelectorComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource FeatureToolbarComboBoxStyle}">
        <Setter Property="Padding" Value="{StaticResource Field.ContentPadding}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Template="{StaticResource AppComboBoxToggleButtonTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"/>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=ToggleButton}" Thickness="2"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=''}"

                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}">
                        <TextBlock.Margin>
                            <MultiBinding Converter="{x:Static conv:ComboBoxContentInsetConverter.Instance}">
                                <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsEditable" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </MultiBinding>
                        </TextBlock.Margin>
                    </TextBlock>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <!-- Padding only for shadow falloff; MinWidth on the card (not shell) keeps left edge aligned.
                                 Shadow plate is a sibling so list text is not rasterized by DropShadowEffect. -->
                            <Border Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SetSelectorComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource FeatureToolbarComboBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="SetSelectorActionComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SetSelectorComboBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- Link controls share density and insets; selection belongs to the ComboBox itself. -->
    <Style x:Key="LinkedNoteComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource FeatureToolbarComboBoxStyle}">
        <Setter Property="ToolTip" Value="{Binding SelectedItem.Title, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Width" Value="{StaticResource Control.Width.LinkedNote}"/>
        <Setter Property="Height" Value="{StaticResource Control.Height.Toolbar}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="{StaticResource Field.ContentPadding}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True"/>
                        <controls:AccentRim x:Name="FocusRing" Surface="{Binding ElementName=ComboBorder}" Thickness="2"/>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <icons:AppIcon Kind="Link" Width="16" Height="16" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimarySubtleForeground}"/>
                            <TextBlock x:Name="LinkedNoteLabel" Grid.Column="1"
                                       Text="{Binding SelectedItem.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Border Grid.Column="2" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <icons:AppIcon x:Name="Chevron" Kind="ChevronDown" Width="12" Height="12"
                                               behaviors:ControlDetailMotionBehavior.IsExpanded="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource TextColorSecondary}" RenderTransformOrigin="0.5,0.5">
                                    <icons:AppIcon.RenderTransform><RotateTransform Angle="0"/></icons:AppIcon.RenderTransform>
                                </icons:AppIcon>
                            </Border>
                        </Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      HorizontalAlignment="Stretch"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="LinkedNoteLabel" Property="Text" Value="{Binding [QuizLinkedNoteNone], Source={StaticResource Loc}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                            <Setter TargetName="FocusRing" Property="IsActive" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The document tab and title/toolbar area are one chrome group when hosted. -->
    <Style x:Key="EditorChromeStyle" TargetType="Border">
        <Setter Property="behaviors:CommandLightBehavior.IsEnabled" Value="True"/>
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Margin" Value="24,16,24,4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="controls:EditorChromeContext.IsTabbed" Value="True">
                <Setter Property="Margin" Value="24,0,24,4"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="controls:SurfaceMaterial.OpenTop" Value="True"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Integrated workspaces: headings/actions belong to the background; content earns a face. -->
    <Style x:Key="WorkspaceHeadingStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="24,20,24,14"/>
    </Style>
    <Style x:Key="WorkspaceFooterStyle" TargetType="Border">
        <Setter Property="behaviors:CommandLightBehavior.IsScope" Value="True"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="24,14,24,18"/>
    </Style>
    <Style x:Key="WorkspaceSectionStyle" TargetType="Border">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Shared chrome for QuizLibrary / FlashcardCombine twin windows. -->
    <Style x:Key="FeatureCombineTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource InputSurfaceInset}"/>
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Form}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FeatureCombineOptionCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource FormCheckBoxStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Dense collection rows stay flat; selection paints a 2 DIP rim without moving content. -->
    <Style x:Key="FeatureCombineItemBorderStyle" TargetType="Border">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="behaviors:StateSurfaceMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:StateSurfaceMotionBehavior.SelectionThickness" Value="2"/>
        <Setter Property="behaviors:StateSurfaceMotionBehavior.IsSelected" Value="{Binding IsSelected}"/>
    </Style>
    <!-- A slider never animates its value: feedback belongs to the grabber. -->
    <ControlTemplate x:Key="ModernSliderThumbTemplate" TargetType="Thumb">
        <Grid Width="18" Height="18">
            <Border x:Name="ThumbFace" Width="14" Height="14" CornerRadius="7"
                    Background="{DynamicResource SliderThumbBackground}" BorderBrush="{DynamicResource SliderThumbBorder}"
                    BorderThickness="2" RenderTransformOrigin="0.5,0.5" Effect="{StaticResource Elevation.Thumb}"/>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ModernSliderTemplate" TargetType="Slider">
        <Grid Margin="2,0">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource SliderTrackBackground}"/>
            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Data" x:Name="ValueFill" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" IsHitTestVisible="False"/>
            <Track x:Name="PART_Track" Focusable="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Template="{StaticResource ModernSliderThumbTemplate}" VerticalAlignment="Center"/></Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="behaviors:SliderSurfaceBehavior.IsEnabled" Value="True"/>
        <Setter Property="Template" Value="{StaticResource ModernSliderTemplate}"/>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
    </Style>
    <!-- Hue is already a value track; preserve its spectrum rather than covering it. -->
    <Style x:Key="HueSliderStyle" TargetType="Slider" BasedOn="{StaticResource ModernSliderStyle}">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Margin="2,0"><Track x:Name="PART_Track" Focusable="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Template="{StaticResource ModernSliderThumbTemplate}" VerticalAlignment="Center"/></Track.Thumb>
            </Track></Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Immediate preferences remain CheckBoxes, including native Space/automation and routed events. -->
    <Style x:Key="SettingsSwitchStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate></Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter HorizontalAlignment="Left" Margin="0,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <Grid Background="Transparent" Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                    <Border x:Name="SwitchTrack" CornerRadius="11" Background="{DynamicResource SliderTrackBackground}"/>
                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Marker" controls:SurfaceMaterial.Foreground="{DynamicResource AccentPrimaryForeground}" x:Name="SwitchOnTrack" CornerRadius="11" Background="{DynamicResource AccentPrimary}" Opacity="0"
                            behaviors:ControlDetailMotionBehavior.IsLit="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Border x:Name="SwitchThumb" Width="16" Height="16" Margin="3,0,0,0" HorizontalAlignment="Left" CornerRadius="8"
                            Background="{DynamicResource AccentPrimaryForeground}"
                            behaviors:ControlDetailMotionBehavior.IsOn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <controls:AccentRim x:Name="SwitchFocus" Surface="{Binding ElementName=SwitchTrack}" Thickness="2"/>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SwitchFocus" Property="IsActive" Value="True"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SwitchTrackHoverBackground}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="StateListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="StateRow" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}"
                    behaviors:StateSurfaceMotionBehavior.IsEnabled="True"
                    behaviors:StateSurfaceMotionBehavior.IsSelected="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                    behaviors:StateSurfaceMotionBehavior.SelectionThickness="2">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="StateRow" Property="behaviors:StateSurfaceMotionBehavior.ActiveState" Value="True"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Plain lists inherit row feedback too; eligibility does not require a feature style. -->
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource StateListBoxItemStyle}"/>
    <!-- Native list semantics and recycling, with app-owned viewport chrome. -->
    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                    <ItemsPresenter/>
                </ScrollViewer>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
