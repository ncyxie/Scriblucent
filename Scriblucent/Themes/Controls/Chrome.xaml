<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
                    xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:icons="clr-namespace:Scriblucent.Icons">
    <!-- Level 1 form chrome (role C): InputSurface + Elevation.Field.
         BorderThickness stays at theme Field.RestBorderThickness always (never changes on focus).
         Focus ring is an adorner (FieldFocusRingBehavior) so light title fields no longer optically
         shrink when a same-as-fill rest rim turns accent, and 0→N thickness never shifts layout.
         Light rest thickness 0 (no visible stroke); dark rest = soft InputRestBorder edge.
         Nested ChromePanelBorderStyle is role E (surface only; no field shadow/rest stroke/focus ring). -->

    <Style x:Key="ChromeFieldBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- No live DropShadow on this border — it wraps text inputs (would blur ClearType). Surface contrast is enough. -->
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="behaviors:RoundedClipBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:FieldFocusRingBehavior.IsEnabled" Value="True"/>
    </Style>

    <Style x:Key="ChromeTitleFieldBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeFieldBorderStyle}">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- Nested chrome panel: surface only (no field shadow, no rest stroke, no focus ring). -->
    <Style x:Key="ChromePanelBorderStyle" TargetType="Border" BasedOn="{StaticResource ChromeFieldBorderStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="behaviors:FieldFocusRingBehavior.IsEnabled" Value="False"/>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <!-- Center single-line caret/glyphs; AcceptsReturn fields pin Top via trigger. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!-- In-tree focus ring (not adorner) so secondary-window rise/sink motion keeps the ring glued.
                         Shadow is a sibling plate so DropShadowEffect does not rasterize (blur) typed text. -->
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <controls:BakedElevationLayer Kind="Field"/>
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                SnapsToDevicePixels="True">
                            <!-- VCA drives host alignment: Center mid-lines one-line fields; Top for multiline. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Stretch"/>
                        </Border>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="6,4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmbeddedFieldTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <!-- Fill chrome shells; Center mid-offsets one-line glyphs in tall title/search hosts. -->
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="Transparent"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopupListScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="False"/>
        <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ScrollWheelContainmentBehavior.IsEnabled" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="CanContentScroll" Value="True"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <ControlTemplate x:Key="AppComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="ComboBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <icons:AppIcon x:Name="Chevron"
                               Kind="ChevronDown"
                               Width="12"
                               Height="12"
                               Grid.Column="1"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                    <icons:AppIcon.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </icons:AppIcon.RenderTransform>
                </icons:AppIcon>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputRestBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Field.RestBorderThickness}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="behaviors:ComboBoxWholeAreaOpenBehavior.IsEnabled" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <!-- Dropdowns can be bound to the full note/set library (hundreds of items); without this
             the default ItemsPanel is a plain non-virtualizing StackPanel. -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Template="{StaticResource AppComboBoxToggleButtonTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"/>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <!-- Padding only for shadow falloff; MinWidth on the card (not shell) keeps left edge aligned.
                                 Shadow plate is a sibling so list text is not rasterized by DropShadowEffect. -->
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editable ComboBox: same chrome as implicit ComboBox, with PART_EditableTextBox. -->
    <Style x:Key="EditableComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="IsTextSearchEnabled" Value="True"/>
        <Setter Property="StaysOpenOnEdit" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True">
                        </Border>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>

                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 Margin="6,0,34,0"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <ToggleButton x:Name="DropDownToggle"
                                      Width="34"
                                      HorizontalAlignment="Right"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <icons:AppIcon x:Name="Chevron"
                                                       Kind="ChevronDown"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <icons:AppIcon.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </icons:AppIcon.RenderTransform>
                                        </icons:AppIcon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form ComboBox: flat closed chrome (no Elevation.Field); popup keeps Elevation.Popup. -->
    <Style x:Key="ChromeComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,34,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <ToggleButton x:Name="DropDownToggle"
                                      Width="34"
                                      HorizontalAlignment="Right"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <icons:AppIcon x:Name="Chevron"
                                                       Kind="ChevronDown"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <icons:AppIcon.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </icons:AppIcon.RenderTransform>
                                        </icons:AppIcon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownItemHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Feature toolbar chrome = Caption; forms / dialogs / menus stay on default ComboBox Body. -->
    <Style x:Key="FeatureToolbarComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
    </Style>

    <Style x:Key="FeatureToolbarComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FeatureToolbarComboBoxItemStyle}"/>
    </Style>

    <!-- Closed display: SelectedItem.DisplayName (ItemTemplate may include action buttons). -->
    <Style x:Key="SetSelectorComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource FeatureToolbarComboBoxStyle}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Template="{StaticResource AppComboBoxToggleButtonTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"/>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=''}"
                                   Margin="10,0,30,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <!-- Padding only for shadow falloff; MinWidth on the card (not shell) keeps left edge aligned.
                                 Shadow plate is a sibling so list text is not rasterized by DropShadowEffect. -->
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SetSelectorComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource FeatureToolbarComboBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="SetSelectorActionComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource SetSelectorComboBoxItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- Closed display: Window.LinkedNoteButtonText (null selection shows localized "None"). -->
    <Style x:Key="LinkedNoteComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ChromeComboBoxStyle}">
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="MaxWidth" Value="240"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="{StaticResource Field.FocusBorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="{Binding LinkedNoteButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="10,0,34,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ToggleButton x:Name="DropDownToggle"
                                      Width="34"
                                      HorizontalAlignment="Right"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <icons:AppIcon x:Name="Chevron"
                                                       Kind="ChevronDown"
                                                       Width="12"
                                                       Height="12"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <icons:AppIcon.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </icons:AppIcon.RenderTransform>
                                        </icons:AppIcon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer Style="{StaticResource PopupListScrollViewerStyle}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared chrome for QuizLibrary / FlashcardCombine twin windows. -->
    <Style x:Key="FeatureCombinePanelStyle" TargetType="Border" BasedOn="{StaticResource ChromePanelBorderStyle}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="FeatureCombineTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FeatureCombineOptionCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Level 4 D-lite: rest S; selected A 2px (library/combine list rows).
         Elevation.Field lives on a sibling plate at call sites — not on this border (wraps titles/meta). -->
    <Style x:Key="FeatureCombineItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
