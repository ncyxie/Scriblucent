<ResourceDictionary xmlns:behaviors="clr-namespace:Scriblucent.Behaviors" xmlns:controls="clr-namespace:Scriblucent.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:converters="clr-namespace:Scriblucent.Converters"
                    xmlns:localization="clr-namespace:Scriblucent.Localization">
    <x:Static x:Key="Loc" Member="localization:LocalizationProvider.Instance"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <converters:FieldContentInsetConverter x:Key="FieldContentInset"/>

    <sys:Double x:Key="CheckGlyphPathLength">14</sys:Double>
    <DoubleCollection x:Key="CheckGlyphDashArray">14</DoubleCollection>

    <!-- Forms/settings dense overlay chrome (intentional step below dashboard SectionTitle/Body).
         Hierarchy: section Body → label Meta SemiBold → helper Caption. Fields stay Type.Body. -->
    <Style x:Key="FormOptionLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormBodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Form}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FormHelperTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FormSectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Settings scroll category labels above card groups. -->
    <Style x:Key="FormCategoryTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
        <Setter Property="Margin" Value="2,18,0,8"/>
    </Style>

    <!-- Metrics are content surfaces, not badges. One family serves history/statistics summaries. -->
    <Style x:Key="MetricTileStyle" TargetType="Border">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Metric"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="MinWidth" Value="124"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="MetricPrimaryTileStyle" TargetType="Border" BasedOn="{StaticResource MetricTileStyle}">
        <Setter Property="controls:SurfaceMaterial.Foreground" Value="{DynamicResource AccentPrimarySubtleForeground}"/>
    </Style>
    <Style x:Key="MetricSuccessTileStyle" TargetType="Border" BasedOn="{StaticResource MetricTileStyle}">
        <Setter Property="controls:SurfaceMaterial.Foreground" Value="{DynamicResource AccentSuccessSubtleForeground}"/>
    </Style>
    <Style x:Key="MetricWarningTileStyle" TargetType="Border" BasedOn="{StaticResource MetricTileStyle}">
        <Setter Property="controls:SurfaceMaterial.Foreground" Value="{DynamicResource AccentWarningSubtleForeground}"/>
    </Style>
    <Style x:Key="MetricDangerTileStyle" TargetType="Border" BasedOn="{StaticResource MetricTileStyle}">
        <Setter Property="controls:SurfaceMaterial.Foreground" Value="{DynamicResource AccentDangerSubtleForeground}"/>
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="MetricCompactValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricCompactValueStyle}">
        <Setter Property="FontSize" Value="{StaticResource Type.Metric.Secondary}"/>
    </Style>
    <Style x:Key="MetricPrimaryValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
        <Setter Property="FontSize" Value="{StaticResource Type.Metric.Primary}"/>
    </Style>
    <Style x:Key="HistoryStatusChipStyle" TargetType="{x:Type Border}">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
        <Setter Property="Padding" Value="{x:Static controls:StatusChipMetrics.Padding}"/>
        <Setter Property="MinHeight" Value="{x:Static controls:StatusChipMetrics.Height}"/>
        <Setter Property="CornerRadius" Value="{x:Static controls:StatusChipMetrics.CornerRadius}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="HistoryStatusChipTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{x:Static controls:StatusChipMetrics.FontSize}"/>
        <Setter Property="FontWeight" Value="{x:Static controls:StatusChipMetrics.TextWeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>


    <!-- Available before Chrome.xaml resolves BasedOn styles; prevents framework-theme fallback. -->
    <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
                <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="behaviors:CheckBoxCheckMotionBehavior.IsEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <!-- Finite form columns constrain labels; horizontal tool rows still measure intrinsically. -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="CheckBoxBorder"
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Path x:Name="CheckGlyph"
                                          Data="M 2,5.5 L 5.5,9 L 12,2.5"
                                          Stroke="{DynamicResource TextColor}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0"
                                          StrokeDashArray="{StaticResource CheckGlyphDashArray}"
                                          StrokeDashOffset="{StaticResource CheckGlyphPathLength}"/>
                                </controls:SurfaceMaterialBorder>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
</ResourceDictionary>
