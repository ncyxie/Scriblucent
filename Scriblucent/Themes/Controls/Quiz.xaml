<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Scriblucent;component/Themes/Controls/Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Letter chip defaults: circle for single/TF; MultipleChoice trigger makes rounded square. -->
    <Style x:Key="QuizOptionLetterChipBaseStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Letter chip on option rows: white well on gray row; selection / submit states via bindings. -->
    <Style x:Key="QuizOptionLetterChipStyle" TargetType="Border" BasedOn="{StaticResource QuizOptionLetterChipBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Parent.Type}" Value="MultipleChoice">
                <Setter Property="CornerRadius" Value="6"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentRimBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSuccessSubtle}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIncorrectSelectedAfterSubmit}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentDangerSubtle}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Base option row chrome for take mode (imperative selection) and preview. -->
    <Style x:Key="QuizOptionButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="OptionBorder"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Standard" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="OptionBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </controls:InteractionSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preview/editor: selection + post-submit success/danger via QuizPreviewOption bindings. -->
    <Style x:Key="QuizOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizOptionButtonBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSuccessSubtle}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentSuccessSubtleForeground}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIncorrectSelectedAfterSubmit}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentDangerSubtle}"/>
                <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentDangerSubtleForeground}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Question jump chips; review status and current position use independent paint. -->
    <Style x:Key="QuizNavQuestionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="NavChipBorder"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{TemplateBinding controls:InteractionSurface.HoverBackground}" PressedBackground="{TemplateBinding controls:InteractionSurface.PressedBackground}" x:Name="NavChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </controls:InteractionSurface>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
