<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
                    xmlns:icons="clr-namespace:Scriblucent.Icons"
                    xmlns:controls="clr-namespace:Scriblucent.Controls"
                    xmlns:converters="clr-namespace:Scriblucent.Converters">

    <converters:GroupAccentConverter x:Key="GroupAccentConverter"/>
    <converters:DashboardSectionMoveConverter x:Key="DashboardSectionMoveConverter"/>
    <Style x:Key="GroupDisclosureButtonStyle" TargetType="Button" BasedOn="{StaticResource DashboardDisclosureButtonStyle}">
        <Setter Property="Width" Value="{StaticResource Control.Size.Reorder}"/>
        <Setter Property="Height" Value="{StaticResource Control.Size.Reorder}"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="ToolTip" Value="{Binding [CollapseGroup], Source={StaticResource Loc}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:DashboardGroupHeader}}" Value="False">
                <Setter Property="ToolTip" Value="{Binding [ExpandGroup], Source={StaticResource Loc}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DashboardGroupHeaderStyle" TargetType="controls:DashboardGroupHeader">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="{DynamicResource ContentInsetSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.SectionTitle}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DashboardGroupHeader">
                    <controls:DashboardGroupHeaderPanel>
                        <Border x:Name="GroupActionsTray" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                        </Border>
                        <controls:DashboardGroupTitlePanel x:Name="TitleArea" Title="{TemplateBinding Header}" ItemCount="{TemplateBinding ItemCount}">
                            <Border x:Name="TitleWash" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Control}">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource GroupAccentConverter}" ConverterParameter="Wash">
                                        <Binding Path="GroupBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <Grid x:Name="TitleContent" Margin="8,0" UseLayoutRounding="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="18" CornerRadius="2" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource GroupAccentConverter}">
                                            <Binding Path="GroupBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="GroupName" Grid.Column="2" Text="{TemplateBinding Header}"
                                           FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Header}"/>
                                <TextBlock x:Name="GroupCount" Grid.Column="3" Text="{Binding ItemCount, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{StaticResource Type.Meta}" Foreground="{DynamicResource TextColorSecondary}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </controls:DashboardGroupTitlePanel>
                    </controls:DashboardGroupHeaderPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DashboardRevealIconStyle" TargetType="{x:Type icons:AppIcon}">
        <Setter Property="behaviors:IndicatorRevealMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="DashboardPinIconStyle" TargetType="{x:Type icons:AppIcon}" BasedOn="{StaticResource DashboardRevealIconStyle}">
        <Setter Property="behaviors:IndicatorRevealMotionBehavior.SourceProperty" Value="IsPinned"/>
        <Setter Property="Kind" Value="Pin"/>
    </Style>
    <Style x:Key="DashboardScheduleIconStyle" TargetType="{x:Type icons:AppIcon}" BasedOn="{StaticResource DashboardRevealIconStyle}">
        <Setter Property="behaviors:IndicatorRevealMotionBehavior.SourceProperty" Value="HasSchedule"/>
        <Setter Property="Kind" Value="Schedule"/>
    </Style>

    <Style x:Key="DashboardTagChipStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource TagChipBackground}"/>
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="behaviors:TagChipMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Visibility" Value="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
    </Style>

    <Style x:Key="DashboardTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
        <Setter Property="Foreground" Value="{DynamicResource TagChipForeground}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="DashboardSectionToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource DashboardDisclosureButtonStyle}"/>


    <Style x:Key="SortOptionRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="behaviors:RadioButtonSelectionMotionBehavior.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral" x:Name="RadioButtonBorder"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Ellipse x:Name="RadioGlyph"
                                     Width="6"
                                     Height="6"
                                     Fill="{DynamicResource TextColor}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0"/>
                        </controls:SurfaceMaterialBorder>
                        <ContentPresenter Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioButtonBorder" Property="BorderBrush" Value="{DynamicResource TextColor}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioButtonBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter TargetName="RadioButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- moved from MainWindow: RecentItemsStripPanelTemplate -->
<ItemsPanelTemplate x:Key="RecentItemsStripPanelTemplate">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Shell.RecentStripInsets}"/>
        </ItemsPanelTemplate>

    <!-- moved from MainWindow: RecentStripItemsStyle -->
<Style x:Key="RecentStripItemsStyle" TargetType="ItemsControl">
            <Setter Property="behaviors:RecentStripEnterMotionBehavior.IsEnabled" Value="True"/>
        </Style>

    <!-- moved from MainWindow: RecentItemsStripScrollViewerStyle -->
    <Style x:Key="RecentItemsStripScrollViewerStyle" TargetType="ScrollViewer">
            <!-- Compact recent cards stay live: the separately drawn scroll tiles differ
                 from their content-sized WPF templates and visibly resize on handoff. -->
            <Setter Property="behaviors:ScrollTileBehavior.IsEnabled" Value="False"/>
            <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="True"/>
            <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="CanContentScroll" Value="False"/>
            <Setter Property="PanningMode" Value="HorizontalOnly"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="behaviors:MiddleClickScrollBehavior.IsEnabled" Value="True"/>
        </Style>

    <!-- moved from MainWindow: DashboardListingScrollViewerStyle -->
    <Style x:Key="DashboardListingScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="behaviors:ScrollBarAutoHideBehavior.Enable" Value="True"/>
            <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- Padding scrolls away with content; margin + rounded clip keep a sticky viewport frame. -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="{StaticResource Shell.DashboardPadding}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="behaviors:RoundedClipBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:RoundedClipBehavior.CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="behaviors:MiddleClickScrollBehavior.IsEnabled" Value="True"/>
        </Style>

    <!-- Level 4 D: CardShadowLayer + NoteCardBorder R(theme); focus A (2px). -->
    <Style x:Key="RecentNoteCardStyle" TargetType="Button">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="behaviors:CommandLightBehavior.Role" Value="Item"/>
        <Setter Property="behaviors:CommandLightBehavior.IsEnabled" Value="False"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="RecentCard"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="CardBorder"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.ShadowElementName" Value="CardShadow"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="Padding" Value="11,8"/>
			<Setter Property="Margin" Value="0,5,7,5"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid ClipToBounds="False">
							<controls:CardShadowLayer x:Name="CardShadow"/>
							<controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" x:Name="CardBorder"
									Background="{TemplateBinding Background}"
									PressedBackground="{DynamicResource SelectionBackground}"
									BorderBrush="{DynamicResource NoteCardBorder}"
									BorderThickness="1"
									CornerRadius="{StaticResource Radius.Control}"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
							</controls:InteractionSurface>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="CardBorder" Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="CardBorder" Property="behaviors:SelectionRimBehavior.IsSelected" Value="True"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

    <!-- Nested calendar-rail event cards (inside rounded/clipped tray):
         no DropShadow — parent RoundedClip/ClipToBounds was clipping Elevation.Card unevenly
         so some rows looked raised and others flat. Lift comes from CardBackground on the tray
         (+ theme NoteCardBorder on dark). Hover uses the shared item wash and pointer light; press stays compact. -->
    <Style x:Key="CalendarScheduledItemCardStyle" TargetType="Border">
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
        <Setter Property="behaviors:StateSurfaceMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource NoteCardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
			<Setter Property="Padding" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Effect" Value="{x:Null}"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ButtonPressMotionBehavior.PressedBackground" Value="{DynamicResource CalendarPressedBackground}"/>
		</Style>

    <!-- moved from MainWindow: FabStyle -->
<Style x:Key="FabStyle" TargetType="Button">
    <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.IsEnabled" Value="True"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.Profile" Value="Fab"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.MotionHostName" Value="FabBorder"/>
			<Setter Property="behaviors:ChromeHoverMotionBehavior.ShadowElementName" Value="FabShadow"/>
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
			<Setter Property="FontSize" Value="{StaticResource Type.Display}"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="{StaticResource Control.Size.Creation}"/>
			<Setter Property="Height" Value="{StaticResource Control.Size.Creation}"/>
			<Setter Property="Margin" Value="0,0,40,36"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Grid x:Name="FabBorder">
							<controls:BakedElevationLayer x:Name="FabShadow" Kind="ButtonCard" Opacity="0.20"/>
							<controls:InteractionSurface Role="Compact" controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" x:Name="FabFace"
									Background="{TemplateBinding Background}"
									BorderBrush="Transparent"
									BorderThickness="0"
									CornerRadius="{StaticResource Radius.Card}">
								<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												  RecognizesAccessKey="True"/>
							</controls:InteractionSurface>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="FabFace" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="FabFace" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
							</Trigger>
						   <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="FabFace" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="FabFace" Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
								<Setter TargetName="FabBorder" Property="Opacity" Value="0.62"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Cursor" Value="Arrow"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

</ResourceDictionary>

