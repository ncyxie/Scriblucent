                <ControlTemplate TargetType="Button">
                    <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" x:Name="SwatchBorder" Role="Compact" HighlightWash="Transparent" HighlightEdge="{DynamicResource AccentPrimary}"
