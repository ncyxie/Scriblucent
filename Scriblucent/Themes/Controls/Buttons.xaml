    <Style x:Key="ChromeDangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
        <Setter Property="controls:InteractionSurface.HighlightWash" Value="{DynamicResource DangerControlHoverWash}"/>
        <Setter Property="controls:InteractionSurface.HighlightEdge" Value="{DynamicResource AccentDanger}"/>
        <Setter Property="controls:InteractionSurface.HoverBackground" Value="{DynamicResource AccentDangerHover}"/>
        <Setter Property="controls:InteractionSurface.PressedBackground" Value="{DynamicResource AccentDangerPressed}"/>
