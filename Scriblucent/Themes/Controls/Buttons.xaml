    <Style x:Key="EditorPrimarySaveButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
        <Setter Property="controls:InteractionSurface.Role" Value="Prominent"/>
        <Setter Property="controls:InteractionSurface.HighlightWash" Value="{DynamicResource FilledControlHoverWash}"/>
        <Setter Property="controls:InteractionSurface.HighlightEdge" Value="{DynamicResource FilledControlHoverEdge}"/>
        <Setter Property="controls:InteractionSurface.HoverBackground" Value="{DynamicResource AccentPrimaryHover}"/>
        <Setter Property="controls:InteractionSurface.PressedBackground" Value="{DynamicResource AccentPrimaryPressed}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="SaveButtonBorder"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="{StaticResource Type.SectionTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
        <Setter Property="controls:SurfaceMaterial.Kind" Value="Filled"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <controls:BakedElevationLayer x:Name="ButtonShadow" Kind="Button" Opacity="0" IsHitTestVisible="False"/>
                    <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" x:Name="SaveButtonBorder"
                            Role="{TemplateBinding controls:InteractionSurface.Role}"
                            HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}"
                            HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}"
                            HoverBackground="{TemplateBinding controls:InteractionSurface.HoverBackground}"
                            PressedBackground="{TemplateBinding controls:InteractionSurface.PressedBackground}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </controls:InteractionSurface>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorSideToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
