<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The same 22 DIP native hit target and corner/edge anchors for inline and floating photos. -->
    <Style x:Key="ImageResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent" Width="22" Height="22">
                <Path x:Name="Contrast" Data="{Binding Data, ElementName=Handle}"
                      Stroke="{DynamicResource EditHandleContrast}" StrokeThickness="4.25"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      IsHitTestVisible="False"/>
                <Path x:Name="Handle" Stroke="{DynamicResource AccentRimBrush}" StrokeThickness="2.25"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="TL"><Setter TargetName="Handle" Property="Data" Value="M 3,11 L 11,11 L 11,3"/></Trigger>
                <Trigger Property="Tag" Value="TR"><Setter TargetName="Handle" Property="Data" Value="M 19,11 L 11,11 L 11,3"/></Trigger>
                <Trigger Property="Tag" Value="BR"><Setter TargetName="Handle" Property="Data" Value="M 19,11 L 11,11 L 11,19"/></Trigger>
                <Trigger Property="Tag" Value="BL"><Setter TargetName="Handle" Property="Data" Value="M 3,11 L 11,11 L 11,19"/></Trigger>
                <Trigger Property="Tag" Value="T">
                    <Setter TargetName="Handle" Property="Data" Value="M 5.5,11 L 16.5,11"/>
                    <Setter TargetName="Handle" Property="StrokeThickness" Value="3"/>
                    <Setter TargetName="Contrast" Property="StrokeThickness" Value="5"/>
                </Trigger>
                <Trigger Property="Tag" Value="B">
                    <Setter TargetName="Handle" Property="Data" Value="M 5.5,11 L 16.5,11"/>
                    <Setter TargetName="Handle" Property="StrokeThickness" Value="3"/>
                    <Setter TargetName="Contrast" Property="StrokeThickness" Value="5"/>
                </Trigger>
                <Trigger Property="Tag" Value="L">
                    <Setter TargetName="Handle" Property="Data" Value="M 11,5.5 L 11,16.5"/>
                    <Setter TargetName="Handle" Property="StrokeThickness" Value="3"/>
                    <Setter TargetName="Contrast" Property="StrokeThickness" Value="5"/>
                </Trigger>
                <Trigger Property="Tag" Value="R">
                    <Setter TargetName="Handle" Property="Data" Value="M 11,5.5 L 11,16.5"/>
                    <Setter TargetName="Handle" Property="StrokeThickness" Value="3"/>
                    <Setter TargetName="Contrast" Property="StrokeThickness" Value="5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
