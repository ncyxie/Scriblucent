<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window and Container Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F7F7FA"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#ECECF1"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E6"/>
    <!-- Shadow-first inputs: invisible rest edge in light; focus uses NoteCardSelectionBorder. -->
    <SolidColorBrush x:Key="InputRestBorder" Color="#00000000"/>
    <SolidColorBrush x:Key="SidebarSeparator" Color="#B4B4C0"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextColor" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TextColorSecondary" Color="#5C5C5C"/>

    <!-- Card/Note Colors -->
    <SolidColorBrush x:Key="NoteCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoteCardBorder" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="NoteCardTitle" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="NoteCardSelection" Color="#F2F6FF"/>
    <SolidColorBrush x:Key="NoteCardSelectionBorder" Color="#3E5FC3"/>

    <!-- Flashcard Colors -->
    <SolidColorBrush x:Key="FlashcardCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBackground" Color="#F8FAFF"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBackground" Color="#F2F6FF"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedHoverBackground" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="FlashcardCardBorder" Color="#C9D0DB"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBorder" Color="#A0B4E0"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBorder" Color="#3F6FE8"/>
    <SolidColorBrush x:Key="FlashcardSideChipBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="FlashcardSideChipBorder" Color="#DDE4F3"/>
    <SolidColorBrush x:Key="FlashcardSideChipForeground" Color="#4B5568"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBackground" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBorder" Color="#C9D8FF"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipForeground" Color="#2D4F9C"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBackground" Color="#E8F8F0"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBorder" Color="#B7E6CC"/>
    <SolidColorBrush x:Key="FlashcardKnownChipForeground" Color="#096B3F"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBackground" Color="#FFF4E0"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBorder" Color="#F6D28B"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipForeground" Color="#8A5200"/>
    <SolidColorBrush x:Key="FlashcardNewChipBackground" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="FlashcardNewChipBorder" Color="#D8DEE8"/>
    <SolidColorBrush x:Key="FlashcardNewChipForeground" Color="#485365"/>

    <!-- Button Colors -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#E4E8F2"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#C5CDDC"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#2B3650"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#D7DEF0"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#C9D3E8"/>

    <!-- Icon Button Colors -->
    <SolidColorBrush x:Key="IconButtonBackground" Color="#E4E8F2"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="#C5CDDC"/>
    <SolidColorBrush x:Key="IconButtonForeground" Color="#2B3650"/>
    <SolidColorBrush x:Key="IconButtonHoverBackground" Color="#D7DEF0"/>
    <SolidColorBrush x:Key="IconButtonPressedBackground" Color="#C9D3E8"/>
    <SolidColorBrush x:Key="EditorToolActiveBackground" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="EditorToolActiveBorder" Color="#8FB1FF"/>
    <SolidColorBrush x:Key="EditorToolActiveForeground" Color="#1F4EA8"/>

    <!-- Mass Select Colors -->
    <SolidColorBrush x:Key="MassSelectBoxBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="MassSelectBoxBorder" Color="#DDE4F3"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBackground" Color="#4A6EE0"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBorder" Color="#3D5FC7"/>
    <SolidColorBrush x:Key="MassSelectBoxGlyph" Color="#FFFFFF"/>

    <!-- Selection/Hover Colors -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="DropdownItemHoverBackground" Color="#E8EEFF"/>
    <SolidColorBrush x:Key="DropdownItemHoverBorder" Color="#C5D4F5"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#EBEBEF"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#8F8F97"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#73737C"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#5E5E68"/>

    <!-- Mind map search highlight colors -->
    <SolidColorBrush x:Key="MindMapSearchMatchBorderBrush" Color="#EAA43A"/>
    <SolidColorBrush x:Key="MindMapSearchActiveBorderBrush" Color="#DA6A21"/>
    <SolidColorBrush x:Key="MindMapConnectionBrush" Color="#94A4C2"/>
    <SolidColorBrush x:Key="MindMapSelectedBorderBrush" Color="#4A6EE0"/>

    <!-- RichTextBox Colors -->
    <SolidColorBrush x:Key="RichTextBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RichTextBoxForeground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#3F6FE8"/>
    <SolidColorBrush x:Key="EditorFindMatchBackground" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="EditorFindActiveMatchBackground" Color="#FBBF24"/>

</ResourceDictionary>
