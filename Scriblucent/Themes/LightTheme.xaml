<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window and Container Colors
         Main dashboard: WindowBackground + SidebarBackground unchanged.
         Feature windows only (note/mind-map/quiz editors):
           FeatureFrameBackground  outer ring (slightly deeper)
           FeatureStageBackground  content plate under white fields
           InputSurface / cards    pure white -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F7F7FA"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#ECECF1"/>
    <SolidColorBrush x:Key="FeatureFrameBackground" Color="#DEDEE8"/>
    <SolidColorBrush x:Key="FeatureStageBackground" Color="#E9E9F0"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputSurface" Color="#FFFFFF"/>
    <!-- Generic hairline (checkboxes, rare non-elevated chrome). -->
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E6"/>
    <!-- Fields light: no rest stroke (thickness 0). Focus ring is an adorner (FieldFocusRingBehavior)
         so title/fields never layout-shift or optically shrink when focused. -->
    <SolidColorBrush x:Key="InputRestBorder" Color="#FFFFFF"/>
    <Thickness x:Key="Field.RestBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="SidebarSeparator" Color="#B4B4C0"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextColor" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TextColorSecondary" Color="#5C5C5C"/>

    <!-- Brand wordmark URI is registered in ThemeManager (sys:Uri XAML parses as String on .NET). -->
    <SolidColorBrush x:Key="AboutStageBase" Color="#F4F5FC"/>
    <SolidColorBrush x:Key="AboutStageForeground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="AboutStageMuted" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="AboutStageCloseFill" Color="#18000000"/>
    <SolidColorBrush x:Key="AboutStageCloseBorder" Color="#14000000"/>
    <LinearGradientBrush x:Key="AboutStageBottomFade" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00F4F5FC" Offset="0"/>
        <GradientStop Color="#CCF4F5FC" Offset="0.55"/>
        <GradientStop Color="#FFF4F5FC" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AboutStageMeshA" Center="0.12,0.18" GradientOrigin="0.12,0.18" RadiusX="0.78" RadiusY="0.92">
        <GradientStop Color="#59435CEC" Offset="0"/>
        <GradientStop Color="#00435CEC" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AboutStageMeshB" Center="0.88,0.22" GradientOrigin="0.88,0.22" RadiusX="0.72" RadiusY="0.86">
        <GradientStop Color="#4A7B8CFF" Offset="0"/>
        <GradientStop Color="#007B8CFF" Offset="1"/>
    </RadialGradientBrush>

    <!-- Semantic accents (brand blue #435CEC + derived hover / pressed / subtle) -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#435CEC"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="#3A4FD4"/>
    <SolidColorBrush x:Key="AccentPrimaryPressed" Color="#3142B8"/>
    <SolidColorBrush x:Key="AccentPrimaryForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentPrimarySubtle" Color="#EEF0FE"/>

    <SolidColorBrush x:Key="AccentDanger" Color="#DC2626"/>
    <SolidColorBrush x:Key="AccentDangerHover" Color="#C92222"/>
    <SolidColorBrush x:Key="AccentDangerPressed" Color="#A91B1B"/>
    <SolidColorBrush x:Key="AccentDangerForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentDangerSubtle" Color="#F6DEDE"/>
    <SolidColorBrush x:Key="AccentDangerSubtleHover" Color="#EFCACA"/>
    <SolidColorBrush x:Key="AccentDangerSubtleBorder" Color="#D7A6A6"/>
    <SolidColorBrush x:Key="AccentDangerSubtleForeground" Color="#9F2D2D"/>

    <SolidColorBrush x:Key="AccentWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentWarningHover" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentWarningPressed" Color="#B45309"/>
    <SolidColorBrush x:Key="AccentWarningForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentWarningSubtle" Color="#FFF9E6"/>
    <SolidColorBrush x:Key="AccentWarningSubtleBorder" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentWarningSubtleForeground" Color="#92400E"/>

    <SolidColorBrush x:Key="AccentSuccess" Color="#096B3F"/>
    <SolidColorBrush x:Key="AccentSuccessForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSuccessSubtle" Color="#E8F8F0"/>
    <SolidColorBrush x:Key="AccentSuccessSubtleBorder" Color="#B7E6CC"/>
    <SolidColorBrush x:Key="AccentSuccessSubtleForeground" Color="#096B3F"/>

    <SolidColorBrush x:Key="ProgressTrackBackground" Color="#D8DCE6"/>

    <!-- Tag chips (fill only — stroke role B, no border token) -->
    <SolidColorBrush x:Key="TagChipBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="TagChipForeground" Color="#4A5D80"/>

    <!-- Card/Note Colors — light: rest stroke off (shadow + surface); selection still uses NoteCardSelectionBorder. -->
    <SolidColorBrush x:Key="NoteCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NoteCardBorder" Color="#00000000"/>
    <SolidColorBrush x:Key="NoteCardTitle" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="NoteCardSelection" Color="#EEF0FE"/>
    <SolidColorBrush x:Key="NoteCardSelectionBorder" Color="#435CEC"/>

    <!-- Flashcard Colors -->
    <SolidColorBrush x:Key="FlashcardCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FlashcardCardHoverBackground" Color="#F7F8FE"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBackground" Color="#EEF0FE"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedHoverBackground" Color="#E8EBFD"/>
    <SolidColorBrush x:Key="FlashcardCardBorder" Color="#00000000"/>
    <SolidColorBrush x:Key="FlashcardCardSelectedBorder" Color="#435CEC"/>
    <SolidColorBrush x:Key="FlashcardSideChipBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="FlashcardSideChipBorder" Color="#DDE4F3"/>
    <SolidColorBrush x:Key="FlashcardSideChipForeground" Color="#4B5568"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBackground" Color="#EEF0FE"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipBorder" Color="#C5CBF8"/>
    <SolidColorBrush x:Key="FlashcardCategoryChipForeground" Color="#2E3FA8"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBackground" Color="#E8F8F0"/>
    <SolidColorBrush x:Key="FlashcardKnownChipBorder" Color="#B7E6CC"/>
    <SolidColorBrush x:Key="FlashcardKnownChipForeground" Color="#096B3F"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBackground" Color="#FFF4E0"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipBorder" Color="#F6D28B"/>
    <SolidColorBrush x:Key="FlashcardUnknownChipForeground" Color="#8A5200"/>
    <SolidColorBrush x:Key="FlashcardNewChipBackground" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="FlashcardNewChipBorder" Color="#D8DEE8"/>
    <SolidColorBrush x:Key="FlashcardNewChipForeground" Color="#485365"/>

    <!-- Button Colors (alias IconButton family — one button surface system) -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#E4E8F2"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#C5CDDC"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#2B3650"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#D7DEF0"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#C9D3E8"/>

    <!-- Icon Button Colors -->
    <SolidColorBrush x:Key="IconButtonBackground" Color="#E4E8F2"/>
    <SolidColorBrush x:Key="IconButtonBorder" Color="#C5CDDC"/>
    <SolidColorBrush x:Key="IconButtonForeground" Color="#2B3650"/>
    <SolidColorBrush x:Key="IconButtonHoverBackground" Color="#D7DEF0"/>
    <SolidColorBrush x:Key="IconButtonPressedBackground" Color="#C9D3E8"/>
    <SolidColorBrush x:Key="EditorToolActiveBackground" Color="#EEF0FE"/>
    <SolidColorBrush x:Key="EditorToolActiveBorder" Color="#8B96F0"/>
    <SolidColorBrush x:Key="EditorToolActiveForeground" Color="#2E3FA8"/>

    <!-- Mass Select Colors -->
    <SolidColorBrush x:Key="MassSelectBoxBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="MassSelectBoxBorder" Color="#DDE4F3"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBackground" Color="#435CEC"/>
    <SolidColorBrush x:Key="MassSelectBoxCheckedBorder" Color="#3A4FD4"/>
    <SolidColorBrush x:Key="MassSelectBoxGlyph" Color="#FFFFFF"/>

    <!-- Selection/Hover Colors -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="DropdownItemHoverBackground" Color="#E8EBFD"/>
    <SolidColorBrush x:Key="DropdownItemHoverBorder" Color="#C5CBF8"/>
    <!-- Calendar-only: soft brand wash (global HoverBackground is too close to white surfaces). -->
    <SolidColorBrush x:Key="CalendarHoverBackground" Color="#E4E8FB"/>
    <SolidColorBrush x:Key="CalendarPressedBackground" Color="#D5DBF8"/>
    <!-- Floating menus / dropdowns: soft edge so white panels separate from light page chrome. -->
    <SolidColorBrush x:Key="PopupBorder" Color="#D0D0DC"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="#EBEBEF"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#8F8F97"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#73737C"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#5E5E68"/>

    <!-- Mind map search highlight colors -->
    <SolidColorBrush x:Key="MindMapSearchMatchBorderBrush" Color="#EAA43A"/>
    <SolidColorBrush x:Key="MindMapSearchActiveBorderBrush" Color="#DA6A21"/>
    <SolidColorBrush x:Key="MindMapConnectionBrush" Color="#94A4C2"/>
    <SolidColorBrush x:Key="MindMapSelectedBorderBrush" Color="#435CEC"/>
    <!-- Root outlines the root node's fill, which is brand-accent blue and invariant across themes. -->
    <SolidColorBrush x:Key="MindMapNodeRootBorderBrush" Color="#2F5CD0"/>
    <SolidColorBrush x:Key="MindMapNodeBorderBrush" Color="#C2CBDC"/>

    <!-- RichTextBox Colors -->
    <SolidColorBrush x:Key="RichTextBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RichTextBoxForeground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#435CEC"/>
    <SolidColorBrush x:Key="EditorFindMatchBackground" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="EditorFindActiveMatchBackground" Color="#FBBF24"/>

</ResourceDictionary>
