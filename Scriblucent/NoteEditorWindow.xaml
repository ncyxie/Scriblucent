<Window x:Class="Scriblucent.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [NoteEditorTitle], Source={StaticResource Loc}}"
        Height="600"
        Width="980"
        MinHeight="520"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FeatureFrameBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="NoteEditorWindow_Closing">
    <Window.Resources>
        <!-- EditorToolButtonBaseStyle/EditorToolIconButtonStyle/EditorDangerToolButtonStyle/
             EditorToolSearchInputStyle/EditorPrimarySaveButtonStyle/EditorSideToolButtonStyle now
             live in Themes/Controls/Buttons.xaml (shared with MindMapPreviewWindow chrome). -->
        <Style x:Key="EditorRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="Background" Value="{DynamicResource RichTextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource RichTextBoxForeground}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource RichTextBoxForeground}"/>
        </Style>

        <Style x:Key="EditorFontComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ChromeComboBoxStyle}">
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform Y="12"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="FontPanelRow" Height="0"/>
            <RowDefinition x:Name="FindReplaceRow" Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="{StaticResource Shell.FeatureTitleRowPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="StatusIndicatorRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fixed left anchor: the button is the FIRST child of this left-aligned
                     horizontal flow, so its position is invariant - it never moves regardless of
                     how long the status text next to it is. (Putting the button after the text
                     instead would make its position a function of the text's length - exactly
                     the "uncontrollable" placement this avoids.) -->
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="2,0,0,4">
                    <Button x:Name="AiCancelButton"
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource EditorDangerToolButtonStyle}"
                            Content="{icons:Icon Kind=Close, Size=10}"
                            ToolTip="Cancel"
                            Visibility="Collapsed"
                            Click="AiCancelButton_Click"/>

                    <TextBlock x:Name="StatusIndicatorText"
                               MaxWidth="320"
                               FontSize="{StaticResource Type.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Column="0"
                        Grid.Row="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChromeTitleFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.DialogTitle}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [NoteEditorTitle], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- White chrome strip matching title field (InputSurface + field elevation; no focus ring). -->
                <Grid Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch">
                <controls:BakedElevationLayer Kind="Field"/>
                <Border Background="{DynamicResource InputSurface}"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="8,6"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- History -->
                        <Button Content="{icons:Icon Undo}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Undo], Source={StaticResource Loc}}"
                                Click="UndoButton_Click"/>
                        <Button Content="{icons:Icon Redo}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Redo], Source={StaticResource Loc}}"
                                Click="RedoButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- Find -->
                        <Button x:Name="SearchButton"
                                Content="{icons:Icon Search}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Search], Source={StaticResource Loc}}"
                                Click="SearchButton_Click"/>
                        <Button Content="{icons:Icon History}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [EditHistory], Source={StaticResource Loc}}"
                                Click="EditHistoryButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- Tools -->
                        <Button x:Name="FontButton"
                                Content="{icons:Icon Font}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Font], Source={StaticResource Loc}}"
                                Click="FontSettings_Click"/>
                        <Button x:Name="ConvertMenuButton"
                                Content="{icons:Icon AiGenerated}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [AiConvertTooltip], Source={StaticResource Loc}}"
                                Click="ConvertMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem x:Name="ConvertAiReviewMenuItem"
                                              IsHitTestVisible="True"
                                              Focusable="False"
                                              StaysOpenOnClick="True">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Border Margin="4,4,4,2">
                                                    <controls:AiReviewNotice MinWidth="248"
                                                                             AllowDismiss="True"
                                                                             Dismissed="ConvertAiReviewNotice_Dismissed"/>
                                                </Border>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>
                                    <Separator x:Name="ConvertAiReviewSeparator"/>
                                    <MenuItem Header="{Binding [ConvertToFlashcards], Source={StaticResource Loc}}"
                                              ToolTip="{Binding [AiConvertTooltip], Source={StaticResource Loc}}"
                                              Click="ConvertToFlashcardsButton_Click"/>
                                    <MenuItem Header="{Binding [ConvertToMindMap], Source={StaticResource Loc}}"
                                              ToolTip="{Binding [AiConvertTooltip], Source={StaticResource Loc}}"
                                              Click="ConvertToMindMapButton_Click"/>
                                    <MenuItem Header="{Binding [ConvertToTest], Source={StaticResource Loc}}"
                                              ToolTip="{Binding [AiConvertTooltip], Source={StaticResource Loc}}"
                                              Click="ConvertToTestButton_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding [StudyCoverage], Source={StaticResource Loc}}">
                                        <MenuItem x:Name="StudyCoverageAutoMenuItem"
                                                  Header="{Binding [StudyCoverageAuto], Source={StaticResource Loc}}"
                                                  Tag="Auto"
                                                  IsCheckable="True"
                                                  Click="StudyCoverageMenuItem_Click"/>
                                        <MenuItem x:Name="StudyCoverageBalancedMenuItem"
                                                  Header="{Binding [StudyCoverageBalanced], Source={StaticResource Loc}}"
                                                  Tag="Balanced"
                                                  IsCheckable="True"
                                                  Click="StudyCoverageMenuItem_Click"/>
                                        <MenuItem x:Name="StudyCoverageThoroughMenuItem"
                                                  Header="{Binding [StudyCoverageThorough], Source={StaticResource Loc}}"
                                                  Tag="Thorough"
                                                  IsCheckable="True"
                                                  Click="StudyCoverageMenuItem_Click"/>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FileMenuButton"
                                Content="{icons:Icon FolderOpen}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [File], Source={StaticResource Loc}}"
                                Click="FileMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                                              Click="OpenFromFileButton_Click"/>
                                    <MenuItem Header="{Binding [Print], Source={StaticResource Loc}}"
                                              Click="PrintButton_Click"/>
                                    <MenuItem Header="{Binding [Export], Source={StaticResource Loc}}">
                                        <MenuItem Header="{Binding [ExportPdf], Source={StaticResource Loc}}"
                                                  Click="ExportPdfButton_Click"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding [ExportNotePackage], Source={StaticResource Loc}}"
                                                  Click="ExportNotePackageMenuItem_Click"/>
                                        <MenuItem Header="{Binding [ExportRtf], Source={StaticResource Loc}}"
                                                  Click="ExportRtfMenuItem_Click"/>
                                        <MenuItem Header="{Binding [ExportText], Source={StaticResource Loc}}"
                                                  Click="ExportTextMenuItem_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="{Binding [InsertPicture], Source={StaticResource Loc}}"
                                              Click="InsertPictureButton_Click"/>
                                    <MenuItem Header="{Binding [InsertSketch], Source={StaticResource Loc}}"
                                              Click="InsertSketchButton_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- View -->
                        <Button x:Name="WordWrapButton"
                                Content="{icons:Icon WordWrap}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [ToggleWordWrap], Source={StaticResource Loc}}"
                                Click="ToggleWordWrap_Click"/>
                        <Button x:Name="ZoomMenuButton"
                                Content="{icons:Icon ZoomIn}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Zoom], Source={StaticResource Loc}}"
                                Click="ZoomMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{Binding [ZoomIn], Source={StaticResource Loc}}"
                                              Click="ZoomInButton_Click"/>
                                    <MenuItem Header="{Binding [ZoomOut], Source={StaticResource Loc}}"
                                              Click="ZoomOutButton_Click"/>
                                    <MenuItem Header="{Binding [ZoomReset], Source={StaticResource Loc}}"
                                              Click="ZoomResetButton_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- Danger -->
                        <Button x:Name="ClearContentButton"
                                Content="{icons:Icon Delete}"
                                Width="32"
                                Height="32"
                                Margin="0,0,6,0"
                                Style="{StaticResource EditorDangerToolButtonStyle}"
                                ToolTip="{Binding [ClearContent], Source={StaticResource Loc}}"
                                Click="ClearContentButton_Click"/>
                        <Button x:Name="TagsPanelToggleButton"
                                Content="{icons:Icon Tag}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Tags], Source={StaticResource Loc}}"
                                Click="TagsPanelToggleButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- Persist -->
                        <Button Content="{icons:Icon Save}"
                                Style="{StaticResource EditorPrimarySaveButtonStyle}"
                                ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="TagsPanel"
                Grid.Row="1"
                Margin="20,4,20,0"
                Padding="10,0"
                Style="{StaticResource ChromeFieldBorderStyle}"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform Y="-6"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <Border x:Name="FontPanel"
                Grid.Row="2"
                Margin="20,8,20,0"
                Style="{StaticResource ChromePanelBorderStyle}"
                Padding="10,7"
                Visibility="Collapsed">
            <StackPanel>
            <WrapPanel VerticalAlignment="Center"
                       Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [FontLabel], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="FontFamilyBox"
                              Width="180"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="FontFamilyBox_Changed">
                        <ComboBoxItem Content="Calibri"/>
                        <ComboBoxItem Content="Segoe UI"/>
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Times New Roman"/>
                        <ComboBoxItem Content="Verdana"/>
                        <ComboBoxItem Content="Tahoma"/>
                        <ComboBoxItem Content="Georgia"/>
                        <ComboBoxItem Content="Trebuchet MS"/>
                        <ComboBoxItem Content="Cambria"/>
                        <ComboBoxItem Content="Garamond"/>
                        <ComboBoxItem Content="Consolas"/>
                    </ComboBox>

                    <TextBlock Text="{Binding [SizeLabel], Source={StaticResource Loc}}"
                               Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="FontSizeBox"
                              Width="80"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="FontSizeBox_Changed">
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="22"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="26"/>
                        <ComboBoxItem Content="28"/>
                        <ComboBoxItem Content="36"/>
                        <ComboBoxItem Content="48"/>
                        <ComboBoxItem Content="72"/>
                    </ComboBox>
                    <Button Content="{icons:Icon Kind=Minus, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="6,0,0,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [DecreaseFontSize], Source={StaticResource Loc}}"
                            Click="DecreaseFontSizeButton_Click"/>
                    <Button Content="{icons:Icon Kind=Plus, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="6,0,0,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [IncreaseFontSize], Source={StaticResource Loc}}"
                            Click="IncreaseFontSizeButton_Click"/>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [SpacingLabel], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="LineSpacingBox"
                              Width="80"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="LineSpacingBox_Changed">
                        <ComboBoxItem Content="1.0"/>
                        <ComboBoxItem Content="1.15"/>
                        <ComboBoxItem Content="1.5"/>
                        <ComboBoxItem Content="2.0"/>
                    </ComboBox>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [IndentLabel], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="IndentSizeBox"
                              Width="92"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              ToolTip="{Binding [IndentSize], Source={StaticResource Loc}}"
                              SelectionChanged="IndentSizeBox_Changed">
                        <ComboBoxItem Content="0.25 in" Tag="24"/>
                        <ComboBoxItem Content="0.5 in" Tag="48"/>
                        <ComboBoxItem Content="0.75 in" Tag="72"/>
                        <ComboBoxItem Content="1 in" Tag="96"/>
                        <ComboBoxItem Content="1.25 in" Tag="120"/>
                        <ComboBoxItem Content="1.5 in" Tag="144"/>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>

            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [TextStyleLabel], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <Button Content="{icons:Icon Kind=Bold, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Bold], Source={StaticResource Loc}}"
                            Click="ToggleBoldButton_Click"/>

                    <Button Content="{icons:Icon Kind=Italic, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Italic], Source={StaticResource Loc}}"
                            Click="ToggleItalicButton_Click"/>

                    <Button Content="{icons:Icon Kind=Underline, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Underline], Source={StaticResource Loc}}"
                            Click="ToggleUnderlineButton_Click"/>

                    <Button Content="{icons:Icon Kind=Strikethrough, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Strikethrough], Source={StaticResource Loc}}"
                            Click="ToggleStrikethroughButton_Click"/>

                    <Button x:Name="TextColorButton"
                            Content="{icons:Icon Kind=Color, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [TextColor], Source={StaticResource Loc}}"
                            Click="TextColorButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [SelectColor], Source={StaticResource Loc}}"
                                          Click="TextColorChooseMenuItem_Click"/>
                                <MenuItem Header="{Binding [ClearColor], Source={StaticResource Loc}}"
                                          Click="TextColorClearMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="HighlightButton"
                            Content="{icons:Icon Kind=Highlight, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Highlight], Source={StaticResource Loc}}"
                            Click="HighlightButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [SelectColor], Source={StaticResource Loc}}"
                                          Click="HighlightChooseMenuItem_Click"/>
                                <MenuItem Header="{Binding [ClearColor], Source={StaticResource Loc}}"
                                          Click="HighlightClearMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="{icons:Icon Kind=Clear, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [ClearFormatting], Source={StaticResource Loc}}"
                            Click="ClearFormattingButton_Click"/>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ListStyle], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <Button x:Name="BulletListButton"
                            Content="{icons:Icon Kind=Bullet, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            FontSize="{StaticResource Type.EmptyState}"
                            ToolTip="{Binding [BulletListStyle], Source={StaticResource Loc}}"
                            Click="BulletListButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [ListBulletDisc], Source={StaticResource Loc}}"
                                          Click="ListBulletDiscMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListBulletCircle], Source={StaticResource Loc}}"
                                          Click="ListBulletCircleMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListBulletSquare], Source={StaticResource Loc}}"
                                          Click="ListBulletSquareMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="NumberedListButton"
                            Content="{icons:Icon Kind=NumberedList, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [NumberedListStyle], Source={StaticResource Loc}}"
                            Click="NumberedListButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [ListNumberDecimal], Source={StaticResource Loc}}"
                                          Click="ListNumberDecimalMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListNumberLowerLatin], Source={StaticResource Loc}}"
                                          Click="ListNumberLowerLatinMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListNumberUpperRoman], Source={StaticResource Loc}}"
                                          Click="ListNumberUpperRomanMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="ChecklistButton"
                            Content="{icons:Icon Kind=Checklist, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Checklist], Source={StaticResource Loc}}"
                            Click="ChecklistButton_Click"/>

                    <Button x:Name="ListRemoveButton"
                            Content="{icons:Icon Kind=Close, Size=12}"
                            Width="32"
                            Height="32"
                            Margin="0"
                            Style="{StaticResource EditorDangerToolButtonStyle}"
                            FontSize="{StaticResource Type.BlockTitle}"
                            IsEnabled="False"
                            ToolTip="{Binding [ListRemove], Source={StaticResource Loc}}"
                            Click="ListRemoveButton_Click"/>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="10,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center"
                          Margin="0,0,6,0">
                        <Button x:Name="InsertTableButton"
                                Content="{icons:Icon Kind=Table, Size=15}"
                                Width="32"
                                Height="32"
                                Margin="0"
                                Style="{StaticResource EditorToolButtonBaseStyle}"
                                ToolTip="{Binding [InsertTable], Source={StaticResource Loc}}"
                                Click="InsertTableButton_Click"/>
                        <Popup x:Name="TableSizePickerPopup"
                               PlacementTarget="{Binding ElementName=InsertTableButton}"
                               Placement="Bottom"
                               HorizontalOffset="-28"
                               VerticalOffset="-24"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="None">
                            <Border Background="Transparent"
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <StackPanel Margin="10">
                                            <TextBlock x:Name="TableSizePickerLabel"
                                                       Text="{Binding [InsertTable], Source={StaticResource Loc}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="0,0,0,8"/>
                                            <UniformGrid x:Name="TableSizePickerGrid"
                                                         Columns="8"
                                                         Rows="8"
                                                         Width="176"
                                                         Height="176"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="InsertPictureButton"
                            Content="{icons:Icon Kind=Image, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [InsertPicture], Source={StaticResource Loc}}"
                            Click="InsertPictureButton_Click"/>
                    <Button x:Name="InsertCaptionButton"
                            Content="{icons:Icon Kind=Tag, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [InsertCaption], Source={StaticResource Loc}}"
                            Click="InsertCaptionButton_Click"/>
                    <Button x:Name="InsertLinkButton"
                            Content="{icons:Icon Kind=Link, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [InsertLink], Source={StaticResource Loc}}"
                            Click="InsertLinkButton_Click"/>
                    <Button x:Name="InsertSketchButton"
                            Content="{icons:Icon Kind=Pen, Size=15}"
                            Width="32"
                            Height="32"
                            Margin="0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Sketch], Source={StaticResource Loc}}"
                            Click="InsertSketchButton_Click"/>
                </StackPanel>
            </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="FindReplaceBar"
                Grid.Row="3"
                Margin="20,8,20,0"
                Background="Transparent"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource ChromeFieldBorderStyle}"
                            MinHeight="32"
                            Margin="0,0,8,0">
                        <TextBox x:Name="FindQueryBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.Meta}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding [FindLabel], Source={StaticResource Loc}}"
                                 TextChanged="FindQueryBox_TextChanged"
                                 PreviewKeyDown="FindQueryBox_PreviewKeyDown"/>
                    </Border>
                    <TextBlock x:Name="FindStatusText"
                               Grid.Column="1"
                               MinWidth="88"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               Text="{Binding [FindReplaceEnterSearch], Source={StaticResource Loc}}"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                    <controls:BakedElevationLayer Kind="Field"/>
                    <Border Background="{DynamicResource InputSurface}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="8,6"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FindPreviousButton"
                                    Style="{StaticResource EditorToolIconButtonStyle}"
                                    Content="{icons:Icon Kind=ArrowUp, Size=14}"
                                    ToolTip="{Binding [FindPrevious], Source={StaticResource Loc}}"
                                    Click="FindPreviousButton_Click"/>
                            <Button x:Name="FindNextButton"
                                    Style="{StaticResource EditorToolIconButtonStyle}"
                                    Content="{icons:Icon Kind=ArrowDown, Size=14}"
                                    ToolTip="{Binding [FindNext], Source={StaticResource Loc}}"
                                    Click="FindNextButton_Click"/>
                            <ToggleButton x:Name="FindMatchCaseToggle"
                                          Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                          Content="Aa"
                                          FontSize="{StaticResource Type.Caption}"
                                          ToolTip="{Binding [FindReplaceMatchCase], Source={StaticResource Loc}}"
                                          Checked="FindOptions_Changed"
                                          Unchecked="FindOptions_Changed"/>
                            <ToggleButton x:Name="FindWholeWordToggle"
                                          Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                          Content="ab"
                                          FontSize="{StaticResource Type.Caption}"
                                          ToolTip="{Binding [FindReplaceWholeWord], Source={StaticResource Loc}}"
                                          Checked="FindOptions_Changed"
                                          Unchecked="FindOptions_Changed"/>
                            <ToggleButton x:Name="FindWrapAroundToggle"
                                          Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                          IsChecked="True"
                                          Content="{icons:Icon Kind=Refresh, Size=14}"
                                          ToolTip="{Binding [FindReplaceWrapAround], Source={StaticResource Loc}}"
                                          Checked="FindOptions_Changed"
                                          Unchecked="FindOptions_Changed"/>
                            <ToggleButton x:Name="FindReplaceToggle"
                                          Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                          Content="{icons:Icon Kind=Swap, Size=14}"
                                          ToolTip="{Binding [ReplaceLabel], Source={StaticResource Loc}}"
                                          Checked="FindReplaceToggle_Changed"
                                          Unchecked="FindReplaceToggle_Changed"/>
                            <Button Style="{StaticResource EditorToolIconButtonStyle}"
                                    Margin="0"
                                    Content="{icons:Icon Kind=Close, Size=14}"
                                    ToolTip="{Binding [Close], Source={StaticResource Loc}}"
                                    Click="CloseFindBarButton_Click"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="FindReplaceReplaceRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource ChromeFieldBorderStyle}"
                            MinHeight="32"
                            Margin="0,0,8,0">
                        <TextBox x:Name="FindReplacementBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.Meta}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding [ReplaceLabel], Source={StaticResource Loc}}"
                                 TextChanged="FindReplacementBox_TextChanged"
                                 PreviewKeyDown="FindReplacementBox_PreviewKeyDown"/>
                    </Border>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                    <controls:BakedElevationLayer Kind="Field"/>
                    <Border Background="{DynamicResource InputSurface}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="8,6"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ReplaceButton"
                                    Style="{StaticResource EditorToolButtonBaseStyle}"
                                    Height="32"
                                    Padding="16,0"
                                    Margin="0,0,6,0"
                                    FontSize="{StaticResource Type.Caption}"
                                    Content="{Binding [Replace], Source={StaticResource Loc}}"
                                    Click="ReplaceButton_Click"/>
                            <Button x:Name="ReplaceAllButton"
                                    Style="{StaticResource EditorToolButtonBaseStyle}"
                                    Height="32"
                                    Padding="16,0"
                                    Margin="0"
                                    FontSize="{StaticResource Type.Caption}"
                                    Content="{Binding [ReplaceAll], Source={StaticResource Loc}}"
                                    Click="ReplaceAllButton_Click"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
              Margin="20,10,20,8"
              CornerRadius="{StaticResource Radius.Card}"
              Background="{DynamicResource RichTextBoxBackground}"
              BorderBrush="{DynamicResource InputRestBorder}"
              BorderThickness="{DynamicResource Field.RestBorderThickness}"
              behaviors:RoundedClipBehavior.IsEnabled="True"
              behaviors:FieldFocusRingBehavior.IsEnabled="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The zoom LayoutTransform applies to EditorSurface only - the scrollbar
                     mirrors below live outside it, so they never scale with the zoom (the
                     note editor's scrollbar "ignores the zoom", like the mind map). -->
                <Grid x:Name="EditorSurface"
                      Grid.Row="0"
                      Grid.Column="0"
                      ClipToBounds="True">
                    <Border Background="{DynamicResource RichTextBoxBackground}"/>
                    <!-- Between the page color and the text. The editor fill is transparent,
                         so the marks read as highlight and do not cover the glyphs.
                         The grid stays put and clips to the text inset; the canvas inside
                         is what scrolls with the note. -->
                    <Grid x:Name="FindHighlightClip">
                          <Canvas x:Name="SelectionHighlightOverlay" IsHitTestVisible="False"/>
                          <Canvas x:Name="FindHighlightOverlay" IsHitTestVisible="False"/>
                    </Grid>
                    <RichTextBox x:Name="ContentTextBox"
                                 Style="{StaticResource EditorRichTextBoxStyle}"
                                 SelectionChanged="ContentTextBox_SelectionChanged"
                                 PreviewMouseWheel="ContentTextBox_PreviewMouseWheel"
                                 TextChanged="ContentTextBox_TextChanged"
                                 SnapsToDevicePixels="True"
                                 TextOptions.TextFormattingMode="Ideal"
                                 TextOptions.TextRenderingMode="ClearType"
                                 RenderOptions.ClearTypeHint="Enabled"
                                 Margin="0"
                                 Padding="18,0"
                                 FontSize="{StaticResource Type.Body}"
                                 FontFamily="{StaticResource FontFamily.Editor}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 KeyboardNavigation.TabNavigation="None"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="Transparent"
                                 SelectionOpacity="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [Cut], Source={StaticResource Loc}}" Command="Cut"/>
                                <MenuItem Header="{Binding [Copy], Source={StaticResource Loc}}" Command="Copy"/>
                                <MenuItem Header="{Binding [Paste], Source={StaticResource Loc}}" Command="Paste"/>
                                <Separator/>
                                <MenuItem Header="{Binding [SelectAll], Source={StaticResource Loc}}" Command="SelectAll"/>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                    <Canvas x:Name="FloatingImageOverlay"
                            Panel.ZIndex="20"
                            ClipToBounds="True"/>
                </Grid>

                <ScrollBar x:Name="EditorMirrorVerticalScrollBar"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Vertical"
                           Width="{DynamicResource GlobalVerticalScrollBarWidth}"
                           Visibility="Collapsed"
                           Scroll="EditorMirrorVerticalScrollBar_Scroll"/>
                <ScrollBar x:Name="EditorMirrorHorizontalScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Orientation="Horizontal"
                           Width="Auto"
                           Height="{DynamicResource GlobalHorizontalScrollBarHeight}"
                           Visibility="Collapsed"
                           Scroll="EditorMirrorHorizontalScrollBar_Scroll"/>
                <Border x:Name="EditorScrollbarCorner"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="{DynamicResource GlobalVerticalScrollBarWidth}"
                        Height="{DynamicResource GlobalHorizontalScrollBarHeight}"
                        Background="{DynamicResource ScrollBarTrackBackground}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="20,0,20,12"
                Style="{StaticResource ChromePanelBorderStyle}"
                Padding="10,7"
                CornerRadius="{StaticResource Radius.Control}">
            <DockPanel LastChildFill="True">
                <Button x:Name="SpellCheckLanguageChooserButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource EditorToolButtonBaseStyle}"
                        ToolTip="{Binding [SpellCheckLanguageChooserTooltip], Source={StaticResource Loc}}"
                        Click="SpellCheckLanguageChooserButton_Click">
                    <StackPanel Orientation="Horizontal" Margin="6,3">
                        <icons:AppIcon Kind="Globe" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SpellCheckLanguageChooserText"
                                   Text=""
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CounterText"
                           Text=""
                           FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource TextColorSecondary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
        </controls:FeatureWindowShell.Body>
    </controls:FeatureWindowShell>
</Window>
