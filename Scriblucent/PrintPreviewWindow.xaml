<Window x:Class="Scriblucent.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [PrintPreviewTitle], Source={StaticResource Loc}}" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WorkspaceBackdrop}">
    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource WorkspaceHeadingStyle}">
                <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                            MinWidth="100"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Click="PrintButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <icons:AppIcon Kind="Print" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryForeground}"/>
                            <TextBlock Text="{Binding [Print], Source={StaticResource Loc}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            MinWidth="90"
                            Padding="16,8"
                            Click="CloseButton_Click"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding [PrintPreviewTitle], Source={StaticResource Loc}}" FontSize="{StaticResource Type.DialogTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    <TextBlock x:Name="HeaderDocumentTitle" FontSize="{StaticResource Type.Control.Toolbar}" Foreground="{DynamicResource TextColorSecondary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
                </DockPanel>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource RoundedContentScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="24,24,24,28"
                          Background="{DynamicResource WindowBackground}">
                <!-- Level 6 floating page: baked CardShadowLayer (no rest hairline). -->
                <Grid x:Name="PreviewPage"
                      Width="794" Height="1123"
                      Margin="0,0,0,20"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True"
                      ClipToBounds="False">
                    <controls:BakedElevationLayer Kind="Paper"/>
                    <Border Background="White"
                            BorderThickness="0"
                            Padding="60">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle"
                                   FontSize="{StaticResource Type.DialogTitle}"
                                   FontWeight="Bold"
                                   Foreground="#20242B"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="PreviewContent"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontFamily.UI}"/>
                    </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </controls:FeatureWindowShell.Body>
    </controls:FeatureWindowShell>
    </Grid>
</Window>
