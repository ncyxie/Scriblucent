<UserControl x:Class="Scriblucent.Views.TrashPanel" PreviewKeyDown="TrashPanel_PreviewKeyDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:motion="clr-namespace:Scriblucent.Animations"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="720" xmlns:controls="clr-namespace:Scriblucent.Controls" xmlns:views="clr-namespace:Scriblucent.Views">
    <UserControl.Resources>
        <Style x:Key="TrashListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <!-- The inner card owns keyboard focus feedback, as well as hover and selection. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrashFilterChipStyle" TargetType="RadioButton" BasedOn="{StaticResource SortOptionRadioButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="2,0,0,0"/>
        </Style>

        <!-- The list owns a bounded viewport so its VirtualizingStackPanel can recycle rows.
             Smooth scrolling comes from the app-wide ScrollViewer style. -->
        <Style x:Key="TrashListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          behaviors:MiddleClickScrollBehavior.IsEnabled="True"
                                          behaviors:RoundedClipBehavior.IsEnabled="True"
                                          behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="ScrimHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Image x:Name="BackdropSnapshot"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
            <Rectangle x:Name="OverlayDim"
                       Fill="{DynamicResource OverlayScrim}"
                       MouseDown="OverlayDim_MouseDown"/>
        </Grid>
        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid x:Name="TrashSurface" Width="700" Height="620"
                  MaxWidth="720"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <controls:BakedElevationLayer Kind="Dialog"/>
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Overlay}"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" motion:ArrivalGroups.Role="Heading">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <icons:AppIcon Kind="Trash" Width="20" Height="20" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Text="{Binding [Trash], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource Type.PageTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OverlayCloseIconButtonStyle}"
                                    Content="{icons:Icon Close}"
                                    Click="CloseButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="1" motion:ArrivalGroups.Role="Content"
                                   Margin="0,6,0,12"
                                   Text="{Binding [TrashRetentionNotice], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormHelperTextStyle}"/>

                        <Border Grid.Row="2" motion:ArrivalGroups.Role="Content"
                                Margin="0,0,0,10"
                                Style="{StaticResource ChromeInsetFieldBorderStyle}"
                                Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <icons:AppIcon Kind="Search" Width="14" Height="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               VerticalAlignment="Center"/>
                                <TextBox x:Name="TrashSearchBox"
                                         Grid.Column="1"
                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TrashSearchBox_TextChanged"
                                         ToolTip="{Binding [TrashSearchHint], Source={StaticResource Loc}}"/>
                            </Grid>
                        </Border>

                        <WrapPanel x:Name="TrashFilterPanel" motion:ArrivalGroups.Role="Content"
                                   Grid.Row="3"
                                   Margin="0,0,0,8">
                            <RadioButton x:Name="FilterAllRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Content="{Binding [TrashFilterAll], Source={StaticResource Loc}}"
                                         IsChecked="True"
                                         Checked="TrashFilter_Checked"
                                         Tag="All"/>
                            <RadioButton x:Name="FilterNotesRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="Note"/>
                            <RadioButton x:Name="FilterFlashcardsRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="FlashcardSet"/>
                            <RadioButton x:Name="FilterMindMapsRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="MindMap"/>
                            <RadioButton x:Name="FilterQuizzesRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="Quiz"/>
                        </WrapPanel>

                        <Grid Grid.Row="4">
                            <controls:ContextualStatePanel x:Name="EmptyStateHost" IllustrationKind="Trash" Visibility="Collapsed"
                                Title="{Binding [TrashEmptyState], Source={StaticResource Loc}}"
                                Description="{Binding [MotionStateTrashDescription], Source={StaticResource Loc}}"/>

                            <ListBox x:Name="TrashedItemsListBox" behaviors:ItemPresenceMotionBehavior.IsEnabled="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Style="{StaticResource TrashListBoxStyle}"
                                     ItemContainerStyle="{StaticResource TrashListBoxItemStyle}"
                                     SelectionMode="Extended"
                                     PreviewMouseLeftButtonDown="TrashedItemsListBox_PreviewMouseLeftButtonDown"
                                     SelectionChanged="TrashedItemsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:SurfaceMaterialBorder behaviors:StateSurfaceMotionBehavior.IsEnabled="True" behaviors:StateSurfaceMotionBehavior.SelectionThickness="2" Padding="12,10"
                                                    CornerRadius="{StaticResource Radius.Card}"
                                                    SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
                                                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="behaviors:StateSurfaceMotionBehavior.ActiveState" Value="True"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="behaviors:StateSurfaceMotionBehavior.IsSelected" Value="True"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsLogicalAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding IsExcludedFromLogicalSelection}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="behaviors:StateSurfaceMotionBehavior.IsSelected" Value="True"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <controls:SurfaceMaterialBorder.ContextMenu><ContextMenu><MenuItem Header="{Binding [MassSelectModeTitle], Source={StaticResource Loc}}" Tag="{Binding}" Click="TrashSelectMenu_Click"/></ContextMenu></controls:SurfaceMaterialBorder.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <controls:CollectionSelectionToggle Grid.Column="0" Loaded="TrashToggle_Loaded" AutomationProperties.Name="{Binding Title}">
                                                        <controls:CollectionSelectionToggle.Style>
                                                            <Style TargetType="controls:CollectionSelectionToggle" BasedOn="{StaticResource CollectionSelectionCheckBoxStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="0,0,8,0"/>
                                                                <Setter Property="IsChecked" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTrashSelecting, RelativeSource={RelativeSource AncestorType=views:TrashPanel}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLogicalAllSelected, RelativeSource={RelativeSource AncestorType=views:TrashPanel}}" Value="True"><Setter Property="IsChecked" Value="True"/></DataTrigger>
                                                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsLogicalAllSelected, RelativeSource={RelativeSource AncestorType=views:TrashPanel}}" Value="True"/>
                                                                        <Condition Binding="{Binding IsExcludedFromLogicalSelection}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions><Setter Property="IsChecked" Value="False"/></MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:CollectionSelectionToggle.Style>
                                                    </controls:CollectionSelectionToggle>
                                                    <icons:AppIcon Grid.Column="1" Kind="{Binding KindIcon}"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource FormBodyTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}"/>
                                                        <TextBlock Style="{StaticResource FormHelperTextStyle}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding KindDisplayName, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding DeletedAtDisplay, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding DaysLeftDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Content="{Binding [TrashRestore], Source={StaticResource Loc}}"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0"
                                                            Click="RestoreItemButton_Click"/>

                                                    <Button Grid.Column="4"
                                                            Content="{Binding [ConfirmDelete], Source={StaticResource Loc}}"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource DialogDangerButtonStyle}"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0"
                                                            Click="DeleteItemPermanentlyButton_Click"/>
                                                </Grid>
                                            </controls:SurfaceMaterialBorder>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                        </Grid>

                        <!-- Share the existing footer footprint. The island's overhang lives in
                             its surrounding padding, preserving uniform virtualized row sizes. -->
                        <Grid Grid.Row="5" Margin="0,12,0,0" motion:ArrivalGroups.Role="Actions">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="EmptyTrashButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" Height="36" MinHeight="36"
                                Content="{Binding [TrashEmptyAction], Source={StaticResource Loc}}" Style="{StaticResource DialogDangerButtonStyle}" Padding="12,6" Click="EmptyTrashButton_Click"/>
                            <Grid Grid.Column="1">
                                <motion:LayoutRevealHost HorizontalAlignment="Right" VerticalAlignment="Center" Height="48" Margin="0,-6,0,-6">
                                    <controls:CollectionSelectionDock x:Name="TrashSelectionDock" Visibility="Collapsed"/>
                                </motion:LayoutRevealHost>
                            </Grid>
                        </Grid>

                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </Border>
    </Grid>
</UserControl>



