<UserControl x:Class="Scriblucent.Views.TrashPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="720" xmlns:controls="clr-namespace:Scriblucent.Controls">
    <UserControl.Resources>
        <Style x:Key="TrashListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentPrimarySubtle}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrashFilterChipStyle" TargetType="RadioButton" BasedOn="{StaticResource SortOptionRadioButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="2,0,0,0"/>
        </Style>

        <!-- Custom template so the list's own ScrollViewer can carry the scroll-tile behavior
             (the default ListBox template's inner ScrollViewer cannot take attached behaviors).
             Virtualization engages because the ListBox now owns a bounded viewport; smooth
             scrolling comes from the app-wide implicit ScrollViewer style. -->
        <Style x:Key="TrashListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          behaviors:ScrollTileBehavior.IsEnabled="True"
                                          behaviors:MiddleClickScrollBehavior.IsEnabled="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="ScrimHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Image x:Name="BackdropSnapshot"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
            <Rectangle x:Name="OverlayDim"
                       Fill="{DynamicResource OverlayScrim}"
                       MouseDown="OverlayDim_MouseDown"/>
        </Grid>
        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid Width="700"
                  MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}"
                  MaxWidth="720"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <controls:BakedElevationLayer Kind="Dialog"/>
                <Border Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Overlay}"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <icons:AppIcon Kind="Trash" Width="20" Height="20" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Text="{Binding [Trash], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource Type.PageTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OverlayCloseIconButtonStyle}"
                                    Content="{icons:Icon Close}"
                                    Click="CloseButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,12"
                                   Text="{Binding [TrashRetentionNotice], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormHelperTextStyle}"/>

                        <Border Grid.Row="2"
                                Margin="0,0,0,10"
                                Style="{StaticResource ChromeFieldBorderStyle}"
                                Background="{DynamicResource WindowBackground}"
                                Padding="10,0"
                                Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <icons:AppIcon Kind="Search" Width="14" Height="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               VerticalAlignment="Center"/>
                                <TextBox x:Name="TrashSearchBox"
                                         Grid.Column="1"
                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TrashSearchBox_TextChanged"
                                         ToolTip="{Binding [TrashSearchHint], Source={StaticResource Loc}}"/>
                            </Grid>
                        </Border>

                        <WrapPanel x:Name="TrashFilterPanel"
                                   Grid.Row="3"
                                   Margin="0,0,0,8">
                            <RadioButton x:Name="FilterAllRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Content="{Binding [TrashFilterAll], Source={StaticResource Loc}}"
                                         IsChecked="True"
                                         Checked="TrashFilter_Checked"
                                         Tag="All"/>
                            <RadioButton x:Name="FilterNotesRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="Note"/>
                            <RadioButton x:Name="FilterFlashcardsRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="FlashcardSet"/>
                            <RadioButton x:Name="FilterMindMapsRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="MindMap"/>
                            <RadioButton x:Name="FilterQuizzesRadio"
                                         Style="{StaticResource TrashFilterChipStyle}"
                                         GroupName="TrashFilterGroup"
                                         Checked="TrashFilter_Checked"
                                         Tag="Quiz"/>
                        </WrapPanel>

                        <Grid Grid.Row="4" MinHeight="220">
                            <StackPanel x:Name="EmptyStateHost"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <icons:AppIcon Kind="Trash" Width="36" Height="36"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               Opacity="0.55"
                                               Margin="0,0,0,10"/>
                                <TextBlock x:Name="EmptyStateText"
                                           Text="{Binding [TrashEmptyState], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormHelperTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <ListBox x:Name="TrashedItemsListBox"
                                     MaxHeight="480"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Style="{StaticResource TrashListBoxStyle}"
                                     ItemContainerStyle="{StaticResource TrashListBoxItemStyle}"
                                     SelectionMode="Extended"
                                     SelectionChanged="TrashedItemsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:DashboardTileHost RendererKey="TrashRow">
                                            <Border Style="{StaticResource ChromePanelBorderStyle}" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <icons:AppIcon Kind="{Binding KindIcon}"
                                                                   Width="16" Height="16"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource FormBodyTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource FormHelperTextStyle}">
                                                            <Run Text="{Binding KindDisplayName, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding DeletedAtDisplay, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding DaysLeftDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Content="{Binding [TrashRestore], Source={StaticResource Loc}}"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0"
                                                            Click="RestoreItemButton_Click"/>

                                                    <Button Grid.Column="3"
                                                            Content="{Binding [ConfirmDelete], Source={StaticResource Loc}}"
                                                            Tag="{Binding}"
                                                            Style="{StaticResource DialogDangerButtonStyle}"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0"
                                                            Click="DeleteItemPermanentlyButton_Click"/>
                                                </Grid>
                                            </Border>
                                            </controls:DashboardTileHost>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RestoreSelectedButton"
                                        Content="{Binding [TrashRestoreSelected], Source={StaticResource Loc}}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="RestoreSelectedButton_Click"/>
                                <Button x:Name="DeleteSelectedButton"
                                        Content="{Binding [TrashDeleteSelected], Source={StaticResource Loc}}"
                                        Style="{StaticResource DialogDangerButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="DeleteSelectedButton_Click"/>
                                <Button x:Name="EmptyTrashButton"
                                        Content="{Binding [TrashEmptyAction], Source={StaticResource Loc}}"
                                        Style="{StaticResource DialogDangerButtonStyle}"
                                        Padding="12,6"
                                        Click="EmptyTrashButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>



