<Window x:Class="Scriblucent.Views.SketchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [SketchDialogTitle], Source={StaticResource Loc}}"
        Width="900" Height="760" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="SketchToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource EditorToolIconToggleButtonStyle}">
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentRimBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SketchCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
            <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="SketchSwatchStyle" TargetType="ToggleButton" BasedOn="{StaticResource EditorToolIconToggleButtonStyle}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SelectionRing" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
                            <Border Margin="4" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentRimBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <controls:OverlayDialogShell x:Name="SketchShell" MaxCardWidth="840" CardPadding="20">
        <controls:OverlayDialogShell.Header>
            <StackPanel x:Name="SketchHeader">
                <TextBlock x:Name="HeadingText" Text="{Binding [SketchDialogTitle], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.DialogTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}" Margin="0,0,0,14"/>
                <Border Style="{StaticResource CommandSurfaceBorderStyle}" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel x:Name="ToolsPanel"/>
                        <Border Height="1" Background="{DynamicResource ActionDividerBrush}" Opacity="0.6" Margin="2,8"/>
                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="InkColorButton" Style="{StaticResource SketchCommandButtonStyle}" Padding="10,6" Margin="0,0,8,4" Click="InkColor_Click">
                                <StackPanel Orientation="Horizontal"><Border x:Name="CurrentPenColorPreview" Width="16" Height="16" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [SketchInkColor], Source={StaticResource Loc}}" FontSize="13"/></StackPanel>
                            </Button>
                            <Button x:Name="BackgroundColorButton" Style="{StaticResource SketchCommandButtonStyle}" Padding="10,6" Margin="0,0,12,4" Click="BackgroundColor_Click">
                                <StackPanel Orientation="Horizontal"><Border x:Name="CurrentBackgroundColorPreview" Width="16" Height="16" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ButtonBorder}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [SketchBackground], Source={StaticResource Loc}}" FontSize="13"/></StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Height="32">
                                <TextBlock Text="{Binding [SketchStrokeWidth], Source={StaticResource Loc}}" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                <Slider x:Name="StrokeWidthSlider" Width="96" Minimum="1" Maximum="28" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="StrokeWidthSlider_ValueChanged"/>
                                <TextBlock x:Name="StrokeWidthLabel" Text="4" Width="25" Margin="7,0,0,0" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding [SketchFit], Source={StaticResource Loc}}" Style="{StaticResource SketchCommandButtonStyle}" Padding="10,6" Click="Fit_Click"/>
                                <ComboBox x:Name="ZoomBox" Style="{StaticResource InsetComboBoxStyle}" Margin="6,0,0,0" MinWidth="88" SelectionChanged="Zoom_Changed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:OverlayDialogShell.Header>
        <controls:OverlayDialogShell.Body>
            <Border x:Name="CanvasViewport" Height="380" Background="{DynamicResource ContentInsetSurface}"
                    CornerRadius="{StaticResource Radius.Card}" behaviors:RoundedClipBehavior.IsEnabled="True"
                    SizeChanged="CanvasViewport_SizeChanged" PreviewMouseWheel="CanvasViewport_MouseWheel"
                    PreviewMouseDown="Viewport_MouseDown" PreviewMouseMove="Viewport_MouseMove" PreviewMouseUp="Viewport_MouseUp">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="False" Padding="0" CanContentScroll="False">
                    <Grid x:Name="Paper" Width="640" Height="400" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.LayoutTransform><ScaleTransform x:Name="CanvasScale"/></Grid.LayoutTransform>
                        <Border x:Name="SketchCanvasViewport" Background="Transparent">
                            <Grid>
                                <Border x:Name="TransparencyChecker"/>
                                <Border x:Name="PaperBackground"/>
                                <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False"/>
                                <InkCanvas x:Name="SketchCanvas" Width="640" Height="400" Background="Transparent" EditingMode="Ink"
                                           Focusable="False" ResizeEnabled="False" MoveEnabled="False" ClipToBounds="True"
                                           UseCustomCursor="True" Cursor="None" ForceCursor="True"
                                           Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                                           PreviewMouseDown="Canvas_MouseDown" MouseLeave="Canvas_MouseLeave"/>
                                <controls:SketchInkPreview x:Name="ShapePreview" IsHitTestVisible="False"/>
                                <Canvas x:Name="CursorLayer" IsHitTestVisible="False" ClipToBounds="True">
                                    <Ellipse x:Name="CursorContrast" Visibility="Collapsed" Stroke="{DynamicResource EditHandleContrast}" StrokeThickness="3"/>
                                    <Ellipse x:Name="CursorOutline" Visibility="Collapsed" Stroke="{DynamicResource TextColor}" StrokeThickness="1"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <Border x:Name="SketchCanvasOutline" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1.5"
                                CornerRadius="{StaticResource Radius.Control}" UseLayoutRounding="False"
                                IsHitTestVisible="False" SizeChanged="SketchCanvasOutline_SizeChanged"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </controls:OverlayDialogShell.Body>
        <controls:OverlayDialogShell.Footer>
            <DockPanel x:Name="SketchFooter" Margin="0,14,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}" Style="{StaticResource DialogSecondaryButtonStyle}" Padding="16,8" MinWidth="96" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="AcceptButton" Content="{Binding [InsertSketch], Source={StaticResource Loc}}" Style="{StaticResource DialogPrimaryButtonStyle}" Padding="16,8" MinWidth="110" Click="Insert_Click"/>
                </StackPanel>
                <Button x:Name="HelpButton" Style="{StaticResource SketchCommandButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="Help_Click"
                        ToolTip="{Binding [SketchHelp], Source={StaticResource Loc}}"
                        AutomationProperties.Name="{Binding [SketchHelp], Source={StaticResource Loc}}">
                    <StackPanel Orientation="Horizontal">
                        <icons:AppIcon Kind="Question" Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding [SketchHelp], Source={StaticResource Loc}}"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
