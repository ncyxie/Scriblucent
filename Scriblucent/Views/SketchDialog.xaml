<Window x:Class="Scriblucent.Views.SketchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        Title="{Binding [SketchDialogTitle], Source={StaticResource Loc}}"
        Width="720"
        Height="640"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SketchSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <controls:OverlayDialogShell MaxCardWidth="680"
                                  CardPadding="20">
        <controls:OverlayDialogShell.Header>
            <TextBlock Text="{Binding [SketchDialogTitle], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.DialogTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,12"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <!-- Tools row -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10">
                    <Button x:Name="PenToolButton"
                            Content="{icons:Icon Kind=Pen, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SketchPen], Source={StaticResource Loc}}"
                            Click="PenToolButton_Click"/>
                    <Button x:Name="MarkerToolButton"
                            Content="{icons:Icon Kind=Highlight, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SketchMarker], Source={StaticResource Loc}}"
                            Click="MarkerToolButton_Click"/>
                    <Button x:Name="EraserToolButton"
                            Content="{icons:Icon Kind=Clear, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="0,0,12,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SketchEraser], Source={StaticResource Loc}}"
                            Click="EraserToolButton_Click"/>

                    <Border Width="1"
                            Height="20"
                            Margin="0,0,12,0"
                            Background="{DynamicResource BorderColor}"/>

                    <TextBlock Text="{Binding [SketchStrokeWidth], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"/>
                    <Slider x:Name="StrokeWidthSlider"
                            Width="120"
                            Minimum="1"
                            Maximum="28"
                            Value="4"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="StrokeWidthSlider_ValueChanged"/>
                    <TextBlock x:Name="StrokeWidthLabel"
                               Width="28"
                               Margin="8,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextColor}"
                               Text="4"/>

                    <Border Width="1"
                            Height="20"
                            Margin="0,0,12,0"
                            Background="{DynamicResource BorderColor}"/>

                    <Button Content="{icons:Icon Kind=Undo, Size=14}"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Undo], Source={StaticResource Loc}}"
                            Click="UndoButton_Click"/>
                    <Button Content="{icons:Icon Kind=Clear, Size=14}"
                            Width="32"
                            Height="32"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SketchClear], Source={StaticResource Loc}}"
                            Click="ClearButton_Click"/>
                </StackPanel>

                <!-- Pen color palette -->
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding [SketchPenColor], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"/>
                    <Button DockPanel.Dock="Right"
                            Content="{icons:Icon Kind=Color, Size=14}"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SelectColor], Source={StaticResource Loc}}"
                            Click="PickPenColorButton_Click"/>
                    <Border x:Name="CurrentPenColorPreview"
                            DockPanel.Dock="Right"
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Background="#1A1A1A"
                            VerticalAlignment="Center"/>
                    <WrapPanel x:Name="PenColorSwatchPanel"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Background -->
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding [SketchBackground], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"/>
                    <Button DockPanel.Dock="Right"
                            Content="{icons:Icon Kind=Color, Size=14}"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [SketchBackgroundCustom], Source={StaticResource Loc}}"
                            Click="PickBackgroundColorButton_Click"/>
                    <Border x:Name="CurrentBackgroundColorPreview"
                            DockPanel.Dock="Right"
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Background="White"
                            VerticalAlignment="Center"/>
                    <WrapPanel x:Name="BackgroundSwatchPanel"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Ink surface is round-clipped; border chrome sits on top. -->
                <Grid Width="640"
                      Height="400"
                      HorizontalAlignment="Center"
                      SnapsToDevicePixels="True">
                    <Border CornerRadius="{StaticResource Radius.Control}"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            Background="Transparent">
                        <Grid>
                            <Border x:Name="TransparencyChecker"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,16,16"
                                                  ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FFE8E8EE">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,16,16"/>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFD0D0D8">
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <RectangleGeometry Rect="0,0,8,8"/>
                                                            <RectangleGeometry Rect="8,8,8,8"/>
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                            <InkCanvas x:Name="SketchCanvas"
                                       Width="640"
                                       Height="400"
                                       MinWidth="640"
                                       MinHeight="400"
                                       MaxWidth="640"
                                       MaxHeight="400"
                                       Background="White"
                                       EditingMode="Ink"
                                       Focusable="False"
                                       ResizeEnabled="False"
                                       MoveEnabled="False"
                                       ClipToBounds="False"
                                       UseCustomCursor="False"
                                       Stylus.IsPressAndHoldEnabled="False"
                                       Stylus.IsFlicksEnabled="False"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True"/>
                </Grid>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="96"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="{Binding [InsertSketch], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="110"
                        Padding="16,8"
                        Click="Insert_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
