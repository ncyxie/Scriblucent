<UserControl x:Class="Scriblucent.Views.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="960">
    <UserControl.Resources>
        <Style x:Key="AuthorLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Opacity" Value="0.86"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="AboutCloseIconButtonStyle" TargetType="Button">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="CloseButtonBorder"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="CloseButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                <Setter TargetName="CloseButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot">
        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"
                           MouseDown="OverlayDim_MouseDown"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="PanelCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="Auto"
                    MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}"
                    MaxWidth="500">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="24" ShadowDepth="0"/>
                </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,18,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding [About], Source={StaticResource Loc}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource AboutCloseIconButtonStyle}"
                            Content="✕"
                            Click="CloseButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" x:Name="ContentPanel" Margin="20,12,20,18">
                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="18,16,18,14" Background="{DynamicResource WindowBackground}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border CornerRadius="14"
                                    Width="54"
                                    Height="54"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <Image Source="/Scriblucent;component/logo.ico"
                                       Width="30"
                                       Height="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Scriblucent"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>
                            <TextBlock Text="{x:Static services:AppVersionInfo.DisplayVersion}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="4,12,4,0">
                        <TextBlock Text="{Binding [AboutDescription], Source={StaticResource Loc}, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextColor}"
                                   Opacity="0.86"
                                   Margin="0,0,0,10"
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>

                        <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding [Authors], Source={StaticResource Loc}}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Margin="0,0,0,6"
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"/>

                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Mantas Gaižutis"/>
                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Jaunius Pigaga"/>
                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Rapolas Turauskas"/>
                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Deividas Kepenis"/>
                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Gustas Valaika"/>
                        <TextBlock Style="{StaticResource AuthorLineStyle}" Text="Mantas Brūžė"/>

                        <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="28,8"
                                Margin="0,14,0,0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
