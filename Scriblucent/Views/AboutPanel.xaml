<UserControl x:Class="Scriblucent.Views.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="960">
    <UserControl.Resources>
        <Style x:Key="AboutSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
        </Style>

        <Style x:Key="AboutStageCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayCloseIconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AboutStageForeground}"/>
            <Setter Property="Background" Value="{DynamicResource AboutStageCloseFill}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="AboutHandleChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="AboutHandleChipMaintainerStyle" TargetType="Border" BasedOn="{StaticResource AboutHandleChipStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimarySubtle}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="AboutHandleChipContributorStyle" TargetType="Border" BasedOn="{StaticResource AboutHandleChipStyle}">
            <Setter Property="Background" Value="{DynamicResource TagChipBackground}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="AboutHandleTextMaintainerStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Badge}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AboutHandleTextContributorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Badge}"/>
            <Setter Property="Foreground" Value="{DynamicResource TagChipForeground}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AboutPersonButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkRowButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot">
        <Grid x:Name="ScrimHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Image x:Name="BackdropSnapshot"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
            <Rectangle x:Name="OverlayDim"
                       Fill="{DynamicResource OverlayScrim}"
                       MouseDown="OverlayDim_MouseDown"/>
        </Grid>

        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <!--
              The floating shadow stays outside the card clip and does not contribute layout size.
              Dialog elevation stretches around PanelCard; only the body scrolls on shorter owners.
            -->
            <Grid Width="Auto"
                  MaxWidth="480"
                  VerticalAlignment="Top"
                  ClipToBounds="False">
                <controls:BakedElevationLayer Kind="Dialog"/>

                <!--
                  BorderThickness=0 so the stage paints edge-to-edge under the rounded clip.
                  Level 2 documented exception: stroke overlay avoids the classic 1px banner inset seam
                  under RoundedClip (not a general floating-surface rest hairline).
                -->
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" x:Name="PanelCard"
                        MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Overlay}"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Soft mesh stage (Linear/Stripe-style blobs, no BlurEffect) -->
                        <Border x:Name="BrandStage"
                                Grid.Row="0"
                                Height="200"
                                Background="{DynamicResource AboutStageBase}"
                                ClipToBounds="True">
                            <Grid>
                                <Ellipse x:Name="MeshNear" Width="420" Height="320"
                                         Margin="-140,-160,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Fill="{DynamicResource AboutStageMeshA}"
                                         IsHitTestVisible="False"/>
                                <Ellipse x:Name="MeshFar" Width="380" Height="300"
                                         Margin="0,-120,-130,0"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{DynamicResource AboutStageMeshB}"
                                         IsHitTestVisible="False"/>

                                <Rectangle x:Name="BrandLight" Width="150" Height="220" Opacity="0"
                                           HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#28FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Soft veil + bottom fade so mesh never reads as hard circles at the seam -->
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#55FFFFFF" Offset="0"/>
                                            <GradientStop Color="#18FFFFFF" Offset="0.4"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.72"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Height="88"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"
                                           Fill="{DynamicResource AboutStageBottomFade}"/>

                                <Grid Margin="20,16,20,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock Text="{Binding [About], Source={StaticResource Loc}}"
                                                   FontSize="{StaticResource Type.Meta}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AboutStageForeground}"
                                                   Opacity="0.78"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.UI}"/>

                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource AboutStageCloseButtonStyle}"
                                                Content="{icons:Icon Kind=Close, Size=14}"
                                                Foreground="{DynamicResource AboutStageForeground}"
                                                Click="CloseButton_Click"/>
                                    </Grid>

                                    <svgc:SvgViewbox x:Name="BrandLogoHost"
                                                     Grid.Row="1"
                                                     Source="{DynamicResource BrandLogoSvg}"
                                                     Height="58"
                                                     Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     SnapsToDevicePixels="True"
                                                     UseLayoutRounding="True"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{x:Static services:AppVersionInfo.DisplayVersion}"
                                               FontSize="{StaticResource Type.Chip}"
                                               Foreground="{DynamicResource AboutStageMuted}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               FontFamily="{StaticResource FontFamily.UI}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="AboutContentScroll" Grid.Row="1"
                                      Style="{StaticResource RoundedCompactScrollViewerStyle}"
                                      Margin="22,0,20,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                                <TextBlock Text="{Binding [AboutTagline], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource Type.SectionTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"
                                           FontFamily="{StaticResource FontFamily.UI}"/>

                                <TextBlock Text="{Binding [AboutDescription], Source={StaticResource Loc}}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="{StaticResource Type.Meta}"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           Margin="4,8,4,18"
                                           LineHeight="20"
                                           FontFamily="{StaticResource FontFamily.UI}"/>

                                <Border Background="{DynamicResource BorderColor}"
                                        Height="1"
                                        Opacity="0.7"
                                        Margin="0,0,0,16"/>

                                <TextBlock Style="{StaticResource AboutSectionLabelStyle}"
                                           Text="{Binding [AboutMaintainedBy], Source={StaticResource Loc}}"/>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/ncyxie"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Mantas Gaižutis"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipMaintainerStyle}">
                                                <TextBlock Text="@ncyxie" Style="{StaticResource AboutHandleTextMaintainerStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/JauniusP"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Jaunius Pigaga"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipMaintainerStyle}">
                                                <TextBlock Text="@JauniusP" Style="{StaticResource AboutHandleTextMaintainerStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource AccentPrimary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Style="{StaticResource AboutSectionLabelStyle}"
                                           Text="{Binding [AboutOriginalContributors], Source={StaticResource Loc}}"/>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/gustas215"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Gustas Valaika"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipContributorStyle}">
                                                <TextBlock Text="@gustas215" Style="{StaticResource AboutHandleTextContributorStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/deikep"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Deividas Kepenis"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipContributorStyle}">
                                                <TextBlock Text="@deikep" Style="{StaticResource AboutHandleTextContributorStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/Mantelio626"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Mantas Brūžė"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipContributorStyle}">
                                                <TextBlock Text="@Mantelio626" Style="{StaticResource AboutHandleTextContributorStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource AboutPersonButtonStyle}"
                                        Tag="https://github.com/Rapol05"
                                        ToolTip="{Binding [OpenGitHubProfile], Source={StaticResource Loc}}"
                                        Click="GitHubProfile_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Rapolas Turauskas"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextColor}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontFamily.UI}"/>
                                            <controls:SurfaceMaterialBorder Style="{StaticResource AboutHandleChipContributorStyle}">
                                                <TextBlock Text="@Rapol05" Style="{StaticResource AboutHandleTextContributorStyle}"/>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <icons:AppIcon Grid.Column="1"
                                                       Kind="Github"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                       VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Text="{Binding [AboutLicenseFooter], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           Opacity="0.75"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0"
                                           FontFamily="{StaticResource FontFamily.UI}"/>

                        </StackPanel>
                        </ScrollViewer>

                        <Button x:Name="AboutCloseButton" Grid.Row="2"
                                Content="{Binding [Close], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="28,8"
                                Margin="0,14,0,28"
                                Click="CloseButton_Click"/>

                        <!-- Stroke overlay: draws the outline without insetting content -->
                        <Border Grid.RowSpan="3"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Overlay}"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </Border>
    </Grid>
</UserControl>
