<Window xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.MindMapPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        x:Name="MindMapWindow"
        Title="{Binding [MindMapPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="1080"
        MinHeight="650"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WorkspaceBackdrop}"
        Closing="MindMapPreviewWindow_Closing">
    <Window.Resources>
        <!-- Footer + linked-note + layout-combo + manual-positioning-toggle styles - the icon
             toolbar itself now uses the shared Editor* family from Themes/Controls/Buttons.xaml
             (promoted from NoteEditorWindow so both editors share one definition). -->
        <Style x:Key="MindMapToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="MindMapLinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkedNoteToolbarButtonStyle}"/>

        <Style x:Key="MindMapToolbarNarrowButtonStyle" TargetType="Button" BasedOn="{StaticResource MindMapToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="MindMapLayoutComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FeatureToolbarComboBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="MindMapLinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource LinkedNoteComboBoxStyle}"/>

        <!-- Level 6 toolbar: rest S; checked = filled accent (no rest hairline). Domain node strokes stay out of chrome. -->
        <Style x:Key="MindMapToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="176"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <controls:InteractionSurface Role="Compact" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" x:Name="ToggleBorder" behaviors:StateSurfaceMotionBehavior.IsEnabled="True" behaviors:StateSurfaceMotionBehavior.IsSelected="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" behaviors:StateSurfaceMotionBehavior.SelectionThickness="2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </controls:InteractionSurface>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="ContentRoot" KeyDown="MindMap_KeyDown"
          controls:EditorChromeContext.Controller="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border motion:WindowMotion.Role="Chrome" Grid.Row="0" Style="{StaticResource EditorChromeStyle}">
            <Grid behaviors:EditorHeaderLayoutBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="EditorTitleField" Grid.Column="0"
                        Grid.Row="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChromeTitleFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.DialogTitle}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [MindMapTitleHint], Source={StaticResource Loc}}"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                        <controls:EditorTitleStatus x:Name="EditedIndicatorText" Style="{StaticResource EditorTitleStatusStyle}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- White chrome strip matching title field (InputSurface + field elevation; no focus ring) -
                     mirrors NoteEditorWindow's dense icon-toolbar strip so both editors share one look. -->
                <Border x:Name="EditorCommandTray" Grid.Column="1"
                        Grid.Row="0"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        VerticalAlignment="Center"
                        Padding="0,6"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <controls:EditorCommandPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="UndoButton"
                                Content="{icons:Icon Undo}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Undo], Source={StaticResource Loc}}"
                                Click="UndoButton_Click"/>
                        <Button x:Name="RedoButton"
                                Content="{icons:Icon Redo}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Redo], Source={StaticResource Loc}}"
                                Click="RedoButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button x:Name="AddNodeMenuButton"
                                Content="{icons:Icon Plus}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapAddNode], Source={StaticResource Loc}}"
                                Click="AddNodeMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{Binding [MindMapAddChild], Source={StaticResource Loc}}" Click="AddChildButton_Click"/>
                                    <MenuItem Header="{Binding [MindMapAddSibling], Source={StaticResource Loc}}" Click="AddSiblingButton_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="DeleteSelectedNodeButton" Content="{icons:Icon Delete}"
                                Width="32"
                                Height="32"
                                Margin="0,0,6,0"
                                Style="{StaticResource EditorDangerToolButtonStyle}"
                                ToolTip="{Binding [Delete], Source={StaticResource Loc}}"
                                Click="DeleteNodeButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button Content="{icons:Icon ChevronDown}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapExpandAll], Source={StaticResource Loc}}"
                                Click="ExpandAllButton_Click"/>
                        <Button Content="{icons:Icon ChevronUp}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapCollapseAll], Source={StaticResource Loc}}"
                                Click="CollapseAllButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <!-- Panels: style → find/replace → layout/view -->
                        <Button x:Name="FontPanelToggleButton"
                                Content="{icons:Icon Font}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapToolbarFont], Source={StaticResource Loc}}"
                                Click="FontPanelToggleButton_Click"/>
                        <Button x:Name="SearchPanelToggleButton"
                                Content="{icons:Icon Search}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapToolbarSearch], Source={StaticResource Loc}}"
                                Click="SearchPanelToggleButton_Click"/>
                        <Button x:Name="ArrangePanelToggleButton"
                                Content="{icons:Icon Settings}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [MindMapToolbarArrange], Source={StaticResource Loc}}"
                                Click="ArrangePanelToggleButton_Click"/>
                        <Button x:Name="TagsPanelToggleButton"
                                Content="{icons:Icon Tag}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Tags], Source={StaticResource Loc}}"
                                Click="TagsPanelToggleButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"
                                Visibility="{Binding Visibility, ElementName=LinkedNoteButton}"/>

                        <Button x:Name="LinkedNoteButton"
                                Content="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonText, RelativeSource={RelativeSource Self}}"
                                Style="{StaticResource MindMapLinkedNoteButtonStyle}"
                                Click="LinkedNoteButton_Click"
                                ToolTip="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonToolTip, RelativeSource={RelativeSource Self}}"
                                TextOptions.TextFormattingMode="Ideal"/>
                        <motion:LayoutRevealHost HorizontalAlignment="Right" VerticalAlignment="Center">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="AiGeneratedInfoBadge"
                                Width="30"
                                Height="30"
                                Margin="4,0,0,0"
                                CornerRadius="15"
                                Background="{DynamicResource IconButtonBackground}"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="180"
                                Visibility="Collapsed">
                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center"/>
                        </controls:SurfaceMaterialBorder>
                        </motion:LayoutRevealHost>
                        <Border Width="1"
                                Height="22"
                                Margin="8,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button Content="{icons:Icon Save}"
                                Style="{StaticResource EditorPrimarySaveButtonStyle}"
                                ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                                Click="SaveButton_Click"/>
                    </controls:EditorCommandPanel>
                </Border>
                <motion:LayoutRevealHost Grid.Row="1" Grid.ColumnSpan="2">
                <controls:AiReviewNotice x:Name="AiReviewNotice"
                                         Margin="0,10,0,0"
                                         AllowDismiss="True"
                                         Dismissed="AiReviewNotice_Dismissed"
                                         Visibility="Collapsed"/>
                </motion:LayoutRevealHost>
            </Grid>
        </Border>

        <motion:LayoutRevealHost Grid.Row="1">
        <Border x:Name="TagsPanel"
                Margin="20,4,20,0"
                Style="{StaticResource ChromeInsetFieldBorderStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Field.InlineLabelMargin}"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>
        </motion:LayoutRevealHost>

        <!-- Collapsible "Arrange & View" panel - hidden by default, toggled via ArrangePanelToggleButton,
             uses the shared layout reveal, matching the note editor toolbar. -->
        <motion:LayoutRevealHost Grid.Row="2">
        <Border x:Name="ArrangePanel"
                Margin="20,8,20,0"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="12,5"
                Visibility="Collapsed">
            <controls:EditorCommandPanel CanWrap="True" VerticalAlignment="Center">
                <ComboBox behaviors:DropdownChoiceWidthBehavior.IsEnabled="True" x:Name="LayoutModeComboBox"
                          Height="32"
                          Margin="0,5,6,5"
                          Style="{StaticResource MindMapLayoutComboBoxStyle}"
                          VerticalContentAlignment="Center"
                          ToolTip="{Binding [MindMapToolbarArrange], Source={StaticResource Loc}}"
                          SelectionChanged="LayoutModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{Binding [MindMapLayoutBalancedTree], Source={StaticResource Loc}}"
                                  Tag="BalancedTree"/>
                    <ComboBoxItem Content="{Binding [MindMapLayoutRightTree], Source={StaticResource Loc}}"
                                  Tag="RightTree"/>
                    <ComboBoxItem Content="{Binding [MindMapLayoutLeftTree], Source={StaticResource Loc}}"
                                  Tag="LeftTree"/>
                    <ComboBoxItem Content="{Binding [MindMapLayoutTopDown], Source={StaticResource Loc}}"
                                  Tag="TopDown"/>
                    <ComboBoxItem Content="{Binding [MindMapLayoutRadial], Source={StaticResource Loc}}"
                                  Tag="Radial"/>
                </ComboBox>
                <Button Content="{icons:Icon Refresh}"
                        Style="{StaticResource EditorToolIconButtonStyle}"
                        Margin="0,5,14,5"
                        ToolTip="{Binding [MindMapAutoLayout], Source={StaticResource Loc}}"
                        Click="AutoLayoutButton_Click"/>

                <Border Width="1"
                        Height="20"
                        Margin="0,11,14,11"
                        Background="{DynamicResource BorderColor}"/>

                <ToggleButton x:Name="ManualPositioningToggle"
                              Margin="0,5,14,5"
                              Style="{StaticResource MindMapToolbarToggleButtonStyle}"
                              Checked="ManualPositioningToggle_Checked"
                              Unchecked="ManualPositioningToggle_Unchecked">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="ManualPositioningStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="{DynamicResource TextColorSecondary}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding [MindMapManualPositioning], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="ManualPositioningStateBadge"
                                controls:SurfaceMaterial.Foreground="{Binding Foreground, ElementName=ManualPositioningStateText}"
                                Margin="9,0,0,0"
                                Padding="6,2"
                                CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource IconButtonBackground}"
                                BorderThickness="0">
                            <TextBlock x:Name="ManualPositioningStateText"
                                       Text="{Binding [MindMapManualPositioningOff], Source={StaticResource Loc}}"
                                       FontSize="{StaticResource Type.Control.Badge}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </controls:SurfaceMaterialBorder>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1"
                        Height="20"
                        Margin="0,11,14,11"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,5,0,5">
                    <Button Content="{icons:Icon ZoomReset}"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [ZoomReset], Source={StaticResource Loc}}"
                            Click="ResetZoomButton_Click"/>
                    <TextBlock Text="{Binding [MindMapZoom], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Control.Toolbar}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               Margin="2,0,8,0"/>
                    <Slider x:Name="ZoomSlider"
                            Width="136"
                            Minimum="0.45"
                            Maximum="1.8"
                            Value="1"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="14,11,14,11"
                        Background="{DynamicResource BorderColor}"/>

                <ComboBox ItemsSource="{Binding Path=(controls:EditorChromeContext.Controller).NoteLinkOptions, RelativeSource={RelativeSource Self}}"
                          SelectedItem="{Binding Path=(controls:EditorChromeContext.Controller).SelectedLinkedNote, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          Style="{StaticResource MindMapLinkedNoteComboBoxStyle}"
                          SelectedValuePath="Id"
                          Margin="0,5,0,5"
                          ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
            </controls:EditorCommandPanel>
        </Border>
        </motion:LayoutRevealHost>

        <!-- Collapsible search bar - hidden by default, toggled via SearchPanelToggleButton, same
             panel-reveal mechanism as ArrangePanel (mutually exclusive - opening one closes the other). -->
        <motion:LayoutRevealHost Grid.Row="2">
        <Border x:Name="SearchPanel"
                Margin="20,8,20,0"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="12,10"
                Visibility="Collapsed">
            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">
                <Border Width="220"
                        Height="32"
                        MinHeight="32"
                        Margin="0,0,8,6"
                        Style="{StaticResource ChromeInsetFieldBorderStyle}">
                    <DockPanel LastChildFill="True">
                        <icons:AppIcon Kind="Search"
                                       Width="14"
                                       Height="14"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Margin="{StaticResource Field.InlineLabelMargin}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 FontSize="{StaticResource Type.Control.Form}"
                                 TextChanged="SearchTextBox_TextChanged"
                                 ToolTip="{Binding [MindMapSearchHint], Source={StaticResource Loc}}"/>
                    </DockPanel>
                </Border>
                <Border Width="180"
                        Height="32"
                        MinHeight="32"
                        Margin="0,0,8,6"
                        Style="{StaticResource ChromeInsetFieldBorderStyle}">
                    <DockPanel LastChildFill="True">
                        <icons:AppIcon Kind="Swap"
                                       Width="14"
                                       Height="14"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Margin="{StaticResource Field.InlineLabelMargin}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="ReplaceTextBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 FontSize="{StaticResource Type.Control.Form}"
                                 ToolTip="{Binding [ReplaceLabel], Source={StaticResource Loc}}"/>
                    </DockPanel>
                </Border>
                <Button Content="{Binding [MindMapSearchPrevious], Source={StaticResource Loc}}"
                        Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                        Margin="0,0,6,6"
                        Click="SearchPreviousButton_Click"/>
                <Button Content="{Binding [MindMapSearchNext], Source={StaticResource Loc}}"
                        Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                        Margin="0,0,6,6"
                        Click="SearchNextButton_Click"/>
                <Button x:Name="SearchReplaceButton"
                        Content="{Binding [Replace], Source={StaticResource Loc}}"
                        Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                        Margin="0,0,6,6"
                        MinWidth="72"
                        IsEnabled="False"
                        Click="SearchReplaceButton_Click"/>
                <Button x:Name="SearchReplaceAllButton"
                        Content="{Binding [ReplaceAll], Source={StaticResource Loc}}"
                        Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                        Margin="0,0,8,6"
                        MinWidth="96"
                        IsEnabled="False"
                        Click="SearchReplaceAllButton_Click"/>
                <TextBlock x:Name="SearchResultsTextBlock"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Type.Caption}"
                           MinWidth="56"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextColorSecondary}"
                           Text="{Binding [MindMapSearchNoResults], Source={StaticResource Loc}}"/>
            </WrapPanel>
        </Border>
        </motion:LayoutRevealHost>

        <!-- Collapsible font panel - hidden by default, toggled via FontPanelToggleButton, same
             panel-reveal mechanism as ArrangePanel/SearchPanel (mutually exclusive with both).
             Edits apply to the current selection. Mixed values stay explicit and only
             the changed font property is applied across nodes in one undo step. -->
        <motion:LayoutRevealHost Grid.Row="2">
        <Border x:Name="FontPanel"
                Margin="20,8,20,0"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="12,10"
                Visibility="Collapsed">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <TextBlock Text="{Binding [FontLabel], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Field.InlineLabelMargin}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <ComboBox x:Name="FontFamilyBox"
                                  Width="{StaticResource Control.Width.FontFamily}"
                                  Height="32"
                                  Style="{StaticResource MindMapLayoutComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="FontFamilyBox_SelectionChanged" ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <TextBlock Text="{Binding [SizeLabel], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource Field.InlineLabelMargin}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <ComboBox behaviors:DropdownChoiceWidthBehavior.IsEnabled="True" x:Name="FontSizeBox"
                                  Height="32"
                                  Style="{StaticResource MindMapLayoutComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="FontSizeBox_SelectionChanged">
                            <ComboBoxItem Content="{Binding [MindMapFontDefault], Source={StaticResource Loc}}" Tag=""/>
                            <ComboBoxItem Content="{Binding [MixedSelection], Source={StaticResource Loc}}" Tag="__mixed" IsEnabled="False"/>
                            <ComboBoxItem Content="8" Tag="8"/>
                            <ComboBoxItem Content="9" Tag="9"/>
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="11" Tag="11"/>
                            <ComboBoxItem Content="12" Tag="12"/>
                            <ComboBoxItem Content="14" Tag="14"/>
                            <ComboBoxItem Content="16" Tag="16"/>
                            <ComboBoxItem Content="18" Tag="18"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="24" Tag="24"/>
                            <ComboBoxItem Content="28" Tag="28"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Width="1"
                            Height="20"
                            Margin="0,6,14,6"
                            Background="{DynamicResource BorderColor}"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <ToggleButton x:Name="FontBoldToggleButton"
                                      Content="B"
                                      FontWeight="Bold"
                                      Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                      ToolTip="{Binding [Bold], Source={StaticResource Loc}}"
                                      Click="FontBoldToggleButton_Click"/>
                        <ToggleButton x:Name="FontItalicToggleButton"
                                      Content="I"
                                      FontStyle="Italic"
                                      Style="{StaticResource EditorToolIconToggleButtonStyle}"
                                      ToolTip="{Binding [Italic], Source={StaticResource Loc}}"
                                      Click="FontItalicToggleButton_Click"/>
                    </StackPanel>

                    <Border Width="1"
                            Height="20"
                            Margin="0,6,14,6"
                            Background="{DynamicResource BorderColor}"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding [NodeTextColor], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <Button x:Name="FontColorButton"
                                Style="{StaticResource EditorColorSwatchButtonStyle}"
                                Click="FontColorButton_Click"
                                ToolTip="{Binding [SelectColor], Source={StaticResource Loc}}"/>
                        <Button Content="{icons:Icon Kind=Close, Size=12}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                Width="28" Height="28"
                                x:Name="FontColorClearButton" Click="FontColorClearButton_Click"
                                ToolTip="{Binding [ClearColor], Source={StaticResource Loc}}"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock x:Name="FontPanelHintText"
                           Text="{Binding [MindMapFontNoSelectionHint], Source={StaticResource Loc}}"
                           Margin="0,8,0,0"
                           FontSize="{StaticResource Type.Caption}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextColorSecondary}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        </motion:LayoutRevealHost>

        <Grid Grid.Row="3" Margin="24,10,24,10">
            <motion:LayoutRevealHost Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16">
                <controls:CollectionSelectionDock x:Name="NodeSelectionDock" Visibility="Collapsed"/>
            </motion:LayoutRevealHost>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="0"
                    IsHitTestVisible="False"/>
            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" CornerRadius="{StaticResource Radius.Card}"
                    Background="{DynamicResource CardBackground}"
                    behaviors:RoundedClipBehavior.IsEnabled="True"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
            <ScrollViewer x:Name="MapScrollViewer"
                          Focusable="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          SizeChanged="MapScrollViewer_SizeChanged"
                          PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                <!-- The zoom transform wraps BOTH the live canvas and the tile layer so cached
                     zoom-level tiles map 1:1 onto the device grid during zoom/pan sessions. -->
                <Grid x:Name="MapViewport">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Canvas x:Name="MapCanvas"
                            MinWidth="960"
                            MinHeight="420"
                            Background="Transparent"
                            SizeChanged="MapCanvas_SizeChanged"/>
                    <Image x:Name="MapSnapshotLayer"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"
                           Stretch="Fill"/>
                </Grid>
            </ScrollViewer>
            </controls:SurfaceMaterialBorder>
        </Grid>

        <Border motion:WindowMotion.Role="Footer" Grid.Row="4"
                Margin="24,0,24,12"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="10,10,10,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left">
                    <Button Content="{Binding [MindMapExportAll], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="150"
                            Click="ExportAllButton_Click"/>
                    <Button Content="{Binding [MindMapExportSelectedBranch], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="170"
                            Click="ExportSelectedBranchButton_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="110"
                            Click="CloseButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

    </Grid>
        </controls:FeatureWindowShell.Body>
    </controls:FeatureWindowShell>
</Window>
