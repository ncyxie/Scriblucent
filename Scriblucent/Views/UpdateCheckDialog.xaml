<Window x:Class="Scriblucent.Views.UpdateCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UpdateCheck"
        Height="420"
        Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid x:Name="OverlayRoot">
        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="DialogCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="30,28,30,24"
                    MaxWidth="560">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="36" ShadowDepth="0"/>
                </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="{DynamicResource FlashcardKnownChipBackground}"
                            BorderBrush="{DynamicResource FlashcardKnownChipBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FlashcardKnownChipForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleText}"
                               Margin="16,2,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="26"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding MessageText}"
                           FontSize="14"
                           Foreground="{DynamicResource TextColor}"
                           Opacity="0.86"
                           TextWrapping="Wrap"
                           Margin="64,0,0,18"
                           LineHeight="20"/>

                <Border Grid.Row="2"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="64,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentVersionText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding LatestVersionText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PublishedText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Visibility="{Binding PublishedVisibility}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Background="{DynamicResource WindowBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="64,0,0,18"
                        Visibility="{Binding ReleaseNotesVisibility}">
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotesText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColor}"
                                   Opacity="0.82"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding CloseText}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="20,10"
                            MinWidth="110"
                            Click="CloseButton_Click"/>

                    <Button Content="{Binding OpenReleasesText}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Padding="20,10"
                            MinWidth="140"
                            Margin="12,0,0,0"
                            Visibility="{Binding OpenReleasesVisibility}"
                            Click="OpenReleasesButton_Click"/>
                </StackPanel>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
