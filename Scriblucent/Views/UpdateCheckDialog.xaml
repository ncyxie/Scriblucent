<Window x:Class="Scriblucent.Views.UpdateCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="UpdateCheck"
        Height="420"
        Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="560"
                                 CardPadding="30,28,30,24">
        <controls:OverlayDialogShell.Header>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level 5 status glyph: fill only (role I soft). -->
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Grid.Column="0"
                        Width="48"
                        Height="48"
                        Background="{DynamicResource FlashcardKnownChipBackground}"
                        BorderThickness="0"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <icons:AppIcon Kind="{Binding IconKind}"
                                   Width="22"
                                   Height="22"
                                   Foreground="{DynamicResource FlashcardKnownChipForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </controls:SurfaceMaterialBorder>

                <TextBlock Grid.Column="1"
                           Text="{Binding TitleText}"
                           Margin="16,2,0,0"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           TextWrapping="Wrap"
                           LineHeight="26"/>
            </Grid>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding MessageText}"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextColor}"
                           Opacity="0.86"
                           TextWrapping="Wrap"
                           Margin="64,0,0,18"
                           LineHeight="20"/>

                <Border x:Name="VersionSummaryFrame" Grid.Row="1" Style="{StaticResource ContentInsetBorderStyle}"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="64,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentVersionText}"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding LatestVersionText}"
                                   FontSize="{StaticResource Type.Meta}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PublishedText}"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Visibility="{Binding PublishedVisibility}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ReleaseNotesFrame" Grid.Row="2" Style="{StaticResource ContentInsetBorderStyle}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        Padding="12"
                        Margin="64,0,0,18"
                        Visibility="{Binding ReleaseNotesVisibility}">
                    <FlowDocumentScrollViewer x:Name="ReleaseNotesViewer"
                                              Document="{Binding ReleaseNotesDocument}"
                                              MaxHeight="280"
                                              Loaded="ReleaseNotesViewer_Loaded"
                                              PreviewMouseWheel="ReleaseNotesViewer_PreviewMouseWheel"
                                              behaviors:RoundedClipBehavior.IsEnabled="True"
                                              behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                              IsToolBarVisible="False"
                                              IsSelectionEnabled="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"/>
                </Border>
            </Grid>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding CloseText}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CloseButton_Click"/>

                <Button Content="{Binding OpenReleasesText}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="140"
                        Margin="12,0,0,0"
                        Visibility="{Binding OpenReleasesVisibility}"
                        Click="OpenReleasesButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
