<Window x:Class="Scriblucent.Views.BulkRenameDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Scriblucent.Controls"
 FontFamily="{DynamicResource FontFamily.UI}" FontSize="{DynamicResource Type.Control.Toolbar}" Title="{Binding [RenameDialogTitle], Source={StaticResource Loc}}" Width="560" SizeToContent="Height"
 WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True">
 <controls:OverlayDialogShell MaxCardWidth="560" CardPadding="20">
  <controls:OverlayDialogShell.Header>
   <TextBlock Text="{Binding [RenameDialogTitle], Source={StaticResource Loc}}" FontSize="{StaticResource Type.DialogTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,14"/>
  </controls:OverlayDialogShell.Header>
  <controls:OverlayDialogShell.Body>
   <StackPanel>
    <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="RuleChanged" Margin="{StaticResource Field.RowMargin}">
     <ComboBoxItem Content="{Binding [RenameTo], Source={StaticResource Loc}}"/>
     <ComboBoxItem Content="{Binding [RenameReplace], Source={StaticResource Loc}}"/>
     <ComboBoxItem Content="{Binding [RenameAffixes], Source={StaticResource Loc}}"/>
     <ComboBoxItem Content="{Binding [RenameNumbered], Source={StaticResource Loc}}"/>
    </ComboBox>
    <StackPanel x:Name="NameFields" Margin="{StaticResource Field.RowMargin}">
     <TextBlock Text="{Binding [RenameTo], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
     <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="NameBox" TextChanged="RuleChanged"/></Border>
    </StackPanel>
    <Grid x:Name="ReplaceFields" Margin="{StaticResource Field.RowMargin}" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,6,0"><TextBlock Text="{Binding [FindLabel], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="FindBox" TextChanged="RuleChanged"/></Border></StackPanel>
     <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock x:Name="ReplacementLabel" Text="{Binding [ReplaceLabel], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="ReplacementBox" TextChanged="RuleChanged"/></Border></StackPanel>
    </Grid>
    <Grid x:Name="AffixFields" Margin="{StaticResource Field.RowMargin}" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,6,0"><TextBlock Text="{Binding [RenamePrefix], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="PrefixBox" TextChanged="RuleChanged"/></Border></StackPanel>
     <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="{Binding [RenameSuffix], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="SuffixBox" TextChanged="RuleChanged"/></Border></StackPanel>
    </Grid>
    <Grid x:Name="NumberFields" Margin="{StaticResource Field.RowMargin}" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding [RenameBase], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="BaseBox" TextChanged="RuleChanged"/></Border></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding [RenameStart], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="{StaticResource Field.LabelMargin}"/>
      <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"><TextBox Style="{StaticResource EmbeddedFieldTextBoxStyle}" FontSize="{StaticResource Type.Control.Form}" x:Name="StartBox" Text="1" TextChanged="RuleChanged"/></Border></StackPanel>
    </Grid>
    <TextBlock x:Name="PreviewCount" Style="{StaticResource FormHelperTextStyle}" Margin="0,0,0,8"/>
    <ItemsControl x:Name="PreviewList" MaxHeight="210" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
     <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer Style="{StaticResource RoundedCompactScrollViewerStyle}" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Before}" ToolTip="{Binding Before}" Foreground="{DynamicResource TextColorSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding After}" ToolTip="{Binding After}" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       </Grid>
      </controls:SurfaceMaterialBorder>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <controls:InlineValidationPresenter x:Name="Validation" Margin="0,8,0,0"/>
   </StackPanel>
  </controls:OverlayDialogShell.Body>
  <controls:OverlayDialogShell.Footer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}" Style="{StaticResource DialogSecondaryButtonStyle}" Padding="14,7" Margin="0,0,8,0" Click="CancelClick"/>
    <Button x:Name="ApplyButton" Content="{Binding [RenameApply], Source={StaticResource Loc}}" Style="{StaticResource DialogPrimaryButtonStyle}" Padding="14,7" Click="ApplyClick" IsDefault="True"/>
   </StackPanel>
  </controls:OverlayDialogShell.Footer>
 </controls:OverlayDialogShell>
</Window>
