<Window x:Class="Scriblucent.Views.FlashcardImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid x:Name="ContentRoot">
        <!-- Backdrop: fades only, never moves - a scrim behind a photo shouldn't slide, that
             reads as the whole scene being one flat picture instead of a photo floating above a
             dimmed room. Cheap by construction: a single pre-blurred snapshot captured once (see
             OverlayBackdropCapture, already used by every other overlay in this app), not a live
             per-frame blur - no ongoing GPU/CPU cost while the viewer is open. -->
        <Grid x:Name="BackdropLayer">
            <Image x:Name="BackdropImage" Stretch="Fill"/>
            <Border Background="#B3000000"/>
        </Grid>
        <!-- Foreground: scales in from center with its own fade, independent of the backdrop -
             the "photo lifts into view" motion, not a slide. -->
        <Grid x:Name="ForegroundLayer" RenderTransformOrigin="0.5,0.5">
            <Image x:Name="ViewerImage"
                   Stretch="Uniform"
                   Margin="70"
                   SnapsToDevicePixels="True">
                <Image.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="48" ShadowDepth="0"/>
                </Image.Effect>
            </Image>
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Background="#33FFFFFF"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    MouseLeftButtonUp="CloseBorder_MouseLeftButtonUp">
                <icons:AppIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
            </Border>
        </Grid>
    </Grid>
</Window>
