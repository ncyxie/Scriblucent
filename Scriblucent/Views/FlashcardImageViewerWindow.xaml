<Window x:Class="Scriblucent.Views.FlashcardImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:services="clr-namespace:Scriblucent.Services"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:localization="clr-namespace:Scriblucent.Localization"
        Title="{Binding [FlashcardViewImage], Source={x:Static localization:LocalizationProvider.Instance}}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid x:Name="ContentRoot">
        <!-- Backdrop: fades only, never moves - a scrim behind a photo shouldn't slide, that
             reads as the whole scene being one flat picture instead of a photo floating above a
             dimmed room. Cheap by construction: a single pre-blurred snapshot captured once (see
             OverlayBackdropCapture, already used by every other overlay in this app), not a live
             per-frame blur - no ongoing GPU/CPU cost while the viewer is open. -->
        <Grid x:Name="BackdropLayer"
              behaviors:RoundedClipBehavior.IsEnabled="True"
              behaviors:RoundedClipBehavior.CornerRadius="{x:Static services:OverlayScrimRounding.WindowMatchRadius}">
            <Image x:Name="BackdropImage" Stretch="Fill"/>
            <Border Background="#B3000000"/>
        </Grid>
        <!-- Foreground travels from the visible thumbnail; its baked shadow follows. -->
        <Grid x:Name="ForegroundLayer" RenderTransformOrigin="0.5,0.5">
            <controls:BakedElevationLayer Kind="Dialog" x:Name="ImageShadow" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="ViewerImage"
                   Stretch="Uniform"
                   Margin="70"
                   SnapsToDevicePixels="True">

            </Image>
            <Button x:Name="CloseButton" Width="36" Height="36"
                    Style="{DynamicResource OverlayCloseIconButtonStyle}"
                    Background="#33FFFFFF"
                    Foreground="White"
                    controls:InteractionSurface.HoverBackground="#55FFFFFF"
                    controls:InteractionSurface.PressedBackground="#66FFFFFF"
                    ToolTip="{Binding [Close], Source={x:Static localization:LocalizationProvider.Instance}}"
                    AutomationProperties.Name="{Binding [Close], Source={x:Static localization:LocalizationProvider.Instance}}"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    Click="CloseButton_Click">
                <icons:AppIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</Window>
