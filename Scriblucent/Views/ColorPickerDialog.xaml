<Window x:Class="Scriblucent.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        Title="{Binding [SelectColor], Source={StaticResource Loc}}"
        Width="400"
        Height="480"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="RecentColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True"
                                behaviors:RoundedClipBehavior.IsEnabled="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <controls:OverlayDialogShell MaxCardWidth="380"
                                  CardPadding="20">
        <controls:OverlayDialogShell.Header>
            <TextBlock Text="{Binding [SelectColor], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.DialogTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,14"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <!-- Saturation / Value field (rounded clip so gradients follow CornerRadius). -->
                <Border x:Name="SpectrumBorder"
                        Width="320"
                        Height="180"
                        HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        Cursor="Cross"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="Spectrum_MouseLeftButtonDown"
                        MouseMove="Spectrum_MouseMove"
                        MouseLeftButtonUp="Spectrum_MouseLeftButtonUp">
                    <Grid>
                        <Border x:Name="SpectrumHueFill"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop x:Name="SpectrumHueStop" Color="#FFFF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border IsHitTestVisible="False"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SpectrumThumb"
                                     Width="14"
                                     Height="14"
                                     Stroke="White"
                                     StrokeThickness="2"
                                     Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="2"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Hue rainbow -->
                <Border x:Name="HueTrackBorder"
                        Margin="0,12,0,0"
                        Width="320"
                        Height="18"
                        HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="9"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                            <GradientStop Color="#FF00FF00" Offset="0.33"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                            <GradientStop Color="#FF0000FF" Offset="0.67"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                            <GradientStop Color="#FFFF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Slider x:Name="HueSlider"
                            Minimum="0"
                            Maximum="360"
                            Value="0"
                            Opacity="0.92"
                            VerticalAlignment="Center"
                            Margin="0,-4"
                            ValueChanged="HueSlider_ValueChanged"/>
                </Border>

                <!-- Preview + hex: same vertical band; flat gray field (no Elevation.Field). -->
                <Grid Margin="0,14,0,0"
                      Width="320"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewSwatch"
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            CornerRadius="{StaticResource Radius.Control}"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Background="#1A1A1A"
                            SnapsToDevicePixels="True"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding [ColorHex], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"/>
                    <Border Grid.Column="2"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="8,0"
                            SnapsToDevicePixels="True">
                        <TextBox x:Name="HexTextBox"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontFamily="Consolas"
                                 MaxLength="7"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Effect="{x:Null}"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 ToolTip="#RRGGBB"
                                 TextChanged="HexTextBox_TextChanged"
                                 LostFocus="HexTextBox_LostFocus"
                                 KeyDown="HexTextBox_KeyDown"/>
                    </Border>
                </Grid>

                <!-- Recent colors -->
                <StackPanel x:Name="RecentColorsSection"
                            Margin="0,14,0,0"
                            Width="320"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="{Binding [RecentColors], Source={StaticResource Loc}}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"
                               Margin="0,0,0,8"/>
                    <WrapPanel x:Name="RecentColorsPanel"/>
                </StackPanel>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="96"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="{Binding [SelectColor], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="110"
                        Padding="16,8"
                        Click="Confirm_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
