<Window x:Class="Scriblucent.Views.FlashcardStudyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="Flashcard History"
        Height="600"
        Width="820"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}">
    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="{StaticResource Shell.FeatureTitleRowPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Flashcard history"
                                   FontSize="{StaticResource Type.DialogTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{Binding SummaryText}"
                                   Margin="0,5,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                        <Border Padding="10,6" Margin="10,0,0,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource SelectionBackground}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Known" FontSize="{StaticResource Type.Chip}" Foreground="{DynamicResource TextColorSecondary}"/>
                                <TextBlock Text="{Binding KnownText}" FontSize="{StaticResource Type.Meta}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="10,6" Margin="8,0,0,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource SelectionBackground}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Unknown" FontSize="{StaticResource Type.Chip}" Foreground="{DynamicResource TextColorSecondary}"/>
                                <TextBlock Text="{Binding UnknownText}" FontSize="{StaticResource Type.Meta}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="10,6" Margin="8,0,0,0" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource SelectionBackground}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Studied" FontSize="{StaticResource Type.Chip}" Foreground="{DynamicResource TextColorSecondary}"/>
                                <TextBlock Text="{Binding StudiedText}" FontSize="{StaticResource Type.Meta}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <Grid Margin="20,16,20,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True"
                                      ClipToBounds="False">
                                    <controls:CardShadowLayer/>
                                    <Border Padding="16,14"
                                            Background="{DynamicResource CardBackground}"
                                            BorderThickness="0"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource Type.SectionTitle}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColor}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}"
                                                           Margin="0,6,0,0"
                                                           FontSize="{StaticResource Type.Caption}"
                                                           Foreground="{DynamicResource TextColorSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="12,6"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0"
                                                    Background="{DynamicResource CardBackground}"
                                                    BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSuccessSubtle}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="{StaticResource Type.Meta}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextColor}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No flashcard study progress yet"
                           FontSize="{StaticResource Type.BlockTitle}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextColorSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </controls:FeatureWindowShell.Body>

        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding ClearButtonText}"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding HasItems}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="ClearAllButton_Click"/>
                    <Button Content="Close"
                            Padding="14,8"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
    </Grid>
</Window>
