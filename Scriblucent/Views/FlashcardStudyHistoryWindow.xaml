<Window x:Class="Scriblucent.Views.FlashcardStudyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="Flashcard History"
        Height="600"
        Width="820"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}">
    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="{StaticResource Shell.FeatureTitleRowPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Flashcard history"
                                   FontSize="{StaticResource Type.DialogTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{Binding SummaryText}"
                                   Margin="0,5,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource HistorySummaryChipStyle}"
                                Margin="10,0,0,0"
                                Background="{DynamicResource FlashcardKnownChipBackground}">
                            <StackPanel>
                                <TextBlock Text="{Binding [Known], Source={StaticResource Loc}}"
                                           Style="{StaticResource HistorySummaryChipLabelStyle}"
                                           Foreground="{DynamicResource FlashcardKnownChipForeground}"/>
                                <TextBlock Text="{Binding KnownText}"
                                           Style="{StaticResource HistorySummaryChipValueStyle}"
                                           Foreground="{DynamicResource FlashcardKnownChipForeground}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HistorySummaryChipStyle}"
                                Margin="8,0,0,0"
                                Background="{DynamicResource FlashcardUnknownChipBackground}">
                            <StackPanel>
                                <TextBlock Text="{Binding [Unknown], Source={StaticResource Loc}}"
                                           Style="{StaticResource HistorySummaryChipLabelStyle}"
                                           Foreground="{DynamicResource FlashcardUnknownChipForeground}"/>
                                <TextBlock Text="{Binding UnknownText}"
                                           Style="{StaticResource HistorySummaryChipValueStyle}"
                                           Foreground="{DynamicResource FlashcardUnknownChipForeground}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HistorySummaryChipStyle}"
                                Margin="8,0,0,0"
                                Background="{DynamicResource FlashcardNewChipBackground}">
                            <StackPanel>
                                <TextBlock Text="Studied"
                                           Style="{StaticResource HistorySummaryChipLabelStyle}"
                                           Foreground="{DynamicResource FlashcardNewChipForeground}"/>
                                <TextBlock Text="{Binding StudiedText}"
                                           Style="{StaticResource HistorySummaryChipValueStyle}"
                                           Foreground="{DynamicResource FlashcardNewChipForeground}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <Grid Margin="20,16,20,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="0"
                              ClipToBounds="True"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"
                                                        UseLayoutRounding="True"
                                                        SnapsToDevicePixels="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="16,14"
                                        Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Grid UseLayoutRounding="True"
                                          SnapsToDevicePixels="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}"
                                                       Margin="0,6,0,0"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       Foreground="{DynamicResource TextColorSecondary}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource HistoryStatusChipStyle}">
                                                    <Setter Property="Background" Value="{DynamicResource FlashcardNewChipBackground}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Known">
                                                            <Setter Property="Background" Value="{DynamicResource FlashcardKnownChipBackground}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Complete">
                                                            <Setter Property="Background" Value="{DynamicResource FlashcardKnownChipBackground}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Unknown">
                                                            <Setter Property="Background" Value="{DynamicResource FlashcardUnknownChipBackground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HistoryStatusChipTextStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource FlashcardNewChipForeground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Known">
                                                                <Setter Property="Foreground" Value="{DynamicResource FlashcardKnownChipForeground}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Complete">
                                                                <Setter Property="Foreground" Value="{DynamicResource FlashcardKnownChipForeground}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Unknown">
                                                                <Setter Property="Foreground" Value="{DynamicResource FlashcardUnknownChipForeground}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No flashcard study progress yet"
                           FontSize="{StaticResource Type.BlockTitle}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextColorSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </controls:FeatureWindowShell.Body>

        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding ClearButtonText}"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding HasItems}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="ClearAllButton_Click"/>
                    <Button Content="Close"
                            Padding="14,8"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
    </Grid>
</Window>
