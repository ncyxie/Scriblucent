																					MaxHeight="280">
																				<Border Background="Transparent"
																						CornerRadius="{StaticResource Radius.Card}"
																						Padding="12"
																						behaviors:RoundedClipBehavior.IsEnabled="True"
																						SnapsToDevicePixels="True"
																						DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}">
																					<StackPanel>
																						<TextBlock Text="{Binding Title}"
																								   FontSize="{StaticResource Type.CardTitle}"
																								   FontWeight="SemiBold"
																								   Foreground="{DynamicResource TextColor}"
																								   Margin="0,0,0,8"
																								   TextTrimming="CharacterEllipsis"/>
																						<ScrollViewer Style="{StaticResource RoundedCompactScrollViewerStyle}" MaxHeight="220"
																									  VerticalScrollBarVisibility="Auto"
																									  HorizontalScrollBarVisibility="Disabled">
																							<ItemsControl ItemsSource="{Binding HoverContentPreviewItems}">
																								<ItemsControl.ItemTemplate>
																									<DataTemplate>
																										<TextBlock Text="{Binding}"
																												   Foreground="{DynamicResource TextColorSecondary}"
																												   FontSize="{StaticResource Type.Meta}"
																												   TextWrapping="Wrap"
																												   Margin="0,1,0,1"/>
																									</DataTemplate>
																								</ItemsControl.ItemTemplate>
																							</ItemsControl>
																						</ScrollViewer>
																					</StackPanel>
																				</Border>
																			</controls:SurfaceMaterialBorder>
																		</Grid>
																	</Border>
																</Popup>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
