                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                  Click="DuplicateMindMapMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                  Click="DeleteMindMapMenuItem_Click"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Grid>
                                                                            <controls:CardShadowLayer/>
                                                                            <Border x:Name="GroupedMindMapCardBorder" Style="{DynamicResource DashboardGroupedListingCardStyle}">
                                                                                <Grid>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>
                                                                                    <CheckBox Grid.RowSpan="3"
                                                                                              HorizontalAlignment="Right"
                                                                                              VerticalAlignment="Top"
                                                                                              Margin="0,0,2,0"
                                                                                              Panel.ZIndex="6"
                                                                                              Style="{StaticResource DashboardMassSelectCheckBoxStyle}"

                                                                                              />
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Border Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="{StaticResource Radius.Card}"
                                                                                                Background="{DynamicResource IconButtonBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                                                ToolTip="{Binding AiGeneratedTooltip}"
                                                                                                Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <icons:AppIcon Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                                            <icons:AppIcon Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="12" Height="12" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding NextScheduleDisplay}"/>
                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                       FontSize="{StaticResource Type.CardTitle}"
                                                                                                       FontWeight="SemiBold"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Button x:Name="ListingContextMenuButton"
                                                                                                Grid.Column="2"
                                                                                                Tag="{Binding}"
                                                                                                Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                                                Style="{DynamicResource DashboardListingMenuButtonStyle}"
                                                                                                ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                                                Click="ListingContextMenuButton_Click"/>
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                       Text="{Binding NodeCountText}"
                       FontSize="{StaticResource Type.Caption}"
                       Foreground="{DynamicResource TextColorSecondary}"
                       Margin="0,6,0,0"/>
                                                                                    <Border Grid.Row="2"
                                                                                            Style="{StaticResource DashboardTagChipStyle}">
                                                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                                                   Style="{StaticResource DashboardTagTextStyle}"/>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </controls:DashboardTileHost>
                                                                    </DataTemplate>
                                                            </controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                            </controls:DashboardVirtualizedCardGrid>
                                                            </controls:DashboardVirtualizationHost>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                        <Border x:Name="MindMapDashboardUngroupedSectionContainer"
                                                Margin="0,0,0,10"
                                                MinHeight="96"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Overlay}"
                                                AllowDrop="True"
                                                DragOver="DashboardUngroupedDropZone_DragOver"
                                                DragLeave="DashboardUngroupedDropZone_DragLeave"
                                                Drop="DashboardUngroupedDropZone_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ShouldShowMindMapsDashboardContent}" Value="True"/>
                                                                <Condition Binding="{Binding IsMindMapDashboardUngroupedSectionVisible}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsMindMapDashboardGroupsFirst}" Value="False">
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                        <Grid Margin="10,2,10,8"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="DashboardUngroupedDropZone_DragOver"
                                              DragLeave="DashboardUngroupedDropZone_DragLeave"
                                              Drop="DashboardUngroupedDropZone_Drop">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,2,0" Content="{icons:Icon Kind=ArrowUp, Size=12}" ToolTip="{Binding [MoveUngroupedSectionUp], Source={StaticResource Loc}}" Click="MoveMindMapDashboardUngroupedUpButton_Click"/>
                                            <Button Grid.Column="1" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,4,0" Content="{icons:Icon Kind=ArrowDown, Size=12}" ToolTip="{Binding [MoveUngroupedSectionDown], Source={StaticResource Loc}}" Click="MoveMindMapDashboardUngroupedDownButton_Click"/>
                                            <Button Grid.Column="2" ToolTip="{Binding [ToggleUngroupedSection], Source={StaticResource Loc}}" Click="ToggleMindMapDashboardUngroupedSectionButton_Click"
                                            Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsMindMapDashboardUngroupedSectionExpanded}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel x:Name="MindMapDashboardUngroupedSectionBody">
                                        <controls:DashboardVirtualizationHost ScrollViewerElement="{Binding ElementName=MindMapsScrollViewer}"
                                                                              MotionScope="{x:Static services:DashboardMotionScope.MindMaps}">
                                        <controls:DashboardVirtualizedCardGrid x:Name="MindMapDashboardUngroupedItemsControl"
                                                      ItemsSource="{Binding MindMapsView}"
                                                      ItemCellSize="360,224"
                                                      AllowDrop="True"
                                                      DragOver="DashboardUngroupedDropZone_DragOver"
                                                      DragLeave="DashboardUngroupedDropZone_DragLeave"
                                                      Drop="DashboardUngroupedDropZone_Drop"
                                                      Visibility="{Binding HasUngroupedMindMaps, Converter={StaticResource BoolToVis}}">
                                            <controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                    <controls:DashboardTileHost RendererKey="MindMapUngrouped">
													<Border x:Name="MindMapCardButton"
															Tag="{Binding}"
															Width="350"
															MinHeight="204"
                                                            Margin="0,0,10,10"
                                                            Padding="10"
                                                            Background="Transparent"
                                                            Cursor="Hand"
                                                            AllowDrop="True"
                                                            behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
                                                            behaviors:CardSurfaceMotionBehavior.Profile="Listing"
                                                            behaviors:CardSurfaceMotionBehavior.ShadowElementName="MindMapCardBorder"
                                                            PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                            MouseMove="DashboardListing_PreviewMouseMove"
                                                            MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
                                                            DragEnter="DashboardListing_PreviewDragEnter"
                                                            DragOver="DashboardListing_PreviewDragOver"
                                                            DragLeave="DashboardListing_PreviewDragLeave"
                                                            Drop="DashboardListing_PreviewDrop">
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                  Click="OpenMindMapMenuItem_Click"/>
                                                            <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}"
                  Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="MindMapInfoMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                          Click="ToggleMindMapPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                          Click="ToggleMindMapPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleMindMapMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                          Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                          Click="RemoveMindMapFromGroupMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                  Click="DuplicateMindMapMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                  Click="DeleteMindMapMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                        <Grid>
                        <controls:CardShadowLayer Margin="8,3,8,0"/>
                                                        <Border x:Name="MindMapCardBorder"
                                                                Style="{DynamicResource DashboardListingCardSelectionStyle}"
                                                                CornerRadius="{StaticResource Radius.Card}"
                                                                Padding="16"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                                                                    <TranslateTransform Y="0"/>
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
															<Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <CheckBox Grid.RowSpan="3"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,0,2,0"
                                                                          Panel.ZIndex="6"
                                                                          Style="{StaticResource DashboardMassSelectCheckBoxStyle}"

                                                                          />

																<Popup PlacementTarget="{Binding ElementName=MindMapContentPreviewBorder}"
																	   AllowsTransparency="True"
																	   PopupAnimation="None"
																	   StaysOpen="True"
																	   Opened="MindMapHoverPreviewPopup_Opened"
																	   Closed="MindMapHoverPreviewPopup_Closed">
																	<Popup.Style>
																		<Style TargetType="Popup">
																			<Setter Property="IsOpen" Value="False"/>
																			<Style.Triggers>
																				<MultiDataTrigger>
																					<MultiDataTrigger.Conditions>
																						<Condition Binding="{Binding PlacementTarget.DataContext.HasHoverContentPreview, RelativeSource={RelativeSource Self}}" Value="True"/>
																						<Condition Binding="{Binding PlacementTarget.IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
																					</MultiDataTrigger.Conditions>
																					<Setter Property="IsOpen" Value="True"/>
																				</MultiDataTrigger>
																			</Style.Triggers>
																		</Style>
																	</Popup.Style>
																	<!-- Symmetric padding for Elevation.Popup falloff; position set in code (Relative to cursor). -->
																	<Border Background="Transparent"
																	        Padding="28,28,28,32"
																	        ClipToBounds="False">
																		<Grid MaxWidth="340"
																		      HorizontalAlignment="Left"
																		      UseLayoutRounding="True"
																		      SnapsToDevicePixels="True">
																			<Border Background="{DynamicResource CardBackground}"
																					BorderBrush="{DynamicResource PopupBorder}"
																					BorderThickness="1"
																					CornerRadius="{StaticResource Radius.Card}"
																					IsHitTestVisible="False"
																					Effect="{StaticResource Elevation.Popup}"/>
																			<Border Background="{DynamicResource CardBackground}"
																					BorderBrush="{DynamicResource PopupBorder}"
																					BorderThickness="1"
																					CornerRadius="{StaticResource Radius.Card}"
																					SnapsToDevicePixels="True"
																					MaxHeight="280">
																				<Border Background="Transparent"
																						CornerRadius="{StaticResource Radius.Card}"
																						Padding="12"
																						behaviors:RoundedClipBehavior.IsEnabled="True"
																						SnapsToDevicePixels="True"
																						DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}">
																					<StackPanel>
																						<TextBlock Text="{Binding Title}"
																								   FontSize="{StaticResource Type.CardTitle}"
																								   FontWeight="SemiBold"
																								   Foreground="{DynamicResource TextColor}"
																								   Margin="0,0,0,8"
																								   TextTrimming="CharacterEllipsis"/>
																						<ScrollViewer MaxHeight="220"
																									  VerticalScrollBarVisibility="Auto"
																									  HorizontalScrollBarVisibility="Disabled">
																							<ItemsControl ItemsSource="{Binding HoverContentPreviewItems}">
																								<ItemsControl.ItemTemplate>
																									<DataTemplate>
																										<TextBlock Text="{Binding}"
																												   Foreground="{DynamicResource TextColorSecondary}"
																												   FontSize="{StaticResource Type.Meta}"
																												   TextWrapping="Wrap"
																												   Margin="0,1,0,1"/>
																									</DataTemplate>
																								</ItemsControl.ItemTemplate>
																							</ItemsControl>
																						</ScrollViewer>
																					</StackPanel>
																				</Border>
																			</Border>
																		</Grid>
																	</Border>
																</Popup>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0"
                                                                            Width="24"
                                                                            Height="24"
                                                                            Margin="0,0,6,0"
                                                                            CornerRadius="{StaticResource Radius.Card}"
                                                                            Background="{DynamicResource IconButtonBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                            ToolTip="{Binding AiGeneratedTooltip}"
                                                                            Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                       <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                        <icons:AppIcon Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="14" Height="14" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                        <icons:AppIcon Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding NextScheduleDisplay}"/>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="{StaticResource Type.CardTitle}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="ListingContextMenuButton"
                                                                            Grid.Column="2"
                                                                            Tag="{Binding}"
                                                                            Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                            Style="{DynamicResource DashboardListingMenuButtonStyle}"
                                                                            ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                            Click="ListingContextMenuButton_Click"/>
                                                                </Grid>

																<Grid Grid.Row="1"
																	  Margin="0,12,0,0"
																	  Visibility="{Binding HasContentPreview, Converter={StaticResource BoolToVis}}">
																	<Grid.ColumnDefinitions>
													<ColumnDefinition Width="180"/>
																		<ColumnDefinition Width="*"/>
																	</Grid.ColumnDefinitions>

																	<TextBlock Grid.Column="0"
																			   Text="{Binding NodeCountText}"
																			   FontSize="{StaticResource Type.Meta}"
																			   Foreground="{DynamicResource TextColorSecondary}"
																			   VerticalAlignment="Top"/>

																	<Border x:Name="MindMapContentPreviewBorder"
																			Grid.Column="1"
																			Background="{DynamicResource WindowBackground}"
																			BorderThickness="0"
																			CornerRadius="{StaticResource Radius.Control}"
													Padding="10,8"
																			Margin="8,0,0,0"
													MinHeight="82"
																			MouseMove="MindMapContentPreviewBorder_MouseMove">
																		<ScrollViewer VerticalScrollBarVisibility="Auto"
																					  HorizontalScrollBarVisibility="Disabled">
																			<ItemsControl ItemsSource="{Binding ContentPreviewItems}">
																				<ItemsControl.ItemTemplate>
																					<DataTemplate>
																						<TextBlock Text="{Binding}"
																								   Foreground="{DynamicResource TextColorSecondary}"
																		   FontSize="{StaticResource Type.Meta}"
																								   TextTrimming="CharacterEllipsis"
																		   Margin="0,2,0,2"/>
																					</DataTemplate>
																				</ItemsControl.ItemTemplate>
																			</ItemsControl>
																		</ScrollViewer>
																	</Border>
																</Grid>

																<StackPanel Grid.Row="1"
																			Orientation="Horizontal"
																			Margin="0,14,0,0"
																			Visibility="{Binding HasContentPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
																	<TextBlock Text="{Binding NodeCountText}"
																			   FontSize="{StaticResource Type.Meta}"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																	<TextBlock Text="  •  "
																			   FontSize="{StaticResource Type.Meta}"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																	<TextBlock Text="{Binding BranchCountText}"
																			   FontSize="{StaticResource Type.Meta}"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																</StackPanel>

                                                                <Border Grid.Row="2"
                                                                        Style="{StaticResource DashboardTagChipStyle}">
                                                                    <TextBlock Text="{Binding TagsDisplay}"
                                                                               Style="{StaticResource DashboardTagTextStyle}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                        </Grid>
                                                    </Border>
                                                </controls:DashboardTileHost>
                                                </DataTemplate>
                                            </controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                        </controls:DashboardVirtualizedCardGrid>
                                        </controls:DashboardVirtualizationHost>
                                            </StackPanel>
                                            </StackPanel>
                                        </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <dashboard:EmptyDashboardPanel x:Name="MindMapsEmptyDashboardPanel"
                                            Grid.Row="2"
                                            Visibility="{Binding ShowMindMapsEmptyDashboard, Converter={StaticResource BoolToVis}}"
                                            Prompt="{Binding [MindMapsEmptyDashboardPrompt], Source={StaticResource Loc}}"
                                            ButtonContent="{Binding [CreateMindMap], Source={StaticResource Loc}}"
                                            Click="CreateMindMapButton_Click"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Button x:Name="ImportButton"
                            Style="{DynamicResource FloatingSecondaryButtonStyle}"
                            Width="32"
                            Height="30"
                            FontSize="{StaticResource Type.Meta}"
                            IsEnabled="{Binding IsNotMassSelectMode}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Content="{icons:Icon Import}"
                            Margin="0,0,49,96"
                            ToolTip="{Binding [MindMapImport], Source={StaticResource Loc}}"
                            Click="ImportButton_Click"/>
                    <Button Style="{StaticResource FabStyle}"
                            IsEnabled="{Binding IsNotMassSelectMode}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Content="{icons:Icon Kind=Plus, Size=22}"
                            ToolTip="{Binding [CreateMindMap], Source={StaticResource Loc}}"
                            Click="CreateMindMapButton_Click"/>
    </Grid>
</UserControl>


