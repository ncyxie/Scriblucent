<UserControl xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.Dashboards.MindMapsDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:dashboard="clr-namespace:Scriblucent.Controls.Dashboard"
             xmlns:vm="clr-namespace:Scriblucent.ViewModels"
             xmlns:Views="clr-namespace:Scriblucent.Views"
             xmlns:converters="clr-namespace:Scriblucent.Converters"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <Grid>
<Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <motion:LayoutRevealHost Grid.Row="0">
                            <motion:LayoutRevealHost.Style>
                                <Style TargetType="motion:LayoutRevealHost">
                                    <Setter Property="IsRevealed" Value="{Binding IsRecentSectionVisible}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentMindMaps.Count}" Value="0">
                                            <Setter Property="IsRevealed" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </motion:LayoutRevealHost.Style>
                            <Border
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{StaticResource Shell.RecentPadding}"
                                ClipToBounds="False">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ReorderControlTrayStyle}">
                                    <Button
                                            ToolTip="{Binding [ToggleRecentMindMapsSection], Source={StaticResource Loc}}"
                                            Click="ToggleRecentSectionButton_Click"
                                    Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                    behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsRecentSectionExpanded}" />
                                </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding [RecentMindMaps], Source={StaticResource Loc}}"
                                               FontSize="{StaticResource Type.SectionTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="8,0,0,0"
                                               FontFamily="{StaticResource FontFamily.UI}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <motion:LayoutRevealHost>
                                <Border x:Name="MindMapRecentSectionBody"
                                        Margin="0,6,0,0"
                                        ClipToBounds="False"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <ScrollViewer Style="{StaticResource RecentItemsStripScrollViewerStyle}">
                                        <ItemsControl Style="{StaticResource RecentStripItemsStyle}"
                                                      ItemsSource="{Binding RecentMindMaps}" ItemsPanel="{StaticResource RecentItemsStripPanelTemplate}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                    <controls:DashboardTileHost RendererKey="RecentMindMap">
                                                    <Button Style="{StaticResource RecentNoteCardStyle}"
                                                            Tag="{Binding}"
                                                            Click="RecentMindMapButton_Click">
                                                        <StackPanel MinWidth="118" MaxWidth="176">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextColor}"/>
                                                            <TextBlock Text="{Binding NodeCountText}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                                       Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    </controls:DashboardTileHost>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                </motion:LayoutRevealHost>
                            </StackPanel>
                        </Border>
                        </motion:LayoutRevealHost>
                        <ScrollViewer x:Name="MindMapsScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListingScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      PreviewDragOver="DashboardScrollViewer_PreviewDragOver"
                                      PreviewDragLeave="DashboardScrollViewer_PreviewDragLeave"
                                      Drop="DashboardScrollViewer_Drop"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="{StaticResource Shell.DashboardScrollClearance}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="MindMapCalendarSectionContainer"
                                        Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,14"
                                        RenderTransformOrigin="0.5,0.5"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="12">
                                    <StackPanel>
                                        <controls:CalendarSectionHeaderPanel Margin="2,0,2,8">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveCalendarUpButton_Click" MoveDown="MoveCalendarDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
                                                        Click="ToggleCalendarSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsCalendarSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                            <controls:CalendarPlannerActions HorizontalAlignment="Right" DataContext="{Binding CalendarPlanner}"/>
                                        </controls:CalendarSectionHeaderPanel>
                                        <motion:LayoutRevealHost>
                                        <Grid x:Name="MindMapCalendarSectionBody" Margin="0">
                                            <controls:CalendarPlannerView x:Name="CalendarSectionBodySurface" DataContext="{Binding CalendarPlanner}"/>
                                        </Grid>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                </Grid>

                                <Grid x:Name="MindMapsDashboardContentHost"
                                        Margin="0,0,0,14"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShouldShowMindMapsDashboardContent}" Value="True"/>
                                                        <Condition Binding="{Binding IsMindMapGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="14">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveDashboardContentUpButton_Click" MoveDown="MoveDashboardContentDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="MindMapsDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapCalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleMindMapDashboardSection], Source={StaticResource Loc}}"
                                                        Click="ToggleMindMapGroupsSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsMindMapGroupsSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.BlockTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <motion:LayoutRevealHost>
                                        <StackPanel x:Name="MindMapGroupsSectionBody"
                                                    RenderTransformOrigin="0.5,0">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform/>
                                            </StackPanel.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="MindMapDashboardGroupsSectionContainer"
                                                        Margin="0,0,0,10"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasMindMapGroups}" Value="True"/>
                                                                        <Condition Binding="{Binding IsMindMapDashboardGroupsSectionVisible}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsMindMapDashboardGroupsFirst}" Value="False">
                                                                    <Setter Property="Grid.Row" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <StackPanel>
                                                        <Grid Margin="10,6,10,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                                        UpLabel="{Binding [MoveGroupsSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveGroupsSectionDown], Source={StaticResource Loc}}"
                                                                        MoveUp="MoveMindMapDashboardGroupsUpButton_Click" MoveDown="MoveMindMapDashboardGroupsDownButton_Click">
                                                                        <controls:PositionButtons.CanMoveUp>
                                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="Visibility"/>
                                                                            </MultiBinding>
                                                                        </controls:PositionButtons.CanMoveUp>
                                                                        <controls:PositionButtons.CanMoveDown>
                                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="Visibility"/>
                                                                            </MultiBinding>
                                                                        </controls:PositionButtons.CanMoveDown>
                                                                    </controls:PositionButtons>
                                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                                    <Button  ToolTip="{Binding [ToggleGroupsSection], Source={StaticResource Loc}}" Click="ToggleMindMapDashboardGroupsSectionButton_Click"
                                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsMindMapDashboardGroupsSectionExpanded}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding [Groups], Source={StaticResource Loc}}"
                                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <motion:LayoutRevealHost>
                                                        <StackPanel x:Name="MindMapDashboardGroupsSectionBody">
                                        <ItemsControl x:Name="MindMapDashboardGroupsItemsControl" behaviors:ItemReorderBehavior.Kind="DashboardGroups"
                                                      ItemsSource="{Binding MindMapGroups}"
                                                      Visibility="{Binding HasMindMapGroups, Converter={StaticResource BoolToVis}}"
                                                      Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapGroupViewModel}">
                                                    <controls:DashboardGroupCard Style="{DynamicResource GroupCardStyle}"
                    BorderThickness="0"
                    Margin="0,0,0,14"
                    AllowDrop="True"
                    PreviewDragOver="DashboardGroupBorder_PreviewDragOver"
                    PreviewDragLeave="DashboardGroupBorder_PreviewDragLeave"
                    PreviewDrop="DashboardGroupBorder_PreviewDrop">
                                                        <controls:DashboardGroupCard.Tag>
                                                            <Binding/>
                                                        </controls:DashboardGroupCard.Tag>
                                                        <controls:DashboardGroupLayoutPanel>
                                                            <!-- Group header with name and context menu -->
                                                            <controls:DashboardGroupHeader Style="{StaticResource DashboardGroupHeaderStyle}"
                                                                Header="{Binding Name}" ItemCount="{Binding MindMaps.Count}"
                                                                GroupBrush="{Binding BackgroundBrush}" IsExpanded="{Binding Disclosure.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ItemReorderControls Style="{StaticResource EmbeddedReorderControlTrayStyle}"/>
                                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                                    <Button Style="{StaticResource GroupDisclosureButtonStyle}" Command="{x:Static controls:DashboardGroupHeader.ToggleExpansionCommand}"
                                                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:DashboardGroupHeader}}"/>
                                                                    <Button
                                                                        Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                                                        Content="{icons:Icon Color}"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
                                                                        Click="DashboardGroupColorButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu ItemContainerStyle="{StaticResource GroupColourMenuItemStyle}" behaviors:GroupColourMenuBehavior.IsEnabled="True">
                                                                            <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorBlue], Source={StaticResource Loc}}" Tag="#EEF0FE" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorMint], Source={StaticResource Loc}}" Tag="#ECFDF3" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorRose], Source={StaticResource Loc}}" Tag="#FFF1F2" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorAmber], Source={StaticResource Loc}}" Tag="#FFFBEB" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorLilac], Source={StaticResource Loc}}" Tag="#F5F3FF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorTeal], Source={StaticResource Loc}}" Tag="#F0FDFA" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorSlate], Source={StaticResource Loc}}" Tag="#F8FAFC" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorPeach], Source={StaticResource Loc}}" Tag="#FFF7ED" Click="DashboardGroupColorMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                    <Button Margin="0"
                                Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                Tag="{Binding}"
                                Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                Click="DashboardGroupMenuButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True">
                                                                            <MenuItem Header="{Binding [RenameGroup], Source={StaticResource Loc}}"
                                              Click="RenameDashboardGroupMenuItem_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="{Binding [DisbandGroup], Source={StaticResource Loc}}"
                                              Click="DisbandDashboardGroupMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                </StackPanel>
                                                            </controls:DashboardGroupHeader>
                                                            <!-- Mind maps inside the group -->
                                                            <controls:DashboardGroupRevealHost x:Name="GroupItemsReveal" IsRevealed="{Binding Disclosure.IsExpanded}">
                                                                    <controls:DashboardVirtualizationHost HostMode="Static" Margin="0,8,0,0"
                                                                                                  MotionScope="{x:Static services:DashboardMotionScope.MindMaps}">
                                                            <controls:DashboardVirtualizedCardGrid behaviors:ItemReorderBehavior.Kind="DashboardItems" ItemsSource="{Binding MindMaps}"
                                                                                                    ItemCellSize="240,152">
                                                            <controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                                        <controls:CollectionSelectionFrame ItemId="{Binding Document.Id}" SelectionLabel="{Binding Title}" FaceName="GroupedMindMapCardBorder">
<controls:DashboardTileHost RendererKey="MindMap" PreserveLiveInputInBitmapMode="True">
                                                                        <Border Tag="{Binding}"
                                                                                Width="236"
                                                                                MinHeight="136"
                                                                                Margin="0,0,4,6"
                                                                                Padding="8"
                                                                                Background="Transparent"
                                                                                Cursor="Hand"
                                                                                AllowDrop="True"
                                                                                behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
                                                                                behaviors:CardSurfaceMotionBehavior.Profile="Listing"
                                                                                behaviors:CardSurfaceMotionBehavior.ShadowElementName="GroupedMindMapCardBorder"
                                                                                PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                                                MouseMove="DashboardListing_PreviewMouseMove"
        MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
        DragEnter="DashboardListing_PreviewDragEnter"
        DragOver="DashboardListing_PreviewDragOver"
        DragLeave="DashboardListing_PreviewDragLeave"
        Drop="DashboardListing_PreviewDrop">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                  Click="OpenMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}"
                  Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="MindMapInfoMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                                              Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                                              Click="RemoveMindMapFromGroupMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                  Click="DuplicateMindMapMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                  Click="DeleteMindMapMenuItem_Click"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Grid>
                                                                            <controls:CardShadowLayer/>
                                                                            <controls:SurfaceMaterialBorder x:Name="GroupedMindMapCardBorder" Style="{DynamicResource DashboardGroupedListingCardStyle}">
                                                                                <Grid>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>

                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="{StaticResource Radius.Card}"
                                                                                                Background="{DynamicResource IconButtonBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                                                ToolTip="{Binding AiGeneratedTooltip}"
                                                                                                Visibility="{Binding ShowAiGeneratedChrome, Converter={StaticResource BoolToVis}}">
                                                                                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                                                                                        </controls:SurfaceMaterialBorder>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <icons:AppIcon Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                                            <icons:AppIcon Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="12" Height="12" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding NextScheduleDisplay}"/>
