                        ImportLabel="{Binding [MindMapImport], Source={StaticResource Loc}}"
                        CreateIcon="MindMaps" CreateRequested="CreateMindMapButton_Click"
                        ImportRequested="ImportButton_Click"/>
    </Grid>
