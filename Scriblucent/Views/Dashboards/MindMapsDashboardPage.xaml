                                                <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                    <controls:CollectionSelectionFrame ItemId="{Binding Document.Id}" SelectionLabel="{Binding Title}" FaceName="MindMapCardBorder">
<controls:DashboardTileHost RendererKey="MindMapUngrouped" PreserveLiveInputInBitmapMode="True">
													<Border x:Name="MindMapCardButton"
