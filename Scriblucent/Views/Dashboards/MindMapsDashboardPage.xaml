                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                        <Grid Margin="10,2,10,8"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="DashboardUngroupedDropZone_DragOver"
                                              DragLeave="DashboardUngroupedDropZone_DragLeave"
                                              Drop="DashboardUngroupedDropZone_Drop">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveUngroupedSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveUngroupedSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveMindMapDashboardUngroupedUpButton_Click" MoveDown="MoveMindMapDashboardUngroupedDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="MindMapDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="MindMapDashboardGroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button  ToolTip="{Binding [ToggleUngroupedSection], Source={StaticResource Loc}}" Click="ToggleMindMapDashboardUngroupedSectionButton_Click"
