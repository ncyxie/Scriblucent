                                                                       <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                                                                    </controls:SurfaceMaterialBorder>
                                                                    <Grid Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <icons:AppIcon Grid.Column="0" Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="14" Height="14" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                        <icons:AppIcon Grid.Column="1" Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding NextScheduleDisplay}"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                                   FontSize="{StaticResource Type.CardTitle.Large}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <Button x:Name="ListingContextMenuButton"
                                                                            Grid.Column="2"
                                                                            Tag="{Binding}"
                                                                            Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                            Style="{DynamicResource DashboardListingMenuButtonStyle}"
                                                                            ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                            Click="ListingContextMenuButton_Click"/>
                                                                </Grid>

																<Grid Grid.Row="1"
																	  Margin="0,12,0,0"
