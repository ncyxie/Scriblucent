<UserControl x:Class="Scriblucent.Views.Dashboards.MindMapsDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:dashboard="clr-namespace:Scriblucent.Controls.Dashboard"
             xmlns:vm="clr-namespace:Scriblucent.ViewModels"
             xmlns:Views="clr-namespace:Scriblucent.Views"
             xmlns:converters="clr-namespace:Scriblucent.Converters"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <Grid>
<Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Visibility="{Binding IsRecentSectionVisible, Converter={StaticResource BoolToVis}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{StaticResource Shell.RecentPadding}"
                                ClipToBounds="False">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            ToolTip="{Binding [ToggleRecentMindMapsSection], Source={StaticResource Loc}}"
                                            Click="ToggleRecentSectionButton_Click"
                                    Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                    behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsRecentSectionExpanded}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding [RecentMindMaps], Source={StaticResource Loc}}"
                                               FontSize="{StaticResource Type.SectionTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="8,0,0,0"
                                               FontFamily="{StaticResource FontFamily.UI}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Border x:Name="MindMapRecentSectionBody"
                                        Margin="0,6,0,0"
                                        ClipToBounds="False"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <ScrollViewer Style="{StaticResource RecentItemsStripScrollViewerStyle}">
                                        <ItemsControl Style="{StaticResource RecentStripItemsStyle}"
                                                      ItemsSource="{Binding RecentMindMaps}" ItemsPanel="{StaticResource RecentItemsStripPanelTemplate}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                    <controls:DashboardTileHost RendererKey="RecentMindMap">
                                                    <Button Style="{StaticResource RecentNoteCardStyle}"
                                                            Tag="{Binding}"
                                                            Click="RecentMindMapButton_Click">
                                                        <StackPanel MinWidth="118" MaxWidth="176">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextColor}"/>
                                                            <TextBlock Text="{Binding NodeCountText}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                                       Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    </controls:DashboardTileHost>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="MindMapsScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListingScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      PreviewDragOver="DashboardScrollViewer_PreviewDragOver"
                                      PreviewDragLeave="DashboardScrollViewer_PreviewDragLeave"
                                      Drop="DashboardScrollViewer_Drop"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,0,0,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="MindMapCalendarSectionContainer"
                                        Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,14"
                                        RenderTransformOrigin="0.5,0.5"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="12">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="{icons:Icon Kind=ArrowUp, Size=12}"
                                                    Margin="0,0,2,0"
                                                    ToolTip="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}"
                                                    Click="MoveCalendarUpButton_Click"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="{icons:Icon Kind=ArrowDown, Size=12}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
                                                    Click="MoveCalendarDownButton_Click"/>
                                            <Button Grid.Column="2"
                                                    ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
                                                    Click="ToggleCalendarSectionButton_Click"
                                            Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsCalendarSectionExpanded}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid x:Name="MindMapCalendarSectionBody" Margin="0" Height="252">
                                            <Grid x:Name="CalendarSectionBodySurface">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource WindowBackground}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource Radius.Card}"
                                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                                    Padding="12">
                                                <Calendar x:Name="MindMapDashboardCalendar"
                                                          Style="{DynamicResource DashboardCalendarControlStyle}"
                                                          SelectedDate="{Binding CalendarSelectedDate, Mode=TwoWay}"
                                                          SelectionMode="SingleDate"
                                                          HorizontalAlignment="Stretch"
                                                          behaviors:CalendarScheduleMarkBehavior.ScheduledDates="{Binding CalendarDatesWithSchedules}"
                                                          SelectedDatesChanged="DashboardCalendar_SelectedDatesChanged"/>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource WindowBackground}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource Radius.Card}"
                                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                                    Padding="12"
                                                    ClipToBounds="False">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding CalendarSelectedDateDisplay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextColor}"
                                                               Margin="2,2,2,8"/>
                                                    <Grid Grid.Row="1">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="178" behaviors:ScrollTileBehavior.IsEnabled="True">
                                                            <ItemsControl ItemsSource="{Binding CalendarScheduledNotes}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CalendarScheduledItemViewModel}">
                                                                        <controls:DashboardTileHost RendererKey="CalendarItem">
                                                                        <Border Style="{StaticResource CalendarScheduledItemCardStyle}"
                                                                                Tag="{Binding}"
                                                                                MouseLeftButtonUp="CalendarScheduledItemCard_MouseLeftButtonUp">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button x:Name="CalendarScheduleGearButton"
                                                                                        Grid.Column="0"
                                                                                        Content="{icons:Icon Edit}"
                                                                                        Style="{DynamicResource TopBarIconButtonStyle}"
                                                                                        Width="30"
                                                                                        Height="30"
                                                                                        Margin="0,0,10,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip="{Binding [CalendarEditSchedule], Source={StaticResource Loc}}"
                                                                                        Click="CalendarScheduleGearButton_Click"/>
                                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextColor}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="0,0,0,6"/>
                                                                                    <TextBlock Text="{Binding ScheduleNote}"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxHeight="34"
                                                                                               Foreground="{DynamicResource TextColorSecondary}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="Text" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </Trigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Border Background="{DynamicResource SelectionBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                                            CornerRadius="{StaticResource Radius.Control}"
                                                                                            Padding="6,2"
                                                                                            Margin="0,0,4,0"
                                                                                            VerticalAlignment="Center">
                                                                                        <icons:AppIcon Kind="{Binding TypeIconKind}" Width="12" Height="12" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource SelectionBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                                            CornerRadius="{StaticResource Radius.Control}"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <icons:AppIcon Kind="Schedule" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                            <TextBlock Text="{Binding TimeText}" FontSize="{StaticResource Type.Meta}" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        </controls:DashboardTileHost>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <TextBlock Text="{Binding [CalendarNoSchedulesForDay], Source={StaticResource Loc}}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   Margin="10,10,10,10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCalendarScheduledNotes}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <Grid x:Name="MindMapsDashboardContentHost"
                                        Margin="0,0,0,14"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShouldShowMindMapsDashboardContent}" Value="True"/>
                                                        <Condition Binding="{Binding IsMindMapGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="14">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="{icons:Icon Kind=ArrowUp, Size=12}"
                                                    Margin="0,0,2,0"
                                                    ToolTip="{Binding [MoveSectionUp], Source={StaticResource Loc}}"
                                                    Click="MoveDashboardContentUpButton_Click"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="{icons:Icon Kind=ArrowDown, Size=12}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding [MoveSectionDown], Source={StaticResource Loc}}"
                                                    Click="MoveDashboardContentDownButton_Click"/>
                                            <Button Grid.Column="2"
                                                    ToolTip="{Binding [ToggleMindMapDashboardSection], Source={StaticResource Loc}}"
                                                    Click="ToggleMindMapGroupsSectionButton_Click"
                                            Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsMindMapGroupsSectionExpanded}" />
                                            <TextBlock Grid.Column="3"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.BlockTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel x:Name="MindMapGroupsSectionBody"
                                                    RenderTransformOrigin="0.5,0">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform/>
                                            </StackPanel.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="MindMapDashboardGroupsSectionContainer"
                                                        Margin="0,0,0,10"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasMindMapGroups}" Value="True"/>
                                                                        <Condition Binding="{Binding IsMindMapDashboardGroupsSectionVisible}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsMindMapDashboardGroupsFirst}" Value="False">
                                                                    <Setter Property="Grid.Row" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <StackPanel>
                                                        <Grid Margin="10,6,10,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,2,0" Content="{icons:Icon Kind=ArrowUp, Size=12}" ToolTip="{Binding [MoveGroupsSectionUp], Source={StaticResource Loc}}" Click="MoveMindMapDashboardGroupsUpButton_Click"/>
                                                            <Button Grid.Column="1" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,4,0" Content="{icons:Icon Kind=ArrowDown, Size=12}" ToolTip="{Binding [MoveGroupsSectionDown], Source={StaticResource Loc}}" Click="MoveMindMapDashboardGroupsDownButton_Click"/>
                                                            <Button Grid.Column="2" ToolTip="{Binding [ToggleGroupsSection], Source={StaticResource Loc}}" Click="ToggleMindMapDashboardGroupsSectionButton_Click"
                                                            Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsMindMapDashboardGroupsSectionExpanded}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding [Groups], Source={StaticResource Loc}}"
                                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel x:Name="MindMapDashboardGroupsSectionBody">
                                        <ItemsControl x:Name="MindMapDashboardGroupsItemsControl"
                                                      ItemsSource="{Binding MindMapGroups}"
                                                      Visibility="{Binding HasMindMapGroups, Converter={StaticResource BoolToVis}}"
                                                      Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapGroupViewModel}">
                                                    <Border Style="{DynamicResource GroupCardStyle}"
                    Background="{Binding BackgroundBrush}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="10"
                    Margin="0,0,0,14"
                    AllowDrop="True"
                    PreviewDragOver="DashboardGroupBorder_PreviewDragOver"
                    PreviewDragLeave="DashboardGroupBorder_PreviewDragLeave"
                    PreviewDrop="DashboardGroupBorder_PreviewDrop">
                                                        <Border.Tag>
                                                            <Binding/>
                                                        </Border.Tag>
                                                        <StackPanel>
                                                            <!-- Group header with name and context menu -->
                                                            <Grid Margin="2,0,2,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Style="{DynamicResource GroupHeaderMoveButtonStyle}"
                                                                        Content="{icons:Icon Kind=ArrowUp, Size=12}"
                                                                        Margin="0,0,3,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [MoveThisGroupUp], Source={StaticResource Loc}}"
                                                                        Click="MoveDashboardGroupUpButton_Click"/>
                                                                <Button Grid.Column="1"
                                                                        Style="{DynamicResource GroupHeaderMoveButtonStyle}"
                                                                        Content="{icons:Icon Kind=ArrowDown, Size=12}"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [MoveThisGroupDown], Source={StaticResource Loc}}"
                                                                        Click="MoveDashboardGroupDownButton_Click"/>
                                                                <Button Grid.Column="2"
                                                                        Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                                                        FontSize="{StaticResource Type.Meta}"
                                                                        Content="{icons:Icon Color}"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
                                                                        Click="DashboardGroupColorButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorBlue], Source={StaticResource Loc}}" Tag="#EEF0FE" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorMint], Source={StaticResource Loc}}" Tag="#ECFDF3" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorRose], Source={StaticResource Loc}}" Tag="#FFF1F2" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorAmber], Source={StaticResource Loc}}" Tag="#FFFBEB" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorLilac], Source={StaticResource Loc}}" Tag="#F5F3FF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorTeal], Source={StaticResource Loc}}" Tag="#F0FDFA" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorSlate], Source={StaticResource Loc}}" Tag="#F8FAFC" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorPeach], Source={StaticResource Loc}}" Tag="#FFF7ED" Click="DashboardGroupColorMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Button Grid.Column="3"
                                Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                Tag="{Binding}"
                                FontSize="{StaticResource Type.BlockTitle}"
                                FontWeight="Bold"
                                Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                Click="DashboardGroupMenuButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{Binding [RenameGroup], Source={StaticResource Loc}}"
                                              Click="RenameDashboardGroupMenuItem_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="{Binding [DisbandGroup], Source={StaticResource Loc}}"
                                              Click="DisbandDashboardGroupMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock Grid.Column="4"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding ForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,0,0"/>
                                                            </Grid>
                                                            <!-- Mind maps inside the group -->
                                                            <controls:DashboardVirtualizationHost HostMode="Static"
                                                                                                  MotionScope="{x:Static services:DashboardMotionScope.MindMaps}">
                                                            <controls:DashboardVirtualizedCardGrid ItemsSource="{Binding MindMaps}"
                                                                                                    ItemCellSize="240,152">
                                                            <controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                                        <controls:DashboardTileHost RendererKey="MindMap">
                                                                        <Border Tag="{Binding}"
                                                                                Width="236"
                                                                                MinHeight="136"
                                                                                Margin="0,0,4,6"
                                                                                Padding="8"
                                                                                Background="Transparent"
                                                                                Cursor="Hand"
                                                                                AllowDrop="True"
                                                                                behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
                                                                                behaviors:CardSurfaceMotionBehavior.Profile="Listing"
                                                                                behaviors:CardSurfaceMotionBehavior.ShadowElementName="GroupedMindMapCardBorder"
                                                                                PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                                                MouseMove="DashboardListing_PreviewMouseMove"
        MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
        DragEnter="DashboardListing_PreviewDragEnter"
        DragOver="DashboardListing_PreviewDragOver"
        DragLeave="DashboardListing_PreviewDragLeave"
        Drop="DashboardListing_PreviewDrop">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                  Click="OpenMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}"
                  Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="MindMapInfoMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                                              Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
