<UserControl xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.Dashboards.NotesDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:dashboard="clr-namespace:Scriblucent.Controls.Dashboard"
             xmlns:vm="clr-namespace:Scriblucent.ViewModels"
             xmlns:Views="clr-namespace:Scriblucent.Views"
             xmlns:converters="clr-namespace:Scriblucent.Converters"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <Grid>
<Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Recent Notes strip -->
                    <motion:LayoutRevealHost Grid.Row="0">
                            <motion:LayoutRevealHost.Style>
                                <Style TargetType="motion:LayoutRevealHost">
                                    <Setter Property="IsRevealed" Value="{Binding IsRecentSectionVisible}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentNotes.Count}" Value="0">
                                            <Setter Property="IsRevealed" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </motion:LayoutRevealHost.Style>
                            <Border
						Background="Transparent"
						BorderThickness="0"
						Padding="{StaticResource Shell.RecentPadding}"
                        ClipToBounds="False">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ReorderControlTrayStyle}">
                                    <Button
									ToolTip="{Binding [ToggleRecentNotesSection], Source={StaticResource Loc}}"
									Click="ToggleRecentSectionButton_Click"

						Style="{StaticResource DashboardSectionToggleButtonStyle}"

						behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsRecentSectionExpanded}" />
                                </Border>
                                <TextBlock Grid.Column="1"
									   Text="{Binding [RecentNotes], Source={StaticResource Loc}}"
									   FontSize="{StaticResource Type.SectionTitle}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									Margin="8,0,0,0"
									   FontFamily="{StaticResource FontFamily.UI}"
									   VerticalAlignment="Center"/>
                            </Grid>
                            <motion:LayoutRevealHost>
                            <Border x:Name="RecentSectionBody"
								Margin="0,6,0,0"
								ClipToBounds="False"
								RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <ScrollViewer x:Name="RecentNotesScrollViewer"
                                              Style="{StaticResource RecentItemsStripScrollViewerStyle}">
                                    <ItemsControl Style="{StaticResource RecentStripItemsStyle}"
                                                  ItemsSource="{Binding RecentNotes}" ItemsPanel="{StaticResource RecentItemsStripPanelTemplate}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                <controls:DashboardTileHost RendererKey="RecentNotes">
                                                <Button Style="{StaticResource RecentNoteCardStyle}"
													Tag="{Binding}"
													Click="RecentNoteButton_Click">
                                                    <StackPanel MinWidth="118" MaxWidth="176">
                                                        <TextBlock Text="{Binding Document.Title}"
															   FontWeight="SemiBold"
															   FontSize="{StaticResource Type.CardTitle}"
															   TextTrimming="CharacterEllipsis"
															   Foreground="{DynamicResource TextColor}"/>
                                                        <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
															   FontSize="{StaticResource Type.Meta}"
															   Foreground="{DynamicResource TextColor}"
															   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                </controls:DashboardTileHost>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            </motion:LayoutRevealHost>
                        </StackPanel>
                    </Border>
                        </motion:LayoutRevealHost>
                    <!-- All Notes + FAB -->
                        <ScrollViewer x:Name="NotesScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListingScrollViewerStyle}"
								 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
								 AllowDrop="True"
								 PreviewDragOver="NotesScrollViewer_PreviewDragOver"
								 PreviewDragLeave="NotesScrollViewer_PreviewDragLeave"
								 PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                            <Grid Margin="{StaticResource Shell.DashboardScrollClearance}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Level 3 section shell: CardBackground, no box stroke. -->
                                <Grid x:Name="CalendarSectionContainer"
									Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
									Margin="0,0,0,14"
									RenderTransformOrigin="0.5,0.5"
									UseLayoutRounding="True"
									SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
									BorderThickness="0"
                                    CornerRadius="{StaticResource Radius.Card}"
									Padding="12">
                                    <StackPanel>
                                        <controls:CalendarSectionHeaderPanel Margin="2,0,2,8">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveCalendarUpButton_Click" MoveDown="MoveCalendarDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="CalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="NotesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="NotesDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="CalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="NotesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="NotesDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
                                                        Click="ToggleCalendarSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsCalendarSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
												   FontSize="{StaticResource Type.SectionTitle}"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												   Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                            </Grid>
                                            <controls:CalendarPlannerActions HorizontalAlignment="Right" DataContext="{Binding CalendarPlanner}"/>
                                        </controls:CalendarSectionHeaderPanel>
                                        <motion:LayoutRevealHost>
                                        <Grid x:Name="CalendarSectionBody" Margin="0">
                                            <controls:CalendarPlannerView x:Name="CalendarSectionBodySurface" DataContext="{Binding CalendarPlanner}"/>
                                        </Grid>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                </Grid>

                                <Grid x:Name="NotesDashboardContentHost"
                                    Margin="0,0,0,14"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShouldShowNotesDashboardContent}" Value="True"/>
                                                        <Condition Binding="{Binding IsNotesDashboardSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Padding="14">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveDashboardContentUpButton_Click" MoveDown="MoveDashboardContentDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="NotesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="CalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="CalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="NotesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="CalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="CalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleNotesDashboardSection], Source={StaticResource Loc}}"
                                                        Click="ToggleNotesDashboardSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsNotesDashboardSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding [NotesDashboard], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.BlockTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <motion:LayoutRevealHost>
                                        <Grid x:Name="NotesDashboardSectionBody"
                                              RenderTransformOrigin="0.5,0">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                <Border x:Name="GroupsSectionContainer"
									Margin="0,0,0,10"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasGroups}" Value="True"/>
                                                        <Condition Binding="{Binding IsGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsGroupsFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Margin="10,6,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveGroupsSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveGroupsSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveGroupsUpButton_Click" MoveDown="MoveGroupsDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="GroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="UngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="UngroupedSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="GroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="UngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="UngroupedSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button  ToolTip="{Binding [ToggleGroupsSection], Source={StaticResource Loc}}" Click="ToggleGroupsSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsGroupsSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [Groups], Source={StaticResource Loc}}"
												   FontSize="{StaticResource Type.SectionTitle}"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                        </Grid>
                                        <motion:LayoutRevealHost>
                                        <StackPanel x:Name="GroupsSectionBody">
                                            <ItemsControl x:Name="GroupsItemsControl" behaviors:ItemReorderBehavior.Kind="DashboardGroups" ItemsSource="{Binding NoteGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NoteGroupViewModel}">
                                                        <controls:DashboardGroupCard Style="{DynamicResource GroupCardStyle}"
													BorderThickness="0"
													Margin="0,0,0,14"
													AllowDrop="True"
													DragOver="GroupBorder_DragOver"
													DragLeave="GroupBorder_DragLeave"
													Drop="GroupBorder_Drop">
                                                            <controls:DashboardGroupCard.Tag>
                                                                <Binding/>
                                                            </controls:DashboardGroupCard.Tag>
                                                            <controls:DashboardGroupLayoutPanel>
                                                                <controls:DashboardGroupHeader Style="{StaticResource DashboardGroupHeaderStyle}"
                                                                Header="{Binding Name}" ItemCount="{Binding Notes.Count}"
                                                                GroupBrush="{Binding BackgroundBrush}" IsExpanded="{Binding Disclosure.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ItemReorderControls Style="{StaticResource EmbeddedReorderControlTrayStyle}"/>
                                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                                    <Button Style="{StaticResource GroupDisclosureButtonStyle}" Command="{x:Static controls:DashboardGroupHeader.ToggleExpansionCommand}"
                                                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:DashboardGroupHeader}}"/>
                                                                    <Button
                                                            Style="{DynamicResource GroupHeaderIconButtonStyle}"
																Content="{icons:Icon Color}"
																Tag="{Binding}"
																ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
																Click="GroupColorButton_Click">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu ItemContainerStyle="{StaticResource GroupColourMenuItemStyle}" behaviors:GroupColourMenuBehavior.IsEnabled="True">
                                                                                <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorBlue], Source={StaticResource Loc}}" Tag="#EEF0FE" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorMint], Source={StaticResource Loc}}" Tag="#ECFDF3" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorRose], Source={StaticResource Loc}}" Tag="#FFF1F2" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorAmber], Source={StaticResource Loc}}" Tag="#FFFBEB" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorLilac], Source={StaticResource Loc}}" Tag="#F5F3FF" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorTeal], Source={StaticResource Loc}}" Tag="#F0FDFA" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorSlate], Source={StaticResource Loc}}" Tag="#F8FAFC" Click="GroupColorMenuItem_Click"/>
                                                                                <MenuItem Header="{Binding [GroupColorPeach], Source={StaticResource Loc}}" Tag="#FFF7ED" Click="GroupColorMenuItem_Click"/>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                    <Button Margin="0"
                                                          Style="{DynamicResource GroupHeaderIconButtonStyle}"
																Content="{icons:Icon Kind=MoreVertical, Size=14}"
																Tag="{Binding}"
																Click="GroupMenuButton_Click">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True">
                                                                                <MenuItem Header="{Binding [RenameGroup], Source={StaticResource Loc}}"
																			  Click="RenameGroupMenuItem_Click"/>
                                                                                <Separator/>
                                                                                <MenuItem Header="{Binding [DisbandGroup], Source={StaticResource Loc}}"
																			  Click="DisbandGroupMenuItem_Click"/>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                </StackPanel>
                                                            </controls:DashboardGroupHeader>
                                                                <controls:DashboardGroupRevealHost x:Name="GroupItemsReveal" IsRevealed="{Binding Disclosure.IsExpanded}">
                                                                    <controls:DashboardVirtualizationHost HostMode="Static" Margin="0,8,0,0"
                                                                                                      MotionScope="{x:Static services:DashboardMotionScope.Notes}">
                                                                    <controls:DashboardVirtualizedNoteCardGrid behaviors:ItemReorderBehavior.Kind="DashboardItems" ItemsSource="{Binding Notes}">
                                                                        <controls:DashboardVirtualizedNoteCardGrid.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                                                <controls:NoteCardControl/>
                                                                            </DataTemplate>
                                                                        </controls:DashboardVirtualizedNoteCardGrid.ItemTemplate>
                                                                    </controls:DashboardVirtualizedNoteCardGrid>
                                                                </controls:DashboardVirtualizationHost>
                                                                </controls:DashboardGroupRevealHost>
                                                            </controls:DashboardGroupLayoutPanel>
                                                        </controls:DashboardGroupCard>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </Border>

								<Border x:Name="UngroupedSectionContainer"
									Background="Transparent"
									CornerRadius="{StaticResource Radius.Overlay}"
									AllowDrop="True"
									DragOver="UngroupedDropZone_DragOver"
									DragLeave="UngroupedDropZone_DragLeave"
									Drop="UngroupedDropZone_Drop"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasUngroupedNotes}" Value="True"/>
                                                        <Condition Binding="{Binding IsUngroupedSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsGroupsFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Margin="10,2,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveUngroupedSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveUngroupedSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveUngroupedUpButton_Click" MoveDown="MoveUngroupedDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="UngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="GroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="GroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="UngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="GroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="GroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button  ToolTip="{Binding [ToggleUngroupedSection], Source={StaticResource Loc}}" Click="ToggleUngroupedSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsUngroupedSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [UngroupedItems], Source={StaticResource Loc}}"
												   FontSize="{StaticResource Type.SectionTitle}"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                        </Grid>
                                        <motion:LayoutRevealHost>
                                        <StackPanel x:Name="UngroupedSectionBody">
                                            <controls:DashboardVirtualizationHost ScrollViewerElement="{Binding ElementName=NotesScrollViewer}"
                                                                                  MotionScope="{x:Static services:DashboardMotionScope.Notes}">
                                                <controls:DashboardVirtualizedNoteCardGrid behaviors:ItemReorderBehavior.Kind="DashboardItems" x:Name="UngroupedNotesItemsControl"
                                                                                          ItemsSource="{Binding NotesView}">
                                                    <controls:DashboardVirtualizedNoteCardGrid.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                            <controls:NoteCardControl/>
                                                        </DataTemplate>
                                                    </controls:DashboardVirtualizedNoteCardGrid.ItemTemplate>
                                                </controls:DashboardVirtualizedNoteCardGrid>
                                            </controls:DashboardVirtualizationHost>
                                        </StackPanel>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </Border>
                                        </Grid>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                </Grid>
                                <dashboard:EmptyDashboardPanel x:Name="NotesEmptyDashboardPanel"
                                            Grid.Row="2"
                                            IconKind="Notes"
                                            Visibility="{Binding ShowNotesEmptyDashboard, Converter={StaticResource BoolToVis}}"
                                            Prompt="{Binding [NotesEmptyDashboardPrompt], Source={StaticResource Loc}}"
                                            ButtonContent="{Binding [NewNoteAction], Source={StaticResource Loc}}"
                                            Click="CreateNoteButton_Click"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <controls:DashboardCreateMenu x:Name="CreationMenu"
                        IsEnabled="{Binding CanCreateDashboardItem}"
                        CreateLabel="{Binding [NewNoteAction], Source={StaticResource Loc}}"
                        QuickAddLabel="{Binding [QuickAddNote], Source={StaticResource Loc}}"
                        QuickAddCommand="{Binding QuickAddDashboardItemCommand}"
                        ImportLabel="{Binding [ImportNotes], Source={StaticResource Loc}}"
                        CreateIcon="Notes" CreateRequested="CreateNoteButton_Click"
                        ImportRequested="ImportButton_Click"/>
    </Grid>
</UserControl>


