<UserControl xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.Dashboards.QuizzesDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:dashboard="clr-namespace:Scriblucent.Controls.Dashboard"
             xmlns:vm="clr-namespace:Scriblucent.ViewModels"
             xmlns:Views="clr-namespace:Scriblucent.Views"
             xmlns:converters="clr-namespace:Scriblucent.Converters"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:services="clr-namespace:Scriblucent.Services"
             xmlns:anim="clr-namespace:Scriblucent.Animations"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <Grid>
<Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <motion:LayoutRevealHost Grid.Row="0">
                            <motion:LayoutRevealHost.Style>
                                <Style TargetType="motion:LayoutRevealHost">
                                    <Setter Property="IsRevealed" Value="{Binding IsRecentSectionVisible}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentQuizzes.Count}" Value="0">
                                            <Setter Property="IsRevealed" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </motion:LayoutRevealHost.Style>
                            <Border
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{StaticResource Shell.RecentPadding}"
                                ClipToBounds="False">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ReorderControlTrayStyle}">
                                    <Button
                                            ToolTip="{Binding [ToggleRecentQuizzesSection], Source={StaticResource Loc}}"
                                            Click="ToggleRecentSectionButton_Click"
                                    Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                    behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsRecentSectionExpanded}" />
                                </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding [RecentQuizzes], Source={StaticResource Loc}}"
                                               FontSize="{StaticResource Type.SectionTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="8,0,0,0"
                                               FontFamily="{StaticResource FontFamily.UI}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <motion:LayoutRevealHost>
                                <Border x:Name="QuizRecentSectionBody"
                                        Margin="0,6,0,0"
                                        ClipToBounds="False"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <ScrollViewer Style="{StaticResource RecentItemsStripScrollViewerStyle}">
                                        <ItemsControl Style="{StaticResource RecentStripItemsStyle}"
                                                      ItemsSource="{Binding RecentQuizzes}" ItemsPanel="{StaticResource RecentItemsStripPanelTemplate}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                                                    <controls:DashboardTileHost RendererKey="RecentQuiz">
                                                    <Button Style="{StaticResource RecentNoteCardStyle}"
                                                            Tag="{Binding}"
                                                            Click="RecentQuizButton_Click">
                                                        <StackPanel MinWidth="118" MaxWidth="176">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextColor}"/>
                                                            <TextBlock Text="{Binding QuestionCountText}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                                       Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
                                                                       FontSize="{StaticResource Type.Meta}"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    </controls:DashboardTileHost>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                </motion:LayoutRevealHost>
                            </StackPanel>
                        </Border>
                        </motion:LayoutRevealHost>
                        <ScrollViewer x:Name="QuizzesScrollViewer"
                                      Grid.Row="1"
                                      Style="{StaticResource DashboardListingScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent"
                                      PreviewDragOver="DashboardScrollViewer_PreviewDragOver"
                                      PreviewDragLeave="DashboardScrollViewer_PreviewDragLeave"
                                      Drop="DashboardScrollViewer_Drop"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="{StaticResource Shell.DashboardScrollClearance}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="QuizCalendarSectionContainer"
                                        Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,14"
                                        RenderTransformOrigin="0.5,0.5"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="12">
                                    <StackPanel>
                                        <controls:CalendarSectionHeaderPanel Margin="2,0,2,8">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveCalendarUpButton_Click" MoveDown="MoveCalendarDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
                                                        Click="ToggleCalendarSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsCalendarSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                            <controls:CalendarPlannerActions HorizontalAlignment="Right" DataContext="{Binding CalendarPlanner}"/>
                                        </controls:CalendarSectionHeaderPanel>
                                        <motion:LayoutRevealHost>
                                        <Grid x:Name="QuizCalendarSectionBody" Margin="0">
                                            <controls:CalendarPlannerView x:Name="CalendarSectionBodySurface" DataContext="{Binding CalendarPlanner}"/>
                                        </Grid>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                </Grid>

                                <!-- Level 3 section shell: surface only (same shape as Notes/Flashcards/MindMaps). -->
                                <Grid x:Name="QuizzesDashboardContentHost"
                                        Margin="0,0,0,14"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShouldShowQuizzesDashboardContent}" Value="True"/>
                                                        <Condition Binding="{Binding IsQuizGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="14">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveDashboardContentUpButton_Click" MoveDown="MoveDashboardContentDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="QuizzesDashboardContentHost" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizCalendarSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button
                                                        ToolTip="{Binding [ToggleQuizDashboardSection], Source={StaticResource Loc}}"
                                                        Click="ToggleQuizGroupsSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsQuizGroupsSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [QuizzesDashboardTitle], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.BlockTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                        <motion:LayoutRevealHost>
                                        <StackPanel x:Name="QuizGroupsSectionBody"
                                                    RenderTransformOrigin="0.5,0">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform/>
                                            </StackPanel.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="QuizDashboardGroupsSectionContainer"
                                                        Margin="0,0,0,10"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasQuizGroups}" Value="True"/>
                                                                        <Condition Binding="{Binding IsQuizDashboardGroupsSectionVisible}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsQuizDashboardGroupsFirst}" Value="False">
                                                                    <Setter Property="Grid.Row" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <StackPanel>
                                                        <Grid Margin="10,6,10,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                                        UpLabel="{Binding [MoveGroupsSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveGroupsSectionDown], Source={StaticResource Loc}}"
                                                                        MoveUp="MoveQuizDashboardGroupsUpButton_Click" MoveDown="MoveQuizDashboardGroupsDownButton_Click">
                                                                        <controls:PositionButtons.CanMoveUp>
                                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="Visibility"/>
                                                                            </MultiBinding>
                                                                        </controls:PositionButtons.CanMoveUp>
                                                                        <controls:PositionButtons.CanMoveDown>
                                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="Visibility"/>
                                                                            </MultiBinding>
                                                                        </controls:PositionButtons.CanMoveDown>
                                                                    </controls:PositionButtons>
                                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                                    <Button  ToolTip="{Binding [ToggleGroupsSection], Source={StaticResource Loc}}" Click="ToggleQuizDashboardGroupsSectionButton_Click"
                                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsQuizDashboardGroupsSectionExpanded}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding [Groups], Source={StaticResource Loc}}"
                                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextColor}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <motion:LayoutRevealHost>
                                                        <StackPanel x:Name="QuizDashboardGroupsSectionBody">
                                        <ItemsControl x:Name="QuizDashboardGroupsItemsControl" behaviors:ItemReorderBehavior.Kind="DashboardGroups"
                                                      ItemsSource="{Binding QuizGroups}"
                                                      Visibility="{Binding HasQuizGroups, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:QuizGroupViewModel}">
                                                    <controls:DashboardGroupCard Style="{DynamicResource GroupCardStyle}"
                                                            BorderThickness="0"
                                                            Margin="0,0,0,14"
                                                            AllowDrop="True"
                                                            PreviewDragOver="DashboardGroupBorder_PreviewDragOver"
                                                            PreviewDragLeave="DashboardGroupBorder_PreviewDragLeave"
                                                            PreviewDrop="DashboardGroupBorder_PreviewDrop">
                                                        <controls:DashboardGroupCard.Tag>
                                                            <Binding/>
                                                        </controls:DashboardGroupCard.Tag>
                                                        <controls:DashboardGroupLayoutPanel>
                                                            <controls:DashboardGroupHeader Style="{StaticResource DashboardGroupHeaderStyle}"
                                                                Header="{Binding Name}" ItemCount="{Binding Quizzes.Count}"
                                                                GroupBrush="{Binding BackgroundBrush}" IsExpanded="{Binding Disclosure.IsExpanded, Mode=TwoWay}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <controls:ItemReorderControls Style="{StaticResource EmbeddedReorderControlTrayStyle}"/>
                                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                                    <Button Style="{StaticResource GroupDisclosureButtonStyle}" Command="{x:Static controls:DashboardGroupHeader.ToggleExpansionCommand}"
                                                                            behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:DashboardGroupHeader}}"/>
                                                                    <Button
                                                                        Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                                                        Content="{icons:Icon Color}"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
                                                                        Click="DashboardGroupColorButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu ItemContainerStyle="{StaticResource GroupColourMenuItemStyle}" behaviors:GroupColourMenuBehavior.IsEnabled="True">
                                                                            <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorBlue], Source={StaticResource Loc}}" Tag="#EEF0FE" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorMint], Source={StaticResource Loc}}" Tag="#ECFDF3" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorRose], Source={StaticResource Loc}}" Tag="#FFF1F2" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorAmber], Source={StaticResource Loc}}" Tag="#FFFBEB" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorLilac], Source={StaticResource Loc}}" Tag="#F5F3FF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorTeal], Source={StaticResource Loc}}" Tag="#F0FDFA" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorSlate], Source={StaticResource Loc}}" Tag="#F8FAFC" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorPeach], Source={StaticResource Loc}}" Tag="#FFF7ED" Click="DashboardGroupColorMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                    <Button Margin="0"
                                                                        Style="{DynamicResource GroupHeaderIconButtonStyle}"
                                                                        Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                        Tag="{Binding}"
                                                                        Click="DashboardGroupMenuButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True">
                                                                            <MenuItem Header="{Binding [RenameGroup], Source={StaticResource Loc}}"
                                                                                      Click="RenameDashboardGroupMenuItem_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="{Binding [DisbandGroup], Source={StaticResource Loc}}"
                                                                                      Click="DisbandDashboardGroupMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                </StackPanel>
                                                            </controls:DashboardGroupHeader>
                                                            <controls:DashboardGroupRevealHost x:Name="GroupItemsReveal" IsRevealed="{Binding Disclosure.IsExpanded}">
                                                                    <controls:DashboardVirtualizationHost HostMode="Static" Margin="0,8,0,0"
                                                                                                  MotionScope="{x:Static services:DashboardMotionScope.Quizzes}">
                                                            <controls:DashboardVirtualizedCardGrid behaviors:ItemReorderBehavior.Kind="DashboardItems" ItemsSource="{Binding Quizzes}"
                                                                                                    ItemCellSize="240,128">
                                                            <controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                                                                        <controls:CollectionSelectionFrame ItemId="{Binding Document.Id}" SelectionLabel="{Binding Title}" FaceName="GroupedQuizCardBorder">
<controls:DashboardTileHost RendererKey="Quiz" PreserveLiveInputInBitmapMode="True">
                                                                        <Border Tag="{Binding}"
                                                                                Width="236"
                                                                                MinHeight="112"
                                                                                Margin="0,0,4,6"
                                                                                Padding="8"
                                                                                Background="Transparent"
                                                                                Cursor="Hand"
                                                                                AllowDrop="True"
                                                                                behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
                                                                                behaviors:CardSurfaceMotionBehavior.Profile="Listing"
                                                                                behaviors:CardSurfaceMotionBehavior.ShadowElementName="GroupedQuizCardBorder"
                                                                                PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                                                MouseMove="DashboardListing_PreviewMouseMove"
                                                                                MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
                                                                                DragEnter="DashboardListing_PreviewDragEnter"
                                                                                DragOver="DashboardListing_PreviewDragOver"
                                                                                DragLeave="DashboardListing_PreviewDragLeave"
                                                                                Drop="DashboardListing_PreviewDrop">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}" Click="OpenQuizMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}" Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="QuizInfoMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleQuizPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleQuizPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleQuizMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}" Click="RemoveQuizFromGroupMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}" Click="DuplicateQuizMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}" Click="DeleteQuizMenuItem_Click"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Grid>
                                                                            <controls:CardShadowLayer/>
                                                                            <controls:SurfaceMaterialBorder x:Name="GroupedQuizCardBorder" Style="{DynamicResource DashboardGroupedListingCardStyle}">
                                                                                <Grid>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                    </Grid.RowDefinitions>

                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="{StaticResource Radius.Card}"
                                                                                                Background="{DynamicResource IconButtonBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                                                ToolTip="{Binding AiGeneratedTooltip}"
                                                                                                Visibility="{Binding ShowAiGeneratedChrome, Converter={StaticResource BoolToVis}}">
                                                                                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
                                                                                        </controls:SurfaceMaterialBorder>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <icons:AppIcon Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                                            <icons:AppIcon Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="12" Height="12" Foreground="{DynamicResource TextColor}" Margin="0,0,5,0" ToolTip="{Binding NextScheduleDisplay}"/>
                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                       FontSize="{StaticResource Type.CardTitle}"
                                                                                                       FontWeight="SemiBold"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Button x:Name="ListingContextMenuButton"
                                                                                                Grid.Column="2"
                                                                                                Tag="{Binding}"
                                                                                                Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                                                Style="{DynamicResource DashboardListingMenuButtonStyle}"
                                                                                                ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                                                Click="ListingContextMenuButton_Click"/>
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="{Binding QuestionCountText}"
                                                                                               FontSize="{StaticResource Type.Caption}"
                                                                                               Foreground="{DynamicResource TextColorSecondary}"
                                                                                               Margin="0,6,0,0"/>
                                                                                    <controls:SurfaceMaterialBorder Grid.Row="2"
                                                                                            Style="{StaticResource DashboardTagChipStyle}">
                                                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                                                   Style="{StaticResource DashboardTagTextStyle}"/>
                                                                                    </controls:SurfaceMaterialBorder>
                                                                                </Grid>
                                                                            </controls:SurfaceMaterialBorder>
                                                                            </Grid>
                                                                        </Border>
                                                                    </controls:DashboardTileHost>
</controls:CollectionSelectionFrame>
                                                                    </DataTemplate>
                                                            </controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                            </controls:DashboardVirtualizedCardGrid>
                                                            </controls:DashboardVirtualizationHost>
                                                                </controls:DashboardGroupRevealHost>
                                                        </controls:DashboardGroupLayoutPanel>
                                                    </controls:DashboardGroupCard>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                                        </StackPanel>
                                                        </motion:LayoutRevealHost>
                                                    </StackPanel>
                                                </Border>

                                        <Border x:Name="QuizDashboardUngroupedSectionContainer"
                                                Margin="0,0,0,10"
                                                MinHeight="96"
                                                Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Overlay}"
                                                AllowDrop="True"
                                                DragOver="DashboardUngroupedDropZone_DragOver"
                                                DragLeave="DashboardUngroupedDropZone_DragLeave"
                                                Drop="DashboardUngroupedDropZone_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ShouldShowQuizzesDashboardContent}" Value="True"/>
                                                                <Condition Binding="{Binding IsQuizDashboardUngroupedSectionVisible}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsQuizDashboardGroupsFirst}" Value="False">
                                                            <Setter Property="Grid.Row" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                        <Grid Margin="10,2,10,8"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="DashboardUngroupedDropZone_DragOver"
                                              DragLeave="DashboardUngroupedDropZone_DragLeave"
                                              Drop="DashboardUngroupedDropZone_Drop">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ReorderControlTrayStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:PositionButtons Style="{StaticResource EmbeddedReorderControlTrayStyle}"
                                                        UpLabel="{Binding [MoveUngroupedSectionUp], Source={StaticResource Loc}}" DownLabel="{Binding [MoveUngroupedSectionDown], Source={StaticResource Loc}}"
                                                        MoveUp="MoveQuizDashboardUngroupedUpButton_Click" MoveDown="MoveQuizDashboardUngroupedDownButton_Click">
                                                        <controls:PositionButtons.CanMoveUp>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Up">
                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveUp>
                                                        <controls:PositionButtons.CanMoveDown>
                                                            <MultiBinding Converter="{StaticResource DashboardSectionMoveConverter}" ConverterParameter="Down">
                                                                <Binding ElementName="QuizDashboardUngroupedSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="(Grid.Row)"/>
                                                                <Binding ElementName="QuizDashboardGroupsSectionContainer" Path="Visibility"/>
                                                            </MultiBinding>
                                                        </controls:PositionButtons.CanMoveDown>
                                                    </controls:PositionButtons>
                                                    <Border Style="{StaticResource ActionStripDividerStyle}"/>
                                                    <Button  ToolTip="{Binding [ToggleUngroupedSection], Source={StaticResource Loc}}" Click="ToggleQuizDashboardUngroupedSectionButton_Click"
                                                        Style="{StaticResource DashboardSectionToggleButtonStyle}"
                                                        behaviors:SectionChevronMotionBehavior.IsExpanded="{Binding IsQuizDashboardUngroupedSectionExpanded}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                                       FontSize="{StaticResource Type.SectionTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <motion:LayoutRevealHost>
                                        <StackPanel x:Name="QuizDashboardUngroupedSectionBody">
                                        <controls:DashboardVirtualizationHost ScrollViewerElement="{Binding ElementName=QuizzesScrollViewer}"
                                                                              MotionScope="{x:Static services:DashboardMotionScope.Quizzes}">
                                        <controls:DashboardVirtualizedCardGrid behaviors:ItemReorderBehavior.Kind="DashboardItems" x:Name="QuizDashboardUngroupedItemsControl"
                                                      ItemsSource="{Binding QuizzesView}"
                                                      ItemCellSize="330,194"
                                                      AllowDrop="True"
                                                      DragOver="DashboardUngroupedDropZone_DragOver"
                                                      DragLeave="DashboardUngroupedDropZone_DragLeave"
                                                      Drop="DashboardUngroupedDropZone_Drop"
                                                      Visibility="{Binding HasUngroupedQuizzes, Converter={StaticResource BoolToVis}}">
                                            <controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:QuizViewModel}">
                                                    <controls:CollectionSelectionFrame ItemId="{Binding Document.Id}" SelectionLabel="{Binding Title}" FaceName="QuizCardBorder">
<controls:DashboardTileHost RendererKey="QuizUngrouped" PreserveLiveInputInBitmapMode="True">
                                                    <Border Tag="{Binding}"
                                                            Width="320"
                                                            MinHeight="174"
                                                            Margin="0,0,10,10"
                                                            Padding="10"
                                                            Background="Transparent"
                                                            Cursor="Hand"
                                                            AllowDrop="True"
                                                            behaviors:CardSurfaceMotionBehavior.IsEnabled="True"
                                                            behaviors:CardSurfaceMotionBehavior.Profile="Listing"
                                                            behaviors:CardSurfaceMotionBehavior.ShadowElementName="QuizCardBorder"
                                                            PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                            MouseMove="DashboardListing_PreviewMouseMove"
                                                            MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
                                                            DragEnter="DashboardListing_PreviewDragEnter"
                                                            DragOver="DashboardListing_PreviewDragOver"
                                                            DragLeave="DashboardListing_PreviewDragLeave"
                                                            Drop="DashboardListing_PreviewDrop">
                                                        <Border.ContextMenu>
                                                            <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                                                                Click="OpenQuizMenuItem_Click"/>
                                                            <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}"
                                                                Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}"
                                                                          Click="QuizInfoMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                          Click="ToggleQuizPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                          Click="ToggleQuizPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}"
                                                                          Click="ScheduleQuizMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                          Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                          Click="RemoveQuizFromGroupMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                                                                Click="DuplicateQuizMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                                                                Click="DeleteQuizMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                        <Grid>
                        <controls:CardShadowLayer/>
                                                        <controls:SurfaceMaterialBorder x:Name="QuizCardBorder"
                                                                Style="{DynamicResource DashboardListingCardSelectionStyle}"
                                                                CornerRadius="{StaticResource Radius.Card}"
                                                                Padding="16"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                                                                    <TranslateTransform Y="0"/>
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>


                                                                <Grid>
																	<Grid.ColumnDefinitions>
																		<ColumnDefinition Width="Auto"/>
																		<ColumnDefinition Width="*"/>
																		<ColumnDefinition Width="Auto"/>
																	</Grid.ColumnDefinitions>
																	<controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Grid.Column="0"
																			Width="24"
																			Height="24"
																			Margin="0,0,6,0"
																			CornerRadius="{StaticResource Radius.Card}"
																			Background="{DynamicResource IconButtonBackground}" BorderBrush="Transparent" BorderThickness="0"
                                                                            ToolTip="{Binding AiGeneratedTooltip}"
                                                                            Visibility="{Binding ShowAiGeneratedChrome, Converter={StaticResource BoolToVis}}">
                                                                        <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}"/>
																	</controls:SurfaceMaterialBorder>
																	<Grid Grid.Column="1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <icons:AppIcon Grid.Column="0" Kind="Pin" Style="{StaticResource DashboardPinIconStyle}" Width="14" Height="14" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                        <icons:AppIcon Grid.Column="1" Kind="Schedule" Style="{StaticResource DashboardScheduleIconStyle}" Width="13" Height="13" Foreground="{DynamicResource TextColor}" Margin="0,0,6,0" ToolTip="{Binding NextScheduleDisplay}"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                                                   FontSize="{StaticResource Type.CardTitle.Large}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                    <Button x:Name="ListingContextMenuButton"
                                                                            Grid.Column="2"
                                                                            Tag="{Binding}"
                                                                            Content="{icons:Icon Kind=MoreVertical, Size=14}"
                                                                            Style="{DynamicResource DashboardListingMenuButtonStyle}"
                                                                            ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                            Click="ListingContextMenuButton_Click"/>
																</Grid>

                                                                <StackPanel Grid.Row="1"
                                                                            Orientation="Horizontal"
                                                                            Margin="0,14,0,0">
                                                                    <TextBlock Text="{Binding QuestionCountText}"
                                                                               FontSize="{StaticResource Type.Body}"
                                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                                </StackPanel>

                                                                <controls:SurfaceMaterialBorder Grid.Row="2"
                                                                        Style="{StaticResource DashboardTagChipStyle}">
                                                                    <TextBlock Text="{Binding TagsDisplay}"
                                                                               Style="{StaticResource DashboardTagTextStyle}"/>
                                                                </controls:SurfaceMaterialBorder>
                                                            </Grid>
                                                        </controls:SurfaceMaterialBorder>
                        </Grid>
                                                    </Border>
                                                </controls:DashboardTileHost>
</controls:CollectionSelectionFrame>
                                                </DataTemplate>
                                            </controls:DashboardVirtualizedCardGrid.ItemTemplate>
                                        </controls:DashboardVirtualizedCardGrid>
                                        </controls:DashboardVirtualizationHost>
                                            </StackPanel>
                                        </motion:LayoutRevealHost>
                                            </StackPanel>
                                        </Border>
                                            </Grid>
                                        </StackPanel>
                                        </motion:LayoutRevealHost>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                </Grid>

                                <dashboard:EmptyDashboardPanel x:Name="QuizzesEmptyDashboardPanel"
                                            Grid.Row="2"
                                            IconKind="Quizzes"
                                            Visibility="{Binding ShowQuizzesEmptyDashboard, Converter={StaticResource BoolToVis}}"
                                            Prompt="{Binding [QuizzesEmptyDashboardTitle], Source={StaticResource Loc}}"
                                            Description="{Binding QuizzesEmptyDashboardPrompt}"
                                            ButtonContent="{Binding [NewQuizAction], Source={StaticResource Loc}}"
                                            Click="CreateQuizButton_Click"/>
                            </Grid>
                        </ScrollViewer>

                        <controls:DashboardCreateMenu x:Name="CreationMenu" Grid.Row="1"
                            IsEnabled="{Binding CanCreateDashboardItem}"
                            CreateLabel="{Binding [NewQuizAction], Source={StaticResource Loc}}"
                            QuickAddLabel="{Binding [QuickAddQuiz], Source={StaticResource Loc}}"
                            QuickAddCommand="{Binding QuickAddDashboardItemCommand}"
                            ImportLabel="{Binding [QuizImport], Source={StaticResource Loc}}"
                            CreateIcon="Quizzes" CreateRequested="CreateQuizButton_Click"
                            ImportRequested="ImportButton_Click"/>
                    </Grid>
    </Grid>
</UserControl>


