                                                                                DragOver="DashboardListing_PreviewDragOver"
                                                                                DragLeave="DashboardListing_PreviewDragLeave"
                                                                                Drop="DashboardListing_PreviewDrop">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}" Click="OpenQuizMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}" Click="StartDashboardMassSelectMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="QuizInfoMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleQuizPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleQuizPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleQuizMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}" Click="RemoveQuizFromGroupMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}" Click="DuplicateQuizMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}" Click="DeleteQuizMenuItem_Click"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Grid>
                                                                            <controls:CardShadowLayer/>
