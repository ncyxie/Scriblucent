<Window x:Class="Scriblucent.Views.SearchReplaceDialogLocalized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="{Binding [FindReplaceTitle], Source={StaticResource Loc}}"
        Height="390"
        Width="560"
        MinHeight="390"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FindReplaceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FindReplaceCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <controls:OverlayDialogShell
                                 MaxCardWidth="560"
                                 CardPadding="18">
        <controls:OverlayDialogShell.Header>
            <TextBlock Text="{Binding [FindReplaceTitle], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.DialogTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,14"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding [FindLabel], Source={StaticResource Loc}}"
                                   Style="{StaticResource FindReplaceLabelStyle}"/>
                        <!-- WindowBackground inset: InputSurface matches CardBackground on the dialog plate. -->
                        <Border Style="{StaticResource ChromeFieldBorderStyle}"
                                Background="{DynamicResource WindowBackground}"
                                Padding="6,0"
                                MinHeight="38">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                     FontSize="{StaticResource Type.Meta}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchOptions_Changed"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding [ReplaceLabel], Source={StaticResource Loc}}"
                                   Style="{StaticResource FindReplaceLabelStyle}"/>
                        <Border Style="{StaticResource ChromeFieldBorderStyle}"
                                Background="{DynamicResource WindowBackground}"
                                Padding="6,0"
                                MinHeight="38">
                            <TextBox x:Name="ReplaceBox"
                                     Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                     FontSize="{StaticResource Type.Meta}"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,12"
                           VerticalAlignment="Center">
                    <CheckBox x:Name="MatchCaseBox"
                              Content="{Binding [FindReplaceMatchCase], Source={StaticResource Loc}}"
                              Style="{StaticResource FindReplaceCheckBoxStyle}"
                              Checked="SearchOptions_Changed"
                              Unchecked="SearchOptions_Changed"/>
                    <CheckBox x:Name="WholeWordBox"
                              Content="{Binding [FindReplaceWholeWord], Source={StaticResource Loc}}"
                              Style="{StaticResource FindReplaceCheckBoxStyle}"
                              Checked="SearchOptions_Changed"
                              Unchecked="SearchOptions_Changed"/>
                    <CheckBox x:Name="WrapAroundBox"
                              Content="{Binding [FindReplaceWrapAround], Source={StaticResource Loc}}"
                              Style="{StaticResource FindReplaceCheckBoxStyle}"
                              Checked="SearchOptions_Changed"
                              Unchecked="SearchOptions_Changed"/>
                </WrapPanel>

                <Border MinHeight="34"
                        Padding="10,7"
                        CornerRadius="{StaticResource Radius.Control}"
                        Background="{DynamicResource IconButtonBackground}"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <TextBlock x:Name="StatusText"
                               Text="{Binding [FindReplaceEnterSearch], Source={StaticResource Loc}}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               FontSize="{StaticResource Type.Caption}"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <!-- Find actions + Close on top; replace actions below — even gaps, no empty UniformGrid cell. -->
            <Grid Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="FindPreviousBtn"
                                Content="{Binding [FindPrevious], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                MinWidth="110"
                                Padding="14,8"
                                Margin="0,0,8,0"
                                Click="FindPreviousBtn_Click"/>
                        <Button x:Name="FindNextBtn"
                                Content="{Binding [FindNext], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                MinWidth="110"
                                Padding="14,8"
                                Click="FindNextBtn_Click"/>
                    </StackPanel>
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            MinWidth="110"
                            Padding="14,8"
                            HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="ReplaceNextBtn"
                            Content="{Binding [ReplaceNext], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            MinWidth="110"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="ReplaceNextBtn_Click"/>
                    <Button x:Name="ReplaceAllBtn"
                            Content="{Binding [ReplaceAll], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            MinWidth="110"
                            Padding="14,8"
                            Click="ReplaceAllBtn_Click"/>
                </StackPanel>
            </Grid>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
