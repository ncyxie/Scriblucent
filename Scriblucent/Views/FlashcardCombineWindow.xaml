<Window x:Class="Scriblucent.Views.FlashcardCombineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="{Binding [PremiumCombineFlashcards], Source={StaticResource Loc}}"
        Width="1180" Height="760" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WorkspaceBackdrop}">
    <controls:CombineWorkspaceView x:Name="ContentRoot"/>
</Window>
