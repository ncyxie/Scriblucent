<Window x:Class="Scriblucent.Views.FlashcardCombineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="Combine Flashcards"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}" xmlns:behaviors="clr-namespace:Scriblucent.Behaviors">
    <Window.Resources>
        <Style x:Key="CombinePanelStyle" TargetType="Border" BasedOn="{StaticResource FeatureCombinePanelStyle}"/>
        <Style x:Key="CombineTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FeatureCombineTextBoxStyle}"/>
        <Style x:Key="CombineOptionCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource FeatureCombineOptionCheckBoxStyle}"/>
        <Style x:Key="CombineItemBorderStyle" TargetType="Border" BasedOn="{StaticResource FeatureCombineItemBorderStyle}"/>
    </Window.Resources>

    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="14,18,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Combine flashcards"
                                   FontSize="{StaticResource Type.DialogTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="Select existing flashcard sets and merge their cards into a new set."
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="Create combined set"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                MinWidth="150"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding HasSelectedSets}"
                                Click="CreateCombinedButton_Click"/>
                        <Button Content="Close"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                MinWidth="90"
                                Padding="16,8"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CombinePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="All flashcard sets"
                                       FontSize="{StaticResource Type.SectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FilteredCountText}"
                                       FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">
                            <TextBox x:Name="FlashcardSearchTextBox"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CombineTextBoxStyle}"
                                     ToolTip="Search flashcard sets, tags, questions, and answers"/>
                            <TextBlock Text="Search flashcard sets, tags, cards..."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=FlashcardSearchTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FlashcardSearchTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:ScrollTileBehavior.IsEnabled="True"
                                      behaviors:MiddleClickScrollBehavior.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding Sets}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DashboardTileHost RendererKey="CombineRow">
                                        <Grid Margin="0,0,0,8"
                                              UseLayoutRounding="True"
                                              SnapsToDevicePixels="True"
                                              ClipToBounds="False"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <controls:CardShadowLayer/>
                                            <Border Style="{StaticResource CombineItemBorderStyle}"
                                                    MouseLeftButtonUp="SetItem_MouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              Click="SelectionCheckBox_Click"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{StaticResource Type.Body}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextColor}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CardCountText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        </controls:DashboardTileHost>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CombinePanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Filter by tag"
                                       FontSize="{StaticResource Type.SectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="180">
                                <ItemsControl ItemsSource="{Binding CategoryFilters}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Tag}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,2"
                                                      Foreground="{DynamicResource TextColor}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Separator Margin="0,16,0,14"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Selected sets"
                                           FontSize="{StaticResource Type.SectionTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCountText}"
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextColorSecondary}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          behaviors:ScrollTileBehavior.IsEnabled="True"
                                      behaviors:MiddleClickScrollBehavior.IsEnabled="True">
                                <ItemsControl ItemsSource="{Binding Sets}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:DashboardTileHost RendererKey="CombineSelectedRow">
                                            <Border Background="{DynamicResource HoverBackground}"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    Padding="10"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{StaticResource Type.Meta}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextColor}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CardCountText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"
                                                              Margin="10,0,0,0"
                                                              Click="SelectionCheckBox_Click"/>
                                                </Grid>
                                            </Border>
                                            </controls:DashboardTileHost>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Combined set title"
                                       FontSize="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,10,0,6"/>
                            <TextBox Text="{Binding CombinedTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CombineTextBoxStyle}"
                                     Margin="0,0,0,10"/>
                            <CheckBox Content="Shuffle cards"
                                      IsChecked="{Binding ShuffleCards, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CombineOptionCheckBoxStyle}"/>
                            <CheckBox Content="Skip duplicate cards"
                                      IsChecked="{Binding SkipDuplicateCards, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CombineOptionCheckBoxStyle}"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedCardCountText}"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Margin="0,10,0,10"/>
                            <Button Content="Clear selection"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinHeight="34"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding HasSelectedSets}"
                                    Click="ClearSelectionButton_Click"/>
                            <Button Content="Create combined set"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    MinHeight="36"
                                    IsEnabled="{Binding HasSelectedSets}"
                                    Click="CreateCombinedButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </controls:FeatureWindowShell.Body>

        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Clear filter"
                                Style="{StaticResource FeatureToolbarSecondaryButtonStyle}"
                                Click="ClearFiltersButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
    </Grid>
</Window>



