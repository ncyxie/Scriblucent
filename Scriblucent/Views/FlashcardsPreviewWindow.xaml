                            TickPlacement="None"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               MinWidth="45">
                        <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value}"/>
                        <Run Text="ms"/>
