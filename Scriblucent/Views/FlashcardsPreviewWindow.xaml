<Window x:Class="Scriblucent.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:wpftoolkit="clr-namespace:WpfToolkit.Controls"
        x:Name="FlashcardsWindow"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="780"
        Width="980"
        MinHeight="620"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}"
        Closing="FlashcardsPreviewWindow_Closing">
    <Window.Resources>
        <ResourceDictionary>
        <!-- Own ScrollViewer>ItemsPresenter template (matching ListBox's own default template
             shape) so ScrollContentPresenter's IScrollInfo auto-discovery finds the virtualizing
             panel. A hand-declared <ScrollViewer> wrapping a plain <ItemsControl> adds an extra
             indirection layer that VirtualizingWrapPanel's IScrollInfo auto-discovery doesn't see
             through, so the panel never re-virtualizes on scroll (confirmed via diagnostic
             logging: PrepareContainerForItemOverride fired twice at startup and never again). -->
        <Style TargetType="controls:FlashcardGridItemsControl">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:FlashcardGridItemsControl">
                        <!-- Padding must live on ItemsPresenter: ScrollViewer.Padding is ignored when
                             VirtualizingWrapPanel is the IScrollInfo (viewport fills the scroller). -->
                        <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      behaviors:RoundedClipBehavior.IsEnabled="True"
                                      behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Card}">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateSetButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        </Style>

        <Style x:Key="FlashcardToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="FlashcardToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarPrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="FlashcardFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="FlashcardFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardToolbarPrimaryButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="FlashcardLinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkedNoteToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MaxWidth" Value="200"/>
        </Style>

        <Style x:Key="FlashcardLinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource LinkedNoteComboBoxStyle}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FlashcardEditorIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- Study/grid faces use bake-once CardShadowLayer (sibling of CardSurface). Hover is
             lift-only on the parent Grid via FlashcardStudyCardSurface_MouseEnter/Leave —
             no live DropShadowEffect per card. -->

        <!-- Level 4 D/G: rest FlashcardCardBorder R(theme); hover fill only; selected A 2px. Shadow is sibling. -->
        <Style x:Key="FlashcardStudyCardStyle" TargetType="Border">
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="224"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardHoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardGridCardStyle" TargetType="Border">
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="224"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardHoverBackground}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardSelectedBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedHoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardSelectedBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardMetaChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlashcardSideChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardSideChipBackground}"/>
        </Style>

        <Style x:Key="FlashcardCategoryChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardCategoryChipBackground}"/>
        </Style>

        <Style x:Key="FlashcardKnownChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardKnownChipBackground}"/>
        </Style>

        <Style x:Key="FlashcardUnknownChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardUnknownChipBackground}"/>
        </Style>

        <Style x:Key="FlashcardNewChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardNewChipBackground}"/>
        </Style>

        <!-- Personal marking toggle (Quizlet's "star") - gold when set, muted otherwise. Reuses
             AccentWarning, the app's existing amber accent, rather than a new theme resource. -->
        <Style x:Key="FlashcardStarIconStyle" TargetType="icons:AppIcon" BasedOn="{StaticResource {x:Type icons:AppIcon}}">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardStarButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
            <Setter Property="ToolTip" Value="{Binding [FlashcardStarCard], Source={StaticResource Loc}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding [FlashcardUnstarCard], Source={StaticResource Loc}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SetOptionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Chip}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <ContextMenu x:Key="FlashcardCardContextMenu"
                     x:Shared="False">
            <ContextMenu.DataContext>
                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}"/>
            </ContextMenu.DataContext>
            <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                      Click="MoveToSetMenuItem_Click"/>
            <MenuItem Header="{Binding [AddFlashcardToSet], Source={StaticResource Loc}}"
                      Click="AddFlashcardToSetMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                      Click="EditFlashcardMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                      Click="DeleteFlashcardMenuItem_Click"/>
        </ContextMenu>

        <!-- Long-term maturity (New/Learning/Mature), not last-grade Known/Unknown - see
             FlashcardPreviewItem.Maturity. Mature/Learning deliberately reuse the Known/Unknown
             chip brushes, matching FlashcardStatisticsWindow's own maturity display. -->
        <DataTemplate x:Key="FlashcardStatusChipsTemplate">
            <Grid>
                <Border Style="{StaticResource FlashcardNewChipStyle}"
                        Visibility="{Binding IsMaturityNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [FlashcardStatusNew], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardNewChipForeground}"/>
                </Border>
                <Border Style="{StaticResource FlashcardUnknownChipStyle}"
                        Visibility="{Binding IsMaturityLearning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [FlashcardStatusLearning], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardUnknownChipForeground}"/>
                </Border>
                <Border Style="{StaticResource FlashcardKnownChipStyle}"
                        Visibility="{Binding IsMaturityMature, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [FlashcardStatusMature], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardKnownChipForeground}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridStatusRowTemplate">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                        MaxWidth="176" Margin="0,0,8,0"
                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Category}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                </Border>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridQuestionFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <Border x:Name="CardSurface"
                    Style="{StaticResource FlashcardGridCardStyle}"
                    ContextMenu="{StaticResource FlashcardCardContextMenu}"
                    MouseEnter="FlashcardStudyCardSurface_MouseEnter"
                    MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource FlashcardSideChipStyle}"
                                HorizontalAlignment="Left"
                                MaxWidth="132">
                            <TextBlock Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                                       Style="{StaticResource FlashcardChipTextStyle}"
                                       Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Visibility="{Binding HasQuestionAudio, Converter={StaticResource BoolToVis}}">
                                <Button Content="{icons:Icon Kind=Play, Size=13}"
                                        Width="26" Height="24" Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsQuestionAudioPlaying, Converter={StaticResource InverseBoolToVis}}"
                                        Click="PlayQuestionAudioButton_Click"/>
                                <Button Content="{icons:Icon Kind=Pause, Size=13}"
                                        Width="26" Height="24" Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsQuestionAudioPlaying, Converter={StaticResource BoolToVis}}"
                                        Click="PlayQuestionAudioButton_Click"/>
                            </Grid>
                            <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                    Visibility="{Binding HasQuestionAudio, Converter={StaticResource BoolToVis}}"
                                    Click="RestartQuestionAudioButton_Click"/>
                            <Button Content="{icons:Icon Kind=Edit, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [Edit], Source={StaticResource Loc}}"
                                    Click="EditFlashcardButton_Click"/>
                            <Button Content="{icons:Icon Kind=Swap, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveFlashcardButton_Click"/>
                            <Button Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardStarButtonStyle}"
                                    Click="ToggleStarButton_Click">
                                <icons:AppIcon Kind="Star" Style="{StaticResource FlashcardStarIconStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Height="76"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource SidebarBackground}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Cursor="Hand"
                                    ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                                    MouseLeftButtonUp="QuestionImage_MouseLeftButtonUp"
                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                    behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                    Visibility="{Binding HasQuestionImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding QuestionImageSource}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Question}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.BlockTitle}"
                                       FontWeight="SemiBold"
                                       LineHeight="23"
                                       Foreground="{DynamicResource TextColor}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <TextBlock Text="{Binding Question}"
                                                   TextWrapping="Wrap"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource FlashcardGridStatusRowTemplate}"/>
                </Grid>
            </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridAnswerFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <Border x:Name="CardSurface"
                    Style="{StaticResource FlashcardGridCardStyle}"
                    ContextMenu="{StaticResource FlashcardCardContextMenu}"
                    MouseEnter="FlashcardStudyCardSurface_MouseEnter"
                    MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource FlashcardSideChipStyle}"
                                HorizontalAlignment="Left"
                                MaxWidth="132">
                            <TextBlock Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                                       Style="{StaticResource FlashcardChipTextStyle}"
                                       Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Visibility="{Binding HasAnswerAudio, Converter={StaticResource BoolToVis}}">
                                <Button Content="{icons:Icon Kind=Play, Size=13}"
                                        Width="26" Height="24" Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsAnswerAudioPlaying, Converter={StaticResource InverseBoolToVis}}"
                                        Click="PlayAnswerAudioButton_Click"/>
                                <Button Content="{icons:Icon Kind=Pause, Size=13}"
                                        Width="26" Height="24" Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsAnswerAudioPlaying, Converter={StaticResource BoolToVis}}"
                                        Click="PlayAnswerAudioButton_Click"/>
                            </Grid>
                            <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                    Visibility="{Binding HasAnswerAudio, Converter={StaticResource BoolToVis}}"
                                    Click="RestartAnswerAudioButton_Click"/>
                            <Button Content="{icons:Icon Kind=Edit, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [Edit], Source={StaticResource Loc}}"
                                    Click="EditFlashcardButton_Click"/>
                            <Button Content="{icons:Icon Kind=Swap, Size=13}"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveFlashcardButton_Click"/>
                            <Button Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardStarButtonStyle}"
                                    Click="ToggleStarButton_Click">
                                <icons:AppIcon Kind="Star" Style="{StaticResource FlashcardStarIconStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Height="76"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource SidebarBackground}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Cursor="Hand"
                                    ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                                    MouseLeftButtonUp="AnswerImage_MouseLeftButtonUp"
                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                    behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                    Visibility="{Binding HasAnswerImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding AnswerImageSource}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Answer}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.BlockTitle}"
                                       FontWeight="SemiBold"
                                       LineHeight="23"
                                       Foreground="{DynamicResource TextColor}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <TextBlock Text="{Binding Answer}"
                                                   TextWrapping="Wrap"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource FlashcardGridStatusRowTemplate}"/>
                </Grid>
            </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyQuestionFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <Border x:Name="CardSurface"
                        Style="{StaticResource FlashcardStudyCardStyle}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter"
                        MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                            <Border Style="{StaticResource FlashcardSideChipStyle}"
                                    MaxWidth="132">
                                <TextBlock Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                            </Border>
                            <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                                    Margin="10,0,0,0"
                                    MaxWidth="210"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Grid Margin="0,0,8,0" Visibility="{Binding HasQuestionAudio, Converter={StaticResource BoolToVis}}">
                                <Button Content="{icons:Icon Kind=Play, Size=13}"
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsQuestionAudioPlaying, Converter={StaticResource InverseBoolToVis}}"
                                        Click="PlayQuestionAudioButton_Click"/>
                                <Button Content="{icons:Icon Kind=Pause, Size=13}"
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsQuestionAudioPlaying, Converter={StaticResource BoolToVis}}"
                                        Click="PlayQuestionAudioButton_Click"/>
                            </Grid>
                            <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                    Visibility="{Binding HasQuestionAudio, Converter={StaticResource BoolToVis}}"
                                    Click="RestartQuestionAudioButton_Click"/>
                            <Button Content="{icons:Icon Kind=Swap, Size=13}"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveStudyModeFlashcardButton_Click"/>
                            <Button Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardStarButtonStyle}"
                                    Click="ToggleStarButton_Click">
                                <icons:AppIcon Kind="Star" Style="{StaticResource FlashcardStarIconStyle}"/>
                            </Button>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Height="76"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource SidebarBackground}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Cursor="Hand"
                                    ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                                    MouseLeftButtonUp="QuestionImage_MouseLeftButtonUp"
                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                    behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                    Visibility="{Binding HasQuestionImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding QuestionImageSource}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Question}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.BlockTitle}"
                                       FontWeight="SemiBold"
                                       LineHeight="23"
                                       Foreground="{DynamicResource TextColor}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <TextBlock Text="{Binding Question}"
                                                   TextWrapping="Wrap"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding [FlashcardShowHint], Source={StaticResource Loc}}"
                                       FontSize="{StaticResource Type.Chip}"
                                       Foreground="{DynamicResource AccentPrimary}"
                                       Cursor="Hand"
                                       TextDecorations="Underline"
                                       MouseLeftButtonUp="StudyHintPrompt_MouseLeftButtonUp"
                                       Visibility="{Binding ShowHintPrompt, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Hint}"
                                       FontSize="{StaticResource Type.Chip}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       MaxWidth="220"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Visibility="{Binding IsHintRevealed, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                                   FontSize="{StaticResource Type.Chip}"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyAnswerFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <Border x:Name="CardSurface"
                        Style="{StaticResource FlashcardStudyCardStyle}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter"
                        MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                            <Border Style="{StaticResource FlashcardSideChipStyle}"
                                    MaxWidth="132">
                                <TextBlock Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                            </Border>
                            <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                                    Margin="10,0,0,0"
                                    MaxWidth="210"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Grid Margin="0,0,8,0" Visibility="{Binding HasAnswerAudio, Converter={StaticResource BoolToVis}}">
                                <Button Content="{icons:Icon Kind=Play, Size=13}"
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsAnswerAudioPlaying, Converter={StaticResource InverseBoolToVis}}"
                                        Click="PlayAnswerAudioButton_Click"/>
                                <Button Content="{icons:Icon Kind=Pause, Size=13}"
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                        ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                        Visibility="{Binding IsAnswerAudioPlaying, Converter={StaticResource BoolToVis}}"
                                        Click="PlayAnswerAudioButton_Click"/>
                            </Grid>
                            <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                    Visibility="{Binding HasAnswerAudio, Converter={StaticResource BoolToVis}}"
                                    Click="RestartAnswerAudioButton_Click"/>
                            <Button Content="{icons:Icon Kind=Swap, Size=13}"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardEditorIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveStudyModeFlashcardButton_Click"/>
                            <Button Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardStarButtonStyle}"
                                    Click="ToggleStarButton_Click">
                                <icons:AppIcon Kind="Star" Style="{StaticResource FlashcardStarIconStyle}"/>
                            </Button>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Height="76"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource SidebarBackground}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Cursor="Hand"
                                    ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                                    MouseLeftButtonUp="AnswerImage_MouseLeftButtonUp"
                                    behaviors:RoundedClipBehavior.IsEnabled="True"
                                    behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                    Visibility="{Binding HasAnswerImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding AnswerImageSource}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Answer}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.BlockTitle}"
                                       FontWeight="SemiBold"
                                       LineHeight="23"
                                       Foreground="{DynamicResource TextColor}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <TextBlock Text="{Binding Answer}"
                                                   TextWrapping="Wrap"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Chip}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Right"/>
                </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="FlashcardsEditorHeaderBorder"
                Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="{StaticResource Shell.FeatureTitleRowPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChromeTitleFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.DialogTitle}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [FlashcardsEditorTitle], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource InputSurface}"
                        CornerRadius="{StaticResource Radius.Control}"
                        VerticalAlignment="Center"
                        Padding="8,6"
                        Effect="{StaticResource Elevation.Field}"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{icons:Icon Plus}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [AddFlashcard], Source={StaticResource Loc}}"
                                Click="AddFlashcardButton_Click"/>
                        <Button x:Name="FiltersButton"
                                Content="{icons:Icon Search}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardFilters], Source={StaticResource Loc}}"
                                Click="FiltersButton_Click"/>
                        <Button x:Name="ShuffleModeButton"
                                Content="{icons:Icon Shuffle, Size=14}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [ShuffleCards], Source={StaticResource Loc}}"
                                Click="ShuffleModeButton_Click"/>
                        <Popup x:Name="FiltersPopup"
                               PlacementTarget="{Binding ElementName=FiltersButton}"
                               Placement="Bottom"
                               HorizontalOffset="-16"
                               VerticalOffset="0"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="None">
                            <Border Background="Transparent"
                                    Padding="16,4,16,18"
                                    ClipToBounds="False">
                                <Grid MinWidth="280"
                                      HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="12"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Vertical">
                                                <ComboBox x:Name="StatusFilterComboBox"
                                                          Width="260"
                                                          Style="{StaticResource ChromeComboBoxStyle}"
                                                          Background="{DynamicResource WindowBackground}"
                                                          DisplayMemberPath="DisplayName"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
                                                <ComboBox x:Name="CategoryFilterComboBox"
                                                          Width="260"
                                                          Style="{StaticResource ChromeComboBoxStyle}"
                                                          Background="{DynamicResource WindowBackground}"
                                                          DisplayMemberPath="DisplayName"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>
                                                <CheckBox x:Name="DueOnlyFilterCheckBox"
                                                          Content="{Binding [FlashcardDueCardsOnly], Source={StaticResource Loc}}"
                                                          Margin="0,0,0,8"
                                                          Click="DueOnlyFilterCheckBox_Click"/>
                                                <CheckBox x:Name="StarredOnlyFilterCheckBox"
                                                          Content="{Binding [FlashcardStarredOnly], Source={StaticResource Loc}}"
                                                          Margin="0,0,0,8"
                                                          Click="StarredOnlyFilterCheckBox_Click"/>
                                                <Border Height="32"
                                                        Padding="6,0"
                                                        Margin="0,0,0,8"
                                                        Style="{StaticResource ChromeFieldBorderStyle}"
                                                        Background="{DynamicResource WindowBackground}"
                                                        MinHeight="32">
                                                    <DockPanel LastChildFill="True">
                                                        <icons:AppIcon Kind="Search" Width="14" Height="14"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   Margin="2,0,8,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox x:Name="FlashcardSearchTextBox"
                                                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource TextColor}"
                                                                 CaretBrush="{DynamicResource TextColor}"
                                                                 VerticalContentAlignment="Center"
                                                                 TextChanged="FlashcardSearchTextBox_TextChanged"
                                                                 ToolTip="{Binding [FlashcardSearchHint], Source={StaticResource Loc}}"/>
                                                    </DockPanel>
                                                </Border>
                                                <Button Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
                                                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0"
                                                        Click="ClearFiltersButton_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                        <Button Content="{icons:Icon History}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardHistory], Source={StaticResource Loc}}"
                                Click="FlashcardHistoryButton_Click"/>
                        <Button x:Name="ImportCardsButton"
                                Content="{icons:Icon Import}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardImportCards], Source={StaticResource Loc}}"
                                Click="ImportCardsButton_Click"/>
                        <Button x:Name="ExportButton"
                                Content="{icons:Icon Download}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Export], Source={StaticResource Loc}}"
                                Click="ExportButton_Click"/>
                        <Button x:Name="FullscreenButton"
                                Content="{icons:Icon Monitor}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [StudyModeFullscreenTooltip], Source={StaticResource Loc}}"
                                Click="FullscreenButton_Click"/>
                        <Button x:Name="OptionsPanelToggleButton"
                                Content="{icons:Icon Settings}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardOptionsTooltip], Source={StaticResource Loc}}"
                                Click="OptionsPanelToggleButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button x:Name="LinkedNoteButton"
                                Content="{Binding ElementName=FlashcardsWindow, Path=LinkedNoteButtonText}"
                                Style="{StaticResource FlashcardLinkedNoteButtonStyle}"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Click="LinkedNoteButton_Click"
                                ToolTip="{Binding ElementName=FlashcardsWindow, Path=LinkedNoteButtonToolTip}"
                                TextOptions.TextFormattingMode="Ideal"/>
                        <Border x:Name="AiGeneratedInfoBadge"
                                Width="30"
                                Height="30"
                                Margin="0,0,0,0"
                                CornerRadius="15"
                                Background="{DynamicResource IconButtonBackground}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="180"
                                Visibility="Collapsed">
                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="1"
                                Height="22"
                                Margin="8,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button Content="{icons:Icon Save}"
                                Style="{StaticResource EditorPrimarySaveButtonStyle}"
                                ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="FlashcardsTagsBorder"
                Grid.Row="1"
                Margin="20,4,20,0"
                Padding="10,0"
                Style="{StaticResource ChromeFieldBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <!-- Collapsible options panel (sets, link, flip speed) — mind-map ArrangePanel pattern. -->
        <Border x:Name="FlashcardsOptionsPanel"
                Grid.Row="2"
                Margin="20,8,20,0"
                Style="{StaticResource ChromePanelBorderStyle}"
                Padding="12,10"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform Y="-6"/>
            </Border.RenderTransform>
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="SetSelectorComboBox"
                          Width="180"
                          Height="32"
                          Margin="0,0,6,10"
                          VerticalAlignment="Center"
                          Style="{StaticResource SetSelectorComboBoxStyle}"
                          Background="{DynamicResource WindowBackground}"
                          ItemContainerStyle="{StaticResource SetSelectorActionComboBoxItemStyle}"
                          SelectionChanged="SetSelectorComboBox_SelectionChanged"
                          ToolTip="{Binding [FlashcardSetLabel], Source={StaticResource Loc}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1"
                                        Content="{icons:Icon Kind=Edit, Size=13}"
                                        Style="{StaticResource SetOptionActionButtonStyle}"
                                        ToolTip="{Binding [RenameFlashcardSet], Source={StaticResource Loc}}"
                                        Click="RenameSetInListButton_Click"/>
                                <Button Grid.Column="2"
                                        Content="{icons:Icon Kind=Close, Size=12}"
                                        Style="{StaticResource SetOptionActionButtonStyle}"
                                        ToolTip="{Binding [DeleteFlashcardSet], Source={StaticResource Loc}}"
                                        Click="DeleteSetInListButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{icons:Icon Group}"
                        Style="{StaticResource EditorToolIconButtonStyle}"
                        Margin="0,0,14,10"
                        ToolTip="{Binding [CreateFlashcardSet], Source={StaticResource Loc}}"
                        Click="CreateSetButton_Click"/>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,14,16"
                        Background="{DynamicResource BorderColor}"/>

                <ComboBox ItemsSource="{Binding ElementName=FlashcardsWindow, Path=NoteLinkOptions}"
                          SelectedItem="{Binding ElementName=FlashcardsWindow, Path=SelectedLinkedNote, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          Style="{StaticResource FlashcardLinkedNoteComboBoxStyle}"
                          SelectedValuePath="Id"
                          Margin="0,0,14,10"
                          VerticalAlignment="Center"
                          ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,14,16"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10">
                    <TextBlock Text="{Binding [FlashcardFlipSpeed], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Meta}"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="FlipSpeedSlider"
                            Width="120"
                            TickPlacement="None"
                            TickFrequency="100"
                            SmallChange="100"
                            LargeChange="100"
                            IsSnapToTickEnabled="True"
                            Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               MinWidth="45">
                        <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value, StringFormat={}{0:0}}"/>
                        <Run Text="ms"/>
                    </TextBlock>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid x:Name="FlashcardsContentHost"
              Grid.Row="3"
              Margin="20,10,20,10">
            <Border x:Name="FlashcardsGridViewBorder"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="0">
                <Grid>
                    <controls:FlashcardGridItemsControl x:Name="FlashcardsItemsControl"
                                  Padding="14,24,14,14"
                                  Margin="16"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <controls:FlashcardGridItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <wpftoolkit:VirtualizingWrapPanel IsItemsHost="True"
                                                                   ItemSize="332,248"/>
                            </ItemsPanelTemplate>
                        </controls:FlashcardGridItemsControl.ItemsPanel>
                        <controls:FlashcardGridItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:FlashcardFlipHost IsFlipped="{Binding IsFlipped, Mode=TwoWay}"
                                                            Width="316"
                                                            Height="224"
                                                            Margin="0,8,16,16"
                                                            ClipToBounds="False"
                                                            MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp">
                                    <controls:FlashcardFlipHost.FrontContent>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource FlashcardGridQuestionFaceTemplate}"/>
                                    </controls:FlashcardFlipHost.FrontContent>
                                    <controls:FlashcardFlipHost.BackContent>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource FlashcardGridAnswerFaceTemplate}"/>
                                    </controls:FlashcardFlipHost.BackContent>
                                </controls:FlashcardFlipHost>
                            </DataTemplate>
                        </controls:FlashcardGridItemsControl.ItemTemplate>
                    </controls:FlashcardGridItemsControl>
                    <TextBlock x:Name="FlashcardsGridEmptyStateText"
                               Visibility="Collapsed"
                               FontSize="{StaticResource Type.EmptyState}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="StudyModeViewBorder"
                    Visibility="Collapsed"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="16,14">
                <ScrollViewer x:Name="StudyModeScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Background="Transparent"
                              Padding="4,12,4,0"
                              ClipToBounds="True"
                              behaviors:RoundedClipBehavior.IsEnabled="True"
                              behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Card}">
                    <StackPanel x:Name="StudyModeContentPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                Margin="0,10,0,8">
                        <Border x:Name="CramModeBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentWarningSubtle}"
                                BorderBrush="{DynamicResource AccentWarningSubtleBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="10,6"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [FlashcardCramBanner], Source={StaticResource Loc}}"
                                       FontSize="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentWarningSubtleForeground}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Stretch"
                                    Margin="0,0,0,12">
                            <Border x:Name="StudyModeProgressTrack"
                                    MaxWidth="316"
                                    HorizontalAlignment="Stretch"
                                    Height="4"
                                    MinHeight="4"
                                    Background="{DynamicResource ProgressTrackBackground}"
                                    CornerRadius="2"
                                    ToolTipService.ShowDuration="5000"
                                    ToolTipService.InitialShowDelay="250">
                                <Border x:Name="StudyModeProgressFill"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Width="0"
                                        Height="4"
                                        MinHeight="4"
                                        Background="{DynamicResource AccentSuccess}"
                                        CornerRadius="2"/>
                            </Border>
                            <Grid Margin="0,6,0,4">
                                <TextBlock x:Name="StudyModeProgressText"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           HorizontalAlignment="Center"/>
                                <!-- Same layout slot as progress text so revealing it does not grow the panel. -->
                                <TextBlock x:Name="StudyModeCompletionText"
                                           Visibility="Collapsed"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentSuccess}"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="StudyModeLiveStatsText"
                                       FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <!-- DownOnly: keep design size when roomy, scale down on short viewports. -->
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     MaxWidth="360"
                                     MaxHeight="280"
                                     HorizontalAlignment="Center"
                                     Margin="0,10,0,0">
                                <Border x:Name="StudyModeCard"
                                        Width="332"
                                        Height="248"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClipToBounds="False"
                                        Cursor="Hand"
                                        ContextMenu="{StaticResource FlashcardCardContextMenu}"
                                        MouseLeftButtonUp="StudyModeCard_MouseLeftButtonUp">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Border.RenderTransform>

                                    <controls:FlashcardFlipHost x:Name="StudyModeFlipHost"
                                                                Width="316"
                                                                Height="224"
                                                                Margin="8">
                                        <controls:FlashcardFlipHost.FrontContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardStudyQuestionFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.FrontContent>
                                        <controls:FlashcardFlipHost.BackContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardStudyAnswerFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.BackContent>
                                    </controls:FlashcardFlipHost>
                                </Border>
                            </Viewbox>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   ItemWidth="Auto"
                                   Margin="0,4,0,0">
                            <Button x:Name="StudyModePreviousButton"
                                    Content="{Binding [StudyModePrevious], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinWidth="100"
                                    Margin="4,0,4,8"
                                    Click="StudyModePreviousButton_Click"/>
                            <Button x:Name="StudyModeNextButton"
                                    Content="{Binding [StudyModeNext], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinWidth="100"
                                    Margin="4,0,4,8"
                                    Click="StudyModeNextButton_Click"/>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   ItemWidth="Auto"
                                   Margin="0,0,0,0">
                            <Button x:Name="StudyModeAgainButton"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinWidth="90"
                                    Margin="4,0,4,8"
                                    Background="{DynamicResource AccentDanger}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AccentDangerForeground}"
