                                    <TextBlock x:Name="StudyModeAgainIntervalText"
                                               HorizontalAlignment="Center"
                                               FontSize="{StaticResource Type.Caption}"
                                               FontWeight="Normal"
                                               Opacity="0.85"/>
                                    <TextBlock Text="{Binding [StudyGradeAgain], Source={StaticResource Loc}}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StudyModeHardButton"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinWidth="90"
                                    Margin="4,0,4,8"
                                    Background="{DynamicResource AccentWarning}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AccentWarningForeground}"
                                    Click="StudyModeHardButton_Click">
