                                    <TextBlock x:Name="StudyModeHardIntervalText"
                                               HorizontalAlignment="Center"
                                               FontSize="{StaticResource Type.Caption}"
                                               FontWeight="Normal"
                                               Opacity="0.85"/>
                                    <TextBlock Text="{Binding [StudyGradeHard], Source={StaticResource Loc}}"
