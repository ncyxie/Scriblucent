<Window xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:wpftoolkit="clr-namespace:WpfToolkit.Controls"
        x:Name="FlashcardsWindow"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="780"
        Width="980"
        MinHeight="620"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WorkspaceBackdrop}"
        Closing="FlashcardsPreviewWindow_Closing">
    <Window.Resources>
        <ResourceDictionary>
        <!-- Own ScrollViewer>ItemsPresenter template (matching ListBox's own default template
             shape) so ScrollContentPresenter's IScrollInfo auto-discovery finds the virtualizing
             panel. A hand-declared <ScrollViewer> wrapping a plain <ItemsControl> adds an extra
             indirection layer that VirtualizingWrapPanel's IScrollInfo auto-discovery doesn't see
             through, so the panel never re-virtualizes on scroll (confirmed via diagnostic
             logging: PrepareContainerForItemOverride fired twice at startup and never again). -->
        <Style TargetType="controls:FlashcardGridItemsControl">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:FlashcardGridItemsControl">
                        <!-- Padding must live on ItemsPresenter: ScrollViewer.Padding is ignored when
                             VirtualizingWrapPanel is the IScrollInfo (viewport fills the scroller). -->
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      behaviors:MiddleClickScrollBehavior.IsEnabled="True"
                                      behaviors:RoundedClipBehavior.IsEnabled="True"
                                      behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Card}">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateSetButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
        </Style>

        <Style x:Key="FlashcardToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="FlashcardToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarPrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="FlashcardFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="FlashcardFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardToolbarPrimaryButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="FlashcardLinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkedNoteToolbarButtonStyle}"/>

        <Style x:Key="FlashcardLinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource LinkedNoteComboBoxStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FlashcardEditorIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:InteractionSurface>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Study/grid faces use bake-once CardShadowLayer (sibling of CardSurface). Hover is
             lift-only on the parent Grid via FlashcardStudyCardSurface_MouseEnter/Leave —
             no live DropShadowEffect per card. -->

        <!-- Shared card geometry and hover treatment; the editor adds selection feedback. -->
        <Style x:Key="FlashcardCardStyle" TargetType="Border">
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Raised"/>
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="224"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="behaviors:ScrollTileBehavior.IsScrolling" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardHoverBackground}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardGridCardStyle" TargetType="Border" BasedOn="{StaticResource FlashcardCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedBackground}"/>
                    <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                    <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="True"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Path=(behaviors:ScrollTileBehavior.IsScrolling), RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedHoverBackground}"/>
                    <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
                    <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="True"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardMetaChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlashcardCategoryChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardCategoryChipBackground}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
        </Style>

        <!-- Starred cards use the shared warning accent. -->
        <Style x:Key="FlashcardStarIconStyle" TargetType="icons:AppIcon" BasedOn="{StaticResource {x:Type icons:AppIcon}}">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardStarButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
            <Setter Property="ToolTip" Value="{Binding [FlashcardStarCard], Source={StaticResource Loc}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding [FlashcardUnstarCard], Source={StaticResource Loc}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SetOptionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <ContextMenu x:Key="FlashcardCardContextMenu" behaviors:ItemReorderBehavior.MenuActions="True"
                     x:Shared="False" Opened="FlashcardCardContextMenu_Opened">
            <ContextMenu.DataContext>
                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}"/>
            </ContextMenu.DataContext>
            <MenuItem Tag="Selection" Header="{Binding [MassSelectModeTitle], Source={StaticResource Loc}}" Click="SelectFlashcardMenuItem_Click"/>
            <Separator/>
            <MenuItem Tag="Duplicate" Header="{Binding [Duplicate], Source={StaticResource Loc}}" InputGestureText="Ctrl+D"
                      Click="DuplicateFlashcardMenuItem_Click"/>
            <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                      Click="MoveToSetMenuItem_Click"/>
            <MenuItem Header="{Binding [AddFlashcardToSet], Source={StaticResource Loc}}"
                      Click="AddFlashcardToSetMenuItem_Click"/>
            <MenuItem Tag="Restart" Header="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                      Click="RestartFlashcardAudioMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                      Click="EditFlashcardMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                      Click="DeleteFlashcardMenuItem_Click"/>
        </ContextMenu>

        <!-- Long-term maturity (New/Learning/Mature), not last-grade Known/Unknown - see
             FlashcardPreviewItem.Maturity. Mature/Learning deliberately reuse the Known/Unknown
             chip brushes, matching FlashcardStatisticsWindow's own maturity display. -->

        <Style x:Key="FlashcardFlipButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactGlyphButtonStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{DynamicResource FlashcardSideChipForeground}"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardSideChipBackground}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
        </Style>

        <Style x:Key="FlashcardHintButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource EditorToolIconToggleButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <controls:InteractionSurface x:Name="ButtonBorder" Background="{TemplateBinding Background}" Role="Compact"
                                HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter Margin="4,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:InteractionSurface>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsStudy), RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding HasHint}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FlashcardHeaderTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <controls:ItemReorderGrip Width="24" Height="24" Background="Transparent"
                        Visibility="{Binding Path=(controls:FlashcardFaceContext.IsStudy), RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource FlashcardFlipButtonStyle}"
                            ToolTip="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}" Click="CardFlipButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FlashcardChipTextStyle}">
                                        <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <icons:AppIcon Kind="Swap" Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:SurfaceMaterialBorder Style="{StaticResource FlashcardCategoryChipStyle}"
                            Margin="0,0,8,0" HorizontalAlignment="Left" ToolTip="{Binding Category}"
                            Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Category}" Style="{StaticResource FlashcardChipTextStyle}"
                                   Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                    </controls:SurfaceMaterialBorder>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextColorSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaturityLearning}" Value="True"><Setter Property="Fill" Value="{DynamicResource FlashcardUnknownChipForeground}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsMaturityMature}" Value="True"><Setter Property="Fill" Value="{DynamicResource FlashcardKnownChipForeground}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding [FlashcardStatusNew], Source={StaticResource Loc}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaturityLearning}" Value="True"><Setter Property="Text" Value="{Binding [FlashcardStatusLearning], Source={StaticResource Loc}}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsMaturityMature}" Value="True"><Setter Property="Text" Value="{Binding [FlashcardStatusMature], Source={StaticResource Loc}}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardActionsTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Content="{Binding [FlashcardShowHint], Source={StaticResource Loc}}" HorizontalAlignment="Left"
                              Style="{StaticResource FlashcardHintButtonStyle}" Checked="CardHintButton_Checked" Unchecked="CardHintButton_Unchecked"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,6,0" Click="CardAudioButton_Click" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="ToolTip" Value="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="False"/>
                                        <Condition Binding="{Binding HasQuestionAudio}" Value="True"/>
                                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding HasAnswerAudio}" Value="True"/>
                                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="False"/>
                                        <Condition Binding="{Binding IsQuestionAudioPlaying}" Value="True"/>
                                    </MultiDataTrigger.Conditions><Setter Property="ToolTip" Value="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"/></MultiDataTrigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding IsAnswerAudioPlaying}" Value="True"/>
                                    </MultiDataTrigger.Conditions><Setter Property="ToolTip" Value="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"/></MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <icons:AppIcon Width="13" Height="13">
                            <icons:AppIcon.Style>
                                <Style TargetType="icons:AppIcon" BasedOn="{StaticResource {x:Type icons:AppIcon}}">
                                    <Setter Property="Kind" Value="Play"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="False"/>
                                            <Condition Binding="{Binding IsQuestionAudioPlaying}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="Kind" Value="Pause"/></MultiDataTrigger>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=(controls:FlashcardFaceContext.IsAnswer), RelativeSource={RelativeSource Self}}" Value="True"/>
                                            <Condition Binding="{Binding IsAnswerAudioPlaying}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="Kind" Value="Pause"/></MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </icons:AppIcon.Style>
                        </icons:AppIcon>
                    </Button>
                    <Button Content="{icons:Icon Kind=Edit, Size=13}" Style="{StaticResource FlashcardEditorIconButtonStyle}"
                            Margin="0,0,6,0" ToolTip="{Binding [Edit], Source={StaticResource Loc}}" Click="EditFlashcardButton_Click"/>
                    <Button Style="{StaticResource FlashcardStarButtonStyle}" Margin="0,0,6,0" Click="ToggleStarButton_Click">
                        <icons:AppIcon Kind="Star" Style="{StaticResource FlashcardStarIconStyle}"/>
                    </Button>
                    <Button Content="{icons:Icon Kind=MoreVertical, Size=13}" Style="{StaticResource FlashcardEditorIconButtonStyle}"
                            ToolTip="{Binding [MassSelectMoreActions], Source={StaticResource Loc}}" Click="CardMoreButton_Click"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardQuestionBodyTemplate">
            <Border Margin="0,6,0,6" Padding="0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Height="76"
                            Margin="0,0,0,6"
                            Background="{DynamicResource MediaCanvasSurface}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Cursor="Hand"
                            ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                            MouseLeftButtonUp="QuestionImage_MouseLeftButtonUp"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                            Visibility="{Binding HasQuestionImage, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding QuestionImageSource}" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Question}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.BlockTitle}"
                               FontWeight="SemiBold"
                               LineHeight="23"
                               Foreground="{DynamicResource TextColor}">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="320"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <TextBlock Text="{Binding Question}"
                                           TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardAnswerBodyTemplate">
            <Border Margin="0,6,0,6" Padding="0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Height="76"
                            Margin="0,0,0,6"
                            Background="{DynamicResource MediaCanvasSurface}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Cursor="Hand"
                            ToolTip="{Binding [FlashcardViewImage], Source={StaticResource Loc}}"
                            MouseLeftButtonUp="AnswerImage_MouseLeftButtonUp"
                            behaviors:RoundedClipBehavior.IsEnabled="True"
                            behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                            Visibility="{Binding HasAnswerImage, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding AnswerImageSource}" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Answer}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.BlockTitle}"
                               FontWeight="SemiBold"
                               LineHeight="23"
                               Foreground="{DynamicResource TextColor}">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="320"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <TextBlock Text="{Binding Answer}"
                                           TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridQuestionFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False" controls:FlashcardFaceContext.IsStudy="False" controls:FlashcardFaceContext.IsAnswer="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <controls:SurfaceMaterialBorder x:Name="CardSurface" Style="{StaticResource FlashcardGridCardStyle}" ContextMenu="{StaticResource FlashcardCardContextMenu}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter" MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}" ContentTemplate="{StaticResource FlashcardHeaderTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource FlashcardQuestionBodyTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource FlashcardActionsTemplate}"/>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridAnswerFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False" controls:FlashcardFaceContext.IsStudy="False" controls:FlashcardFaceContext.IsAnswer="True">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <controls:SurfaceMaterialBorder x:Name="CardSurface" Style="{StaticResource FlashcardGridCardStyle}" ContextMenu="{StaticResource FlashcardCardContextMenu}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter" MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}" ContentTemplate="{StaticResource FlashcardHeaderTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource FlashcardAnswerBodyTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource FlashcardActionsTemplate}"/>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyQuestionFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False" controls:FlashcardFaceContext.IsStudy="True" controls:FlashcardFaceContext.IsAnswer="False">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <controls:SurfaceMaterialBorder x:Name="CardSurface" Style="{StaticResource FlashcardCardStyle}" ContextMenu="{StaticResource FlashcardCardContextMenu}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter" MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}" ContentTemplate="{StaticResource FlashcardHeaderTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource FlashcardQuestionBodyTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource FlashcardActionsTemplate}"/>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyAnswerFaceTemplate">
            <Grid Width="316" Height="224" ClipToBounds="False" controls:FlashcardFaceContext.IsStudy="True" controls:FlashcardFaceContext.IsAnswer="True">
                <controls:CardShadowLayer x:Name="ShadowLayer"/>
                <controls:SurfaceMaterialBorder x:Name="CardSurface" Style="{StaticResource FlashcardCardStyle}" ContextMenu="{StaticResource FlashcardCardContextMenu}"
                        MouseEnter="FlashcardStudyCardSurface_MouseEnter" MouseLeave="FlashcardStudyCardSurface_MouseLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}" ContentTemplate="{StaticResource FlashcardHeaderTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource FlashcardAnswerBodyTemplate}"/>
                        <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource FlashcardActionsTemplate}"/>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="ContentRoot" controls:EditorChromeContext.Controller="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Popup x:Name="FlashcardHintPopup" Placement="Top" VerticalOffset="8" HorizontalOffset="-16"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="None"
               Opened="FlashcardHintPopup_Opened" Closed="FlashcardHintPopup_Closed">
            <Border Padding="16" PreviewKeyDown="FlashcardHintPopup_PreviewKeyDown">
                <Grid MaxWidth="286" MaxHeight="160">
                    <controls:BakedElevationLayer Kind="ButtonCard" IsHitTestVisible="False"/>
                    <controls:SurfaceMaterialBorder Background="{DynamicResource CardBackground}" controls:SurfaceMaterial.Kind="Raised"
                            BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12">
                        <ScrollViewer x:Name="FlashcardHintScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource RoundedCompactScrollViewerStyle}"
                                      Focusable="True" KeyboardNavigation.TabNavigation="Cycle" behaviors:SmoothScrollBehavior.IsEnabled="True"
                                      behaviors:ScrollWheelContainmentBehavior.IsEnabled="True">
                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="{StaticResource Type.Body}"
                                       Foreground="{DynamicResource TextColor}"/>
                        </ScrollViewer>
                    </controls:SurfaceMaterialBorder>
                </Grid>
            </Border>
        </Popup>

        <Border motion:WindowMotion.Role="Chrome" x:Name="FlashcardsEditorHeaderBorder"
                Grid.Row="0" Style="{StaticResource EditorChromeStyle}">
            <Grid behaviors:EditorHeaderLayoutBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="EditorTitleField" Grid.Column="0"
                        Grid.Row="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChromeTitleFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.DialogTitle}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [FlashcardsEditorTitle], Source={StaticResource Loc}}"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                        <controls:EditorTitleStatus x:Name="EditedIndicatorText" Style="{StaticResource EditorTitleStatusStyle}"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="EditorCommandTray" Grid.Column="1"
                        Grid.Row="0"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        VerticalAlignment="Center"
                        Padding="0,6"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <controls:EditorCommandPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="AddCardToolButton" Content="{icons:Icon Plus}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [AddFlashcard], Source={StaticResource Loc}}"
                                Click="AddFlashcardButton_Click"/>
                        <Button x:Name="FiltersButton"
                                Content="{icons:Icon Search}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardFilters], Source={StaticResource Loc}}"
                                Click="FiltersButton_Click"/>
                        <Button x:Name="ShuffleModeButton"
                                Content="{icons:Icon Shuffle, Size=14}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [ShuffleCards], Source={StaticResource Loc}}"
                                Click="ShuffleModeButton_Click"/>
                        <Popup x:Name="FiltersPopup"
                               PlacementTarget="{Binding ElementName=FiltersButton}"
                               Placement="Bottom"
                               HorizontalOffset="-32"
                               VerticalOffset="-28"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="None">
                            <Border
                                    Padding="32"
                                    ClipToBounds="False">
                                <Grid MinWidth="280"
                                      HorizontalAlignment="Left"
                                      UseLayoutRounding="True"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            IsHitTestVisible="False"
                                            Effect="{StaticResource Elevation.Popup}"/>
                                    <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource PopupBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            SnapsToDevicePixels="True">
                                        <Border Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="12"
                                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Vertical">
                                                <ComboBox x:Name="StatusFilterComboBox"
                                                          Width="260"
                                                          Style="{StaticResource InsetComboBoxStyle}"
                                                          DisplayMemberPath="DisplayName"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="StatusFilterComboBox_SelectionChanged" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"/>
                                                <ComboBox x:Name="CategoryFilterComboBox"
                                                          Width="260"
                                                          Style="{StaticResource InsetComboBoxStyle}"
                                                          DisplayMemberPath="DisplayName"
                                                          Margin="0,0,0,8"
                                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"/>
                                                <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="DueOnlyFilterCheckBox"
                                                          Content="{Binding [FlashcardDueCardsOnly], Source={StaticResource Loc}}"
                                                          Margin="0,0,0,8"
                                                          Click="DueOnlyFilterCheckBox_Click"/>
                                                <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="StarredOnlyFilterCheckBox"
                                                          Content="{Binding [FlashcardStarredOnly], Source={StaticResource Loc}}"
                                                          Margin="0,0,0,8"
                                                          Click="StarredOnlyFilterCheckBox_Click"/>
                                                <Border Height="32"
                                                        Margin="0,0,0,8"
                                                        Style="{StaticResource ChromeInsetFieldBorderStyle}"
                                                        MinHeight="32">
                                                    <DockPanel LastChildFill="True">
                                                        <icons:AppIcon Kind="Search" Width="14" Height="14"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   Margin="{StaticResource Field.InlineLabelMargin}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox x:Name="FlashcardSearchTextBox"
                                                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource TextColor}"
                                                                 CaretBrush="{DynamicResource TextColor}"
                                                                 VerticalContentAlignment="Center"
                                                                 TextChanged="FlashcardSearchTextBox_TextChanged"
                                                                 ToolTip="{Binding [FlashcardSearchHint], Source={StaticResource Loc}}"/>
                                                    </DockPanel>
                                                </Border>
                                                <Button Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
                                                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0"
                                                        Click="ClearFiltersButton_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </controls:SurfaceMaterialBorder>
                                </Grid>
                            </Border>
                        </Popup>
                        <Button Content="{icons:Icon History}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardHistory], Source={StaticResource Loc}}"
                                Click="FlashcardHistoryButton_Click"/>
                        <Button x:Name="ImportCardsButton"
                                Content="{icons:Icon Import}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardImportCards], Source={StaticResource Loc}}"
                                Click="ImportCardsButton_Click"/>
                        <Button x:Name="ExportButton"
                                Content="{icons:Icon Download}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Export], Source={StaticResource Loc}}"
                                Click="ExportButton_Click"/>
                        <Button x:Name="FullscreenButton"
                                Content="{icons:Icon Monitor}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [StudyModeFullscreenTooltip], Source={StaticResource Loc}}"
                                Click="FullscreenButton_Click"/>
                        <Button x:Name="OptionsPanelToggleButton"
                                Content="{icons:Icon Settings}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [FlashcardOptionsTooltip], Source={StaticResource Loc}}"
                                Click="OptionsPanelToggleButton_Click"/>
                        <Button x:Name="TagsPanelToggleButton"
                                Content="{icons:Icon Tag}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Tags], Source={StaticResource Loc}}"
                                Click="TagsPanelToggleButton_Click"/>
                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"
                                Visibility="{Binding Visibility, ElementName=LinkedNoteButton}"/>

                        <Button x:Name="LinkedNoteButton"
                                Content="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonText, RelativeSource={RelativeSource Self}}"
                                Style="{StaticResource FlashcardLinkedNoteButtonStyle}"
                                VerticalAlignment="Center"
                                Click="LinkedNoteButton_Click"
                                ToolTip="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonToolTip, RelativeSource={RelativeSource Self}}"
                                TextOptions.TextFormattingMode="Ideal"/>
                        <motion:LayoutRevealHost VerticalAlignment="Center">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="AiGeneratedInfoBadge"
                                Width="30"
                                Height="30"
                                Margin="0,0,0,0"
                                CornerRadius="15"
                                Background="{DynamicResource IconButtonBackground}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="180"
                                Visibility="Collapsed">
                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center"/>
                        </controls:SurfaceMaterialBorder>
                        </motion:LayoutRevealHost>
                        <Border Width="1"
                                Height="22"
                                Margin="8,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button Content="{icons:Icon Save}"
                                Style="{StaticResource EditorPrimarySaveButtonStyle}"
                                ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                                Click="SaveButton_Click"/>
                    </controls:EditorCommandPanel>
                </Border>
                <motion:LayoutRevealHost Grid.Row="1" Grid.ColumnSpan="2">
                <controls:AiReviewNotice x:Name="AiReviewNotice"
                                         Margin="0,10,0,0"
                                         AllowDismiss="True"
                                         Dismissed="AiReviewNotice_Dismissed"
                                         Visibility="Collapsed"/>
                </motion:LayoutRevealHost>
            </Grid>
        </Border>

        <motion:LayoutRevealHost Grid.Row="1">
        <Border x:Name="FlashcardsTagsBorder"
                Margin="20,4,20,0"
                Style="{StaticResource ChromeInsetFieldBorderStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Field.InlineLabelMargin}"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>
        </motion:LayoutRevealHost>

        <!-- Collapsible options panel (sets, link, flip speed) — mind-map ArrangePanel pattern. -->
        <motion:LayoutRevealHost Grid.Row="2">
        <Border x:Name="FlashcardsOptionsPanel"
                Margin="20,8,20,0"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="12,5"
                Visibility="Collapsed">
            <controls:EditorCommandPanel CanWrap="True" VerticalAlignment="Center">
                <ComboBox x:Name="SetSelectorComboBox"
                          Width="180"
                          Height="32"
                          Margin="0,5,6,5"
                          VerticalAlignment="Center"
                          Style="{StaticResource SetSelectorComboBoxStyle}"
                          ItemContainerStyle="{StaticResource SetSelectorActionComboBoxItemStyle}"
                          SelectionChanged="SetSelectorComboBox_SelectionChanged"
                          ToolTip="{Binding [FlashcardSetLabel], Source={StaticResource Loc}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1"
                                        Content="{icons:Icon Kind=Edit, Size=13}"
                                        Style="{StaticResource SetOptionActionButtonStyle}"
                                        ToolTip="{Binding [RenameFlashcardSet], Source={StaticResource Loc}}"
                                        Click="RenameSetInListButton_Click"/>
                                <Button Grid.Column="2"
                                        Content="{icons:Icon Kind=Close, Size=12}"
                                        Style="{StaticResource SetOptionActionButtonStyle}"
                                        ToolTip="{Binding [DeleteFlashcardSet], Source={StaticResource Loc}}"
                                        Click="DeleteSetInListButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{icons:Icon Group}"
                        Style="{StaticResource EditorToolIconButtonStyle}"
                        Margin="0,5,14,5"
                        ToolTip="{Binding [CreateFlashcardSet], Source={StaticResource Loc}}"
                        Click="CreateSetButton_Click"/>

                <Border Width="1"
                        Height="20"
                        Margin="0,11,14,11"
                        Background="{DynamicResource BorderColor}"/>

                <ComboBox ItemsSource="{Binding Path=(controls:EditorChromeContext.Controller).NoteLinkOptions, RelativeSource={RelativeSource Self}}"
                          SelectedItem="{Binding Path=(controls:EditorChromeContext.Controller).SelectedLinkedNote, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          Style="{StaticResource FlashcardLinkedNoteComboBoxStyle}"
                          SelectedValuePath="Id"
                          Margin="0,5,14,5"
                          VerticalAlignment="Center"
                          ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>

                <Border Width="1"
                        Height="20"
                        Margin="0,11,14,11"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,5,0,5">
                    <TextBlock Text="{Binding [FlashcardFlipSpeed], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Control.Toolbar}"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="FlipSpeedSlider"
                            Width="120"
                            TickPlacement="None"
                            TickFrequency="100"
                            SmallChange="100"
                            LargeChange="100"
                            IsSnapToTickEnabled="True"
                            Height="28"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               MinWidth="45">
                        <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value, StringFormat={}{0:0}}"/>
                        <Run Text="ms"/>
                    </TextBlock>
                </StackPanel>
            </controls:EditorCommandPanel>
        </Border>
        </motion:LayoutRevealHost>

        <Grid x:Name="FlashcardsContentHost"
              Grid.Row="3"
              Margin="24,10,24,10">
            <motion:LayoutRevealHost Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16">
                <controls:CollectionSelectionDock x:Name="BulkSelectionBar" ScrollTarget="{Binding ElementName=FlashcardsItemsControl}" Visibility="Collapsed"/>
            </motion:LayoutRevealHost>
            <Border x:Name="FlashcardsGridViewBorder"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="0">
                <Grid>
                    <controls:FlashcardGridItemsControl x:Name="FlashcardsItemsControl" behaviors:ItemReorderBehavior.Kind="Flashcards" controls:CollectionSelectionDock.Clearance="{Binding ScrollClearance, ElementName=BulkSelectionBar}"
                                  Padding="14,24,14,14"
                                  Margin="16"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <controls:FlashcardGridItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <wpftoolkit:VirtualizingWrapPanel IsItemsHost="True"
                                                                   ItemSize="332,248"/>
                            </ItemsPanelTemplate>
                        </controls:FlashcardGridItemsControl.ItemsPanel>
                        <controls:FlashcardGridItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:CollectionSelectionFrame FaceName="CardSurface" SelectionInset="0,10,10,0" ItemId="{Binding Id}" SelectionLabel="{Binding Question}" Margin="0,8,16,16"
                                    Selection="{Binding Path=(controls:EditorChromeContext.Controller).BulkSelection, RelativeSource={RelativeSource Self}}">
                                <controls:DashboardTileHost RendererKey="FlashcardGridCard" PreserveLiveInputInBitmapMode="True"
                                                            ClipToBounds="False">
                                    <controls:FlashcardFlipHost IsFlipped="{Binding IsFlipped, Mode=TwoWay}"
                                                                DeferHiddenFaceLayout="True"
                                                                Width="316"
                                                                Height="224"
                                                                MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp">
                                        <controls:FlashcardFlipHost.FrontContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardGridQuestionFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.FrontContent>
                                        <controls:FlashcardFlipHost.BackContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardGridAnswerFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.BackContent>
                                    </controls:FlashcardFlipHost>
                                </controls:DashboardTileHost>
                                </controls:CollectionSelectionFrame>
                            </DataTemplate>
                        </controls:FlashcardGridItemsControl.ItemTemplate>
                    </controls:FlashcardGridItemsControl>
                    <StackPanel x:Name="FlashcardsGridEmptyCreate"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <controls:EmptyStateIllustration IconKind="Flashcards" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <controls:IllustratedStateHeading Text="{Binding [FlashcardGridEmptyBeginCreating], Source={StaticResource Loc}}"
                                   Style="{StaticResource IllustratedStateTitleStyle}"
                                   Margin="0,0,0,20"/>
                        <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                                MinWidth="180"
                                Padding="18,10"
                                HorizontalAlignment="Center"
                                Content="{Binding [AddFlashcard], Source={StaticResource Loc}}"
                                Click="AddFlashcardButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="FlashcardsGridEmptyStateText"
                               Visibility="Collapsed"
                               FontSize="{StaticResource Type.EmptyState}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="StudyModeViewBorder"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="16,14">
                <ScrollViewer x:Name="StudyModeScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Background="Transparent"
                              Padding="4,12,4,0"
                              ClipToBounds="True"
                              behaviors:RoundedClipBehavior.IsEnabled="True"
                              behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Card}">
                    <StackPanel x:Name="StudyModeContentPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520"
                                Margin="0">

                        <StackPanel HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8">
                            <Border x:Name="StudyModeProgressTrack"
                                    MaxWidth="316"
                                    HorizontalAlignment="Stretch"
                                    Height="4"
                                    MinHeight="4"
                                    Background="{DynamicResource ProgressTrackBackground}"
                                    CornerRadius="2"
                                    ToolTipService.ShowDuration="5000"
                                    ToolTipService.InitialShowDelay="250">
                                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Data" x:Name="StudyModeProgressFill"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Width="0"
                                        Height="4"
                                        MinHeight="4"
                                        Background="{DynamicResource AccentSuccess}"
                                        CornerRadius="2"/>
                            </Border>
                            <Grid Margin="0,6,0,4">
                                <controls:SurfaceMaterialBorder x:Name="CramModeBanner" controls:SurfaceMaterial.Kind="Tinted"
                                        Visibility="Collapsed" HorizontalAlignment="Right" Height="20" Padding="6,0"
                                        Background="{DynamicResource AccentWarningSubtle}" CornerRadius="{StaticResource Radius.Control}"
                                        ToolTip="{Binding [FlashcardCramBanner], Source={StaticResource Loc}}">
                                    <TextBlock Text="{Binding [FlashcardPracticeLabel], Source={StaticResource Loc}}"
                                               FontSize="{StaticResource Type.Control.Helper}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentWarningSubtleForeground}"/>
                                </controls:SurfaceMaterialBorder>
                                <TextBlock x:Name="StudyModeProgressText"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           HorizontalAlignment="Center"/>
                                <!-- Same layout slot as progress text so revealing it does not grow the panel. -->
                                <TextBlock x:Name="StudyModeCompletionText"
                                           Visibility="Collapsed"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentSuccess}"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="StudyModeLiveStatsText"
                                       FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <!-- DownOnly: keep design size when roomy, scale down on short viewports. -->
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     MaxWidth="360"
                                     MaxHeight="280"
                                     HorizontalAlignment="Center"
                                     Margin="0,10,0,0">
                                <Border x:Name="StudyModeCard"
                                        Width="332"
                                        Height="248"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClipToBounds="False"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="StudyModeCard_MouseLeftButtonUp">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Border.RenderTransform>

                                    <Grid>
                                    <controls:FlashcardFlipHost x:Name="StudyModeFlipHost"
                                                                Width="316"
                                                                Height="224"
                                                                Margin="8">
                                        <controls:FlashcardFlipHost.FrontContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardStudyQuestionFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.FrontContent>
                                        <controls:FlashcardFlipHost.BackContent>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FlashcardStudyAnswerFaceTemplate}"/>
                                        </controls:FlashcardFlipHost.BackContent>
                                    </controls:FlashcardFlipHost>
                                        <controls:StudyResultEmblem x:Name="StudyCompletionEmblem" IsCompletion="True"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   ItemWidth="Auto"
