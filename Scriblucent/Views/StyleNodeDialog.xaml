<Window x:Class="Scriblucent.Views.StyleNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [MindMapStyleOrganizeTitle], Source={StaticResource Loc}}"
        Height="560"
        Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="StyleNodeColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="behaviors:CommandLightBehavior.Role" Value="Value"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="Transparent" HighlightEdge="{DynamicResource AccentPrimary}" x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleNodeClearButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Helper}"/>
        </Style>

        <Style x:Key="StyleNodeIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Compact" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource IconButtonHoverBackground}" PressedBackground="{DynamicResource IconButtonPressedBackground}" x:Name="IconButtonBorder" behaviors:StateSurfaceMotionBehavior.IsEnabled="True" behaviors:StateSurfaceMotionBehavior.IsSelected="{Binding (behaviors:StateSurfaceMotionBehavior.IsSelected), RelativeSource={RelativeSource TemplatedParent}}" behaviors:StateSurfaceMotionBehavior.SelectionThickness="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </controls:InteractionSurface>
                        <ControlTemplate.Triggers>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <controls:OverlayDialogShell
                                 MaxCardWidth="480"
                                 CardPadding="24">
        <controls:OverlayDialogShell.Header>
            <TextBlock Text="{Binding [MindMapStyleOrganizeTitle], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.DialogTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,20"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeBackgroundColor], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Form}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BackgroundColorButton"
                                        Style="{StaticResource StyleNodeColorSwatchButtonStyle}"
                                        Click="BackgroundColorButton_Click"
                                        ToolTip="{Binding [SelectColor], Source={StaticResource Loc}}"/>
                                <Button Content="{icons:Icon Kind=Close, Size=12}"
                                        Style="{StaticResource StyleNodeClearButtonStyle}"
                                        Click="ClearBackgroundColorButton_Click"
                                        ToolTip="{Binding [ClearColor], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeBorderColor], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Form}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BorderColorButton"
                                        Style="{StaticResource StyleNodeColorSwatchButtonStyle}"
                                        Click="BorderColorButton_Click"
                                        ToolTip="{Binding [SelectColor], Source={StaticResource Loc}}"/>
                                <Button Content="{icons:Icon Kind=Close, Size=12}"
                                        Style="{StaticResource StyleNodeClearButtonStyle}"
                                        Click="ClearBorderColorButton_Click"
                                        ToolTip="{Binding [ClearColor], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeBorderThickness], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Form}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="BorderThicknessSlider"
                                        Width="120"
                                        Minimum="0" Maximum="5"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <TextBlock x:Name="BorderThicknessText"
                                           Text="1"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource Type.Control.Helper}"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           MinWidth="20"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeShape], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Form}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <ComboBox behaviors:DropdownChoiceWidthBehavior.IsEnabled="True" x:Name="ShapeComboBox" Style="{StaticResource ChromeComboBoxStyle}"
                                      Grid.Column="1"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="ShapeComboBox_SelectionChanged">
                                <ComboBoxItem Content="{Binding [ShapeRounded], Source={StaticResource Loc}}" Tag="Rounded"/>
                                <ComboBoxItem Content="{Binding [ShapeRectangle], Source={StaticResource Loc}}" Tag="Rectangle"/>
                                <ComboBoxItem Content="{Binding [ShapeCircle], Source={StaticResource Loc}}" Tag="Circle"/>
                                <ComboBoxItem Content="{Binding [ShapeEllipse], Source={StaticResource Loc}}" Tag="Ellipse"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeIcon], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Form}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <Button Grid.Column="1"
                                    Content="{icons:Icon Kind=Close, Size=12}"
                                    Style="{StaticResource StyleNodeClearButtonStyle}"
                                    Margin="0"
                                    Click="ClearIconButton_Click"
                                    ToolTip="{Binding [ClearIcon], Source={StaticResource Loc}}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [NodeIconBadgeColor], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Type.Control.Helper}"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="IconBadgeColorButton"
                                        Style="{StaticResource StyleNodeColorSwatchButtonStyle}"
                                        Click="IconBadgeColorButton_Click"
                                        ToolTip="{Binding [SelectColor], Source={StaticResource Loc}}"/>
                                <Button Content="{icons:Icon Kind=Close, Size=12}"
                                        Style="{StaticResource StyleNodeClearButtonStyle}"
                                        Click="ClearIconBadgeColorButton_Click"
                                        ToolTip="{Binding [ClearColor], Source={StaticResource Loc}}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource ContentInsetBorderStyle}" Margin="0,0,0,4"
                                Padding="12">
                            <WrapPanel x:Name="IconGrid" Orientation="Horizontal"/>
                        </Border>
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{Binding [NodeNote], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Control.Form}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="{StaticResource Field.LabelMargin}"/>
                    <TextBox x:Name="NoteTextBox" Style="{StaticResource InsetFieldTextBoxStyle}"
                             Height="80"
                             MaxHeight="80"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextChanged="NoteTextBox_TextChanged"/>

                    <TextBlock Text="{Binding [MindMapNodeLink], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Control.Form}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="{StaticResource Field.SectionLabelMargin}"/>
                    <ComboBox x:Name="LinkedNoteComboBox"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource ChromeComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="LinkedNoteComboBox_SelectionChanged" ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CancelButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Margin="12,0,0,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
