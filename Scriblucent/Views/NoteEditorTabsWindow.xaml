<Window x:Class="Scriblucent.NoteEditorTabsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="Note Editor"
        Height="720"
        Width="1050"
        WindowStartupLocation="CenterOwner"
        Icon="/logo.ico"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}">
    <Window.Resources>
        <Style x:Key="EditorTabTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.UI}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="160"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorTabIconStyle" TargetType="icons:AppIcon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorTabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Chip}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                behaviors:RoundedClipBehavior.CornerRadius="16">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource IconButtonBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter Property="Panel.ZIndex" Value="10"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource CardBackground}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Align with editor chrome (FeatureTitleRowPadding / editor Margins = 20). -->
                            <Border Grid.Row="0"
                                    Margin="20,14,20,0"
                                    Padding="6"
                                    Background="{DynamicResource SelectionBackground}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    ClipToBounds="False"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              ClipToBounds="False"
                                              behaviors:ScrollBarAutoHideBehavior.Enable="False">
                                    <!-- StackPanel keeps pill gaps/corners intact; TabPanel was covering right radii. -->
                                    <StackPanel x:Name="HeaderPanel"
                                                IsItemsHost="True"
                                                Orientation="Horizontal"
                                                Background="Transparent"
                                                ClipToBounds="False"
                                                KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Background="Transparent"
                                    CornerRadius="0,10,10,10"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- Required by TabControl; unused — editors live on EditorHost. -->
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Visibility="Collapsed"/>
                                    <ContentControl x:Name="EditorHost"
                                                    Focusable="False"
                                                    IsTabStop="False"
                                                    KeyboardNavigation.TabIndex="2"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid>
        <TabControl x:Name="EditorTabs"
                    Style="{StaticResource EditorTabControlStyle}"
                    ItemContainerStyle="{StaticResource EditorTabItemStyle}"/>

    </Grid>
        </controls:FeatureWindowShell.Body>
    </controls:FeatureWindowShell>
</Window>
