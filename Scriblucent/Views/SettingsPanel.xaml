<UserControl x:Class="Scriblucent.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="960">
    <UserControl.Resources>
        <!-- Prefer app Chrome ComboBox/TextBox; keep only denser field sizing for settings forms. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ChromeComboBoxStyle}">
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- White lift on SidebarBackground section plates (DialogSecondary WindowBackground is too close). -->
        <Style x:Key="SettingsChromeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        </Style>

        <!-- Same slim chrome as the secondary settings buttons, in the accent color so it
             stays visible on the white language list. -->
        <Style x:Key="SettingsAccentInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiToolsListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiToolsModelRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiToolsModelStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FormHelperTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Text" Value="{Binding [AiToolsNotDownloaded], Source={StaticResource Loc}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                    <Setter Property="Text" Value="{Binding [AiToolsDownloaded], Source={StaticResource Loc}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentSuccessSubtleForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="ScrimHost"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="{DynamicResource OverlayScrim}"
                           MouseDown="OverlayDim_MouseDown"/>
        </Grid>
        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Grid Width="Auto"
                  MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}"
                  MaxWidth="560"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <controls:BakedElevationLayer Kind="Dialog"/>
                <Border x:Name="PanelCard"
                        Background="{DynamicResource CardBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Overlay}"
                        Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding [Settings], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.PageTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource OverlayCloseIconButtonStyle}"
                            Content="{icons:Icon Close}"
                            Click="CloseButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              behaviors:RoundedClipBehavior.IsEnabled="True"
                              behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Appearance -->
                <TextBlock Grid.Row="0"
                           Text="{Binding [SettingsCategoryAppearance], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"
                           Margin="2,0,0,8"/>

                <Border Grid.Row="1"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding [SettingsLanguageAndTheme], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [Language], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox Margin="0,8,0,0"
                                          MinWidth="180"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Tag="en" Content="{Binding [LanguageEnglish], Source={StaticResource Loc}}"/>
                                    <ComboBoxItem Tag="lt" Content="{Binding [LanguageLithuanian], Source={StaticResource Loc}}"/>
                                </ComboBox>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Margin="10,0"
                                    Background="{DynamicResource BorderColor}"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [Theme], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox Margin="0,8,0,0"
                                          MinWidth="180"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Tag="System" Content="{Binding [ThemeSystem], Source={StaticResource Loc}}"/>
                                    <ComboBoxItem Tag="Light" Content="{Binding [ThemeLight], Source={StaticResource Loc}}"/>
                                    <ComboBoxItem Tag="Dark" Content="{Binding [ThemeDark], Source={StaticResource Loc}}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [MeasurementUnitSystem], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <ComboBox x:Name="MeasurementUnitSystemBox"
                                  Margin="0,0,0,0"
                                  SelectionChanged="MeasurementUnitSystemBox_SelectionChanged">
                            <ComboBoxItem Tag="Imperial" Content="{Binding [MeasurementUnitImperial], Source={StaticResource Loc}}"/>
                            <ComboBoxItem Tag="Metric" Content="{Binding [MeasurementUnitMetric], Source={StaticResource Loc}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Animations], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <CheckBox x:Name="ReduceAnimationsCheckBox"
                                  Content="{Binding [ReduceAnimations], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="ReduceAnimationsCheckBox_Changed"
                                  Unchecked="ReduceAnimationsCheckBox_Changed"/>
                        <TextBlock Text="{Binding [ReduceAnimationsDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Scrollbar], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <CheckBox x:Name="EnableScrollbarCheckBox"
                                  Content="{Binding [EnableScrollbar], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  IsChecked="{Binding EnableScrollbar, Mode=TwoWay}"/>
                        <StackPanel Margin="24,10,0,0"
                                    IsEnabled="{Binding IsChecked, ElementName=EnableScrollbarCheckBox}"
                                    Visibility="{Binding IsChecked, ElementName=EnableScrollbarCheckBox, Converter={StaticResource BoolToVis}}">
                            <CheckBox x:Name="EnableVerticalScrollbarCheckBox"
                                      Content="{Binding [EnableVerticalScrollbar], Source={StaticResource Loc}}"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding EnableVerticalScrollbar, Mode=TwoWay}"/>
                            <CheckBox x:Name="EnableHorizontalScrollbarCheckBox"
                                      Margin="0,8,0,0"
                                      Content="{Binding [EnableHorizontalScrollbar], Source={StaticResource Loc}}"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding EnableHorizontalScrollbar, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="5"
                           Text="{Binding [SettingsCategoryNoteEditor], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="6"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [DefaultNoteTemplate], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <TextBlock Text="{Binding [DefaultNoteTemplateDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [FontLabel], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox x:Name="DefaultNoteFontFamilyBox"
                                          Margin="0,8,0,0"
                                          MinWidth="180"
                                          SelectionChanged="DefaultNoteTemplate_SelectionChanged"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="1"
                                    Margin="10,0"
                                    Background="{DynamicResource BorderColor}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [SizeLabel], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox x:Name="DefaultNoteFontSizeBox"
                                          Margin="0,8,0,0"
                                          MinWidth="120"
                                          SelectionChanged="DefaultNoteTemplate_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SpacingLabel], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox x:Name="DefaultNoteLineSpacingBox"
                                          Margin="0,8,0,0"
                                          MinWidth="120"
                                          SelectionChanged="DefaultNoteTemplate_SelectionChanged"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="1"
                                    Margin="10,0"
                                    Background="{DynamicResource BorderColor}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [IndentLabel], Source={StaticResource Loc}}"
                                           Style="{StaticResource FormOptionLabelStyle}"/>
                                <ComboBox x:Name="DefaultNoteIndentBox"
                                          Margin="0,8,0,0"
                                          MinWidth="120"
                                          SelectionChanged="DefaultNoteTemplate_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="DefaultNoteWordWrapCheckBox"
                                  Margin="0,14,0,0"
                                  Content="{Binding [WordWrap], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="DefaultNoteWordWrapCheckBox_Changed"
                                  Unchecked="DefaultNoteWordWrapCheckBox_Changed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="7"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Paste], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <TextBlock Text="{Binding [PasteChoiceDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        <ComboBox x:Name="DefaultPasteModeBox"
                                  Margin="0,8,0,0"
                                  MinWidth="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="DefaultPasteModeBox_SelectionChanged">
                            <ComboBoxItem Tag="KeepFormatting" Content="{Binding [PasteKeepFormatting], Source={StaticResource Loc}}"/>
                            <ComboBoxItem Tag="TextOnly" Content="{Binding [PasteAsText], Source={StaticResource Loc}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Workspace -->
                <TextBlock Grid.Row="11"
                           Text="{Binding [SettingsCategoryWorkspace], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="12"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding [RecentItemsLimit], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border x:Name="RecentItemsLimitFieldBorder"
                                    Style="{StaticResource ChromeFieldBorderStyle}"
                                    Padding="6,0"
                                    MinHeight="30"
                                    Margin="0,0,8,0">
                                <TextBox x:Name="RecentItemsLimitTextBox"
                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                         Width="48"
                                         TextAlignment="Right"
                                         TextChanged="RecentItemsLimitTextBox_TextChanged"
                                         LostFocus="RecentItemsLimitTextBox_LostFocus"
                                         PreviewKeyDown="RecentItemsLimitTextBox_PreviewKeyDown"/>
                            </Border>
                            <TextBlock Text="{Binding [RecentItemsLimitUnit], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FormHelperTextStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="RecentItemsLimitWarningText"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentDangerHover}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border x:Name="AutoSaveSettingsCard"
                        Grid.Row="13"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [AutoSave], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <CheckBox x:Name="EnableAutoSaveCheckBox"
                                  Content="{Binding [EnableAutoSave], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="EnableAutoSaveCheckBox_Checked"
                                  Unchecked="EnableAutoSaveCheckBox_Unchecked"/>

                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding IsChecked, ElementName=EnableAutoSaveCheckBox, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding [AutoSaveFrequency], Source={StaticResource Loc}}"
                                       Style="{StaticResource FormOptionLabelStyle}"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Border Style="{StaticResource ChromeFieldBorderStyle}"
                                        Padding="6,0"
                                        MinHeight="30"
                                        Margin="0,0,8,0">
                                    <TextBox x:Name="AutoSaveIntervalTextBox"
                                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                             Width="48"
                                             TextAlignment="Right"
                                             TextChanged="AutoSaveIntervalTextBox_TextChanged"
                                             LostFocus="AutoSaveIntervalTextBox_LostFocus"
                                             PreviewKeyDown="AutoSaveIntervalTextBox_PreviewKeyDown"/>
                                </Border>
                                <ComboBox x:Name="AutoSaveIntervalUnitBox"
                                          Width="92"
                                          SelectionChanged="AutoSaveIntervalUnitBox_SelectionChanged">
                                    <ComboBoxItem Tag="Seconds" Content="{Binding [AutoSaveUnitSeconds], Source={StaticResource Loc}}"/>
                                    <ComboBoxItem Tag="Minutes" Content="{Binding [AutoSaveUnitMinutes], Source={StaticResource Loc}}"/>
                                    <ComboBoxItem Tag="Hours" Content="{Binding [AutoSaveUnitHours], Source={StaticResource Loc}}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SpellCheckSettingsCard"
                        Grid.Row="14"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [SpellCheck], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <CheckBox x:Name="EnableSpellCheckCheckBox"
                                  Content="{Binding [EnableSpellCheck], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="EnableSpellCheckCheckBox_Changed"
                                  Unchecked="EnableSpellCheckCheckBox_Changed"/>
                        <TextBlock Text="{Binding [SpellCheckDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsChecked, ElementName=EnableSpellCheckCheckBox, Converter={StaticResource BoolToVis}}">
                            <Border Height="1"
                                    Background="{DynamicResource BorderColor}"
                                    Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding [SpellCheckLanguages], Source={StaticResource Loc}}"
                                       Style="{StaticResource FormOptionLabelStyle}"/>
                            <TextBlock Text="{Binding [SpellCheckLanguagesDescription], Source={StaticResource Loc}}"
                                       Style="{StaticResource FormHelperTextStyle}"
                                       Margin="0,0,0,10"/>

                            <Border Style="{StaticResource ChromePanelBorderStyle}"
                                    Padding="6"
                                    Grid.IsSharedSizeScope="True">
                                <ListBox x:Name="SpellCheckLanguagesListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         MaxHeight="260"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource AiToolsListBoxItemStyle}"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpellCheckLanguageAction"/>
                                                    </Grid.ColumnDefinitions>

                                                    <RadioButton Grid.Column="0"
                                                                 Style="{StaticResource SortOptionRadioButtonStyle}"
                                                                 GroupName="SpellCheckLanguageGroup"
                                                                 Content="{Binding DisplayName}"
                                                                 IsChecked="{Binding IsEnabled}"
                                                                 IsEnabled="{Binding IsDownloaded}"
                                                                 Tag="{Binding Key}"
                                                                 Margin="2,4"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextColor}"
                                                                 Checked="SpellCheckLanguageRadioButton_Checked"/>

                                                    <Button Grid.Column="1"
                                                            Content="{Binding [SpellCheckLanguageDownload], Source={StaticResource Loc}}"
                                                            Tag="{Binding Key}"
                                                            Style="{StaticResource SettingsAccentInlineButtonStyle}"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Click="DownloadSpellCheckLanguage_Click"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVis}}"/>

                                                    <Button Grid.Column="1"
                                                            Content="{Binding [Delete], Source={StaticResource Loc}}"
                                                            Tag="{Binding Key}"
                                                            Style="{StaticResource DialogDangerButtonStyle}"
                                                            Padding="10,4"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Click="DeleteSpellCheckLanguage_Click"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SpellCheckCheckForUpdatesButton"
                                        Content="{Binding [SpellCheckCheckForUpdates], Source={StaticResource Loc}}"
                                        Style="{StaticResource SettingsChromeSecondaryButtonStyle}"
                                        Padding="12,6"
                                        Click="CheckSpellCheckLanguageUpdates_Click"/>
                                <Button Content="{Binding [SpellCheckOpenFolder], Source={StaticResource Loc}}"
                                        Style="{StaticResource SettingsChromeSecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="8,0,0,0"
                                        Click="OpenSpellCheckDictionariesFolder_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="SpellCheckLanguageStatusText"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource FormHelperTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI Tools -->
                <TextBlock Grid.Row="9"
                           Text="{Binding [SettingsCategoryAiTools], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="10"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <CheckBox x:Name="EnableAiFeaturesCheckBox"
                                  Content="{Binding [EnableAiFeatures], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="EnableAiFeaturesCheckBox_Changed"
                                  Unchecked="EnableAiFeaturesCheckBox_Changed"/>
                        <TextBlock Text="{Binding [EnableAiFeaturesDescription], Source={StaticResource Loc}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        <Button x:Name="RemoveDownloadedAiModelsButton"
                                Content="{Binding [AiToolsRemoveDownloadedModels], Source={StaticResource Loc}}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Padding="10,5"
                                Style="{StaticResource DialogDangerButtonStyle}"
                                Visibility="Collapsed"
                                Click="RemoveDownloadedAiModelsButton_Click"/>
                        <StackPanel x:Name="AiToolsDetailPanel">
                        <controls:AiReviewNotice Margin="0,12,0,12"/>
                        <TextBlock Text="{Binding [AiToolsDefaultModel], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}">
                            <TextBlock.ContextMenu>
                                <ContextMenu x:Name="FlashcardModelContextMenu">
                                    <MenuItem Tag="Qwen3.5-0.8B" Click="FlashcardModelMenuItem_Click"/>
                                    <MenuItem Tag="Qwen3.5-2B" Click="FlashcardModelMenuItem_Click"/>
                                    <MenuItem Tag="Qwen3.5-4B" Click="FlashcardModelMenuItem_Click"/>
                                    <MenuItem Tag="Qwen3.5-9B" Click="FlashcardModelMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>

                        <ComboBox x:Name="FlashcardModelBox"
                                  Margin="0,6,8,8"
                                  SelectedValuePath="Key"
                                  SelectionChanged="FlashcardModelBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0"
                                                Padding="6,1,6,1"
                                                CornerRadius="8"
                                                Background="{DynamicResource AccentPrimary}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowBetaBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding [AiModelBetaBadge], Source={StaticResource Loc}}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryForeground}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Margin="8,0,0,0"
                                                Padding="6,1,6,1"
                                                CornerRadius="8"
                                                Background="{DynamicResource AccentPrimary}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowClozeOnlyBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding [AiModelClozeOnlyBadge], Source={StaticResource Loc}}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentPrimaryForeground}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="FlashcardModelWarningText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentWarningHover}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <CheckBox x:Name="UseGpuAccelerationCheckBox"
                                  Content="{Binding [UseGpuAcceleration], Source={StaticResource Loc}}"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Left"
                                  Checked="UseGpuAccelerationCheckBox_Changed"
                                  Unchecked="UseGpuAccelerationCheckBox_Changed"/>
                        <TextBlock Text="{Binding [UseGpuAccelerationDescription], Source={StaticResource Loc}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>

                        <TextBlock Text="{Binding [StudyCoverage], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormOptionLabelStyle}"/>
                        <ComboBox x:Name="StudyCoverageBox"
                                  Margin="0,6,8,0"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="StudyCoverageBox_SelectionChanged">
                            <ComboBoxItem Content="{Binding [StudyCoverageAuto], Source={StaticResource Loc}}" Tag="Auto"/>
                            <ComboBoxItem Content="{Binding [StudyCoverageBalanced], Source={StaticResource Loc}}" Tag="Balanced"/>
                            <ComboBoxItem Content="{Binding [StudyCoverageThorough], Source={StaticResource Loc}}" Tag="Thorough"/>
                        </ComboBox>
                        <Button Content="{Binding [StudyCoverageClearPlans], Source={StaticResource Loc}}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Padding="10,5"
                                Style="{StaticResource SettingsChromeSecondaryButtonStyle}"
                                Click="ClearStudyPlanCache_Click"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderColor}"
                                Margin="0,12,0,12"/>

                        <TextBlock Text="{Binding [AiToolsAvailableModels], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource ChromePanelBorderStyle}"
                                    Padding="6">
                                <ListBox x:Name="AiToolsListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Grid.IsSharedSizeScope="True"
                                         ItemContainerStyle="{StaticResource AiToolsListBoxItemStyle}"
                                         SelectionChanged="AiToolsListBox_SelectionChanged"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AiToolsModelRowBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="AiToolStatus" MinWidth="96"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="AiToolEnabled"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource FormBodyTextStyle}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Margin="0,0,12,0"/>

                                                    <TextBlock Grid.Column="1"
                                                               Margin="0,0,12,0"
                                                               Style="{StaticResource AiToolsModelStatusTextStyle}"/>

                                                    <CheckBox Grid.Column="2"
                                                              Content="{Binding [AiToolsEnabled], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding IsEnabled}"
                                                              IsEnabled="{Binding IsSupported}"
                                                              Tag="{Binding Key}"
                                                              Checked="AiToolEnabledCheckBox_Changed"
                                                              Unchecked="AiToolEnabledCheckBox_Changed"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Content="{icons:Icon Kind=ChevronUp, Size=12}"
                                        Width="32"
                                        Height="32"
                                        Click="MoveAiToolUp_Click"
                                        Style="{StaticResource SettingsChromeSecondaryButtonStyle}"/>
                                <Button Content="{icons:Icon Kind=ChevronDown, Size=12}"
                                        Width="32"
                                        Height="32"
                                        Margin="0,6,0,0"
                                        Click="MoveAiToolDown_Click"
                                        Style="{StaticResource SettingsChromeSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <Button Content="{Binding [AiToolsDownloadSelected], Source={StaticResource Loc}}"
                                    x:Name="DownloadSelectedAiToolButton"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Padding="12,6"
                                    Click="DownloadSelectedAiTool_Click"/>
                            <Button Content="{Binding [AiToolsDeleteSelected], Source={StaticResource Loc}}"
                                    x:Name="DeleteSelectedAiToolButton"
                                    Style="{StaticResource DialogDangerButtonStyle}"
                                    Padding="12,6"
                                    Margin="8,0,0,0"
                                    Click="DeleteSelectedAiTool_Click"/>
                            <Button Content="{Binding [AiToolsOpenFolder], Source={StaticResource Loc}}"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SettingsChromeSecondaryButtonStyle}"
                                    Padding="12,6"
                                    Click="OpenAiToolsFolder_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="AiToolsStatusText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Flashcards -->
                <TextBlock Grid.Row="15"
                           Text="{Binding [SettingsCategoryFlashcards], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="16"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [FlashcardSchedulingAlgorithm], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <TextBlock Text="{Binding [FlashcardSchedulingAlgorithmTooltip], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormHelperTextStyle}"
                                   Margin="0,0,0,10"/>
                        <ComboBox x:Name="FlashcardSchedulingAlgorithmBox"
                                  MinWidth="180"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="FlashcardSchedulingAlgorithmBox_SelectionChanged">
                            <ComboBoxItem Content="SM-2" Tag="Sm2"/>
                            <ComboBoxItem Content="FSRS-6" Tag="Fsrs6"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="17"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [FlashcardAudioVolume], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <TextBlock Text="{Binding [FlashcardAudioVolumeDescription], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormHelperTextStyle}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="FlashcardAudioVolumeSlider"
                                    Width="220"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="FlashcardAudioVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="FlashcardAudioVolumeValueText"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       MinWidth="36"
                                       FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Activity -->
                <TextBlock Grid.Row="18"
                           Text="{Binding [SettingsCategoryActivity], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="19"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserActivitySummaryTitle}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding StatsTotalNotes}"
                                           Style="{StaticResource FormBodyTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding StatsWordsTyped}"
                                           Style="{StaticResource FormBodyTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding StatsCharactersTyped}"
                                           Style="{StaticResource FormBodyTextStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatsTimeSpent}"
                                           Style="{StaticResource FormBodyTextStyle}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding StatsLastActive}"
                                           Style="{StaticResource FormBodyTextStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="{Binding [ResetActivitySummary], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogWarningButtonStyle}"
                                Padding="14,8"
                                MinWidth="140"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="ResetActivitySummary_Click"/>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <TextBlock Grid.Row="20"
                           Text="{Binding [SettingsCategoryData], Source={StaticResource Loc}}"
                           Style="{StaticResource FormCategoryTitleStyle}"/>

                <Border Grid.Row="21"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [ResetFactorySettings], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <TextBlock Text="{Binding [ResetFactorySettingsDescription], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormHelperTextStyle}"
                                   Margin="0,0,0,12"/>
                        <Button Content="{Binding [ResetFactorySettings], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogDangerButtonStyle}"
                                Padding="14,8"
                                MinWidth="140"
                                HorizontalAlignment="Left"
                                Click="ResetFactorySettings_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="22"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [Diagnostics], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormSectionTitleStyle}"/>
                        <CheckBox x:Name="EnableDiagnosticLoggingCheckBox"
                                  Content="{Binding [EnableDiagnosticLogging], Source={StaticResource Loc}}"
                                  HorizontalAlignment="Left"
                                  Checked="EnableDiagnosticLoggingCheckBox_Changed"
                                  Unchecked="EnableDiagnosticLoggingCheckBox_Changed"/>
                        <TextBlock Text="{Binding [EnableDiagnosticLoggingDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        <StackPanel x:Name="AiContentDiagnosticsPanel">
                        <CheckBox x:Name="EnableAiContentDiagnosticsCheckBox"
                                  Content="{Binding [EnableAiContentDiagnostics], Source={StaticResource Loc}}"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Left"
                                  Checked="EnableAiContentDiagnosticsCheckBox_Changed"
                                  Unchecked="EnableAiContentDiagnosticsCheckBox_Changed"/>
                        <TextBlock Text="{Binding [EnableAiContentDiagnosticsDescription], Source={StaticResource Loc}}"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource FormHelperTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="23" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="{Binding [CheckForUpdates], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="14,8"
                            MinWidth="190"
                            HorizontalAlignment="Left"
                            Click="CheckUpdates_Click"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Content="{Binding [Close], Source={StaticResource Loc}}"
                            Margin="10,0,0,0"
                            MinWidth="100"
                            Padding="14,8"
                            Click="CloseButton_Click"/>
                </Grid>
                </Grid>
            </ScrollViewer>
            </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
