<UserControl x:Class="Scriblucent.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
             xmlns:icons="clr-namespace:Scriblucent.Icons"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="960">
    <UserControl.Resources>
        <Style x:Key="SettingsCloseIconButtonStyle" TargetType="Button">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="CloseButtonBorder"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="CloseButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                <Setter TargetName="CloseButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style with Theme Support -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{DynamicResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="ContentPresenter"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="150">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style with Theme Support -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <icons:AppIcon Grid.Column="1"
                                   Kind="ChevronDown"
                                   Width="10"
                                   Height="10"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,2,5,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"
                           MouseDown="OverlayDim_MouseDown"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="PanelCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Width="Auto"
                    MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}"
                    MaxWidth="560">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="24" ShadowDepth="0"/>
                </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding [Settings], Source={StaticResource Loc}}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SettingsCloseIconButtonStyle}"
                            Content="{icons:Icon Close}"
                            Click="CloseButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [Language], Source={StaticResource Loc}}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <ComboBox Margin="0,8,0,0"
                                      MinWidth="180"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="en" Content="{Binding [LanguageEnglish], Source={StaticResource Loc}}"/>
                                <ComboBoxItem Tag="lt" Content="{Binding [LanguageLithuanian], Source={StaticResource Loc}}"/>
                            </ComboBox>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="10,0"
                                Background="{DynamicResource BorderColor}"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [Theme], Source={StaticResource Loc}}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <ComboBox Margin="0,8,0,0"
                                      MinWidth="180"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="System" Content="{Binding [ThemeSystem], Source={StaticResource Loc}}"/>
                                <ComboBoxItem Tag="Light" Content="{Binding [ThemeLight], Source={StaticResource Loc}}"/>
                                <ComboBoxItem Tag="Dark" Content="{Binding [ThemeDark], Source={StaticResource Loc}}"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [AiToolsSectionTitle], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}">
                            <TextBlock.ContextMenu>
                                <ContextMenu x:Name="FlashcardModelContextMenu">
                                    <MenuItem Tag="Qwen3.5-0.8B" Click="FlashcardModelMenuItem_Click"/>
                                    <MenuItem Tag="Qwen3.5-2B" Click="FlashcardModelMenuItem_Click"/>
                                    <MenuItem Tag="Qwen3.5-4B" Click="FlashcardModelMenuItem_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>

                        <TextBlock Text="{Binding [AiToolsDefaultModel], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <ComboBox x:Name="FlashcardModelBox"
                                  Margin="0,6,0,0"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="FlashcardModelBox_SelectionChanged">
                        </ComboBox>

                        <TextBlock x:Name="FlashcardModelWarningText"
                                   Margin="0,8,0,0"
                                   Foreground="#D97706"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderColor}"
                                Margin="0,12,0,12"/>

                        <TextBlock Text="{Binding [AiToolsAvailableModels], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Background="{DynamicResource CardBackground}">
                                <ListBox x:Name="AiToolsListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="AiToolsListBox_SelectionChanged"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextColor}"/>

                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,8,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding [AiToolsNotDownloaded], Source={StaticResource Loc}}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding [AiToolsDownloaded], Source={StaticResource Loc}}"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <CheckBox Grid.Column="2"
                                                          Content="{Binding [AiToolsEnabled], Source={StaticResource Loc}}"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Tag="{Binding Key}"
                                                          Checked="AiToolEnabledCheckBox_Changed"
                                                          Unchecked="AiToolEnabledCheckBox_Changed"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="{icons:Icon Kind=ChevronUp, Size=12}"
                                        Width="32"
                                        Height="30"
                                        Click="MoveAiToolUp_Click"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"/>
                                <Button Content="{icons:Icon Kind=ChevronDown, Size=12}"
                                        Width="32"
                                        Height="30"
                                        Margin="0,6,0,0"
                                        Click="MoveAiToolDown_Click"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <Button Content="{Binding [AiToolsDownloadSelected], Source={StaticResource Loc}}"
                                    x:Name="DownloadSelectedAiToolButton"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Padding="12,6"
                                    Click="DownloadSelectedAiTool_Click"/>
                            <Button Content="{Binding [AiToolsDeleteSelected], Source={StaticResource Loc}}"
                                    x:Name="DeleteSelectedAiToolButton"
                                    Style="{StaticResource DialogDangerButtonStyle}"
                                    Padding="12,6"
                                    Margin="8,0,0,0"
                                    Click="DeleteSelectedAiTool_Click"/>
                            <Button Content="{Binding [AiToolsOpenFolder], Source={StaticResource Loc}}"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Padding="12,6"
                                    Click="OpenAiToolsFolder_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="AiToolsStatusText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   TextWrapping="Wrap"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderColor}"
                                Margin="0,10,0,10"/>

                        <TextBlock Text="{Binding [AiToolsRuntimeTitle], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <WrapPanel Margin="0,8,-8,-8" HorizontalAlignment="Left">
                            <Button Content="{Binding [AiToolsRuntimeDownload], Source={StaticResource Loc}}"
                                    x:Name="RuntimeDownloadButton"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="DownloadRuntime_Click"/>
                            <Button Content="{Binding [AiToolsRuntimeCheckUpdates], Source={StaticResource Loc}}"
                                    x:Name="RuntimeUpdateButton"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="CheckRuntimeUpdates_Click"/>
                            <Button Content="{Binding [AiToolsRuntimeOpenFolder], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="OpenRuntimeFolder_Click"/>
                            <Button Content="{Binding [AiToolsRuntimeDelete], Source={StaticResource Loc}}"
                                    x:Name="RuntimeDeleteButton"
                                    Style="{StaticResource DialogDangerButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,8,8"
                                    Click="DeleteRuntime_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="RuntimeStatusText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
        Margin="0,14,0,0"
        Background="{DynamicResource SidebarBackground}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16,12">

                    <StackPanel>
                        <TextBlock Text="{Binding [MeasurementUnitSystem], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <ComboBox x:Name="MeasurementUnitSystemBox"
                                  Margin="0,8,0,0"
                                  SelectionChanged="MeasurementUnitSystemBox_SelectionChanged">
                            <ComboBoxItem Tag="Imperial" Content="{Binding [MeasurementUnitImperial], Source={StaticResource Loc}}"/>
                            <ComboBoxItem Tag="Metric" Content="{Binding [MeasurementUnitMetric], Source={StaticResource Loc}}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding [RecentItemsLimit], Source={StaticResource Loc}}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,0">
                                <TextBox x:Name="RecentItemsLimitTextBox"
                                         Width="48"
                                         Height="30"
                                         Padding="0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextAlignment="Right"
                                         TextChanged="RecentItemsLimitTextBox_TextChanged"
                                         LostFocus="RecentItemsLimitTextBox_LostFocus"
                                         PreviewKeyDown="RecentItemsLimitTextBox_PreviewKeyDown"/>
                            </Border>
                            <TextBlock Text="{Binding [RecentItemsLimitUnit], Source={StaticResource Loc}}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding [Animations], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>

                            <CheckBox x:Name="ReduceAnimationsCheckBox"
                                      Grid.Column="1"
                                      Content="{Binding [ReduceAnimations], Source={StaticResource Loc}}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Checked="ReduceAnimationsCheckBox_Changed"
                                      Unchecked="ReduceAnimationsCheckBox_Changed"/>
                        </Grid>

                        <TextBlock Text="{Binding [ReduceAnimationsDescription], Source={StaticResource Loc}}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Scrollbar and Auto-Save Settings -->
                <Border Grid.Row="5"
        Margin="0,14,0,0"
        Background="{DynamicResource SidebarBackground}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16,12">
                    <StackPanel>
                        <!-- Scrollbar Setting -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding [Scrollbar], Source={StaticResource Loc}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <CheckBox x:Name="EnableScrollbarCheckBox"
                                          Content="{Binding [EnableScrollbar], Source={StaticResource Loc}}"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding EnableScrollbar, Mode=TwoWay}"/>
                                <StackPanel Margin="24,10,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=EnableScrollbarCheckBox}"
                                            Visibility="{Binding IsChecked, ElementName=EnableScrollbarCheckBox, Converter={StaticResource BoolToVis}}">
                                    <CheckBox x:Name="EnableVerticalScrollbarCheckBox"
                                              Content="{Binding [EnableVerticalScrollbar], Source={StaticResource Loc}}"
                                              HorizontalAlignment="Left"
                                              IsChecked="{Binding EnableVerticalScrollbar, Mode=TwoWay}"/>
                                    <CheckBox x:Name="EnableHorizontalScrollbarCheckBox"
                                              Margin="0,8,0,0"
                                              Content="{Binding [EnableHorizontalScrollbar], Source={StaticResource Loc}}"
                                              HorizontalAlignment="Left"
                                              IsChecked="{Binding EnableHorizontalScrollbar, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                    <!-- Auto-Save Setting -->
                    <Border x:Name="AutoSaveSettingsCard"
                            Grid.Row="6"
                            Margin="0,14,0,0"
                            Background="{DynamicResource SidebarBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="16,12"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=EnableAutoSaveCheckBox}" Value="True">
                                        <Setter Property="Padding" Value="16,12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- Auto-Save Enable/Disable -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="{Binding [AutoSave], Source={StaticResource Loc}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                                <CheckBox Grid.Column="1"
                      x:Name="EnableAutoSaveCheckBox"
                      Content="{Binding [EnableAutoSave], Source={StaticResource Loc}}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Checked="EnableAutoSaveCheckBox_Checked"
                      Unchecked="EnableAutoSaveCheckBox_Unchecked"/>
                            </Grid>

                            <!-- Auto-Save Interval Control -->
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding IsChecked, ElementName=EnableAutoSaveCheckBox, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="{Binding [AutoSaveFrequency], Source={StaticResource Loc}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,0"
                                            Margin="0,0,8,0">
                                        <TextBox x:Name="AutoSaveIntervalTextBox"
                                                 Width="48"
                                                 Height="30"
                                                 Padding="0"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextAlignment="Right"
                                                 TextChanged="AutoSaveIntervalTextBox_TextChanged"
                                                 LostFocus="AutoSaveIntervalTextBox_LostFocus"
                                                 PreviewKeyDown="AutoSaveIntervalTextBox_PreviewKeyDown"/>
                                    </Border>
                                    <ComboBox x:Name="AutoSaveIntervalUnitBox"
                                              Width="92"
                                              SelectionChanged="AutoSaveIntervalUnitBox_SelectionChanged">
                                        <ComboBoxItem Tag="Seconds" Content="{Binding [AutoSaveUnitSeconds], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Tag="Minutes" Content="{Binding [AutoSaveUnitMinutes], Source={StaticResource Loc}}"/>
                                        <ComboBoxItem Tag="Hours" Content="{Binding [AutoSaveUnitHours], Source={StaticResource Loc}}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activity Summary Settings -->
                <Border Grid.Row="7"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserActivitySummaryTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding StatsTotalNotes}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StatsWordsTyped}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StatsCharactersTyped}" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatsTimeSpent}" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StatsLastActive}" Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Reset Factory Settings Section -->
                <Border Grid.Row="8"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [ResetFactorySettings], Source={StaticResource Loc}}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding [ResetFactorySettingsDescription], Source={StaticResource Loc}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="{Binding [ResetFactorySettings], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogDangerButtonStyle}"
                                Padding="14,8"
                                MinWidth="140"
                                HorizontalAlignment="Left"
                                Click="ResetFactorySettings_Click"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="9" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="{Binding [CheckForUpdates], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="14,8"
                            MinWidth="190"
                            HorizontalAlignment="Left"
                            Click="CheckUpdates_Click"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Content="{Binding [Close], Source={StaticResource Loc}}"
                            Margin="10,0,0,0"
                            MinWidth="100"
                            Padding="14,8"
                            Click="CloseButton_Click"/>
                </Grid>
                </Grid>
            </ScrollViewer>
            </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
