<UserControl xmlns:icons="clr-namespace:Scriblucent.Icons" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:Scriblucent.Behaviors" xmlns:controls="clr-namespace:Scriblucent.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:motion="clr-namespace:Scriblucent.Animations" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Scriblucent.Views.SettingsPanel" x:Name="SettingsRoot" mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="960">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ChromeComboBoxStyle}">
            <Setter Property="Height" Value="{StaticResource Control.Height.Form}" />
        </Style>
        <Style x:Key="SettingsChromeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Neutral"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}" />
        </Style>
        <Style x:Key="SettingsAccentInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="controls:InteractionSurface.Role" Value="Compact" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{StaticResource Control.Height.Inline}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Filled"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryForeground}" />
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Inline}" />
        </Style>
        <Style x:Key="AiToolsListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiToolsModelRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="behaviors:StateSurfaceMotionBehavior.IsEnabled" Value="True" />
            <Setter Property="behaviors:StateSurfaceMotionBehavior.IsSelected" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Setter Property="behaviors:StateSurfaceMotionBehavior.SelectionThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="behaviors:StateSurfaceMotionBehavior.ActiveState" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiToolsModelStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FormHelperTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Text" Value="{Binding [AiToolsNotDownloaded], Source={StaticResource Loc}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                    <Setter Property="Text" Value="{Binding [AiToolsDownloaded], Source={StaticResource Loc}}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentSuccessSubtleForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonBaseStyle}">
            <Setter Property="behaviors:CommandLightBehavior.Role" Value="Navigation"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="None"/>
            <Setter Property="Focusable" Value="True" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <Grid x:Name="ScrimHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Image x:Name="BackdropSnapshot" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
            <Rectangle x:Name="OverlayDim" Fill="{DynamicResource OverlayScrim}" MouseDown="OverlayDim_MouseDown" />
        </Grid>
        <Border x:Name="PanelMotionHost" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid Width="Auto" MaxHeight="{Binding ActualHeight, ElementName=OverlayRoot}" MaxWidth="740" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <controls:BakedElevationLayer Kind="Dialog" />
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" x:Name="PanelCard" Background="{DynamicResource CardBackground}" BorderThickness="0" CornerRadius="{StaticResource Radius.Overlay}" Padding="24">
                    <Grid behaviors:SettingsNavigationBehavior.IsEnabled="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" motion:ArrivalGroups.Role="Heading">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Settings], Source={StaticResource Loc}}" FontSize="{StaticResource Type.PageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" />
                            <Button Grid.Column="1" Style="{StaticResource OverlayCloseIconButtonStyle}" Content="{icons:Icon Close}" Click="CloseButton_Click" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="CategorySelectionPlate" Background="{DynamicResource SelectionBackground}" IsHitTestVisible="False" />
                            <WrapPanel x:Name="CategoryNavigation" behaviors:CommandLightBehavior.IsScope="True">
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryAppearance], Source={StaticResource Loc}}" Tag="SettingsSectionAppearance" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryNoteEditor], Source={StaticResource Loc}}" Tag="SettingsSectionNoteEditor" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryAiTools], Source={StaticResource Loc}}" Tag="SettingsSectionAiTools" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryWorkspace], Source={StaticResource Loc}}" Tag="SettingsSectionWorkspace" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryFlashcards], Source={StaticResource Loc}}" Tag="SettingsSectionFlashcards" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryActivity], Source={StaticResource Loc}}" Tag="SettingsSectionActivity" />
                                <Button Style="{StaticResource SettingsCategoryButtonStyle}" Content="{Binding [SettingsCategoryData], Source={StaticResource Loc}}" Tag="SettingsSectionData" />
                            </WrapPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" behaviors:RoundedClipBehavior.IsEnabled="True" behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}" x:Name="SettingsScrollViewer" behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <StackPanel>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionAppearance">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryAppearance], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,16" FontSize="{StaticResource Type.BlockTitle}" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <Grid behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding [Language], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox Margin="0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Tag="en" Content="{Binding [LanguageEnglish], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="lt" Content="{Binding [LanguageLithuanian], Source={StaticResource Loc}}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Margin="10,0" Background="{DynamicResource BorderColor}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding [Theme], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox Margin="0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Tag="System" Content="{Binding [ThemeSystem], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="Light" Content="{Binding [ThemeLight], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="Dark" Content="{Binding [ThemeDark], Source={StaticResource Loc}}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <Grid behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding [MeasurementUnitSystem], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox x:Name="MeasurementUnitSystemBox" Margin="0" SelectionChanged="MeasurementUnitSystemBox_SelectionChanged" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Tag="Imperial" Content="{Binding [MeasurementUnitImperial], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="Metric" Content="{Binding [MeasurementUnitMetric], Source={StaticResource Loc}}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Margin="10,0" Background="{DynamicResource BorderColor}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding [Animations], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" Margin="{StaticResource Field.LabelMargin}" />
                                                        <ComboBox x:Name="MotionPreferenceComboBox" HorizontalAlignment="Stretch" SelectionChanged="MotionPreferenceComboBox_SelectionChanged" Margin="0">
                                                            <ComboBoxItem Content="{Binding [MotionAutomatic], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Content="{Binding [MotionReduced], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Content="{Binding [MotionOff], Source={StaticResource Loc}}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding [MotionDescription], Source={StaticResource Loc}}" Margin="0,10,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="3" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Scrollbar], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <CheckBox x:Name="EnableScrollbarCheckBox" Content="{Binding [EnableScrollbar], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" IsChecked="{Binding EnableScrollbar, Mode=TwoWay}" Style="{StaticResource SettingsSwitchStyle}" />
                                                <StackPanel Margin="24,10,0,0" IsEnabled="{Binding IsChecked, ElementName=EnableScrollbarCheckBox}" Visibility="{Binding IsChecked, ElementName=EnableScrollbarCheckBox, Converter={StaticResource BoolToVis}}">
                                                    <CheckBox x:Name="EnableVerticalScrollbarCheckBox" Content="{Binding [EnableVerticalScrollbar], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" IsChecked="{Binding EnableVerticalScrollbar, Mode=TwoWay}" Style="{StaticResource SettingsSwitchStyle}" />
                                                    <CheckBox x:Name="EnableHorizontalScrollbarCheckBox" Margin="0,8,0,0" Content="{Binding [EnableHorizontalScrollbar], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" IsChecked="{Binding EnableHorizontalScrollbar, Mode=TwoWay}" Style="{StaticResource SettingsSwitchStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionNoteEditor">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryNoteEditor], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [DefaultNoteTemplate], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <TextBlock Text="{Binding [DefaultNoteTemplateDescription], Source={StaticResource Loc}}" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                <Grid Margin="0,12,0,0" behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding [FontLabel], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox x:Name="DefaultNoteFontFamilyBox" Margin="0" SelectionChanged="DefaultNoteTemplate_SelectionChanged" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Margin="10,0" Background="{DynamicResource BorderColor}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding [SizeLabel], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox x:Name="DefaultNoteFontSizeBox" Margin="0" SelectionChanged="DefaultNoteTemplate_SelectionChanged" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,12,0,0" behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding [SpacingLabel], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox x:Name="DefaultNoteLineSpacingBox" Margin="0" SelectionChanged="DefaultNoteTemplate_SelectionChanged" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Margin="10,0" Background="{DynamicResource BorderColor}" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding [IndentLabel], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" VerticalAlignment="Center" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                        <ComboBox x:Name="DefaultNoteIndentBox" Margin="0" SelectionChanged="DefaultNoteTemplate_SelectionChanged" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="DefaultNoteWordWrapCheckBox" Margin="0,14,0,0" Content="{Binding [WordWrap], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Checked="DefaultNoteWordWrapCheckBox_Changed" Unchecked="DefaultNoteWordWrapCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                <CheckBox x:Name="AutoFormatListsCheckBox" Margin="0,10,0,0" Content="{Binding [AutoFormatLists], Source={StaticResource Loc}}" ToolTip="{Binding [AutoFormatListsHint], Source={StaticResource Loc}}" Checked="AutoFormatListsCheckBox_Changed" Unchecked="AutoFormatListsCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Paste], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <TextBlock Text="{Binding [PasteChoiceDescription], Source={StaticResource Loc}}" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                <ComboBox x:Name="DefaultPasteModeBox" Margin="0,8,0,0" HorizontalAlignment="Stretch" SelectionChanged="DefaultPasteModeBox_SelectionChanged">
                                                    <ComboBoxItem Tag="KeepFormatting" Content="{Binding [PasteKeepFormatting], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="TextOnly" Content="{Binding [PasteAsText], Source={StaticResource Loc}}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionAiTools">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryAiTools], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableAiFeaturesCheckBox" Content="{Binding [EnableAiFeatures], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Checked="EnableAiFeaturesCheckBox_Changed" Unchecked="EnableAiFeaturesCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                <TextBlock Text="{Binding [EnableAiFeaturesDescription], Source={StaticResource Loc}}" Margin="0,5,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                <Button x:Name="RemoveDownloadedAiModelsButton" Content="{Binding [AiToolsRemoveDownloadedModels], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="10,5" Style="{StaticResource DialogDangerButtonStyle}" Visibility="Collapsed" Click="RemoveDownloadedAiModelsButton_Click" />
                                                <motion:LayoutRevealHost>
                                                    <StackPanel x:Name="AiToolsDetailPanel">
                                                        <controls:AiReviewNotice Margin="0,12,0,12" />
                                                        <TextBlock Text="{Binding [AiToolsDefaultModel], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" Margin="{StaticResource Field.LabelMargin}">
                                                            <TextBlock.ContextMenu>
                                                                <ContextMenu x:Name="FlashcardModelContextMenu">
                                                                    <MenuItem Tag="Qwen3.5-0.8B" Click="FlashcardModelMenuItem_Click" />
                                                                    <MenuItem Tag="Qwen3.5-2B" Click="FlashcardModelMenuItem_Click" />
                                                                    <MenuItem Tag="Qwen3.5-4B" Click="FlashcardModelMenuItem_Click" />
                                                                    <MenuItem Tag="Qwen3.5-9B" Click="FlashcardModelMenuItem_Click" />
                                                                </ContextMenu>
                                                            </TextBlock.ContextMenu>
                                                        </TextBlock>
                                                        <ComboBox x:Name="FlashcardModelBox" Margin="0,0,0,8" SelectedValuePath="Key" SelectionChanged="FlashcardModelBox_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        <controls:SurfaceMaterialBorder Grid.Column="1" controls:SurfaceMaterial.Kind="Marker" controls:SurfaceMaterial.Foreground="{DynamicResource AccentPrimaryForeground}" Margin="8,0,0,0" Padding="6,1,6,1" CornerRadius="8" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Center" Visibility="{Binding ShowBetaBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding [AiModelBetaBadge], Source={StaticResource Loc}}" FontSize="{StaticResource Type.Control.Badge}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryForeground}" VerticalAlignment="Center" />
                                                                        </controls:SurfaceMaterialBorder>
                                                                        <controls:SurfaceMaterialBorder Grid.Column="2" controls:SurfaceMaterial.Kind="Marker" controls:SurfaceMaterial.Foreground="{DynamicResource AccentPrimaryForeground}" Margin="8,0,0,0" Padding="6,1,6,1" CornerRadius="8" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Center" Visibility="{Binding ShowClozeOnlyBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding [AiModelClozeOnlyBadge], Source={StaticResource Loc}}" FontSize="{StaticResource Type.Control.Badge}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryForeground}" VerticalAlignment="Center" />
                                                                        </controls:SurfaceMaterialBorder>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <motion:LayoutRevealHost>
                                                            <TextBlock x:Name="FlashcardModelWarningText" Margin="0,8,0,0" Foreground="{DynamicResource AccentWarningHover}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                        </motion:LayoutRevealHost>
                                                        <CheckBox x:Name="UseGpuAccelerationCheckBox" Content="{Binding [UseGpuAcceleration], Source={StaticResource Loc}}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Checked="UseGpuAccelerationCheckBox_Changed" Unchecked="UseGpuAccelerationCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                        <TextBlock Text="{Binding [UseGpuAccelerationDescription], Source={StaticResource Loc}}" Margin="0,5,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                        <TextBlock Text="{Binding [StudyCoverage], Source={StaticResource Loc}}" Margin="{StaticResource Field.SectionLabelMargin}" Style="{StaticResource FormOptionLabelStyle}" />
                                                        <ComboBox x:Name="StudyCoverageBox" Margin="0" SelectedValuePath="Tag" SelectionChanged="StudyCoverageBox_SelectionChanged">
                                                            <ComboBoxItem Content="{Binding [StudyCoverageAuto], Source={StaticResource Loc}}" Tag="Auto" />
                                                            <ComboBoxItem Content="{Binding [StudyCoverageBalanced], Source={StaticResource Loc}}" Tag="Balanced" />
                                                            <ComboBoxItem Content="{Binding [StudyCoverageThorough], Source={StaticResource Loc}}" Tag="Thorough" />
                                                        </ComboBox>
                                                        <Button Content="{Binding [StudyCoverageClearPlans], Source={StaticResource Loc}}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5" Style="{StaticResource SettingsChromeSecondaryButtonStyle}" Click="ClearStudyPlanCache_Click" />
                                                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,12,0,12" />
                                                        <TextBlock Text="{Binding [AiToolsAvailableModels], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" />
                                                        <Grid Margin="0,8,0,0">
                                                            <Border Grid.Column="0" Style="{StaticResource ChromePanelBorderStyle}" Padding="6">
                                                                <ListBox x:Name="AiToolsListBox" behaviors:ItemReorderBehavior.Kind="AiTools" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource AiToolsListBoxItemStyle}" SelectionChanged="AiToolsListBox_SelectionChanged" SelectionMode="Single">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource AiToolsModelRowBorderStyle}">
                                                                                <DockPanel>
                                                                                    <controls:ItemReorderControls DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                                                    <Grid behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiToolStatus" MinWidth="96" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiToolEnabled" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource FormBodyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0" />
                                                                                        <TextBlock Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource AiToolsModelStatusTextStyle}" />
                                                                                        <CheckBox Style="{StaticResource SettingsSwitchStyle}" Grid.Column="2" Content="{Binding [AiToolsEnabled], Source={StaticResource Loc}}" IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding IsSupported}" Tag="{Binding Key}" Checked="AiToolEnabledCheckBox_Changed" Unchecked="AiToolEnabledCheckBox_Changed" VerticalAlignment="Center" />
                                                                                    </Grid>
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Grid>
                                                        <WrapPanel HorizontalAlignment="Left" Margin="0,8,0,0">
                                                            <Button Content="{Binding [AiToolsDownloadSelected], Source={StaticResource Loc}}" x:Name="DownloadSelectedAiToolButton" Style="{StaticResource DialogPrimaryButtonStyle}" Padding="12,6" Click="DownloadSelectedAiTool_Click" Margin="0,0,8,8" />
                                                            <Button Content="{Binding [AiToolsDeleteSelected], Source={StaticResource Loc}}" x:Name="DeleteSelectedAiToolButton" Style="{StaticResource DialogDangerButtonStyle}" Padding="12,6" Margin="0,0,8,8" Click="DeleteSelectedAiTool_Click" />
                                                            <Button Content="{Binding [AiToolsOpenFolder], Source={StaticResource Loc}}" Margin="0,0,8,8" Style="{StaticResource SettingsChromeSecondaryButtonStyle}" Padding="12,6" Click="OpenAiToolsFolder_Click" />
                                                        </WrapPanel>
                                                        <TextBlock x:Name="AiToolsStatusText" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                    </StackPanel>
                                                </motion:LayoutRevealHost>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionWorkspace">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryWorkspace], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [RecentItemsLimit], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" Margin="{StaticResource Field.LabelMargin}" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border x:Name="RecentItemsLimitFieldBorder" Style="{StaticResource ChromeFieldBorderStyle}" MinHeight="{StaticResource Control.Height.Form}" Margin="0,0,8,0" Width="72">
                                                        <TextBox x:Name="RecentItemsLimitTextBox" Style="{StaticResource EmbeddedFieldTextBoxStyle}" Width="48" TextAlignment="Right" TextChanged="RecentItemsLimitTextBox_TextChanged" LostFocus="RecentItemsLimitTextBox_LostFocus" PreviewKeyDown="RecentItemsLimitTextBox_PreviewKeyDown" />
                                                    </Border>
                                                    <TextBlock Text="{Binding [RecentItemsLimitUnit], Source={StaticResource Loc}}" VerticalAlignment="Center" Style="{StaticResource FormHelperTextStyle}" />
                                                </StackPanel>
                                                <motion:LayoutRevealHost>
                                                    <TextBlock x:Name="RecentItemsLimitWarningText" Margin="0,8,0,0" Foreground="{DynamicResource AccentDangerHover}" TextWrapping="Wrap" Visibility="Collapsed" />
                                                </motion:LayoutRevealHost>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [CalendarWeekStartsOn], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" Margin="{StaticResource Field.LabelMargin}" TextWrapping="Wrap" />
                                                <ComboBox x:Name="CalendarWeekStartBox" Margin="0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedCalendarWeekStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding [CalendarWeekStartsOn], Source={StaticResource Loc}}">
                                                    <ComboBoxItem Tag="Default" Content="{Binding [CalendarWeekStartDefault], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Monday" Content="{Binding [CalendarMonday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Tuesday" Content="{Binding [CalendarTuesday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Wednesday" Content="{Binding [CalendarWednesday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Thursday" Content="{Binding [CalendarThursday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Friday" Content="{Binding [CalendarFriday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Saturday" Content="{Binding [CalendarSaturday], Source={StaticResource Loc}}" />
                                                    <ComboBoxItem Tag="Sunday" Content="{Binding [CalendarSunday], Source={StaticResource Loc}}" />
                                                </ComboBox>
                                                <TextBlock Text="{Binding [CalendarWeekStartDescription], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AutoSaveSettingsCard" Grid.Row="3" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [AutoSave], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <CheckBox x:Name="EnableAutoSaveCheckBox" Content="{Binding [EnableAutoSave], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Checked="EnableAutoSaveCheckBox_Checked" Unchecked="EnableAutoSaveCheckBox_Unchecked" Style="{StaticResource SettingsSwitchStyle}" />
                                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=EnableAutoSaveCheckBox, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding [AutoSaveFrequency], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" Margin="0,0,0,8" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <Border Style="{StaticResource ChromeFieldBorderStyle}" MinHeight="{StaticResource Control.Height.Form}" Margin="0,0,8,0">
                                                            <TextBox x:Name="AutoSaveIntervalTextBox" Style="{StaticResource EmbeddedFieldTextBoxStyle}" Width="48" TextAlignment="Right" TextChanged="AutoSaveIntervalTextBox_TextChanged" LostFocus="AutoSaveIntervalTextBox_LostFocus" PreviewKeyDown="AutoSaveIntervalTextBox_PreviewKeyDown" />
                                                        </Border>
                                                        <ComboBox behaviors:DropdownChoiceWidthBehavior.IsEnabled="True" x:Name="AutoSaveIntervalUnitBox" SelectionChanged="AutoSaveIntervalUnitBox_SelectionChanged">
                                                            <ComboBoxItem Tag="Seconds" Content="{Binding [AutoSaveUnitSeconds], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="Minutes" Content="{Binding [AutoSaveUnitMinutes], Source={StaticResource Loc}}" />
                                                            <ComboBoxItem Tag="Hours" Content="{Binding [AutoSaveUnitHours], Source={StaticResource Loc}}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="SpellCheckSettingsCard" Grid.Row="4" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [SpellCheck], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <CheckBox x:Name="EnableSpellCheckCheckBox" Content="{Binding [EnableSpellCheck], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Checked="EnableSpellCheckCheckBox_Changed" Unchecked="EnableSpellCheckCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                <TextBlock Text="{Binding [SpellCheckDescription], Source={StaticResource Loc}}" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=EnableSpellCheckCheckBox, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,12" />
                                                    <TextBlock Text="{Binding [SpellCheckLanguages], Source={StaticResource Loc}}" Style="{StaticResource FormOptionLabelStyle}" />
                                                    <TextBlock Text="{Binding [SpellCheckLanguagesDescription], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="0,0,0,10" />
                                                    <Border Style="{StaticResource ChromePanelBorderStyle}" Padding="6" Grid.IsSharedSizeScope="True">
                                                        <!-- The smooth wheel controller consumes pixels, including when rows stack on narrow layouts. -->
                                                        <ListBox x:Name="SpellCheckLanguagesListBox" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource AiToolsListBoxItemStyle}" SelectionMode="Single">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="4,2">
                                                                        <Grid behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SpellCheckLanguageAction" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <RadioButton Grid.Column="0" Style="{StaticResource SortOptionRadioButtonStyle}" GroupName="SpellCheckLanguageGroup" Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsDownloaded}" Tag="{Binding Key}" Margin="2,4" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Checked="SpellCheckLanguageRadioButton_Checked" />
                                                                            <Button Grid.Column="1" Content="{Binding [SpellCheckLanguageDownload], Source={StaticResource Loc}}" Tag="{Binding Key}" Style="{StaticResource SettingsAccentInlineButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="DownloadSpellCheckLanguage_Click" Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVis}}" />
                                                                            <Button Grid.Column="1" Content="{Binding [Delete], Source={StaticResource Loc}}" Tag="{Binding Key}" Style="{StaticResource DialogDangerButtonStyle}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center" Click="DeleteSpellCheckLanguage_Click" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                    <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                                                        <Button x:Name="SpellCheckCheckForUpdatesButton" Content="{Binding [SpellCheckCheckForUpdates], Source={StaticResource Loc}}" Style="{StaticResource SettingsChromeSecondaryButtonStyle}" Padding="12,6" Click="CheckSpellCheckLanguageUpdates_Click" Margin="0,0,8,8" />
                                                        <Button Content="{Binding [SpellCheckOpenFolder], Source={StaticResource Loc}}" Style="{StaticResource SettingsChromeSecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,8" Click="OpenSpellCheckDictionariesFolder_Click" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="SpellCheckLanguageStatusText" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionFlashcards">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryFlashcards], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [FlashcardSchedulingAlgorithm], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <TextBlock Text="{Binding [FlashcardSchedulingAlgorithmTooltip], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="0,0,0,10" />
                                                <ComboBox x:Name="FlashcardSchedulingAlgorithmBox" HorizontalAlignment="Stretch" SelectionChanged="FlashcardSchedulingAlgorithmBox_SelectionChanged">
                                                    <ComboBoxItem Content="SM-2" Tag="Sm2" />
                                                    <ComboBoxItem Content="FSRS-6" Tag="Fsrs6" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="2" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [FlashcardAudioVolume], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <TextBlock Text="{Binding [FlashcardAudioVolumeDescription], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="0,0,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="FlashcardAudioVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="FlashcardAudioVolumeSlider_ValueChanged" />
                                                    <TextBlock x:Name="FlashcardAudioVolumeValueText" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="36" FontSize="{StaticResource Type.Control.Form}" Foreground="{DynamicResource TextColorSecondary}" Grid.Column="1" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionActivity">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryActivity], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding UserActivitySummaryTitle}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <Grid behaviors:AdaptiveColumnsBehavior.IsEnabled="True">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding StatsTotalNotes}" Style="{StaticResource FormBodyTextStyle}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding StatsWordsTyped}" Style="{StaticResource FormBodyTextStyle}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding StatsCharactersTyped}" Style="{StaticResource FormBodyTextStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding StatsTimeSpent}" Style="{StaticResource FormBodyTextStyle}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding StatsLastActive}" Style="{StaticResource FormBodyTextStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Button Content="{Binding [ResetActivitySummary], Source={StaticResource Loc}}" Style="{StaticResource DialogWarningButtonStyle}" Padding="14,8" MinWidth="140" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ResetActivitySummary_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border motion:ArrivalGroups.Role="Content" Style="{StaticResource ContentInsetBorderStyle}" Padding="18" Margin="0,0,0,12" x:Name="SettingsSectionData">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding [SettingsCategoryData], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" FontSize="{StaticResource Type.BlockTitle}" Margin="0,0,0,16" />
                                        <StackPanel x:Name="SettingsUpdatesSection" Grid.Row="1">
                                            <TextBlock Text="{Binding [UpdatesSectionTitle], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="CheckForUpdatesOnStartupCheckBox" Style="{StaticResource SettingsSwitchStyle}"
                                                      HorizontalAlignment="Stretch" Content="{Binding [CheckForUpdatesOnStartup], Source={StaticResource Loc}}"
                                                      Checked="CheckForUpdatesOnStartup_Changed" Unchecked="CheckForUpdatesOnStartup_Changed"/>
                                            <TextBlock Text="{Binding [CheckForUpdatesOnStartupDescription], Source={StaticResource Loc}}"
                                                       Style="{StaticResource FormHelperTextStyle}" Margin="0,8,0,0"/>
                                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Background="{DynamicResource AccentPrimarySubtle}"
                                                    CornerRadius="{StaticResource Radius.Control}" Padding="12" Margin="0,12,0,0"
                                                    Visibility="{Binding Updates.HasAvailableUpdate, ElementName=SettingsRoot, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock x:Name="AvailableUpdateVersionText" Foreground="{DynamicResource AccentPrimarySubtleForeground}"
                                                               FontSize="{StaticResource Type.Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <Button Content="{Binding [UpdateViewDetails], Source={StaticResource Loc}}" Style="{StaticResource SettingsChromeSecondaryButtonStyle}"
                                                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="ViewAvailableUpdate_Click"/>
                                                </StackPanel>
                                            </controls:SurfaceMaterialBorder>
                                        </StackPanel>
                                        <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" CornerRadius="0" Padding="0,20,0,0" Margin="0,20,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [ResetFactorySettings], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <TextBlock Text="{Binding [ResetFactorySettingsDescription], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" Margin="0,0,0,12" />
                                                <Button Content="{Binding [ResetFactorySettings], Source={StaticResource Loc}}" Style="{StaticResource DialogDangerButtonStyle}" Padding="14,8" MinWidth="140" HorizontalAlignment="Left" Click="ResetFactorySettings_Click" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="3" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Diagnostics], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" />
                                                <CheckBox x:Name="EnableDiagnosticLoggingCheckBox" Content="{Binding [EnableDiagnosticLogging], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Checked="EnableDiagnosticLoggingCheckBox_Changed" Unchecked="EnableDiagnosticLoggingCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                <TextBlock Text="{Binding [EnableDiagnosticLoggingDescription], Source={StaticResource Loc}}" Margin="0,8,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                <motion:LayoutRevealHost>
                                                    <StackPanel x:Name="AiContentDiagnosticsPanel">
                                                        <CheckBox x:Name="EnableAiContentDiagnosticsCheckBox" Content="{Binding [EnableAiContentDiagnostics], Source={StaticResource Loc}}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Checked="EnableAiContentDiagnosticsCheckBox_Changed" Unchecked="EnableAiContentDiagnosticsCheckBox_Changed" Style="{StaticResource SettingsSwitchStyle}" />
                                                        <TextBlock Text="{Binding [EnableAiContentDiagnosticsDescription], Source={StaticResource Loc}}" Margin="0,5,0,0" Style="{StaticResource FormHelperTextStyle}" />
                                                    </StackPanel>
                                                </motion:LayoutRevealHost>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid motion:ArrivalGroups.Role="Actions" Margin="0,16,0,0" Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding [CheckForUpdates], Source={StaticResource Loc}}" Style="{StaticResource DialogSecondaryButtonStyle}" Padding="14,8" MinWidth="190" HorizontalAlignment="Left" Click="CheckUpdates_Click" />
                            <Button Grid.Column="1" Style="{StaticResource DialogPrimaryButtonStyle}" Content="{Binding [Close], Source={StaticResource Loc}}" Margin="10,0,0,0" MinWidth="100" Padding="14,8" Click="CloseButton_Click" />
                        </Grid>
                    </Grid>
                </controls:SurfaceMaterialBorder>
            </Grid>
        </Border>
    </Grid>
</UserControl>
