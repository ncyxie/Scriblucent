<Window x:Class="Scriblucent.Views.EditFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="{Binding [EditFlashcard], Source={StaticResource Loc}}"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="480"
                                 CardPadding="28">
        <controls:OverlayDialogShell.Header>
            <StackPanel Margin="0,0,0,20">
                <TextBlock x:Name="DialogTitleTextBlock"
                           Text="{Binding DialogTitle}"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="DialogHintTextBlock"
                           Text="{Binding DialogHint}"
                           FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource TextColorSecondary}"/>
            </StackPanel>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Meta}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="QuestionTextBox"
                             Height="80"
                             MaxHeight="80"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Meta}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="AnswerTextBox"
                             Height="120"
                             MaxHeight="120"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardCategory], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Meta}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox Grid.Row="2"
                              x:Name="CategoryComboBox"
                              ItemsSource="{Binding CategoryOptions}"
                              Style="{StaticResource EditableComboBoxStyle}"
                              Height="38"
                              VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CancelButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Margin="12,0,0,0"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
