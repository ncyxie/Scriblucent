<Window x:Class="Scriblucent.Views.EditFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [EditFlashcard], Source={StaticResource Loc}}"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <Grid x:Name="OverlayRoot">
        <Grid.Resources>
            <Style x:Key="FlashcardEditorInputStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="#4A6EE0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlashcardCategoryComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="2">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="FlashcardCategoryComboToggleTemplate" TargetType="ToggleButton">
                <Border Background="Transparent">
                    <TextBlock Text="▾"
                               FontSize="12"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>

            <Style x:Key="FlashcardCategoryComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="ComboBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        SnapsToDevicePixels="True"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Margin="12,0,38,0"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{DynamicResource TextColor}"
                                         FontSize="{TemplateBinding FontSize}"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                <ToggleButton Grid.Column="1"
                                              Width="34"
                                              HorizontalAlignment="Right"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Template="{StaticResource FlashcardCategoryComboToggleTemplate}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"/>

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="None">
                                    <Border Margin="0,6,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="180"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="18" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#4A6EE0"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#4A6EE0"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="PART_Popup" Property="MinHeight" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlashcardDialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>

            <Style x:Key="FlashcardDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>
        </Grid.Resources>

        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="DialogCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28"
                    MaxWidth="480">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="32" ShadowDepth="4"/>
                </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock x:Name="DialogTitleTextBlock"
                           Grid.Row="0"
                           Text="{Binding DialogTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="DialogHintTextBlock"
                           Grid.Row="0"
                           Text="{Binding DialogHint}"
                           FontSize="12"
                           Foreground="{DynamicResource TextColorSecondary}"
                           Margin="0,34,0,20"/>

                <!-- Question -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="QuestionTextBox"
                             Height="80"
                             Style="{StaticResource FlashcardEditorInputStyle}"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Answer -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="AnswerTextBox"
                             MinHeight="120"
                             Style="{StaticResource FlashcardEditorInputStyle}"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Category -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardCategory], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox Grid.Row="2"
                              x:Name="CategoryComboBox"
                              ItemsSource="{Binding CategoryOptions}"
                              ItemContainerStyle="{StaticResource FlashcardCategoryComboBoxItemStyle}"
                              Style="{StaticResource FlashcardCategoryComboBoxStyle}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">
                    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardDialogSecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                            Margin="12,0,0,0"
                            Style="{StaticResource FlashcardDialogPrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
