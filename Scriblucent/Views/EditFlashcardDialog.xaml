<Window x:Class="Scriblucent.Views.EditFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        Title="{Binding [EditFlashcard], Source={StaticResource Loc}}"
        Height="630"
        Width="520"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="480"
                                 CardPadding="28">
        <controls:OverlayDialogShell.Header>
            <StackPanel Margin="0,0,0,20">
                <TextBlock x:Name="DialogTitleTextBlock"
                           Text="{Binding DialogTitle}"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="DialogHintTextBlock"
                           Text="{Binding DialogHint}"
                           FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource TextColorSecondary}"/>
            </StackPanel>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
            <StackPanel>
                <TextBlock Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.Meta}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,8"/>
                <Border Style="{StaticResource ChromeFieldBorderStyle}"
                        Background="{DynamicResource WindowBackground}"
                        Padding="9,7"
                        MinHeight="80"
                        MaxHeight="80"
                        Margin="0,0,0,10">
                    <TextBox x:Name="QuestionTextBox"
                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <StackPanel x:Name="QuestionImageEmptyPanel" Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="{Binding [FlashcardAddImage], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="10,6"
                                Click="QuestionAddImageButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="QuestionImageAttachedPanel" Orientation="Horizontal" Margin="0,0,16,0" Visibility="Collapsed">
                        <Border Width="72" Height="72"
                                Background="{DynamicResource WindowBackground}"
                                CornerRadius="{StaticResource Radius.Control}"
                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                Margin="0,0,10,0">
                            <Image x:Name="QuestionImagePreview" Stretch="Uniform"/>
                        </Border>
                        <Button Content="{Binding [Remove], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="8,5"
                                Click="QuestionRemoveImageButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="QuestionAudioEmptyPanel" Orientation="Horizontal">
                        <Button Content="{Binding [FlashcardAddAudio], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="10,6"
                                Click="QuestionAddAudioButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="QuestionAudioAttachedPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Margin="0,0,6,0">
                            <Button x:Name="QuestionPlayButton"
                                    Content="{icons:Icon Kind=Play, Size=13}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    Width="26" Height="24" Padding="0"
                                    ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                    Click="QuestionPlayAudioButton_Click"/>
                            <Button x:Name="QuestionPauseButton"
                                    Content="{icons:Icon Kind=Pause, Size=13}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    Width="26" Height="24" Padding="0"
                                    Visibility="Collapsed"
                                    ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                    Click="QuestionPlayAudioButton_Click"/>
                        </Grid>
                        <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Width="26" Height="24" Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                Click="QuestionRestartAudioButton_Click"/>
                        <Button Content="{Binding [Remove], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="8,5"
                                Click="QuestionRemoveAudioButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.Meta}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,8"/>
                <Border Style="{StaticResource ChromeFieldBorderStyle}"
                        Background="{DynamicResource WindowBackground}"
                        Padding="9,7"
                        MinHeight="120"
                        MaxHeight="120"
                        Margin="0,0,0,10">
                    <TextBox x:Name="AnswerTextBox"
                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <StackPanel x:Name="AnswerImageEmptyPanel" Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="{Binding [FlashcardAddImage], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="10,6"
                                Click="AnswerAddImageButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="AnswerImageAttachedPanel" Orientation="Horizontal" Margin="0,0,16,0" Visibility="Collapsed">
                        <Border Width="72" Height="72"
                                Background="{DynamicResource WindowBackground}"
                                CornerRadius="{StaticResource Radius.Control}"
                                behaviors:RoundedClipBehavior.IsEnabled="True"
                                behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}"
                                Margin="0,0,10,0">
                            <Image x:Name="AnswerImagePreview" Stretch="Uniform"/>
                        </Border>
                        <Button Content="{Binding [Remove], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="8,5"
                                Click="AnswerRemoveImageButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="AnswerAudioEmptyPanel" Orientation="Horizontal">
                        <Button Content="{Binding [FlashcardAddAudio], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="10,6"
                                Click="AnswerAddAudioButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="AnswerAudioAttachedPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Margin="0,0,6,0">
                            <Button x:Name="AnswerPlayButton"
                                    Content="{icons:Icon Kind=Play, Size=13}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    Width="26" Height="24" Padding="0"
                                    ToolTip="{Binding [FlashcardPlayAudio], Source={StaticResource Loc}}"
                                    Click="AnswerPlayAudioButton_Click"/>
                            <Button x:Name="AnswerPauseButton"
                                    Content="{icons:Icon Kind=Pause, Size=13}"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    Width="26" Height="24" Padding="0"
                                    Visibility="Collapsed"
                                    ToolTip="{Binding [FlashcardPauseAudio], Source={StaticResource Loc}}"
                                    Click="AnswerPlayAudioButton_Click"/>
                        </Grid>
                        <Button Content="{icons:Icon Kind=Refresh, Size=13}"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Width="26" Height="24" Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="{Binding [FlashcardRestartAudio], Source={StaticResource Loc}}"
                                Click="AnswerRestartAudioButton_Click"/>
                        <Button Content="{Binding [Remove], Source={StaticResource Loc}}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="8,5"
                                Click="AnswerRemoveAudioButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding [FlashcardCategory], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.Meta}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="CategoryComboBox"
                          ItemsSource="{Binding CategoryOptions}"
                          Style="{StaticResource EditableComboBoxStyle}"
                          Background="{DynamicResource WindowBackground}"
                          Height="38"
                          Margin="0,0,0,20"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="{Binding [FlashcardHint], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.Meta}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,8"/>
                <Border Style="{StaticResource ChromeFieldBorderStyle}"
                        Background="{DynamicResource WindowBackground}"
                        Padding="9,0"
                        MinHeight="38"
                        Margin="0,0,0,16">
                    <TextBox x:Name="HintTextBox"
                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CancelButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Margin="12,0,0,0"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
