<Window x:Class="Scriblucent.Views.EditHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="{Binding [EditHistoryTitle], Source={StaticResource Loc}}"
        Height="460"
        Width="640"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResize"
        MinHeight="380"
        MinWidth="520"
        Background="{DynamicResource FeatureFrameBackground}">
    <Window.Resources>
        <Style x:Key="EditHistoryListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="{StaticResource Shell.FeatureTitleRowPadding}">
                <TextBlock Text="{Binding [EditHistoryTitle], Source={StaticResource Loc}}"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <Border Margin="16"
                    BorderThickness="0"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}"
                    Padding="8">
                <ListBox x:Name="HistoryListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource EditHistoryListBoxItemStyle}"
                         MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True"
                                  ClipToBounds="False">
                                <controls:CardShadowLayer/>
                                <Border Padding="10"
                                        CornerRadius="{StaticResource Radius.Control}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding TimestampText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding PreviewText}"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="58"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </controls:FeatureWindowShell.Body>

        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            MinWidth="120"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding [RestoreVersion], Source={StaticResource Loc}}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            MinWidth="140"
                            Margin="10,0,0,0"
                            Click="RestoreButton_Click"/>
                </StackPanel>
            </Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
    </Grid>
</Window>
