<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Scriblucent.Animations" xmlns:behaviors="clr-namespace:Scriblucent.Behaviors" xmlns:controls="clr-namespace:Scriblucent.Controls" x:Class="Scriblucent.Views.FlashcardStatisticsWindow" Title="{Binding [PremiumFlashcardStatistics], Source={StaticResource Loc}}" Height="720" Width="920" MinHeight="480" MinWidth="640" WindowStartupLocation="CenterOwner" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Background="{DynamicResource WorkspaceBackdrop}">
    <Window.Resources>
        <DataTemplate x:Key="StatBarRowTemplate">
            <Grid Margin="0,0,0,8" ToolTip="{Binding CountDescription}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="{StaticResource Type.Control.Toolbar}" Foreground="{DynamicResource TextColorSecondary}" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" x:Name="StatBarTrack" Height="10" HorizontalAlignment="Stretch" Margin="8,0" Background="{DynamicResource ProgressTrackBackground}" CornerRadius="5" Loaded="StatBarTrack_Loaded">
                    <controls:SurfaceMaterialBorder x:Name="StatBarFill" Width="0" Height="10" HorizontalAlignment="Left" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="controls:SurfaceMaterial.Kind" Value="Data"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="New">
                                        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                        <Setter Property="controls:SurfaceMaterial.Kind" Value="Data"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="Learning">
                                        <Setter Property="Background" Value="{DynamicResource AccentWarning}"/>
                                        <Setter Property="controls:SurfaceMaterial.Kind" Value="Data"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChipKind}" Value="Mature">
                                        <Setter Property="Background" Value="{DynamicResource AccentSuccess}"/>
                                        <Setter Property="controls:SurfaceMaterial.Kind" Value="Data"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </controls:SurfaceMaterialBorder>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="{StaticResource Type.Control.Toolbar}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="ContentRoot">
        <controls:FeatureWindowShell>
            <controls:FeatureWindowShell.Header>
                <Border Style="{StaticResource WorkspaceHeadingStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding [PremiumFlashcardStatistics], Source={StaticResource Loc}}" FontSize="{StaticResource Type.DialogTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="{Binding HeaderSubtitleText}" Margin="0,5,0,0" FontSize="{StaticResource Type.Control.Helper}" Foreground="{DynamicResource TextColorSecondary}"/>
                    </StackPanel>
                </Border>
            </controls:FeatureWindowShell.Header>
            <controls:FeatureWindowShell.Body>
                <ScrollViewer Style="{StaticResource RoundedContentScrollViewerStyle}" Margin="24,4,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <StackPanel>
                        <StackPanel motion:ArrivalGroups.Role="Content">
                            <WrapPanel Margin="0,0,0,12">
                                <controls:SurfaceMaterialBorder Style="{StaticResource MetricPrimaryTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DueTodayCountText}" Style="{StaticResource MetricPrimaryValueStyle}" Foreground="{DynamicResource AccentPrimarySubtleForeground}"/>
                                        <TextBlock Text="{Binding [PremiumDueToday], Source={StaticResource Loc}}" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                <controls:SurfaceMaterialBorder Style="{StaticResource MetricTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalCountText}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource TextColor}"/>
                                        <TextBlock Text="{Binding [PremiumTotal], Source={StaticResource Loc}}" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                <controls:SurfaceMaterialBorder Style="{StaticResource MetricTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NewCountText}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource TextColor}"/>
                                        <TextBlock Text="{Binding [PremiumNew], Source={StaticResource Loc}}" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                <controls:SurfaceMaterialBorder Style="{StaticResource MetricWarningTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LearningCountText}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource AccentWarningSubtleForeground}"/>
                                        <TextBlock Text="{Binding [PremiumLearning], Source={StaticResource Loc}}" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                                <controls:SurfaceMaterialBorder Style="{StaticResource MetricSuccessTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MatureCountText}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource AccentSuccessSubtleForeground}"/>
                                        <TextBlock Text="{Binding [PremiumMature], Source={StaticResource Loc}}" Style="{StaticResource MetricLabelStyle}"/>
                                    </StackPanel>
                                </controls:SurfaceMaterialBorder>
                            </WrapPanel>
                        </StackPanel>
                        <controls:ResponsiveSectionPanel Breakpoint="760" Gap="20">
                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" motion:ArrivalGroups.Role="Content" Background="{DynamicResource CardBackground}" BorderThickness="0" CornerRadius="{StaticResource Radius.Card}" Padding="20,16" Style="{StaticResource WorkspaceSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [PremiumCardBreakdown], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding MaturityRows}" ItemTemplate="{StaticResource StatBarRowTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SurfaceMaterialBorder>
                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" motion:ArrivalGroups.Role="Content" Background="{DynamicResource CardBackground}" BorderThickness="0" CornerRadius="{StaticResource Radius.Card}" Padding="20,16" Style="{StaticResource WorkspaceSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [PremiumForecast], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding ForecastRows}" ItemTemplate="{StaticResource StatBarRowTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SurfaceMaterialBorder>
                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" motion:ArrivalGroups.Role="Content" Background="{DynamicResource CardBackground}" BorderThickness="0" CornerRadius="{StaticResource Radius.Card}" Padding="20,16" Style="{StaticResource WorkspaceSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [PremiumIntervals], Source={StaticResource Loc}}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding IntervalRows}" ItemTemplate="{StaticResource StatBarRowTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SurfaceMaterialBorder>
                            <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" motion:ArrivalGroups.Role="Content" Background="{DynamicResource CardBackground}" BorderThickness="0" CornerRadius="{StaticResource Radius.Card}" Padding="20,16" Style="{StaticResource WorkspaceSectionStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding DifficultySignalTitleText}" Style="{StaticResource FormSectionTitleStyle}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding DifficultySignalRows}" ItemTemplate="{StaticResource StatBarRowTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:SurfaceMaterialBorder>
                        </controls:ResponsiveSectionPanel>
                    </StackPanel>
                </ScrollViewer>
            </controls:FeatureWindowShell.Body>
            <controls:FeatureWindowShell.Footer>
                <Border Style="{StaticResource WorkspaceFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [Close], Source={StaticResource Loc}}" Padding="14,8" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Border>
            </controls:FeatureWindowShell.Footer>
        </controls:FeatureWindowShell>
    </Grid>
</Window>
