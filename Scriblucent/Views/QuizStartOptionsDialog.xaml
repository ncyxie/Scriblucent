<Window x:Class="Scriblucent.Views.QuizStartOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [QuizStartOptionsTitle], Source={StaticResource Loc}}"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="520"
                                 CardPadding="30,28,30,24">
        <controls:OverlayDialogShell.Header>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level 5 status glyph: fill only (role I soft). -->
                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        Background="{DynamicResource FlashcardKnownChipBackground}"
                        BorderThickness="0"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <icons:AppIcon Kind="Play" Width="12" Height="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FlashcardKnownChipForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,1,0,0">
                    <TextBlock Text="{Binding [QuizStartOptionsTitle], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.DialogTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="26"/>
                    <TextBlock Text="{Binding [QuizStartOptionsMessage], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Meta}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,8,8"
                               LineHeight="19"/>
                </StackPanel>
            </Grid>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <Border Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="64,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [QuizStartTimeLimitQuestion], Source={StaticResource Loc}}"
                                   FontSize="{StaticResource Type.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,7"/>
                        <ComboBox x:Name="TimeLimitComboBox"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="TimeLimitComboBox_SelectionChanged">
                            <ComboBoxItem Content="{Binding [QuizTimeLimitNone], Source={StaticResource Loc}}" Tag="0"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitOneMinute], Source={StaticResource Loc}}" Tag="60"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitFiveMinutes], Source={StaticResource Loc}}" Tag="300"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitTenMinutes], Source={StaticResource Loc}}" Tag="600"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitFifteenMinutes], Source={StaticResource Loc}}" Tag="900"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitThirtyMinutes], Source={StaticResource Loc}}" Tag="1800"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitCustom], Source={StaticResource Loc}}" Tag="custom"/>
                        </ComboBox>
                        <Grid x:Name="CustomTimePanel"
                              Margin="0,10,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomTimeTextBox"
                                     Grid.Column="0"
                                     Height="42"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [QuizTimeLimitCustomUnit], Source={StaticResource Loc}}"
                                       FontSize="{StaticResource Type.Meta}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2"
                                       x:Name="TimeValidationText"
                                       Text="{Binding [QuizTimeLimitValidation], Source={StaticResource Loc}}"
                                       Foreground="{DynamicResource AccentDanger}"
                                       FontSize="{StaticResource Type.Caption}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="64,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding [QuizStartPassingScoreQuestion], Source={StaticResource Loc}}"
                                   FontSize="{StaticResource Type.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PassingScoreTextBox"
                                     Grid.Column="0"
                                     Height="42"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                            <TextBlock Grid.Column="1"
                                       Text="%"
                                       FontSize="{StaticResource Type.Meta}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2"
                                       x:Name="ValidationText"
                                       Text="{Binding [QuizPassingScoreValidation], Source={StaticResource Loc}}"
                                       Foreground="{DynamicResource AccentDanger}"
                                       FontSize="{StaticResource Type.Caption}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CancelButton_Click"/>

                <Button Content="{Binding [QuizStartConfirm], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="120"
                        Margin="12,0,0,0"
                        Click="StartButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
