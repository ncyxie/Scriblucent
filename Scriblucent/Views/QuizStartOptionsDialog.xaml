<Window xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.QuizStartOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding [QuizOptionsTitle], Source={StaticResource Loc}}"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="520"
                                 CardPadding="30,28,30,24">
        <controls:OverlayDialogShell.Header>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level 5 status glyph: fill only (role I soft). -->
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" Grid.Column="0"
                        Width="48"
                        Height="48"
                        Background="{DynamicResource FlashcardKnownChipBackground}"
                        BorderThickness="0"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <icons:AppIcon Kind="Play" Width="12" Height="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FlashcardKnownChipForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                </controls:SurfaceMaterialBorder>

                <StackPanel Grid.Column="1" Margin="16,1,0,0">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="{Binding [QuizOptionsTitle], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.DialogTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="26"/>
                    <TextBlock x:Name="HeaderMessageText"
                               Text="{Binding [QuizOptionsMessage], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Meta}"
                               Foreground="{DynamicResource TextColorSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,8,8"
                               LineHeight="19"/>
                </StackPanel>
            </Grid>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <Border Style="{StaticResource ContentInsetBorderStyle}"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="64,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding [QuizStartTimeLimitQuestion], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"
                                   Margin="{StaticResource Field.LabelMargin}"/>
                        <ComboBox x:Name="TimeLimitComboBox"
                                  Style="{StaticResource ChromeComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="TimeLimitComboBox_SelectionChanged">
                            <ComboBoxItem Content="{Binding [QuizTimeLimitNone], Source={StaticResource Loc}}" Tag="0"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitOneMinute], Source={StaticResource Loc}}" Tag="60"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitFiveMinutes], Source={StaticResource Loc}}" Tag="300"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitTenMinutes], Source={StaticResource Loc}}" Tag="600"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitFifteenMinutes], Source={StaticResource Loc}}" Tag="900"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitThirtyMinutes], Source={StaticResource Loc}}" Tag="1800"/>
                            <ComboBoxItem Content="{Binding [QuizTimeLimitCustom], Source={StaticResource Loc}}" Tag="custom"/>
                        </ComboBox>
                        <motion:LayoutRevealHost x:Name="CustomTimeHost">
                        <Grid x:Name="CustomTimePanel"
                              Margin="0,10,0,0"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource ChromeFieldBorderStyle}"
                                    MinHeight="36">
                                <TextBox x:Name="CustomTimeTextBox"
                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                         TextAlignment="Center"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [QuizTimeLimitCustomUnit], Source={StaticResource Loc}}"
                                       Style="{StaticResource FormBodyTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                            <controls:InlineValidationPresenter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                       x:Name="TimeValidationText"
                                       Text="{Binding [QuizTimeLimitValidation], Source={StaticResource Loc}}"
                                       Margin="0,4,0,0"/>
                        </Grid>
                        </motion:LayoutRevealHost>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentInsetBorderStyle}"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="64,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding [QuizStartPassingScoreQuestion], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"
                                   Margin="{StaticResource Field.LabelMargin}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource ChromeFieldBorderStyle}"
                                    MinHeight="36">
                                <TextBox x:Name="PassingScoreTextBox"
                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                         TextAlignment="Center"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="%"
                                       Style="{StaticResource FormBodyTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                            <controls:InlineValidationPresenter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                       x:Name="ValidationText"
                                       Text="{Binding [QuizPassingScoreValidation], Source={StaticResource Loc}}"
                                       Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentInsetBorderStyle}"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="64,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding [QuizPreferencesHeading], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="ShuffleQuestionsCheckBox"
                                  Content="{Binding [QuizShuffleQuestionsLabel], Source={StaticResource Loc}}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="ShuffleOptionsCheckBox"
                                  Content="{Binding [QuizShuffleOptionsLabel], Source={StaticResource Loc}}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="PartialCreditCheckBox"
                                  Content="{Binding [QuizPartialCreditLabel], Source={StaticResource Loc}}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource FormCheckBoxStyle}" x:Name="ExamModeCheckBox"
                                  Content="{Binding [QuizExamModeLabel], Source={StaticResource Loc}}"
                                  ToolTip="{Binding [QuizExamModeTooltip], Source={StaticResource Loc}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        Click="CancelButton_Click"/>

                <Button x:Name="ConfirmButton"
                        Content="{Binding [Save], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="120"
                        Margin="12,0,0,0"
                        Click="StartButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
