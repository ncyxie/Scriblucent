<Window x:Class="Scriblucent.Views.ItemInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="Info"
        Height="620"
        Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="InfoRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinHeight" Value="66"/>
        </Style>

        <DataTemplate x:Key="InfoRowTemplate">
            <Border Style="{StaticResource InfoRowCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               FontSize="{StaticResource Type.Chip}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Loaded="TrimmedTextBlock_Loaded"
                               SizeChanged="TrimmedTextBlock_SizeChanged"/>
                    <TextBlock Text="{Binding Value}"
                               FontSize="{StaticResource Type.Body}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0"
                               LineHeight="19"
                               Loaded="TrimmedTextBlock_Loaded"
                               SizeChanged="TrimmedTextBlock_SizeChanged"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <controls:OverlayDialogShell
                                 MaxCardWidth="640"
                                 CardPadding="28,26,28,22">
        <controls:OverlayDialogShell.Header>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level 5 status glyph: fill only (role I soft). -->
                <Border Grid.Column="0"
                        Width="46"
                        Height="46"
                        Background="{DynamicResource EditorToolActiveBackground}"
                        BorderThickness="0"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <TextBlock Text="i"
                               FontSize="{StaticResource Type.Display}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource EditorToolActiveForeground}"
                               FontFamily="{StaticResource FontFamily.UI}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding TitleText}"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="26"
                           Margin="16,2,0,0"
                           Loaded="TrimmedTextBlock_Loaded"
                           SizeChanged="TrimmedTextBlock_SizeChanged"/>
            </Grid>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Padding="0,0,2,0"
                          MinHeight="400"
                          MaxHeight="430">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding PrimaryRows}"
                                  ItemTemplate="{StaticResource InfoRowTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Expander IsExpanded="False"
                              Margin="0,4,0,0"
                              Foreground="{DynamicResource TextColor}">
                        <Expander.Header>
                            <TextBlock Text="{Binding AdvancedHeaderText}"
                                       FontSize="{StaticResource Type.Meta}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding AdvancedRows}"
                                      ItemTemplate="{StaticResource InfoRowTemplate}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <Button Content="{Binding OkText}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Padding="20,10"
                    MinWidth="110"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    Click="OkButton_Click"/>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
