<Window x:Class="Scriblucent.Views.ItemInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info"
        Height="620"
        Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="InfoRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinHeight" Value="66"/>
        </Style>

        <DataTemplate x:Key="InfoRowTemplate">
            <Border Style="{StaticResource InfoRowCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Loaded="TrimmedTextBlock_Loaded"
                               SizeChanged="TrimmedTextBlock_SizeChanged"/>
                    <TextBlock Text="{Binding Value}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0"
                               LineHeight="19"
                               Loaded="TrimmedTextBlock_Loaded"
                               SizeChanged="TrimmedTextBlock_SizeChanged"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="OverlayRoot">
        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="DialogCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28,26,28,22"
                    Width="640"
                    Height="560"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="36" ShadowDepth="0"/>
                </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="46"
                            Height="46"
                            Background="#EAF2FF"
                            BorderBrush="#BFD7FF"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <TextBlock Text="i"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   FontFamily="Segoe UI, sans-serif"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-2,0,0"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="26"
                               Margin="16,2,0,0"
                               Loaded="TrimmedTextBlock_Loaded"
                               SizeChanged="TrimmedTextBlock_SizeChanged"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="0,0,2,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PrimaryRows}"
                                      ItemTemplate="{StaticResource InfoRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Expander IsExpanded="False"
                                  Margin="0,4,0,0"
                                  Foreground="{DynamicResource TextColor}">
                            <Expander.Header>
                                <TextBlock Text="{Binding AdvancedHeaderText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"/>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding AdvancedRows}"
                                          ItemTemplate="{StaticResource InfoRowTemplate}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="{Binding OkText}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Click="OkButton_Click"/>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
