<Window x:Class="Scriblucent.Views.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        Title="{Binding [SimpleInputTitle], Source={StaticResource Loc}}"
        MinHeight="185"
        Height="185"
        Width="420"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="420"
                                 CardPadding="18">
        <controls:OverlayDialogShell.Header>
            <TextBlock x:Name="PromptText"
                       FontWeight="SemiBold"
                       FontSize="{StaticResource Type.DialogTitle}"
                       Foreground="{DynamicResource TextColor}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <Border Style="{StaticResource ChromeFieldBorderStyle}"
                        Background="{DynamicResource WindowBackground}"
                        Margin="0,0,0,14">
                    <TextBox x:Name="InputBox"
                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                             FontSize="{StaticResource Type.Meta}"/>
                </Border>
                <TextBlock x:Name="ValidationText" Visibility="Collapsed"
                           Foreground="{DynamicResource AccentDanger}" TextWrapping="Wrap"
                           FontSize="{StaticResource Type.Caption}" Margin="0,0,0,12"/>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="{Binding [Ok], Source={StaticResource Loc}}"
                        IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        Click="Ok_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
