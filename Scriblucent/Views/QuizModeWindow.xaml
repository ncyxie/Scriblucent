<Window x:Class="Scriblucent.Views.QuizModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        Title="{Binding [QuizModeTitle], Source={StaticResource Loc}}"
        Height="650"
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{DynamicResource FeatureFrameBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="QuizModeWindow_PreviewKeyDown">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="{StaticResource Shell.FeatureTitleRowPadding}">
            <Grid>
                <TextBlock x:Name="ProgressText"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextColorSecondary}"/>
                <Border x:Name="TimerBorder" CornerRadius="6" Padding="8,4" Background="Transparent">
                    <TextBlock x:Name="TimerText"
               HorizontalAlignment="Right"
               FontSize="{StaticResource Type.Body}"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextColor}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Question + navigator -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Question Area -->
            <Border Grid.Column="0"
                    x:Name="QuestionView"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Margin="0,0,12,0"
                    Padding="0"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="20">
                <StackPanel>
                <!-- Type hint + flag for review (Moodle-style) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="QuestionTypeIndicator"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border Background="{DynamicResource SelectionBackground}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <icons:AppIcon Kind="Checkmark" Width="16" Height="16"
                                            Foreground="{DynamicResource TextColor}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>
                                <TextBlock x:Name="QuestionTypeText"
                                Text="{Binding [QuizMultipleChoiceInstruction], Source={StaticResource Loc}}"
                                            FontSize="{StaticResource Type.Caption}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextColor}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button x:Name="FlagQuestionButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="10,6"
                            Cursor="Hand"
                            Click="FlagQuestionButton_Click"
                            ToolTip="{Binding [QuizFlagQuestionTooltip], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                                <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
                                <Setter Property="MinHeight" Value="30"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <icons:AppIcon x:Name="FlagQuestionIcon"
                                           Kind="Flag"
                                           Width="14"
                                           Height="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextColor}"/>
                            <TextBlock x:Name="FlagQuestionLabel"
                                       Text="{Binding [QuizFlagQuestion], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Question Text -->
                <TextBlock x:Name="QuestionTextBlock"
                           FontSize="{StaticResource Type.PageTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Options -->
                <StackPanel x:Name="OptionsPanel"
                            Margin="0,0,0,20"/>
                <!-- Hint Section -->
                <StackPanel x:Name="HintSection" Margin="0,0,0,8" Visibility="Collapsed">
                    <Button x:Name="ShowHintButton"
                            HorizontalAlignment="Left"
                            Padding="12,7"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            Click="ShowHintButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                                <Setter Property="FontSize" Value="{StaticResource Type.Meta}"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <icons:AppIcon Kind="Lightbulb" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Show Hint" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Level 5 status banner: soft fill (role I); no decorative box stroke. -->
                    <Border x:Name="HintTextBorder"
            Background="{DynamicResource AccentWarningSubtle}"
            BorderThickness="0"
            CornerRadius="{StaticResource Radius.Control}"
            Padding="12,10"
            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <icons:AppIcon Kind="Lightbulb"
                                           Width="14"
                                           Height="14"
                                           VerticalAlignment="Top"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource AccentWarningSubtleForeground}"/>
                            <TextBlock x:Name="HintTextBlock"
                       FontSize="{StaticResource Type.Meta}"
                       Foreground="{DynamicResource AccentWarningSubtleForeground}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- Results View (hidden during quiz) -->
            <Border Grid.Column="0"
                    x:Name="ResultsView"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Margin="0,0,12,0"
                    Padding="0"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              Padding="20">
                    <StackPanel>
                        <!-- Score Summary -->
                        <Border Background="{DynamicResource WindowBackground}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ResultsTitleText"
                                Text="{Binding [QuizResultsTitleGreat], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource Type.Display}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="ResultsScoreText"
                                           FontSize="{StaticResource Type.DialogTitle}"
                                           Foreground="{DynamicResource TextColor}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="ResultsTimeText"
                                           FontSize="{StaticResource Type.Body}"
                                           Foreground="{DynamicResource TextColorSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Questions Review -->
                        <TextBlock Text="{Binding [QuizReviewAnswers], Source={StaticResource Loc}}"
                                   FontSize="{StaticResource Type.BlockTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,16"/>

                        <StackPanel x:Name="ResultsQuestionsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Moodle-style question number navigator -->
            <Border Grid.Column="1"
                    x:Name="QuestionNavPanel"
                    Width="148"
                    MinWidth="148"
                    Style="{StaticResource ChromePanelBorderStyle}"
                    Padding="10,10,4,10"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [QuizNavigationTitle], Source={StaticResource Loc}}"
                               FontSize="{StaticResource Type.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               Margin="0,0,6,10"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  CanContentScroll="False"
                                  VerticalAlignment="Stretch"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  behaviors:ScrollBarAutoHideBehavior.Enable="True">
                        <WrapPanel x:Name="QuestionNavButtonsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Navigation -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="PreviousButton"
                        Content="{Binding [QuizPreviousButton], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Background="{DynamicResource CardBackground}"
                        MinWidth="130"
                        Padding="16,10"
                        Click="PreviousButton_Click"/>

                <Button Grid.Column="4"
                        x:Name="NextButton"
                        Content="{Binding [QuizNextButton], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="130"
                        Padding="16,10"
                        Click="NextButton_Click"/>

                <Button Grid.Column="4"
                        x:Name="SubmitButton"
                        Content="{Binding [QuizSubmitButton], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="130"
                        Padding="16,10"
                        Visibility="Collapsed"
                        Click="SubmitButton_Click"/>

				<Button Grid.Column="2"
						x:Name="RetryAllButton"
						Style="{StaticResource DialogSecondaryButtonStyle}"
						Background="{DynamicResource CardBackground}"
						MinWidth="130"
						Padding="16,10"
						Visibility="Collapsed"
						Click="RetryAllButton_Click">
					<StackPanel Orientation="Horizontal">
						<icons:AppIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="Retry All" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Button Grid.Column="3"
						x:Name="RetryWrongButton"
						Style="{StaticResource DialogSecondaryButtonStyle}"
						Background="{DynamicResource CardBackground}"
						MinWidth="130"
						Padding="16,10"
						Margin="8,0,0,0"
						Visibility="Collapsed"
						Click="RetryWrongButton_Click">
					<StackPanel Orientation="Horizontal">
						<icons:AppIcon Kind="Warning" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="Retry Wrong" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

                <Button Grid.Column="4"
                        x:Name="DoneButton"
                        Content="{Binding [QuizDoneButton], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="130"
                        Padding="16,10"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="DoneButton_Click"/>

            </Grid>
        </Border>
