<Window x:Class="Scriblucent.Views.QuizPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        x:Name="QuizWindow"
        Title="{Binding [QuizPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="650"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBackground}"
        Closing="QuizPreviewWindow_Closing">
    <Window.Resources>
        <Style x:Key="QuizToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="LinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="LinkedNoteBorder"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkedNoteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="QuizFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="QuizFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarPrimaryButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="QuizCompactToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="QuizOptionMoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="ButtonBorder"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="QuizOptionRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="ButtonBorder"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#F6DEDE"/>
            <Setter Property="BorderBrush" Value="#D7A6A6"/>
            <Setter Property="Foreground" Value="#9F2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFCACA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C78D8D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5BABA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B97979"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizEditorTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="EditorTextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EditorTextBoxBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="QuizEditorComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="QuizEditorComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <icons:AppIcon Kind="ChevronDown" Width="12" Height="12" Grid.Column="1"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="QuizEditorComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="QuizEditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="QuizEditorComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="QuizEditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="QuizEditorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource QuizEditorComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource QuizEditorComboBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource QuizEditorComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonText}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizEditorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizOptionButtonStyle" TargetType="Button">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="OptionBorder"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter Property="BorderBrush" Value="#3F6FE8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="Foreground" Value="#065F46"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncorrectSelectedAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [QuizTitleHint], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                        <ComboBox ItemsSource="{Binding ElementName=QuizWindow, Path=NoteLinkOptions}"
                                  SelectedItem="{Binding ElementName=QuizWindow, Path=SelectedLinkedNote, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  MinWidth="140"
                                  MaxWidth="170"
                                  Margin="0,0,0,6"
                                  Style="{StaticResource LinkedNoteComboBoxStyle}"
                                  Visibility="{Binding ElementName=QuizWindow, Path=IsEditMode, Converter={StaticResource BoolToVis}}"
                                  SelectedValuePath="Id"
                                  ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
                        <Button x:Name="LinkedNoteButton"
                                Content="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonText}"
                                Style="{StaticResource LinkedNoteButtonStyle}"
                                MinWidth="140"
                                MaxWidth="170"
                                Click="LinkedNoteButton_Click"
                                Visibility="{Binding ElementName=QuizWindow, Path=IsEditMode, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonToolTip}"
                                TextOptions.TextFormattingMode="Ideal"/>
                    </StackPanel>

                    <Border x:Name="AiGeneratedInfoBadge"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{DynamicResource IconButtonBackground}"
                            BorderBrush="{DynamicResource IconButtonBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="180"
                            Visibility="Collapsed">
                        <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,12,20,10"
                Padding="12,9"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionCountTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock x:Name="AnsweredCountTextBlock"
                               Margin="16,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        x:Name="ScoreBadge"
                        Padding="10,5"
                        CornerRadius="8"
                        Background="{DynamicResource SelectionBackground}"
                        Margin="12,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                </Border>

                <WrapPanel Grid.Column="2"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
                    <Button x:Name="ModeToggleButton"
                            Content="{Binding [EditQuiz], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="ModeToggleButton_Click"/>
                    <Button Content="Shuffle"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="ShuffleQuestionsButton_Click"
                            ToolTip="Shuffle questions randomly"/>
                    <Button x:Name="CategoriesButton"
                            Content="Categories"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="CategoriesAndSetsButton_Click"
                            ToolTip="Edit quiz tags"/>
                    <Button Content="History"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="QuizHistoryButton_Click"
                            ToolTip="Show this quiz's attempt history"/>
                    <Button x:Name="ExportButton"
                            Content="{Binding [Export], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="ExportButton_Click"
                            ToolTip="{Binding [Export], Source={StaticResource Loc}}"/>
                    <Button x:Name="FullscreenButton"
                            Content="Fullscreen"
                            Style="{StaticResource QuizCompactToolButtonStyle}"
                            Click="FullscreenButton_Click"
                            ToolTip="Toggle Fullscreen (F11)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="QuestionsScrollViewer"
                      Grid.Row="2"
                      Margin="20,0,20,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="QuestionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <!-- Shadow on a sibling so question text/inputs keep ClearType -->
                            <Border CornerRadius="12"
                                    Background="{DynamicResource CardBackground}"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                                </Border.Effect>
                            </Border>
                            <Border Padding="16"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Ideal"
                                    TextOptions.TextRenderingMode="ClearType">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3F6FE8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding HeaderText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <ComboBox Style="{StaticResource QuizEditorComboBoxStyle}"
                                                  MinWidth="150"
                                                  Margin="0,0,8,8"
                                                  Loaded="QuizTypeComboBox_Loaded"
                                                  SelectionChanged="QuizTypeComboBox_SelectionChanged"
                                                  Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="SingleChoice"
                                                          Content="{Binding [QuizTypeSingleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="MultipleChoice"
                                                          Content="{Binding [QuizTypeMultipleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="TrueFalse"
                                                          Content="{Binding [QuizTypeTrueFalse], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="PlainText"
                                                          Content="{Binding [QuizTypePlainText], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                        <Button Content="{icons:Icon Kind=ArrowUp, Size=12}"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [MoveQuestionUp], Source={StaticResource Loc}}"
                                                Click="MoveQuestionUpButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{icons:Icon Kind=ArrowDown, Size=12}"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [MoveQuestionDown], Source={StaticResource Loc}}"
                                                Click="MoveQuestionDownButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{icons:Icon Kind=Close, Size=12}"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [DeleteQuestion], Source={StaticResource Loc}}"
                                                Click="DeleteQuestionButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Border Padding="8,4"
                                                CornerRadius="7"
                                                Background="{Binding ResultBackground}"
                                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ResultText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Question}"
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="42"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Style="{StaticResource QuizEditorTextBoxStyle}"
                                         Margin="0,0,0,12"
                                         Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                <!-- Grid.Row="2" - Question Content Area (Options OR PlainText Answer) -->
                                <Grid Grid.Row="2">

                                    <!-- ✅ Multiple choice / True-False options (hidden when PlainText) -->
                                    <ItemsControl ItemsSource="{Binding Options}"
                  Visibility="{Binding IsPlainText, Converter={StaticResource InverseBoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource QuizOptionButtonStyle}"
                        Margin="0,0,0,8"
                        Click="OptionButton_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding MarkerText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsCorrect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{Binding [CorrectAnswer], Source={StaticResource Loc}}"
                                  Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Grid.Column="2"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <TextBox Grid.Column="2"
                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 Style="{StaticResource QuizEditorTextBoxStyle}"
                                 MinHeight="30"
                                 Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Margin="6,0,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Parent.CanReorderOptions}" Value="True"/>
                                                                                <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Content="{icons:Icon Kind=ArrowUp, Size=12}"
                                    Style="{StaticResource QuizOptionMoveButtonStyle}"
                                    ToolTip="{Binding [MoveOptionUp], Source={StaticResource Loc}}"
                                    Click="MoveOptionUpButton_Click"/>
                                                            <Button Content="{icons:Icon Kind=ArrowDown, Size=12}"
                                    Style="{StaticResource QuizOptionMoveButtonStyle}"
                                    ToolTip="{Binding [MoveOptionDown], Source={StaticResource Loc}}"
                                    Click="MoveOptionDownButton_Click"/>
                                                            <Button Content="{icons:Icon Kind=Close, Size=12}"
                                    Style="{StaticResource QuizOptionRemoveButtonStyle}"
                                    ToolTip="{Binding [RemoveOption], Source={StaticResource Loc}}"
                                    Click="RemoveOptionButton_Click"
                                    Visibility="{Binding Parent.CanRemoveOption, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Plain text answer section -->
                                    <Border Visibility="{Binding IsPlainText, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding [QuizPlainTextEditAnswerLabel], Source={StaticResource Loc}}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding [QuizPlainTextYourAnswerLabel], Source={StaticResource Loc}}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>

                                            <TextBox Text="{Binding PlainTextAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="76"
                                                     MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Style="{StaticResource QuizEditorTextBoxStyle}"
                                                     Margin="0,8,0,0"
                                                     ToolTip="{Binding [QuizPlainTextAnswerHint], Source={StaticResource Loc}}"
                                                     Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBox x:Name="PlainTextPracticeTextBox"
                                                         Text="{Binding PlainTextUserAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsSubmitted}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="86"
                                                         MaxHeight="170"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource QuizEditorTextBoxStyle}"
                                                         ToolTip="{Binding [QuizPlainTextPracticeHint], Source={StaticResource Loc}}"/>
                                                <TextBlock Text="{Binding [QuizPlainTextPracticePlaceholder], Source={StaticResource Loc}}"
                                                           IsHitTestVisible="False"
                                                           Margin="10,8,10,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Opacity="0.72"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, ElementName=PlainTextPracticeTextBox}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PlainTextPracticeTextBox}" Value="False"/>
                                                                        <Condition Binding="{Binding IsSubmitted}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <CheckBox Content="{Binding [QuizPlainTextMatchCase], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding PlainTextMatchCase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="12"
                                                              Foreground="{DynamicResource TextColorSecondary}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,16,0"
                                                              ToolTip="{Binding [QuizPlainTextMatchCaseHint], Source={StaticResource Loc}}"/>
                                                    <CheckBox Content="{Binding [QuizPlainTextIgnorePunctuation], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding PlainTextIgnorePunctuation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="12"
                                                              Foreground="{DynamicResource TextColorSecondary}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="{Binding [QuizPlainTextIgnorePunctuationHint], Source={StaticResource Loc}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CorrectPlainTextAnswerDisplay}"
                                                           Grid.Column="0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ShowPlainTextCorrectAnswer, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock FontSize="11"
                                                           Grid.Column="1"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding PlainTextPracticeCharCountText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding PlainTextAnswerCharCountText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <Border Grid.Row="3"
                                        Margin="0,4,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SelectionBackground}"
                                        CornerRadius="8"
                                        Visibility="{Binding HasVisibleExplanation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExplanationText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                </Border>

                                <Border Grid.Row="3"
                                        Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Button Content="{Binding [AddOption], Source={StaticResource Loc}}"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="AddOptionButton_Click"
                                                Visibility="{Binding CanAddOption, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding [QuizExplanationLabel], Source={StaticResource Loc}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   Margin="0,4,0,6"/>
                                        <TextBox Text="{Binding Explanation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38"
                                                 MaxHeight="72"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding [QuizExplanationHint], Source={StaticResource Loc}}"
                                                 Style="{StaticResource QuizEditorTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="20,0,20,12"
                Padding="12,10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Button x:Name="StartQuizButton"
                            Content="{Binding [QuizStartButton], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterPrimaryButtonStyle}"
                            Background="#10B981"
                            BorderBrush="#10B981"
                            Foreground="White"
                            Click="StartQuizButton_Click"
                            ToolTip="{Binding [QuizStartButtonTooltip], Source={StaticResource Loc}}"/>
                    <Button x:Name="CheckAnswersButton"
                            Content="{Binding [QuizCheckAnswers], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterPrimaryButtonStyle}"
                            Click="CheckAnswersButton_Click"/>
                    <Button x:Name="ResetAnswersButton"
                            Content="{Binding [QuizResetAnswers], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="ResetAnswersButton_Click"/>
                    <Button x:Name="AddQuestionButton"
                            Content="{Binding [AddQuestion], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="AddQuestionButton_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0,0,0">
                    <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterPrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Margin="0,4,0,4"
                            Click="CloseButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
