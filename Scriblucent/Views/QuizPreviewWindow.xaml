<Window xmlns:motion="clr-namespace:Scriblucent.Animations" x:Class="Scriblucent.Views.QuizPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:converters="clr-namespace:Scriblucent.Converters"
        x:Name="QuizWindow"
        Title="{Binding [QuizPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="650"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WorkspaceBackdrop}"
        Closing="QuizPreviewWindow_Closing">
    <Window.Resources>
        <converters:CollectionTailMarginConverter x:Key="QuestionTailMargin" BaseMargin="17,14,17,17"/>
        <!-- Keep the scroller in the ItemsControl template so its presenter exposes the
             VirtualizingStackPanel as IScrollInfo to ScrollContentPresenter. -->
        <Style x:Key="QuizQuestionsItemsControlStyle" TargetType="{x:Type ItemsControl}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ScrollViewer x:Name="QuestionsScrollViewer"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      behaviors:RoundedClipBehavior.IsEnabled="True"
                                      behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Card}"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                                      behaviors:MiddleClickScrollBehavior.IsEnabled="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuizToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="LinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkedNoteToolbarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuizLinkedNoteSlotStyle" TargetType="Grid">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(controls:EditorChromeContext.Controller).SelectedLinkedNote, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                        <Condition Binding="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuizToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FeatureToolbarPrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="QuizFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="QuizFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarPrimaryButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="QuizCompactToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>


        <Style x:Key="QuizOptionRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="ButtonBorder"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Meta}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="controls:InteractionSurface.HighlightWash" Value="{DynamicResource DangerControlHoverWash}"/>
            <Setter Property="controls:InteractionSurface.HighlightEdge" Value="{DynamicResource AccentDanger}"/>
            <Setter Property="Background" Value="{DynamicResource AccentDangerSubtle}"/>
            <Setter Property="controls:SurfaceMaterial.Kind" Value="Tinted"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentDangerSubtleForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:InteractionSurface controls:SurfaceMaterial.Kind="{TemplateBinding controls:SurfaceMaterial.Kind}" controls:SurfaceMaterial.Foreground="{TemplateBinding Foreground}" Role="Standard" HighlightWash="{TemplateBinding controls:InteractionSurface.HighlightWash}" HighlightEdge="{TemplateBinding controls:InteractionSurface.HighlightEdge}" HoverBackground="{DynamicResource AccentDangerSubtleHover}" PressedBackground="{DynamicResource AccentDangerSubtleHover}" x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </controls:InteractionSurface>
                        <ControlTemplate.Triggers>


                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizEditorComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ChromeComboBoxStyle}">
            <Setter Property="MinHeight" Value="{StaticResource Control.Height.Toolbar}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Control.Toolbar}"/>
            <Setter Property="Height" Value="{StaticResource Control.Height.Toolbar}"/>
        </Style>
    </Window.Resources>
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Body><Grid x:Name="ContentRoot" controls:EditorChromeContext.Controller="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border motion:WindowMotion.Role="Chrome" Grid.Row="0" Style="{StaticResource EditorChromeStyle}">
            <Grid behaviors:EditorHeaderLayoutBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="EditorTitleField" Grid.Column="0"
                        Grid.Row="0"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ChromeTitleFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                 FontSize="{StaticResource Type.DialogTitle}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [QuizTitleHint], Source={StaticResource Loc}}"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                        <controls:EditorTitleStatus x:Name="EditedIndicatorText" Style="{StaticResource EditorTitleStatusStyle}"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="EditorCommandTray" Grid.Column="1"
                        Grid.Row="0"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Control}"
                        VerticalAlignment="Center"
                        Padding="0,6"
                        behaviors:RoundedClipBehavior.IsEnabled="True"
                        SnapsToDevicePixels="True">
                    <controls:EditorCommandPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="ModeToggleButton"
                                Content="{icons:Icon Edit}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [EditQuiz], Source={StaticResource Loc}}"
                                Click="ModeToggleButton_Click"/>
                        <Button x:Name="ShuffleQuestionsButton"
                                Content="{icons:Icon Shuffle, Size=14}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [QuizShuffleTooltip], Source={StaticResource Loc}}"
                                Click="ShuffleQuestionsButton_Click"/>
                        <Button Content="{icons:Icon History}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [QuizHistory], Source={StaticResource Loc}}"
                                Click="QuizHistoryButton_Click"/>
                        <Button x:Name="ImportQuestionsButton"
                                Content="{icons:Icon Import}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [QuizImportQuestions], Source={StaticResource Loc}}"
                                Click="ImportQuestionsButton_Click"/>
                        <Button x:Name="ExportButton"
                                Content="{icons:Icon Download}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Export], Source={StaticResource Loc}}"
                                Click="ExportButton_Click"/>
                        <Button x:Name="FullscreenButton"
                                Content="{icons:Icon Monitor}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [StudyModeFullscreenTooltip], Source={StaticResource Loc}}"
                                Click="FullscreenButton_Click"/>
                        <Button x:Name="TagsPanelToggleButton"
                                Content="{icons:Icon Tag}"
                                Style="{StaticResource EditorToolIconButtonStyle}"
                                ToolTip="{Binding [Tags], Source={StaticResource Loc}}"
                                Click="TagsPanelToggleButton_Click"/>

                        <Border Width="1"
                                Height="22"
                                Margin="2,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"
                                Visibility="{Binding Visibility, ElementName=LinkedNoteSlot}"/>

                        <Grid x:Name="LinkedNoteSlot" Style="{StaticResource QuizLinkedNoteSlotStyle}" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Path=(controls:EditorChromeContext.Controller).NoteLinkOptions, RelativeSource={RelativeSource Self}}"
                                      SelectedItem="{Binding Path=(controls:EditorChromeContext.Controller).SelectedLinkedNote, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                      DisplayMemberPath="Title"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource LinkedNoteComboBoxStyle}"
                                      Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"
                                      SelectedValuePath="Id"
                                      ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
                            <Button x:Name="LinkedNoteButton"
                                    Content="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonText, RelativeSource={RelativeSource Self}}"
                                    Style="{StaticResource LinkedNoteButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="LinkedNoteButton_Click"
                                    ToolTip="{Binding Path=(controls:EditorChromeContext.Controller).LinkedNoteButtonToolTip, RelativeSource={RelativeSource Self}}"
                                    TextOptions.TextFormattingMode="Ideal"/>
                        </Grid>
                        <motion:LayoutRevealHost HorizontalAlignment="Right" VerticalAlignment="Center">
                        <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Tinted" x:Name="AiGeneratedInfoBadge"
                                Width="30"
                                Height="30"
                                Margin="4,0,0,0"
                                CornerRadius="15"
                                Background="{DynamicResource IconButtonBackground}"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="180"
                                Visibility="Collapsed">
                            <icons:AppIcon Kind="AiGenerated" Width="14" Height="14" Foreground="{DynamicResource TextColorSecondary}" VerticalAlignment="Center"/>
                        </controls:SurfaceMaterialBorder>
                        </motion:LayoutRevealHost>

                        <Border Width="1"
                                Height="22"
                                Margin="8,0,8,0"
                                Background="{DynamicResource SidebarSeparator}"/>

                        <Button Content="{icons:Icon Save}"
                                Style="{StaticResource EditorPrimarySaveButtonStyle}"
                                ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                                Click="SaveButton_Click"/>
                    </controls:EditorCommandPanel>
                </Border>
                <motion:LayoutRevealHost Grid.Row="1" Grid.ColumnSpan="2">
                <controls:AiReviewNotice x:Name="AiReviewNotice"
                                         Margin="0,10,0,0"
                                         AllowDismiss="True"
                                         Dismissed="AiReviewNotice_Dismissed"
                                         Visibility="Collapsed"/>
                </motion:LayoutRevealHost>
            </Grid>
        </Border>

        <motion:LayoutRevealHost Grid.Row="1">
        <Border x:Name="TagsPanel"
                Margin="24,4,24,0"
                Style="{StaticResource ChromeInsetFieldBorderStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Field.InlineLabelMargin}"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>
        </motion:LayoutRevealHost>

        <Border x:Name="QuizSummaryPanel" Grid.Row="2"
                Margin="24,4,24,0"
                Padding="10,0"
                Style="{StaticResource ChromePanelBorderStyle}">
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionCountTextBlock"
                               FontSize="{StaticResource Type.Meta}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock x:Name="AnsweredCountTextBlock"
                               Margin="16,0,0,0"
                               FontSize="{StaticResource Type.Meta}"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <motion:LayoutRevealHost Grid.Column="1" VerticalAlignment="Center">
                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Neutral"
                        x:Name="ScoreBadge"
                        Padding="10,5"
                        CornerRadius="{StaticResource Radius.Control}"
                        Background="{DynamicResource InputSurfaceInset}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreTextBlock"
                               FontSize="{StaticResource Type.Meta}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                </controls:SurfaceMaterialBorder>
                </motion:LayoutRevealHost>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="24,10,24,10">
        <motion:LayoutRevealHost Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16">
            <controls:CollectionSelectionDock x:Name="BulkSelectionBar" ScrollTarget="{Binding ElementName=QuestionsItemsControl}" Visibility="Collapsed"/>
        </motion:LayoutRevealHost>
        <ItemsControl x:Name="QuestionsItemsControl" behaviors:ItemReorderBehavior.Kind="QuizQuestions" controls:CollectionSelectionDock.Clearance="{Binding ScrollClearance, ElementName=BulkSelectionBar}"
                          Style="{StaticResource QuizQuestionsItemsControlStyle}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                        <Grid.Margin>
                            <MultiBinding Converter="{StaticResource QuestionTailMargin}">
                                <Binding Path="Number"/>
                                <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                <Binding Path="(controls:CollectionSelectionDock.Clearance)" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </Grid.Margin>
                        <controls:CollectionSelectionFrame FaceName="QuizQuestionFace" IsHoverTintEnabled="False" SelectionInset="0,16,16,0" ItemId="{Binding Id}" SelectionLabel="{Binding Question}"
                            Selection="{Binding Path=(controls:EditorChromeContext.Controller).BulkSelection, RelativeSource={RelativeSource Self}}">
                        <controls:CollectionSelectionFrame.ContextMenu>
                            <ContextMenu behaviors:ItemReorderBehavior.MenuActions="True"><MenuItem Header="{Binding [MassSelectModeTitle], Source={StaticResource Loc}}" Click="SelectQuestionMenuItem_Click"/></ContextMenu>
                        </controls:CollectionSelectionFrame.ContextMenu>
                        <controls:DashboardTileHost RendererKey="QuizQuestion">
                        <Grid ClipToBounds="False">
                            <controls:SurfaceMaterialBorder x:Name="QuizQuestionFace" controls:SurfaceMaterial.Kind="Raised" Padding="16"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Ideal"
                                    TextOptions.TextRenderingMode="ClearType">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="behaviors:SelectionRimBehavior.IsSelected" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:ItemReorderControls Margin="0,0,6,0" Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelecting, RelativeSource={RelativeSource AncestorType=controls:CollectionSelectionFrame}}" Value="True"><Setter Property="Margin" Value="0,0,36,0"/></DataTrigger>
                                        </Style.Triggers></Style></StackPanel.Style>
                                        <ComboBox behaviors:DropdownChoiceWidthBehavior.IsEnabled="True" Style="{StaticResource QuizEditorComboBoxStyle}"
                                                  MinWidth="150"
                                                  Height="32" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Loaded="QuizTypeComboBox_Loaded"
                                                  SelectionChanged="QuizTypeComboBox_SelectionChanged"
                                                  Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                            <ComboBoxItem Tag="SingleChoice"
                                                          Content="{Binding [QuizTypeSingleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Tag="MultipleChoice"
                                                          Content="{Binding [QuizTypeMultipleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Tag="TrueFalse"
                                                          Content="{Binding [QuizTypeTrueFalse], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Tag="PlainText"
                                                          Content="{Binding [QuizTypePlainText], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                        <Button x:Name="DeleteQuestionButton" Content="{icons:Icon Delete}"
                                                Width="32"
                                                Height="32"
                                                Margin="0" VerticalAlignment="Center"
                                                Style="{StaticResource EditorDangerToolButtonStyle}"
                                                ToolTip="{Binding [DeleteQuestion], Source={StaticResource Loc}}"
                                                Click="DeleteQuestionButton_Click"
                                                Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                                        <Border Padding="8,4"
                                                CornerRadius="7"
                                                Background="{Binding ResultBackground}"
                                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ResultText}"
                                                       FontSize="{StaticResource Type.Meta}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Question}"
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource Type.BlockTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}"/>

                                <Border Grid.Row="1"
                                        Style="{StaticResource ChromeMultilineFieldBorderStyle}"
                                        MinHeight="42"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontSize="{StaticResource Type.BlockTitle}"
                                             FontWeight="SemiBold"
                                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                                </Border>

                                <Grid Grid.Row="2">

                                    <ItemsControl ItemsSource="{Binding Options}" behaviors:ItemReorderBehavior.Kind="QuizOptions"
                  Visibility="{Binding IsPlainText, Converter={StaticResource InverseBoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource QuizOptionButtonStyle}"
                        Margin="0,0,0,8"
                        Click="OptionButton_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Style="{StaticResource QuizOptionLetterChipStyle}"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center">
                                                            <Grid HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MarkerLetter}"
                                                                           FontSize="{StaticResource Type.Caption}"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                           Visibility="{Binding ShowMarkerLetter, Converter={StaticResource BoolToVis}}"/>
                                                                <icons:AppIcon Kind="Checkmark"
                                                                               Width="14"
                                                                               Height="14"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                               Visibility="{Binding ShowSubmitCorrectIcon, Converter={StaticResource BoolToVis}}"/>
                                                                <icons:AppIcon Kind="Close"
                                                                               Width="12"
                                                                               Height="12"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                               Visibility="{Binding ShowSubmitIncorrectIcon, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <CheckBox Grid.Column="1"
                                                                  IsChecked="{Binding IsCorrect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="{Binding [CorrectAnswer], Source={StaticResource Loc}}"
                                                                  Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Text}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="{StaticResource Type.Control.Form}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource ChromeInsetFieldBorderStyle}"
                                                                Background="{DynamicResource InputSurface}"
                                                                MinHeight="{StaticResource Control.Height.Form}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextWrapping="Wrap"
                                                                     FontSize="{StaticResource Type.Control.Form}"
                                                                     Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    Margin="6,0,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Parent.CanReorderOptions}" Value="True"/>
                                                                                <Condition Binding="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <controls:ItemReorderControls Margin="0,0,4,0"/>
                                                            <Button Content="{icons:Icon Kind=Close, Size=12}"
                                                                    Style="{StaticResource QuizOptionRemoveButtonStyle}"
                                                                    ToolTip="{Binding [RemoveOption], Source={StaticResource Loc}}"
                                                                    Click="RemoveOptionButton_Click"
                                                                    Visibility="{Binding Parent.CanRemoveOption, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Plain text answer section -->
                                    <Border Visibility="{Binding IsPlainText, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding [QuizPlainTextEditAnswerLabel], Source={StaticResource Loc}}"
                                                           FontSize="{StaticResource Type.Control.Form}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding [QuizPlainTextYourAnswerLabel], Source={StaticResource Loc}}"
                                                           FontSize="{StaticResource Type.Control.Form}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>

                                            <Border Style="{StaticResource ChromeMultilineFieldBorderStyle}"
                                                    MinHeight="76"
                                                    MaxHeight="150"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                                <TextBox Text="{Binding PlainTextAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                                         ToolTip="{Binding [QuizPlainTextAnswerHint], Source={StaticResource Loc}}"/>
                                            </Border>

                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBoolToVis}}">
                                                <Border x:Name="PlainTextPracticeField" Style="{StaticResource ChromeMultilineFieldBorderStyle}"
                                                        MinHeight="86"
                                                        MaxHeight="170">
                                                    <TextBox x:Name="PlainTextPracticeTextBox"
                                                             Text="{Binding PlainTextUserAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsSubmitted}"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                                             ToolTip="{Binding [QuizPlainTextPracticeHint], Source={StaticResource Loc}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding [QuizPlainTextPracticePlaceholder], Source={StaticResource Loc}}"
                                                           IsHitTestVisible="False"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           Opacity="0.72"
                                                           TextWrapping="Wrap" FontSize="{Binding FontSize, ElementName=PlainTextPracticeTextBox}" FontFamily="{Binding FontFamily, ElementName=PlainTextPracticeTextBox}">
                                                    <TextBlock.Margin><MultiBinding Converter="{StaticResource FieldContentInset}"><Binding ElementName="PlainTextPracticeField" Path="Padding"/><Binding ElementName="PlainTextPracticeField" Path="BorderThickness"/></MultiBinding></TextBlock.Margin>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, ElementName=PlainTextPracticeTextBox}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PlainTextPracticeTextBox}" Value="False"/>
                                                                        <Condition Binding="{Binding IsSubmitted}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Margin="0,10,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                                    <CheckBox Style="{StaticResource FormCheckBoxStyle}" Content="{Binding [QuizPlainTextMatchCase], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding PlainTextMatchCase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="{StaticResource Type.Control.Form}"
                                                              Foreground="{DynamicResource TextColorSecondary}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,16,0"
                                                              ToolTip="{Binding [QuizPlainTextMatchCaseHint], Source={StaticResource Loc}}"/>
                                                    <CheckBox Style="{StaticResource FormCheckBoxStyle}" Content="{Binding [QuizPlainTextIgnorePunctuation], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding PlainTextIgnorePunctuation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="{StaticResource Type.Control.Form}"
                                                              Foreground="{DynamicResource TextColorSecondary}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="{Binding [QuizPlainTextIgnorePunctuationHint], Source={StaticResource Loc}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CorrectPlainTextAnswerDisplay}"
                                                           Grid.Column="0"
                                                           FontSize="{StaticResource Type.Caption}"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ShowPlainTextCorrectAnswer, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock FontSize="{StaticResource Type.Meta}"
                                                           Grid.Column="1"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding PlainTextPracticeCharCountText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding PlainTextAnswerCharCountText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <controls:SurfaceMaterialBorder controls:SurfaceMaterial.Kind="Raised" Grid.Row="3"
                                        Margin="0,4,8,8"
                                        Padding="10,8"
                                        Background="{DynamicResource InputSurfaceInset}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Visibility="{Binding HasVisibleExplanation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExplanationText}"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource Type.Control.Helper}"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                </controls:SurfaceMaterialBorder>

                                <StackPanel Grid.Row="3"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding Path=(controls:EditorChromeContext.Controller).IsEditMode, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}">
                                    <Button Content="{Binding [AddOption], Source={StaticResource Loc}}"
                                            Style="{StaticResource QuizToolbarButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8"
                                            Click="AddOptionButton_Click"
                                            Visibility="{Binding CanAddOption, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Same label + field rhythm as expected-answer above (no nested panel inset). -->
                                    <TextBlock Text="{Binding [QuizExplanationLabel], Source={StaticResource Loc}}"
                                               FontSize="{StaticResource Type.Control.Form}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                    <Border Style="{StaticResource ChromeMultilineFieldBorderStyle}"
                                            MinHeight="76"
                                            MaxHeight="150"
                                            Margin="0,8,0,0">
                                        <TextBox Text="{Binding Explanation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="{Binding [QuizExplanationHint], Source={StaticResource Loc}}"
                                                 Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </controls:SurfaceMaterialBorder>
                        </Grid>
                        </controls:DashboardTileHost>
                        </controls:CollectionSelectionFrame>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>

        <Border motion:WindowMotion.Role="Footer" Grid.Row="4"
                Margin="24,0,24,12"
                Style="{StaticResource CommandSurfaceBorderStyle}"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Button controls:InteractionSurface.HoverBackground="{DynamicResource AccentSuccessHover}" controls:InteractionSurface.PressedBackground="{DynamicResource AccentSuccessPressed}" controls:SurfaceMaterial.Kind="Filled" controls:SurfaceMaterial.Foreground="{DynamicResource AccentSuccessForeground}" x:Name="StartQuizButton"
                            Content="{Binding [QuizStartButton], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterPrimaryButtonStyle}"
                            Background="{DynamicResource AccentSuccess}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentSuccessForeground}"
                            Click="StartQuizButton_Click"
                            ToolTip="{Binding [QuizStartButtonTooltip], Source={StaticResource Loc}}"/>
                    <Button x:Name="QuizOptionsButton"
                            Content="{Binding [QuizOptionsButton], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="QuizOptionsButton_Click"
                            ToolTip="{Binding [QuizOptionsButtonTooltip], Source={StaticResource Loc}}"/>
                    <Button x:Name="PracticeMissedButton"
                            Content="{Binding [QuizPracticeMissedButton], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="PracticeMissedButton_Click"
                            ToolTip="{Binding [QuizPracticeMissedButtonTooltip], Source={StaticResource Loc}}"
                            Visibility="Collapsed"/>
                    <Button x:Name="CheckAnswersButton"
                            Content="{Binding [QuizCheckAnswers], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterPrimaryButtonStyle}"
                            Click="CheckAnswersButton_Click"/>
                    <Button x:Name="ResetAnswersButton"
                            Content="{Binding [QuizResetAnswers], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="ResetAnswersButton_Click"/>
                    <Button x:Name="AddQuestionButton"
                            Content="{Binding [AddQuestion], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Click="AddQuestionButton_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0,0,0">
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource QuizFooterButtonStyle}"
                            Margin="0,4,0,4"
                            Click="CloseButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

    </Grid>
        </controls:FeatureWindowShell.Body>
    </controls:FeatureWindowShell>
</Window>
