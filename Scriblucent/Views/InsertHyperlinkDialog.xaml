<Window x:Class="Scriblucent.Views.InsertHyperlinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        xmlns:behaviors="clr-namespace:Scriblucent.Behaviors"
        Title="{Binding [InsertLinkDialogTitle], Source={StaticResource Loc}}"
        Width="440"
        Height="540"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">
    <controls:OverlayDialogShell MaxCardWidth="400"
                                  CardPadding="20">
        <controls:OverlayDialogShell.Header>
            <TextBlock Text="{Binding [InsertLinkDialogTitle], Source={StaticResource Loc}}"
                       FontSize="{StaticResource Type.DialogTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,14"/>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="WebModeRadioButton"
                                 Style="{StaticResource SortOptionRadioButtonStyle}"
                                 GroupName="InsertLinkMode"
                                 Content="{Binding [InsertLinkModeWeb], Source={StaticResource Loc}}"
                                 IsChecked="True"
                                 Margin="0,0,18,0"
                                 Checked="ModeRadioButton_Checked"/>
                    <RadioButton x:Name="NoteModeRadioButton"
                                 Style="{StaticResource SortOptionRadioButtonStyle}"
                                 GroupName="InsertLinkMode"
                                 Content="{Binding [InsertLinkModeNote], Source={StaticResource Loc}}"
                                 Checked="ModeRadioButton_Checked"/>
                </StackPanel>

                <TextBlock Text="{Binding [InsertLinkDisplayTextLabel], Source={StaticResource Loc}}"
                           Style="{StaticResource FormOptionLabelStyle}"
                           Margin="{StaticResource Field.LabelMargin}"/>
                <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"
                        Margin="{StaticResource Field.RowMargin}">
                    <TextBox x:Name="DisplayTextBox"
                             Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                </Border>

                <Grid x:Name="WebModePanel">
                    <StackPanel>
                        <TextBlock Text="{Binding [InsertLinkUrlLabel], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"
                                   Margin="{StaticResource Field.LabelMargin}"/>
                        <Border Style="{StaticResource ChromeInsetFieldBorderStyle}">
                            <TextBox x:Name="UrlTextBox"
                                     Style="{StaticResource EmbeddedFieldTextBoxStyle}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="NoteModePanel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{Binding [InsertLinkNoteSearchPlaceholder], Source={StaticResource Loc}}"
                                   Style="{StaticResource FormOptionLabelStyle}"
                                   Margin="{StaticResource Field.LabelMargin}"/>
                        <Border Style="{StaticResource ChromeInsetFieldBorderStyle}"
                                Margin="0,0,0,10">
                            <TextBox x:Name="NoteSearchTextBox"
                                     Style="{StaticResource EmbeddedFieldTextBoxStyle}"
                                     TextChanged="NoteSearchTextBox_TextChanged"/>
                        </Border>
                        <Border Style="{StaticResource ContentInsetBorderStyle}"

                                Padding="4"
                                Height="150">
                            <Grid>
                            <ListBox x:Name="NoteResultsListBox"
                                     ItemContainerStyle="{StaticResource StateListBoxItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     DisplayMemberPath="Title"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     SelectionChanged="NoteResultsListBox_SelectionChanged">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <ScrollViewer Focusable="False"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Background="Transparent"
                                                      behaviors:MiddleClickScrollBehavior.IsEnabled="True"
                                                      behaviors:RoundedClipBehavior.IsEnabled="True"
                                                      behaviors:RoundedClipBehavior.CornerRadius="{StaticResource Radius.Control}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                            <StackPanel x:Name="NoteNoResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                <icons:AppIcon Kind="Search" Width="22" Height="22" Foreground="{DynamicResource TextColorSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [InsertLinkNoResults], Source={StaticResource Loc}}" FontSize="{StaticResource Type.Control.Toolbar}" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding [InsertLinkNoResultsHint], Source={StaticResource Loc}}" Style="{StaticResource FormHelperTextStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <controls:InlineValidationPresenter x:Name="ValidationText"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="96"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="{Binding [InsertLink], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="96"
                        Padding="16,8"
                        Click="Insert_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
