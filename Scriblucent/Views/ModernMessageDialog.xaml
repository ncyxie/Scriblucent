<Window x:Class="Scriblucent.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:icons="clr-namespace:Scriblucent.Icons"
        Title="{Binding TitleText}"
        Height="340"
        Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <controls:OverlayDialogShell
                                 MaxCardWidth="600"
                                 CardPadding="30,28,30,24">
        <controls:OverlayDialogShell.Header>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level 5 status glyph: fill only (role I soft); IconBorder kept for binding if needed later. -->
                <controls:SurfaceMaterialBorder Grid.Column="0"
                        Width="48"
                        Height="48"
                        controls:SurfaceMaterial.Kind="Tinted" Background="{Binding IconBackground}"
                        BorderThickness="0"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <icons:AppIcon Kind="{Binding IconKind}"
                                   Width="22"
                                   Height="22"
                                   Foreground="{Binding IconForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </controls:SurfaceMaterialBorder>

                <TextBlock Grid.Column="1"
                           Text="{Binding TitleText}"
                           Margin="16,3,0,0"
                           FontSize="{StaticResource Type.DialogTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           TextWrapping="Wrap"
                           LineHeight="26"/>
            </Grid>
        </controls:OverlayDialogShell.Header>

        <controls:OverlayDialogShell.Body>
            <ScrollViewer MaxHeight="260"
                          Style="{StaticResource RoundedCompactScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="64,0,0,26">
                <TextBlock Text="{Binding MessageText}"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextColor}"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           LineHeight="20"/>
            </ScrollViewer>
        </controls:OverlayDialogShell.Body>

        <controls:OverlayDialogShell.Footer>
            <StackPanel x:Name="ButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="{Binding CancelText}"
                        Visibility="{Binding CancelVisibility}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="16,10"
                        MinWidth="96"
                        Click="CancelButton_Click"/>

                <Button x:Name="PrimaryButton"
                        Content="{Binding PrimaryText}"
                        Visibility="{Binding PrimaryVisibility}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="16,10"
                        MinWidth="96"
                        Margin="12,0,0,0"
                        Click="PrimaryButton_Click"/>

                <Button x:Name="NoButton"
                        Content="{Binding NoText}"
                        Visibility="{Binding NoVisibility}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="16,10"
                        MinWidth="96"
                        Margin="12,0,0,0"
                        Click="NoButton_Click"/>
            </StackPanel>
        </controls:OverlayDialogShell.Footer>
    </controls:OverlayDialogShell>
</Window>
