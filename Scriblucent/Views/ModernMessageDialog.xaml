<Window x:Class="Scriblucent.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Height="340"
        Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid x:Name="OverlayRoot">
        <Viewbox x:Name="ScrimViewbox"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="Linear">
            <Grid x:Name="ScrimHost">
                <Image x:Name="BackdropSnapshot"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
                <Rectangle x:Name="OverlayDim"
                           Fill="#66000000"/>
            </Grid>
        </Viewbox>
        <Border x:Name="PanelMotionHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border x:Name="DialogCard"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="30,28,30,24"
                    MaxWidth="540">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="36" ShadowDepth="0"/>
                </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="{Binding IconBackground}"
                            BorderBrush="{Binding IconBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding IconForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleText}"
                               Margin="16,3,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="26"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="64,0,0,26">
                    <TextBlock Text="{Binding MessageText}"
                               FontSize="14"
                               Foreground="{DynamicResource TextColor}"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </ScrollViewer>

                <StackPanel x:Name="ButtonPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="{Binding CancelText}"
                            Visibility="{Binding CancelVisibility}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="20,10"
                            MinWidth="110"
                            Click="CancelButton_Click"/>

                    <Button x:Name="NoButton"
                            Content="{Binding NoText}"
                            Visibility="{Binding NoVisibility}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="20,10"
                            MinWidth="110"
                            Margin="12,0,0,0"
                            Click="NoButton_Click"/>

                    <Button x:Name="PrimaryButton"
                            Content="{Binding PrimaryText}"
                            Visibility="{Binding PrimaryVisibility}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Padding="20,10"
                            MinWidth="110"
                            Margin="12,0,0,0"
                            Click="PrimaryButton_Click"/>
                </StackPanel>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
