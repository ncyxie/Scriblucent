<Window x:Class="Scriblucent.Views.QuizLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scriblucent.Controls"
        xmlns:vm="clr-namespace:Scriblucent.ViewModels"
        xmlns:views="clr-namespace:Scriblucent.Views"
        Title="Combine Quizzes"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource FeatureFrameBackground}">
    <Window.Resources>
        <Style x:Key="LibraryCardStyle" TargetType="Border" BasedOn="{StaticResource FeatureCombinePanelStyle}"/>
        <Style x:Key="LibraryTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FeatureCombineTextBoxStyle}"/>
        <Style x:Key="LibraryOptionCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource FeatureCombineOptionCheckBoxStyle}"/>
        <Style x:Key="LibraryQuizItemBorderStyle" TargetType="Border" BasedOn="{StaticResource FeatureCombineItemBorderStyle}"/>
    </Window.Resources>

    <Grid x:Name="ContentRoot">
    <controls:FeatureWindowShell>
        <controls:FeatureWindowShell.Header>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="14,18,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Combine quizzes"
                                   FontSize="{StaticResource Type.DialogTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Text="Select existing quizzes and merge their questions into a new quiz."
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextColorSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="Create combined quiz"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                MinWidth="150"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding HasSelectedQuizzes}"
                                Click="CreateCombinedQuizButton_Click"/>
                        <Button Content="Close"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                MinWidth="90"
                                Padding="16,8"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Header>

        <controls:FeatureWindowShell.Body>
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource LibraryCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="All quizzes"
                                       FontSize="{StaticResource Type.SectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FilteredCountText}"
                                       FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,12">
                            <TextBox x:Name="QuizSearchTextBox"
                                     Text="{Binding QuizSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Style="{StaticResource LibraryTextBoxStyle}"
                                     ToolTip="Search quiz titles, tags, questions, explanations, and answers"/>
                            <TextBlock Text="Search quizzes, tags, questions..."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=QuizSearchTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuizSearchTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Quizzes}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:QuizLibraryItemViewModel}">
                                        <Grid Margin="0,0,0,8"
                                              UseLayoutRounding="True"
                                              SnapsToDevicePixels="True"
                                              ClipToBounds="False"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <controls:CardShadowLayer/>
                                            <Border Style="{StaticResource LibraryQuizItemBorderStyle}"
                                                    MouseLeftButtonUp="QuizItem_MouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              Click="SelectionCheckBox_Click"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{StaticResource Type.Body}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextColor}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding QuestionCountText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                                        <TextBlock Text="{Binding TagsDisplay}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource LibraryCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Filter by tag"
                                       FontSize="{StaticResource Type.SectionTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="180">
                                <ItemsControl ItemsSource="{Binding CategoryFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Tag}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,2"
                                                      Foreground="{DynamicResource TextColor}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Separator Margin="0,16,0,14"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Selected quizzes"
                                           FontSize="{StaticResource Type.SectionTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCountText}"
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextColorSecondary}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Quizzes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type views:QuizLibraryItemViewModel}">
                                            <Border Background="{DynamicResource HoverBackground}"
                                                    BorderThickness="0"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    Padding="10"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{StaticResource Type.Meta}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextColor}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding QuestionCountText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"
                                                              Margin="10,0,0,0"
                                                              Click="SelectionCheckBox_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Combined quiz title"
                                       FontSize="{StaticResource Type.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"
                                       Margin="0,10,0,6"/>
                            <TextBox Text="{Binding CombinedQuizTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LibraryTextBoxStyle}"
                                     Margin="0,0,0,10"/>
                            <CheckBox Content="Shuffle questions"
                                      IsChecked="{Binding ShuffleCombinedQuestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource LibraryOptionCheckBoxStyle}"/>
                            <CheckBox Content="Skip duplicate questions"
                                      IsChecked="{Binding SkipDuplicateQuestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource LibraryOptionCheckBoxStyle}"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedQuestionCountText}"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Margin="0,10,0,10"/>
                            <Button Content="Clear selection"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    MinHeight="34"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding HasSelectedQuizzes}"
                                    Click="ClearSelectionButton_Click"/>
                            <Button Content="Create combined quiz"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    MinHeight="36"
                                    IsEnabled="{Binding HasSelectedQuizzes}"
                                    Click="CreateCombinedQuizButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </controls:FeatureWindowShell.Body>

        <controls:FeatureWindowShell.Footer>
            <Border Style="{StaticResource ChromePanelBorderStyle}"
                    CornerRadius="0"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextColorSecondary}"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Clear filter"
                                Style="{StaticResource FeatureToolbarSecondaryButtonStyle}"
                                Click="ClearFiltersButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </controls:FeatureWindowShell.Footer>
    </controls:FeatureWindowShell>
    </Grid>
</Window>
