<Window x:Class="Scriblucent.Views.QuizLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scriblucent.ViewModels"
        xmlns:views="clr-namespace:Scriblucent.Views"
        Title="Combine Quizzes"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="LibraryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="LibraryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LibraryTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryOptionCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LibraryQuizItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="14,14,14,10"
                Padding="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Combine quizzes"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock Text="Select existing quizzes and merge their questions into a new quiz."
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="Create combined quiz"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            MinWidth="150"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding HasSelectedQuizzes}"
                            Click="CreateCombinedQuizButton_Click"/>
                    <Button Content="Close"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            MinWidth="90"
                            Padding="16,8"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="All quizzes"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FilteredCountText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextColorSecondary}"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,12">
                        <TextBox x:Name="QuizSearchTextBox"
                                 Text="{Binding QuizSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchTextBox_TextChanged"
                                 Style="{StaticResource LibraryTextBoxStyle}"
                                 ToolTip="Search quiz titles, tags, questions, explanations, and answers"/>
                        <TextBlock Text="Search quizzes, tags, questions..."
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=QuizSearchTextBox}" Value=""/>
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuizSearchTextBox}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Quizzes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:QuizLibraryItemViewModel}">
                                    <Border Style="{StaticResource LibraryQuizItemBorderStyle}"
                                            MouseLeftButtonUp="QuizItem_MouseLeftButtonUp"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Click="SelectionCheckBox_Click"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColor}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding QuestionCountText}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextColorSecondary}"/>
                                                <TextBlock Text="{Binding TagsDisplay}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Filter by tag"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,0,0,12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      MaxHeight="180">
                            <ItemsControl ItemsSource="{Binding CategoryFilters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Tag}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,2"
                                                  Foreground="{DynamicResource TextColor}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Margin="0,16,0,14"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Selected quizzes"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedCountText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextColorSecondary}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Quizzes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:QuizLibraryItemViewModel}">
                                        <Border Background="{DynamicResource HoverBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextColor}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding QuestionCountText}"
                                                               Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,0,0"
                                                          Click="SelectionCheckBox_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Combined quiz title"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   Margin="0,10,0,6"/>
                        <TextBox Text="{Binding CombinedQuizTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LibraryTextBoxStyle}"
                                 Margin="0,0,0,10"/>
                        <CheckBox Content="Shuffle questions"
                                  IsChecked="{Binding ShuffleCombinedQuestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource LibraryOptionCheckBoxStyle}"/>
                        <CheckBox Content="Skip duplicate questions"
                                  IsChecked="{Binding SkipDuplicateQuestions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource LibraryOptionCheckBoxStyle}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding SelectedQuestionCountText}"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   Margin="0,10,0,10"/>
                        <Button Content="Clear selection"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                MinHeight="34"
                                Margin="0,0,0,8"
                                IsEnabled="{Binding HasSelectedQuizzes}"
                                Click="ClearSelectionButton_Click"/>
                        <Button Content="Create combined quiz"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                MinHeight="36"
                                IsEnabled="{Binding HasSelectedQuizzes}"
                                Click="CreateCombinedQuizButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="14,0,14,14"
                Padding="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextColorSecondary}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Clear filter"
                            Style="{StaticResource LibraryToolbarButtonStyle}"
                            Click="ClearFiltersButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
