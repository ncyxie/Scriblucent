<Window x:Class="NoteCards.Views.FlashcardStudyHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flashcard History"
        Height="600"
        Width="820"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Flashcard history"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock Text="{Binding SummaryText}"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <Border Padding="10,6" Margin="10,0,0,0" CornerRadius="8" Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Known" FontSize="10" Foreground="{DynamicResource TextColorSecondary}"/>
                            <TextBlock Text="{Binding KnownText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="10,6" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Unknown" FontSize="10" Foreground="{DynamicResource TextColorSecondary}"/>
                            <TextBlock Text="{Binding UnknownText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="10,6" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Studied" FontSize="10" Foreground="{DynamicResource TextColorSecondary}"/>
                            <TextBlock Text="{Binding StudiedText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20,16,20,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="16,14"
                                    CornerRadius="10"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Margin="14,0,0,0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextColor}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No flashcard study progress yet"
                       FontSize="16"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextColorSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>

        <Border Grid.Row="2"
                Padding="20,12"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ClearButtonText}"
                        Padding="14,8"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding HasItems}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Click="ClearAllButton_Click"/>
                <Button Content="Close"
                        Padding="14,8"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
