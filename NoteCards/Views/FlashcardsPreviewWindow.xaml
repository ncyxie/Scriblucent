<Window x:Class="NoteCards.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:NoteCards.Behaviors"
        xmlns:controls="clr-namespace:NoteCards.Controls"
        x:Name="FlashcardsWindow"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="730"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="FlashcardsPreviewWindow_Closing">
    <Window.Resources>
        <ResourceDictionary>
        <ControlTemplate x:Key="SetSelectorToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="11"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SetSelectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource SetSelectorToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=''}"
                                       Margin="10,0,24,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetSelectorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SetSelectorActionComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource SetSelectorComboBoxItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="CreateSetButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FlashcardToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="FlashcardToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="FlashcardLinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardToolbarButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="LinkedNoteBorder"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkedNoteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashcardLinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SetSelectorComboBoxStyle}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource SetSelectorToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding ElementName=FlashcardsWindow, Path=LinkedNoteButtonText}"
                                       Margin="10,0,24,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashcardEditorIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashcardSearchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}"/>

        <DropShadowEffect x:Key="FlashcardStudyCardShadow"
                          Color="#000000"
                          Opacity="0.08"
                          BlurRadius="10"
                          ShadowDepth="1"
                          Direction="270"
                          RenderingBias="Performance"/>

        <DropShadowEffect x:Key="FlashcardStudyCardHoverShadow"
                          Color="#000000"
                          Opacity="0.16"
                          BlurRadius="15"
                          ShadowDepth="2"
                          Direction="270"
                          RenderingBias="Performance"/>

        <Style x:Key="FlashcardStudyCardStyle" TargetType="Border">
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="224"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource FlashcardStudyCardShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardHoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardHoverBorder}"/>
                    <Setter Property="Effect" Value="{StaticResource FlashcardStudyCardHoverShadow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardGridCardStyle" TargetType="Border">
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="224"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource FlashcardCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="1" Direction="270" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardHoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardHoverBorder}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="15" ShadowDepth="2" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardSelectedBorder}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="18" ShadowDepth="2" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource FlashcardCardSelectedHoverBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCardSelectedBorder}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlashcardMetaChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlashcardSideChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardSideChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardSideChipBorder}"/>
        </Style>

        <Style x:Key="FlashcardCategoryChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardCategoryChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardCategoryChipBorder}"/>
        </Style>

        <Style x:Key="FlashcardKnownChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardKnownChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardKnownChipBorder}"/>
        </Style>

        <Style x:Key="FlashcardUnknownChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardUnknownChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardUnknownChipBorder}"/>
        </Style>

        <Style x:Key="FlashcardNewChipStyle" TargetType="Border" BasedOn="{StaticResource FlashcardMetaChipStyle}">
            <Setter Property="Background" Value="{DynamicResource FlashcardNewChipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlashcardNewChipBorder}"/>
        </Style>

        <Style x:Key="FlashcardChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SetOptionActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <ContextMenu x:Key="FlashcardCardContextMenu"
                     x:Shared="False">
            <ContextMenu.DataContext>
                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}"/>
            </ContextMenu.DataContext>
            <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                      Click="MoveToSetMenuItem_Click"/>
            <MenuItem Header="{Binding [AddFlashcardToSet], Source={StaticResource Loc}}"
                      Click="AddFlashcardToSetMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                      Click="EditFlashcardMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                      Click="DeleteFlashcardMenuItem_Click"/>
        </ContextMenu>

        <DataTemplate x:Key="FlashcardStatusChipsTemplate">
            <Grid>
                <Border Style="{StaticResource FlashcardKnownChipStyle}"
                        Visibility="{Binding IsKnown, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Known], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardKnownChipForeground}"/>
                </Border>
                <Border Style="{StaticResource FlashcardUnknownChipStyle}"
                        Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [Unknown], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardUnknownChipForeground}"/>
                </Border>
                <Border Style="{StaticResource FlashcardNewChipStyle}"
                        Visibility="{Binding IsUnreviewed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding [FlashcardStatusNew], Source={StaticResource Loc}}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardNewChipForeground}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridStatusRowTemplate">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                        MaxWidth="176" Margin="0,0,8,0"
                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Category}"
                               Style="{StaticResource FlashcardChipTextStyle}"
                               Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                </Border>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridQuestionFaceTemplate">
            <Border Style="{StaticResource FlashcardGridCardStyle}"
                    ContextMenu="{StaticResource FlashcardCardContextMenu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource FlashcardSideChipStyle}"
                                HorizontalAlignment="Left"
                                MaxWidth="132">
                            <TextBlock Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                                       Style="{StaticResource FlashcardChipTextStyle}"
                                       Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✎"
                                    Width="26" Height="24" Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [Edit], Source={StaticResource Loc}}"
                                    Click="EditFlashcardButton_Click"/>
                            <Button Content="⇄"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveFlashcardButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <TextBlock Text="{Binding Question}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   LineHeight="23"
                                   MaxHeight="116"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Border>
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource FlashcardGridStatusRowTemplate}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardGridAnswerFaceTemplate">
            <Border Style="{StaticResource FlashcardGridCardStyle}"
                    ContextMenu="{StaticResource FlashcardCardContextMenu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Style="{StaticResource FlashcardSideChipStyle}"
                                HorizontalAlignment="Left"
                                MaxWidth="132">
                            <TextBlock Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                                       Style="{StaticResource FlashcardChipTextStyle}"
                                       Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✎"
                                    Width="26" Height="24" Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [Edit], Source={StaticResource Loc}}"
                                    Click="EditFlashcardButton_Click"/>
                            <Button Content="⇄"
                                    Width="26" Height="24" Margin="6,0,0,0" Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveFlashcardButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <TextBlock Text="{Binding Answer}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   LineHeight="23"
                                   MaxHeight="116"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Border>
                    <ContentControl Grid.Row="2"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource FlashcardGridStatusRowTemplate}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyQuestionFaceTemplate">
            <Border Style="{StaticResource FlashcardStudyCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                            <Border Style="{StaticResource FlashcardSideChipStyle}"
                                    MaxWidth="132">
                                <TextBlock Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                            </Border>
                            <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                                    Margin="10,0,0,0"
                                    MaxWidth="210"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="⇄"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveStudyModeFlashcardButton_Click"/>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <TextBlock Text="{Binding Question}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   LineHeight="23"
                                   MaxHeight="116"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FlashcardStudyAnswerFaceTemplate">
            <Border Style="{StaticResource FlashcardStudyCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                            <Border Style="{StaticResource FlashcardSideChipStyle}"
                                    MaxWidth="132">
                                <TextBlock Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardSideChipForeground}"/>
                            </Border>
                            <Border Style="{StaticResource FlashcardCategoryChipStyle}"
                                    Margin="10,0,0,0"
                                    MaxWidth="210"
                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Category}"
                                           Style="{StaticResource FlashcardChipTextStyle}"
                                           Foreground="{DynamicResource FlashcardCategoryChipForeground}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="⇄"
                                    Width="26"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                    ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                    Click="MoveStudyModeFlashcardButton_Click"/>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource FlashcardStatusChipsTemplate}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,12" Padding="0,2">
                        <TextBlock Text="{Binding Answer}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   LineHeight="23"
                                   MaxHeight="116"
                                   Foreground="{DynamicResource TextColor}"/>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="FlashcardsEditorHeaderBorder"
                Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [FlashcardsEditorTitle], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ElementName=FlashcardsWindow, Path=NoteLinkOptions}"
                              SelectedItem="{Binding ElementName=FlashcardsWindow, Path=SelectedLinkedNote, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              Style="{StaticResource FlashcardLinkedNoteComboBoxStyle}"
                              SelectedValuePath="Id"
                              ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
                    <Button x:Name="LinkedNoteButton"
                            Content="{Binding ElementName=FlashcardsWindow, Path=LinkedNoteButtonText}"
                            Style="{StaticResource FlashcardLinkedNoteButtonStyle}"
                            Click="LinkedNoteButton_Click"
                            ToolTip="{Binding ElementName=FlashcardsWindow, Path=LinkedNoteButtonToolTip}"
                            TextOptions.TextFormattingMode="Display"/>
                    <Border x:Name="AiGeneratedInfoBadge"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{DynamicResource IconButtonBackground}"
                            BorderBrush="{DynamicResource IconButtonBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="180"
                            Visibility="Collapsed">
                        <TextBlock Text="🤖"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FlashcardsTagsBorder"
                Grid.Row="1"
                Margin="20,10,20,0"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <Border x:Name="FlashcardsFiltersBorder"
                Grid.Row="2"
                Margin="20,10,20,0"
                Padding="10,8,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <Button x:Name="FiltersButton"
                            Content="{Binding [FlashcardFilters], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarButtonStyle}"
                            Margin="0,0,10,8"
                            Click="FiltersButton_Click"/>
                    <Popup x:Name="FiltersPopup"
                           PlacementTarget="{Binding ElementName=FiltersButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="None">
                        <Border Margin="0,6,0,0"
                                Padding="10"
                                MinWidth="280"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <ComboBox x:Name="StatusFilterComboBox"
                                          Width="260"
                                          Style="{StaticResource SetSelectorComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,8"
                                          SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
                                <ComboBox x:Name="CategoryFilterComboBox"
                                          Width="260"
                                          Style="{StaticResource SetSelectorComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,8"
                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>
                                <Border Height="32"
                                        Padding="10,0"
                                        Margin="0,0,0,8"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="⌕"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <TextBox x:Name="FlashcardSearchTextBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextColor}"
                                                 CaretBrush="{DynamicResource TextColor}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="FlashcardSearchTextBox_TextChanged"
                                                 ToolTip="{Binding [FlashcardSearchHint], Source={StaticResource Loc}}"/>
                                    </DockPanel>
                                </Border>
                                <Button Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
                                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0"
                                        Click="ClearFiltersButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <WrapPanel Grid.Column="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <ComboBox x:Name="SetSelectorComboBox"
                              Width="128"
                              Style="{StaticResource SetSelectorComboBoxStyle}"
                              ItemContainerStyle="{StaticResource SetSelectorActionComboBoxItemStyle}"
                              Margin="0,0,8,8"
                              SelectionChanged="SetSelectorComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="✎"
                                            Style="{StaticResource SetOptionActionButtonStyle}"
                                            ToolTip="{Binding [RenameFlashcardSet], Source={StaticResource Loc}}"
                                            Click="RenameSetInListButton_Click"/>
                                    <Button Grid.Column="2"
                                            Content="×"
                                            Style="{StaticResource SetOptionActionButtonStyle}"
                                            ToolTip="{Binding [DeleteFlashcardSet], Source={StaticResource Loc}}"
                                            Click="DeleteSetInListButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{Binding [CreateFlashcardSet], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarButtonStyle}"
                            Click="CreateSetButton_Click"/>
                    <Button Content="History"
                            Style="{StaticResource FlashcardToolbarButtonStyle}"
                            Click="FlashcardHistoryButton_Click"/>
                    <Button Content="{Binding [AddFlashcard], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarPrimaryButtonStyle}"
                            Click="AddFlashcardButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="FlashcardsContentHost"
              Grid.Row="4"
              Margin="20,0,20,0">
            <Border x:Name="FlashcardsGridViewBorder"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14">
                    <ItemsControl x:Name="FlashcardsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:FlashcardFlipHost IsFlipped="{Binding IsFlipped, Mode=TwoWay}"
                                                            Margin="0,0,16,16"
                                                            MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp">
                                    <controls:FlashcardFlipHost.FrontContent>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource FlashcardGridQuestionFaceTemplate}"/>
                                    </controls:FlashcardFlipHost.FrontContent>
                                    <controls:FlashcardFlipHost.BackContent>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource FlashcardGridAnswerFaceTemplate}"/>
                                    </controls:FlashcardFlipHost.BackContent>
                                </controls:FlashcardFlipHost>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="StudyModeViewBorder"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}"
                    Padding="14,12,14,10">
                <Grid x:Name="StudyModeStage">
                    <StackPanel x:Name="StudyModeContentPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                Width="332"
                                Margin="0,0,0,16">
                        <Border x:Name="StudyModeProgressTrack"
                                Width="316"
                                HorizontalAlignment="Center"
                                Height="4"
                                MinHeight="4"
                                Background="#D8DCE6"
                                CornerRadius="2"
                                ToolTipService.ShowDuration="5000"
                                ToolTipService.InitialShowDelay="250">
                            <Border x:Name="StudyModeProgressFill"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Width="0"
                                    Height="4"
                                    MinHeight="4"
                                    Background="#10B981"
                                    CornerRadius="2"/>
                        </Border>
                        <TextBlock x:Name="StudyModeProgressText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="StudyModeCompletionText"
                                   Visibility="Collapsed"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#10B981"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                        <Border x:Name="StudyModeCard"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ClipToBounds="True"
                                Cursor="Hand"
                                ContextMenu="{StaticResource FlashcardCardContextMenu}"
                                MouseLeftButtonUp="StudyModeCard_MouseLeftButtonUp">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Border.RenderTransform>

                            <controls:FlashcardFlipHost x:Name="StudyModeFlipHost"
                                                        Margin="8,8,8,8">
                                <controls:FlashcardFlipHost.FrontContent>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource FlashcardStudyQuestionFaceTemplate}"/>
                                </controls:FlashcardFlipHost.FrontContent>
                                <controls:FlashcardFlipHost.BackContent>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource FlashcardStudyAnswerFaceTemplate}"/>
                                </controls:FlashcardFlipHost.BackContent>
                            </controls:FlashcardFlipHost>
                        </Border>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0">
                        <Button x:Name="StudyModePreviousButton"
            Content="{Binding [StudyModePrevious], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Margin="5,0,5,8"
            Click="StudyModePreviousButton_Click"/>
                        <Button x:Name="StudyModeNextButton"
            Content="{Binding [StudyModeNext], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Margin="5,0,5,8"
            Click="StudyModeNextButton_Click"/>

                        <Button x:Name="StudyModeMarkKnownButton"
            Content="{Binding [Known], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="140"
            Margin="5,0,5,8"
            Background="#10B981"
            BorderBrush="#10B981"
            Foreground="White"
            Click="StudyModeMarkKnownButton_Click"/>

                        <Button x:Name="StudyModeMarkUnknownButton"
            Content="{Binding [Unknown], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="160"
            Margin="5,0,5,8"
            Background="#F59E0B"
            BorderBrush="#F59E0B"
            Foreground="White"
            Click="StudyModeMarkUnknownButton_Click"/>
                    </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="FlashcardsBottomToolbarBorder"
                Grid.Row="6"
                Margin="20,0,20,12"
                Padding="10,10,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,16,8">
                    <TextBlock Text="{Binding [FlashcardFlipSpeed], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="FlipSpeedSlider"
                            Width="120"
                            TickPlacement="BottomRight"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextColorSecondary}"
                               MinWidth="45">
                        <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value}"/>
                        <Run Text="ms"/>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="QuestionAnswerToggleButton"
                        Content="{Binding [FlashcardsShowAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="150"
                        Click="QuestionAnswerToggleButton_Click"/>
                <Button x:Name="ShuffleModeButton"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="110"
                        Click="ShuffleModeButton_Click"/>
                <Button x:Name="StartStudyModeButton"
                        Content="{Binding [StudyModeStart], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="140"
                        Click="StartStudyModeButton_Click"/>
                <Button x:Name="StudyModeFullscreenButton"
                        Content="{Binding [StudyModeFullscreen], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="150"
                        ToolTip="{Binding [StudyModeFullscreenTooltip], Source={StaticResource Loc}}"
                        Click="StudyModeFullscreenButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarPrimaryButtonStyle}"
                        MinWidth="110"
                        Click="SaveButton_Click"/>
                <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="110"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Border>
