<Window x:Class="NoteCards.Views.MindMapPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:NoteCards.Behaviors"
        x:Name="MindMapWindow"
        Title="{Binding [MindMapPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="1080"
        MinHeight="650"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="MindMapPreviewWindow_Closing">
    <Window.Resources>
        <Style x:Key="MindMapToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="MindMapLinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource MindMapToolbarButtonStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="LinkedNoteBorder"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkedNoteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapToolbarCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource MindMapToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="MindMapToolbarNarrowButtonStyle" TargetType="Button" BasedOn="{StaticResource MindMapToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="MindMapToolbarSectionStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="MindMapToolbarSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="MindMapToolbarTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Padding="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource MindMapSelectedBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapLayoutComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapLayoutComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MindMapLayoutComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="8,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                    <Border Grid.Column="1"
                                            Background="Transparent"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource TextColorSecondary}"
                                              Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    </Border>

                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Margin="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapLinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MindMapLayoutComboBoxStyle}">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="8,0,4,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding ElementName=MindMapWindow, Path=LinkedNoteButtonText}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <Border Grid.Column="1"
                                            Background="Transparent"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource TextColorSecondary}"
                                              Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    </Border>
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Margin="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="176"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource MindMapSelectedBorderBrush}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource MindMapSelectedBorderBrush}"/>
                                <Setter TargetName="ToggleBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4A6EE0"
                                                          BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MindMapToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="ContentRoot"
          Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [MindMapTitleHint], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ElementName=MindMapWindow, Path=NoteLinkOptions}"
                              SelectedItem="{Binding ElementName=MindMapWindow, Path=SelectedLinkedNote, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              Style="{StaticResource MindMapLinkedNoteComboBoxStyle}"
                              SelectedValuePath="Id"
                              ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
                    <Button x:Name="LinkedNoteButton"
                            Content="{Binding ElementName=MindMapWindow, Path=LinkedNoteButtonText}"
                            Style="{StaticResource MindMapLinkedNoteButtonStyle}"
                            Click="LinkedNoteButton_Click"
                            ToolTip="{Binding ElementName=MindMapWindow, Path=LinkedNoteButtonToolTip}"
                            TextOptions.TextFormattingMode="Display"/>
                    <Border x:Name="AiGeneratedInfoBadge"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{DynamicResource IconButtonBackground}"
                            BorderBrush="{DynamicResource IconButtonBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="180"
                            Visibility="Collapsed">
                        <TextBlock Text="🤖"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="20,10,20,0"
                Padding="12,10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Padding="0">
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Left">
                    <StackPanel Style="{StaticResource MindMapToolbarSectionStyle}">
                        <TextBlock Text="{Binding [MindMapToolbarNodes], Source={StaticResource Loc}}"
                                   Style="{StaticResource MindMapToolbarSectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [MindMapAddChild], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    Click="AddChildButton_Click"/>
                            <Button Content="{Binding [MindMapAddSibling], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    Click="AddSiblingButton_Click"/>
                            <Button Content="{Binding [MindMapExpandAll], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    Click="ExpandAllButton_Click"/>
                            <Button Content="{Binding [MindMapCollapseAll], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    Margin="0"
                                    Click="CollapseAllButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource MindMapToolbarSectionStyle}">
                        <TextBlock Text="{Binding [MindMapToolbarArrange], Source={StaticResource Loc}}"
                                   Style="{StaticResource MindMapToolbarSectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LayoutModeComboBox"
                                      Width="178"
                                      Height="32"
                                      Margin="0,0,6,0"
                                      Style="{StaticResource MindMapLayoutComboBoxStyle}"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="LayoutModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="{Binding [MindMapLayoutBalancedTree], Source={StaticResource Loc}}"
                                              Tag="BalancedTree"/>
                                <ComboBoxItem Content="{Binding [MindMapLayoutRightTree], Source={StaticResource Loc}}"
                                              Tag="RightTree"/>
                                <ComboBoxItem Content="{Binding [MindMapLayoutLeftTree], Source={StaticResource Loc}}"
                                              Tag="LeftTree"/>
                                <ComboBoxItem Content="{Binding [MindMapLayoutTopDown], Source={StaticResource Loc}}"
                                              Tag="TopDown"/>
                                <ComboBoxItem Content="{Binding [MindMapLayoutRadial], Source={StaticResource Loc}}"
                                              Tag="Radial"/>
                            </ComboBox>
                            <Button Content="{Binding [MindMapAutoLayout], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    MinWidth="112"
                                    Click="AutoLayoutButton_Click"/>
                            <ToggleButton x:Name="ManualPositioningToggle"
                                          Margin="0"
                                          Style="{StaticResource MindMapToolbarToggleButtonStyle}"
                                          Checked="ManualPositioningToggle_Checked"
                                          Unchecked="ManualPositioningToggle_Unchecked">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="ManualPositioningStatusDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource TextColorSecondary}"
                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding [MindMapManualPositioning], Source={StaticResource Loc}}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <Border x:Name="ManualPositioningStateBadge"
                                            Margin="9,0,0,0"
                                            Padding="6,2"
                                            CornerRadius="8"
                                            Background="{DynamicResource IconButtonBackground}"
                                            BorderBrush="{DynamicResource IconButtonBorder}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="ManualPositioningStateText"
                                                   Text="{Binding [MindMapManualPositioningOff], Source={StaticResource Loc}}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource MindMapToolbarSectionStyle}">
                        <TextBlock Text="{Binding [MindMapToolbarView], Source={StaticResource Loc}}"
                                   Style="{StaticResource MindMapToolbarSectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="{Binding [ZoomReset], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarCompactButtonStyle}"
                                    Click="ResetZoomButton_Click"/>
                            <TextBlock Text="{Binding [MindMapZoom], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Margin="2,0,8,0"/>
                            <Slider x:Name="ZoomSlider"
                                    Width="136"
                                    Minimum="0.45"
                                    Maximum="1.8"
                                    Value="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ValueChanged="ZoomSlider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource MindMapToolbarSectionStyle}"
                                Margin="0">
                        <TextBlock Text="{Binding [MindMapToolbarSearch], Source={StaticResource Loc}}"
                                   Style="{StaticResource MindMapToolbarSectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBox x:Name="SearchTextBox"
                                     Width="220"
                                     Style="{StaticResource MindMapToolbarTextBoxStyle}"
                                     TextChanged="SearchTextBox_TextChanged"
                                     ToolTip="{Binding [MindMapSearchHint], Source={StaticResource Loc}}"/>
                            <Button Content="{Binding [MindMapSearchPrevious], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                                    Margin="8,0,6,0"
                                    Click="SearchPreviousButton_Click"/>
                            <Button Content="{Binding [MindMapSearchNext], Source={StaticResource Loc}}"
                                    Style="{StaticResource MindMapToolbarNarrowButtonStyle}"
                                    Click="SearchNextButton_Click"/>
                            <TextBlock x:Name="SearchResultsTextBlock"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       MinWidth="56"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       Text="{Binding [MindMapSearchNoResults], Source={StaticResource Loc}}"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3"
                Margin="20,10,20,10"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{DynamicResource CardBackground}"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="MapScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          SizeChanged="MapScrollViewer_SizeChanged"
                          PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                <Canvas x:Name="MapCanvas"
                        MinWidth="960"
                        MinHeight="420"
                        Background="Transparent">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4"
                Margin="20,0,20,12"
                Padding="10,10,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0"
                           Orientation="Horizontal"
                           HorizontalAlignment="Left">
                    <Button Content="{Binding [MindMapExportAll], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="150"
                            Click="ExportAllButton_Click"/>
                    <Button Content="{Binding [MindMapImport], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="120"
                            Click="ImportButton_Click"/>
                    <Button Content="{Binding [MindMapExportSelectedBranch], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="170"
                            Click="ExportSelectedBranchButton_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarPrimaryButtonStyle}"
                            MinWidth="110"
                            Click="SaveButton_Click"/>
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                            Style="{StaticResource MindMapToolbarButtonStyle}"
                            MinWidth="110"
                            Click="CloseButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
