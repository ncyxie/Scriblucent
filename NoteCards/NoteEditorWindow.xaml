<Window x:Class="NoteCards.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:NoteCards.Behaviors"
        Title="{Binding [NoteEditorTitle], Source={StaticResource Loc}}"
        Height="600"
        Width="800"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="NoteEditorWindow_Closing">
    <Window.Resources>
        <Style x:Key="EditorToolButtonBaseStyle" TargetType="Button">
            <Setter Property="behaviors:ButtonPressMotionBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="ButtonBorder"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="0"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="EditorDangerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
            <Setter Property="Background" Value="#F6DEDE"/>
            <Setter Property="BorderBrush" Value="#D7A6A6"/>
            <Setter Property="Foreground" Value="#9F2D2D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="0"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFCACA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C78D8D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5BABA"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B97979"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorToolSearchInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrimarySaveButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
            <Setter Property="behaviors:ButtonPressMotionBehavior.MotionHostName" Value="SaveButtonBorder"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3F6FE8"/>
            <Setter Property="BorderBrush" Value="#2F5CD0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SaveButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SaveButtonBorder" Property="Background" Value="#3562D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SaveButtonBorder" Property="Background" Value="#294CB2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorSideToolButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorToolButtonBaseStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="EditorRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="Background" Value="{DynamicResource RichTextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource RichTextBoxForeground}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource RichTextBoxForeground}"/>
        </Style>

        <ControlTemplate x:Key="EditorComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="EditorComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="11"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="EditorComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="EditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="EditorComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="EditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="EditorFontComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource EditorComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorFontComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform Y="12"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,12,14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="StatusIndicatorRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusIndicatorText"
                           Grid.Row="0"
                           Grid.Column="0"
                           Margin="2,0,14,4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColorSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0"
                           Visibility="Collapsed"/>

                <Border Grid.Column="0"
                        Grid.Row="1"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="36"
                        Padding="12,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [NoteEditorTitle], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="↶"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [Undo], Source={StaticResource Loc}}"
                            Click="UndoButton_Click"/>
                    <Button Content="↷"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [Redo], Source={StaticResource Loc}}"
                            Click="RedoButton_Click"/>
                    <Border Width="1"
                            Height="22"
                            Margin="2,0,8,0"
                            Background="{DynamicResource BorderColor}"/>
                    <Button Content="🕘"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [EditHistory], Source={StaticResource Loc}}"
                            Click="EditHistoryButton_Click"/>
                    <Button x:Name="OnlineSearchButton"
                            Content="🌐"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [SearchOnline], Source={StaticResource Loc}}"
                            IsEnabled="False"
                            Click="OnlineSearchButton_Click"/>
                    <Border Width="1"
                            Height="22"
                            Margin="2,0,8,0"
                            Background="{DynamicResource BorderColor}"/>
                    <Button x:Name="ConvertToFlashcardsButton"
                            Content="🧠"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [ConvertToFlashcards], Source={StaticResource Loc}}"
                            Click="ConvertToFlashcardsButton_Click"/>
                    <Button x:Name="ConvertToMindMapButton"
                            Content="🗺"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [ConvertToMindMap], Source={StaticResource Loc}}"
                            Click="ConvertToMindMapButton_Click"/>
                    <Button x:Name="ConvertToTestButton"
                            Content="☑"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [ConvertToTest], Source={StaticResource Loc}}"
                            Click="ConvertToTestButton_Click"/>
                    <Border Width="1"
                            Height="22"
                            Margin="2,0,8,0"
                            Background="{DynamicResource BorderColor}"/>
                    <Button x:Name="SearchButton"
                            Content="🔎"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [Search], Source={StaticResource Loc}}"
                            Click="SearchButton_Click"/>
                    <Button x:Name="ClearContentButton"
                            Content="🗑"
                            Style="{StaticResource EditorToolIconButtonStyle}"
                            ToolTip="{Binding [ClearContent], Source={StaticResource Loc}}"
                            Click="ClearContentButton_Click"/>
                    <Button Content="✓"
                            Style="{StaticResource EditorPrimarySaveButtonStyle}"
                            ToolTip="{Binding [Save], Source={StaticResource Loc}}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="20,10,20,0"
                Padding="12,7"
                CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <Border x:Name="FontPanel"
                Grid.Row="2"
                Grid.Column="0"
                Margin="20,10,20,0"
                Padding="12,7"
                CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform Y="-6"/>
            </Border.RenderTransform>
            <StackPanel>
            <WrapPanel VerticalAlignment="Center"
                       Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [FontLabel], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="FontFamilyBox"
                              Width="180"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="FontFamilyBox_Changed">
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Calibri"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Segoe UI"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Arial"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Times New Roman"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Verdana"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Tahoma"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Georgia"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Trebuchet MS"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Cambria"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Garamond"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="Consolas"/>
                    </ComboBox>

                    <TextBlock Text="{Binding [SizeLabel], Source={StaticResource Loc}}"
                               Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="FontSizeBox"
                              Width="80"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="FontSizeBox_Changed">
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="8"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="9"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="10"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="11"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="12"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="14"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="16"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="18"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="20"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="22"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="24"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="26"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="28"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="36"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="48"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="72"/>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>

            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [SpacingLabel], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="LineSpacingBox"
                              Width="80"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              SelectionChanged="LineSpacingBox_Changed">
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1.0"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1.15"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1.5"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="2.0"/>
                    </ComboBox>

                    <TextBlock Text="{Binding [IndentLabel], Source={StaticResource Loc}}"
                               Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="IndentSizeBox"
                              Width="92"
                              Style="{StaticResource EditorFontComboBoxStyle}"
                              ToolTip="{Binding [IndentSize], Source={StaticResource Loc}}"
                              SelectionChanged="IndentSizeBox_Changed">
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="0.25 in" Tag="24"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="0.5 in" Tag="48"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="0.75 in" Tag="72"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1 in" Tag="96"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1.25 in" Tag="120"/>
                        <ComboBoxItem Style="{StaticResource EditorFontComboBoxItemStyle}" Content="1.5 in" Tag="144"/>
                    </ComboBox>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <TextBlock Text="{Binding [TextStyleLabel], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <Button Content="B"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            FontWeight="Bold"
                            ToolTip="{Binding [Bold], Source={StaticResource Loc}}"
                            Click="ToggleBoldButton_Click"/>

                    <Button Content="I"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            FontStyle="Italic"
                            ToolTip="{Binding [Italic], Source={StaticResource Loc}}"
                            Click="ToggleItalicButton_Click"/>

                    <Button Width="32"
                            Height="32"
                            Margin="0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            ToolTip="{Binding [Underline], Source={StaticResource Loc}}"
                            Click="ToggleUnderlineButton_Click">
                        <TextBlock Text="U" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>

                <Border Width="1"
                        Height="20"
                        Margin="0,6,10,6"
                        Background="{DynamicResource BorderColor}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ListStyle], Source={StaticResource Loc}}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <Button x:Name="BulletListButton"
                            Content="•"
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            FontSize="18"
                            ToolTip="{Binding [BulletListStyle], Source={StaticResource Loc}}"
                            Click="BulletListButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [ListBulletDisc], Source={StaticResource Loc}}"
                                          Click="ListBulletDiscMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListBulletCircle], Source={StaticResource Loc}}"
                                          Click="ListBulletCircleMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListBulletSquare], Source={StaticResource Loc}}"
                                          Click="ListBulletSquareMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="NumberedListButton"
                            Content="1."
                            Width="32"
                            Height="32"
                            Margin="0,0,6,0"
                            Style="{StaticResource EditorToolButtonBaseStyle}"
                            FontSize="12"
                            ToolTip="{Binding [NumberedListStyle], Source={StaticResource Loc}}"
                            Click="NumberedListButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [ListNumberDecimal], Source={StaticResource Loc}}"
                                          Click="ListNumberDecimalMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListNumberLowerLatin], Source={StaticResource Loc}}"
                                          Click="ListNumberLowerLatinMenuItem_Click"/>
                                <MenuItem Header="{Binding [ListNumberUpperRoman], Source={StaticResource Loc}}"
                                          Click="ListNumberUpperRomanMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="ListRemoveButton"
                            Content="×"
                            Width="32"
                            Height="32"
                            Margin="0"
                            Style="{StaticResource EditorDangerToolButtonStyle}"
                            FontSize="16"
                            IsEnabled="False"
                            ToolTip="{Binding [ListRemove], Source={StaticResource Loc}}"
                            Click="ListRemoveButton_Click"/>
                </StackPanel>
            </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Grid.Column="0"
                Margin="20,10,20,8"
                Padding="2"
                CornerRadius="10"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                Background="{DynamicResource CardBackground}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
            </Border.Effect>
            <Border CornerRadius="8"
                    Background="{DynamicResource RichTextBoxBackground}">
                <Grid x:Name="EditorSurface"
                      ClipToBounds="True">
                    <RichTextBox x:Name="ContentTextBox"
                                 Style="{StaticResource EditorRichTextBoxStyle}"
                                 SelectionChanged="ContentTextBox_SelectionChanged"
                                 PreviewMouseWheel="ContentTextBox_PreviewMouseWheel"
                                 TextChanged="ContentTextBox_TextChanged"
                                 SnapsToDevicePixels="True"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 RenderOptions.ClearTypeHint="Enabled"
                                 Margin="0"
                                 Padding="18,16"
                                 FontSize="14"
                                 FontFamily="Calibri"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 KeyboardNavigation.TabNavigation="None"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="{DynamicResource EditorSelectionBrush}"
                                 SelectionOpacity="0.4"
                                 Background="Transparent"
                                 BorderThickness="0">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [Cut], Source={StaticResource Loc}}" Command="Cut"/>
                                <MenuItem Header="{Binding [Copy], Source={StaticResource Loc}}" Command="Copy"/>
                                <MenuItem Header="{Binding [Paste], Source={StaticResource Loc}}" Command="Paste"/>
                                <Separator/>
                                <MenuItem Header="{Binding [SelectAll], Source={StaticResource Loc}}" Command="SelectAll"/>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                    <Canvas x:Name="FloatingImageOverlay"
                            Panel.ZIndex="20"
                            ClipToBounds="False"/>
                    <Border x:Name="EditorScrollbarCorner"
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource ScrollBarTrackBackground}"
                            IsHitTestVisible="False"
                            Panel.ZIndex="30"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="4"
                Grid.Column="0"
                Margin="20,0,20,12"
                Padding="10,7"
                CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <TextBlock x:Name="CounterText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource TextColorSecondary}"
                       HorizontalAlignment="Right"/>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Grid.RowSpan="3"
                Margin="0,10,20,20"
                Padding="7"
                CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          Padding="0">
                <StackPanel>
                    <Button x:Name="OpenFileButton"
                            Content="📂"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [Open], Source={StaticResource Loc}}"
                            Click="OpenFromFileButton_Click"/>
                    <Button Content="🖨"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [Print], Source={StaticResource Loc}}"
                            Click="PrintButton_Click"/>
                    <Button x:Name="ExportButton"
                            Content="⇩"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            FontSize="16"
                            ToolTip="{Binding [Export], Source={StaticResource Loc}}"
                            Click="ExportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [ExportPdf], Source={StaticResource Loc}}"
                                          Click="ExportPdfButton_Click"/>
                                <Separator/>
                                <MenuItem Header="{Binding [ExportNotePackage], Source={StaticResource Loc}}"
                                          Click="ExportNotePackageMenuItem_Click"/>
                                <MenuItem Header="{Binding [ExportRtf], Source={StaticResource Loc}}"
                                          Click="ExportRtfMenuItem_Click"/>
                                <MenuItem Header="{Binding [ExportText], Source={StaticResource Loc}}"
                                          Click="ExportTextMenuItem_Click"/>
                                <MenuItem Header="{Binding [ExportMarkdown], Source={StaticResource Loc}}"
                                          Click="ExportMarkdownMenuItem_Click"/>
                                <MenuItem Header="{Binding [ExportXamlPackage], Source={StaticResource Loc}}"
                                          Click="ExportXamlPackageMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="🖼"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [InsertImage], Source={StaticResource Loc}}"
                            Click="InsertImageButton_Click"/>
                    <Separator Margin="4,0,4,8"/>
                    <Button x:Name="WordWrapButton"
                            Content="↔"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [ToggleWordWrap], Source={StaticResource Loc}}"
                            Click="ToggleWordWrap_Click"/>
                    <Separator Margin="4,0,4,8"/>
                    <Button x:Name="FontButton"
                            Content="𝑭"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [Font], Source={StaticResource Loc}}"
                            Click="FontSettings_Click"/>
                    <Separator Margin="4,0,4,8"/>
                    <Button x:Name="ZoomInButton"
                            Content="+"
                            FontSize="18"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [ZoomIn], Source={StaticResource Loc}}"
                            Click="ZoomInButton_Click"/>
                    <Button x:Name="ZoomOutButton"
                            Content="-"
                            FontSize="18"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [ZoomOut], Source={StaticResource Loc}}"
                            Click="ZoomOutButton_Click"/>
                    <Button x:Name="ZoomResetButton"
                            Content="1:1"
                            FontSize="12"
                            Style="{StaticResource EditorSideToolButtonStyle}"
                            ToolTip="{Binding [ZoomReset], Source={StaticResource Loc}}"
                            Click="ZoomResetButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
